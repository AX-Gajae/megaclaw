<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  월드모델 사이클 — 매일 09:00 (노트 889).

  crontab 이 아니라 LaunchAgent 인 이유: 이 기계에서 `crontab <파일>`(쓰기)이
  멈춘다(읽기 `crontab -l` 은 된다). macOS 가 crontab 수정에 전체 디스크 접근을
  요구해서인데 헤드리스 프로세스에는 그 대화상자를 못 띄운다. LaunchAgent 는
  ~/Library/LaunchAgents 에 파일을 쓰는 평범한 경로이고 이 기계에 이미 열두 개가
  돌고 있다. 그리고 cron 보다 낫다 — 잠들어 지나친 시각을 깨어나서 따라잡는다.

  크론이 하는 일은 **기계적인 것뿐**이다. 판단이 필요한 자리(문서 추출·예측)는
  에이전트 2패스라 요청 파일로 쌓이고 그 목록이 슬랙 DM 으로 온다.

  끄기:  launchctl bootout gui/$(id -u)/com.sweetspot.worldmodel-cycle
  지금 한 번 돌리기:  launchctl kickstart -k gui/$(id -u)/com.sweetspot.worldmodel-cycle
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sweetspot.worldmodel-cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/ax/world_model/cycle_run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ax/world_model</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- 로그는 래퍼가 찍는 것과 같은 파일로 모은다 -->
    <key>StandardOutPath</key>
    <string>/Users/ax/world_model/cycle_log/cycle_cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ax/world_model/cycle_log/cycle_cron.log</string>

    <!-- 로그인 시 자동 실행하지 않는다 --- 정해진 시각에만 돈다 -->
    <key>RunAtLoad</key>
    <false/>

    <!--
      PATH 에 ~/.local/bin 이 **반드시 있어야 한다**(2026-08-10 첫 실행에서 잡음).
      gcloud SDK 는 PATH 에서 python 을 고르는데 이게 빠지면 /usr/bin/python3(3.9)
      가 잡혀 bq 가 `TypeError: unsupported operand type(s) for |` 로 죽는다.
      순서에 기대지 않도록 CLOUDSDK_PYTHON 도 함께 못박는다.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ax/google-cloud-sdk/bin:/Users/ax/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLOUDSDK_PYTHON</key>
        <string>/Users/ax/.local/bin/python3.12</string>
    </dict>
</dict>
</plist>
