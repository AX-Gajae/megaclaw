r-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0b/9e/c2/0b9ec2c5-ec70-e86d-36e3-bea9ce83f4ac/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/512x512bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/dark-dome/id1875297665?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0b/9e/c2/0b9ec2c5-ec70-e86d-36e3-bea9ce83f4ac/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0b/9e/c2/0b9ec2c5-ec70-e86d-36e3-bea9ce83f4ac/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/100x100bb.jpg", "features": [], "releaseNotes": "일부 사소한 버그를 수정했습니다.", "artistId": 1875297665, "artistName": "Dark Dome", "genres": ["게임", "퍼즐", "어드벤처"], "price": 4400.0, "releaseDate": "2026-03-13T07:00:00Z", "genreIds": ["6014", "7012", "7002"], "sellerName": "Dark Dome Studios SAC", "isVppDeviceBasedLicensingEnabled": true, "primaryGenreName": "Games", "primaryGenreId": 6014, "trackId": 6758867945, "trackName": "Hidden Memories", "currentVersionReleaseDate": "2026-06-09T20:50:14Z", "version": "4.0", "wrapperType": "software", "currency": "KRW", "description": "Lucian은 낯선 곳에서 눈을 뜹니다. 그는 갇혀 있으며, 이곳에 어떻게 오게 되었는지 전혀 기억하지 못합니다. 탈출할 수 있는 유일한 방법은 지난 밤의 사건들을 재구성하는 것. 하지만 진실이 당신의 상상보다 더 끔찍하다면요?\n\n구석구석을 탐험하고, 중요한 물건을 찾고, 기억의 조각들을 되살려 진실을 밝혀내세요. 그 기억 속에는 모든 열쇠를 쥔 듯한 수수께끼의 소녀가 등장하지만… 그녀를 찾는 것은 쉽지 않을 것입니다. 그녀는 아군일까요? 아니면 악몽의 시작일까요?\n\n수수께끼의 인물들과 상호작용하세요\n독창적인 퍼즐과 두뇌를 자극하는 수수께끼를 풀어보세요\n어둠의 비밀로 가득한 기억 속으로 몰입하세요\n\n당신의 선택 하나하나가 진실에 더 가까워지게 하거나, 더 깊은 미스터리 속으로 빠져들게 만듭니다. 탈출할 수 있을까요?\n\n당신의 두뇌를 시험할 포인트 앤 클릭 미스터리 게임\n이 모험에서 당신은 주인공의 잊혀진 기억을 탐험하며 독특한 사고력을 요구하는 도전에 맞서야 합니다. 각 기억에는 정교한 퍼즐과 교묘한 수수께끼가 숨어 있으며, 이것을 풀어야만 탈출할 수 있고 이 소름끼치는 이야기의 결말에 도달할 수 있습니다.\n서스펜스 넘치는 분위기, 예기치 못한 전개, 미스터리한 캐릭터들이 이야기에 몰입감을 더하며, 수수께끼로 가득한 Hidden Town의 세계를 더욱 깊게 파고들 수 있게 합니다.\n\n몰입감 있는 경험: 긴장감 넘치는 사운드트랙과 아름다운 비주얼로 그림자와 비밀로 가득한 세계에 완전히 빠져보세요.\n\n새로운 도전: 숨겨진 그림자와 갇힌 영혼들\n예기치 못한 장소에 숨겨진 10개의 그림자를 찾아보세요. 쉬운 일이 아니므로, 당신의 관찰력과 지혜를 시험해보세요.\n길 잃은 영혼들의 부두 인형: 여정을 따라가며, 이곳에 갇힌 영혼들과 연결된 부두 인형을 발견하게 됩니다. 각 인형은 미니 게임을 열어주며, 당신은 이 영혼들이 저세상으로 갈 수 있도록 도와야 합니다. 그들은 어떻게 죽었을까요? 어떤 비밀을 남겼을까요? 그들을 구할 수 있을까요, 아니면 영원히 이곳을 떠돌게 될까요?\n\n프리미엄 버전\n프리미엄 버전을 구매하면 Hidden Town 속 더 많은 미스터리를 밝혀주는 비밀 이야기가 열립니다. 추가적인 도전으로 가득한 독점 장면과 함께 평행 이야기 속으로 빠져보세요. 프리미엄 버전에서는 다음과 같은 혜택을 받을 수 있습니다:\n새로운 독점 퍼즐 해금\n모든 잃어버린 영혼 미니 게임 접근 가능\n광고 없이 즐기기\n무제한 힌트 제공\n\n이 탈출 게임은 어떻게 플레이하나요?\n주변의 사물들을 터치하여 상호작용하고, 숨겨진 단서를 찾고, 아이템을 조합하여 이야기를 진행해보세요. 작은 디테일 하나가 탈출의 열쇠가 될 수도 있고… 영원히 갇히게 만들 수도 있습니다.\n\n지금 \"Hidden Memories\"를 다운로드하고 공포와 미스터리가 가득한 탈출 게임을 경험해보세요. 너무 늦기 전에 진실을 밝혀야 합니다… 아니면 당신도 이 잊혀진 기억 속 또 하나의 잃어버린 영혼이 될지도 모릅니다.\n\nDark Dome의 방탈출 게임에 담긴 수수께끼 이야기 속으로 빠져보세요. Hidden Town에는 여전히 밝혀지지 않은 수많은 비밀이 숨어 있습니다.", "sellerUrl": "http://darkdome.com", "averageUserRatingForCurrentVersion": 5, "languageCodesISO2A": ["AR", "BN", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HI", "HU", "ID", "IT", "JA", "KO", "NB", "FA", "PL", "PT", "RO", "RU", "ZH", "ES", "SV", "TE", "TH", "ZH", "TR", "UR", "VI"], "fileSizeBytes": "194632704", "formattedPrice": "￦4,400", "userRatingCountForCurrentVersion": 1, "trackContentRating": "12+", "minimumOsVersion": "12.0", "bundleId": "com.darkdome.hidden.memories", "averageUserRating": 5, "trackCensoredName": "Hidden Memories", "trackViewUrl": "https://apps.apple.com/kr/app/hidden-memories/id6758867945?uo=4", "contentAdvisoryRating": "12+", "userRatingCount": 1}]}