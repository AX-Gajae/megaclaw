urple211/v4/e3/81/60/e3816027-ed71-e54f-370f-431794096bc4/2fd54499-5a7a-48f7-837b-2ba8b2368985_ipad.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/b4/55/96/b45596c3-5a61-2f93-89b3-2e05d43d8319/4a0d5289-2015-4df6-9967-9ef81a1a0ce4_ASO_template_iPad12-9_screen_03.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/fc/f4/fd/fcf4fdc6-0049-5b12-42b0-7cc06f6a79c1/b718987f-eb5d-4188-83d8-5d2532b5e4eb_ASO_template_iPad12-9_screen_04.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/46/d3/2f/46d32fd1-6e47-718b-8126-945e742db362/fd31c16f-a278-42c7-9f3d-a4e4f871e882_ASO_template_iPad12-9_screen_05__U00283_U0029.png/576x768bb.png"], "appletvScreenshotUrls": [], "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c3/f7/0e/c3f70e29-d8c7-66a2-fafe-435c92bb5c24/AppIcon-0-0-1x_U007epad-0-1-85-220.png/60x60bb.jpg", "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c3/f7/0e/c3f70e29-d8c7-66a2-fafe-435c92bb5c24/AppIcon-0-0-1x_U007epad-0-1-85-220.png/512x512bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c3/f7/0e/c3f70e29-d8c7-66a2-fafe-435c92bb5c24/AppIcon-0-0-1x_U007epad-0-1-85-220.png/100x100bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/%E4%B8%80%E8%88%AC%E8%B2%A1%E5%9B%A3%E6%B3%95%E4%BA%BA-%E6%97%A5%E6%9C%AC%E6%B0%97%E8%B1%A1%E5%8D%94%E4%BC%9A/id433865749?uo=4", "features": ["iosUniversal"], "bundleId": "jp.or.jwa.tenkijp1", "artistId": 433865749, "artistName": "一般財団法人 日本気象協会", "genres": ["날씨", "뉴스"], "genreIds": ["6001", "6009"], "price": 0.0, "primaryGenreName": "Weather", "primaryGenreId": 6001, "sellerName": "Japan Weather Association", "isVppDeviceBasedLicensingEnabled": true, "releaseDate": "2011-05-15T19:31:53Z", "trackName": "tenki.jp 天気予報・雨雲レーダー/地震速報・台風情報", "trackId": 433865746, "currentVersionReleaseDate": "2026-07-26T15:10:43Z", "version": "4.0.0", "wrapperType": "software", "currency": "KRW", "description": "【tenki.jpとは】\n\ntenki.jpは、日本気象協会が運営する公式天気・防災情報アプリです。1時間ごとの天気予報・48時間先まで無料の雨雲レーダー・地震速報・台風情報・花粉・気圧・熱中症など、日常の天気確認から緊急時の防災対策まで対応するオールインワンのお天気アプリです。全国各地の気象予報士が24時間体制で分析・予測し、常に最新の気象情報をお届けします。\n\n\n【tenki.jpの特徴】\n\n・日本気象協会公式の信頼性の高い気象情報\n・48時間先まで無料で使える雨雲レーダー\n・台風・地震・津波・警報注意報などの防災情報を1つのアプリで確認\n・花粉・気圧・熱中症・PM2.5など健康に関わる生活指数を毎日更新\n・全国の気象予報士による解説コラム「日直予報士」を毎日複数回更新\n・ウィジェット・通知機能でアプリを開かずに天気を把握\n・tenki.jpメンバーシップ（無料）でポイントが貯まる\n\n\n【主な機能】\n\n■ 天気予報\n\n・1時間ごとの天気予報：天気・気温・降水確率・湿度・降水量・風向き・風速を時間単位で確認できます\n・2週間天気予報：テレビの週間予報より長い14日間分の予報を確認できます。4日目以降も6時間単位で詳細確認が可能です\n・今いる場所の天気：現在地の気温・降水量・風向き・風速をリアルタイムで確認できます\n・地点登録：自宅・職場・実家など、よく使う場所を最大10か所お気に入り登録できます（tenki.jpライトでは最大20か所）\n・天気リスト：登録した地点を一覧で表示できます。みたい情報（時間ごと・週間予報など）をカスタマイズできます\n\n■ 雨雲レーダー（無料で48時間先まで）\n\n・現在の雨雲の動きをリアルタイムで表示\n・48時間先までの雨雲の動きを無料で確認可能\n・雷レーダーもご利用いただけます\n・外出・レジャー・イベント前の天気確認に最適です\n\n■ 地震速報・防災情報\n\n・防災：防災に関する情報を１画面で確認できます。\n・全国の最新21件の地震情報をリアルタイム表示\n・台風情報・津波情報・警報注意報・火山情報など、防災に必要な情報をワンアプリで一括確認\n・tenki.jpメンバーシップの「いのちを守る防災診断」で、自宅周辺の危険度・ハザードマップ・避難対策を確認できます\n\n■ 気圧・花粉・熱中症などの生活指数\n\n低気圧による頭痛・花粉症・熱中症など、天気に左右されやすい体調変化を毎日更新してお届けします。以下の生活指数をお好みで最大5つカスタマイズして表示できます。\n\n【通年】服装・洗濯・お出かけ・星空・傘・紫外線・体感温度・洗車・睡眠\n【夏季】汗かき・不快・冷房・アイス・ビール・蚊ケア\n【冬季】水道凍結・うるおい・霜・風邪ひき・暖房・鍋もの\n【その他】花粉（1月下旬〜5月）・熱中症（4〜9月）・PM2.5（通年）\n\n■ 日直予報士\n\n日本気象協会所属の気象予報士が、最新の天気・防災・季節の話題を毎日複数回更新して解説します。\n\n■ レジャー天気\n\n人気のレジャースポット別の天気情報を提供します。\n山・海・空港・野球場・サッカー場・ゴルフ場・キャンプ場・競馬場・釣り・お出かけ天気など、週末の計画に役立てられます。\n\n■ 季節情報\n\n四季折々の便利情報を特集・ニュースでお届けします。\n台風情報・紅葉見頃情報・熱中症情報・ヒートショック・花粉情報・桜開花情報・GWの天候・梅雨入り・明け・スキー積雪情報・初日の出\n\n■ 天気図・気象衛星\n\n実況天気図・予想天気図（24・48・72時間後）・気象衛星画像・PM2.5分布予測を確認できます。\n\n■ ウィジェット・通知機能\n\n・ホーム画面のウィジェットでアプリを起動せずに天気を確認\n・朝（7〜8時頃）・昼（11〜12時頃）・夕（17〜18時頃）・晩（20〜21時頃）から選んで天気予報を通知\n・現在地の雨雲接近プッシュ通知（tenki.jpライト加入で利用可能）\n\n\n【こんな方におすすめ】\n\n・朝の服装や傘の必要性をすぐに判断したい方\n・週末の登山・アウトドア・ゴルフなど、レジャーの天気を事前に調べたい方\n・台風・大雨・地震など、災害リスクに備えたい方\n・気圧の変化で頭痛や体調不良が起きやすい方（低気圧・頭痛対策）\n・花粉症の時期に飛散量・花粉情報を毎日確認したい方\n・2週間先まで天気を把握して旅行や行事の計画を立てたい方\n・熱中症・PM2.5など健康に関わる気象情報を活用したい方\n\n\n【tenki.jpメンバーシップ（登録無料）】\n\n無料のメンバー登録で以下の機能が使えます。\n\n1. 防災：自宅付近の天気予報・災害情報・防災危険度を一覧で確認。台風・地震・ゲリラ豪雨など緊急時も安心して行動できます\n2. いのちを守る防災診断：自宅周辺の危険度・ハザードマップを確認し、ひとりひとりに合わせた避難対策・防災グッズの提案を受けられます\n3. tenki.jpポイント：毎日の天気予報チェックでポイントが貯まり、電子マネーやコンビニスイーツなどに交換できます\n\n\n【サブスクプラン：tenki.jpライト（月額260円）】\n\n・主要画面の広告が非表示\n・現在地の雨雲接近プッシュ通知\n・天気予報の登録地点を最大20か所まで拡張\n・新機能や限定コンテンツをいち早く利用可能\n\n\n【tenki.jpまとめ】\n\ntenki.jpは、日本気象協会公式の天気・防災アプリです。雨雲レーダー・地震速報・花粉・気圧・熱中症情報を一本で網羅し、毎日の天気確認から台風・災害時の防災対策、レジャー計画まで幅広く対応します。全国の気象予報士が24時間体制でお届けする信頼性の高い気象情報を、ぜひ毎日の生活にお役立てください。\n\n【関連アプリ】tenki.jp登山天気\n【プライバシーポリシー】https://static.tenki.jp/inapp/app/iphone/privacy.html\n【利用規約】https://static.tenki.jp/inapp/app/iphone/rule.html", "averageUserRatingForCurrentVersion": 4.82222, "trackCensoredName": "tenki.jp 天気予報・雨雲レーダー/地震速報・台風情報", "languageCodesISO2A": ["JA"], "fileSizeBytes": "250964992", "formattedPrice": "무료", "contentAdvisoryRating": "4+", "userRatingCountForCurrentVersion": 45, "trackViewUrl": "https://apps.apple.com/kr/app/tenki-jp-%E5%A4%A9%E6%B0%97%E4%BA%88%E5%A0%B1-%E9%9B%A8%E9%9B%B2%E3%83%AC%E3%83%BC%E3%83%80%E3%83%BC-%E5%9C%B0%E9%9C%87%E9%80%9F%E5%A0%B1-%E5%8F%B0%E9%A2%A8%E6%83%85%E5%A0%B1/id433865746?uo=4", "trackContentRating": "4+", "sellerUrl": "https://tenki.jp/", "averageUserRating": 4.82222, "minimumOsVersion": "16.0", "releaseNotes": "いつも「tenki.jp」をご利用いただきありがとうございます。\n今回のアップデートは以下になります。\n\n【UXアップデート　第一弾】\n・新画面「天気リスト」：日常の知りたい場所の天気を一目でご確認いただけます。\n・新画面「防災」：大変な日に必要な防災情報を素早く確認いただけます。\n・ボトムメニューを刷新、必要な情報に迷わずアクセスしやすくなりました。\n・地点検索プレビュー機能：地点登録する前に、気になる天気を確認いただけます。\n\n今後も「tenki.jp」は、皆さまの快適で安心な生活をサポートするため、サービスの向上に努めてまいります。\n引き続き「tenki.jp」をよろしくお願いいたします。", "userRatingCount": 45}]}