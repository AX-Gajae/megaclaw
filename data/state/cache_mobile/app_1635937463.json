s", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "averageUserRating": 2.94118, "trackCensoredName": "UNO Wonder", "trackViewUrl": "https://apps.apple.com/kr/app/uno-wonder/id1635937463?uo=4", "contentAdvisoryRating": "4+", "averageUserRatingForCurrentVersion": 2.94118, "sellerUrl": "https://www.mattel163.com/", "languageCodesISO2A": ["NL", "EN", "FR", "DE", "IT", "JA", "PL", "PT", "RU", "ZH", "ES", "ZH", "TR"], "fileSizeBytes": "437037056", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 17, "trackContentRating": "4+", "artistId": 1344700141, "artistName": "Mattel163 Limited", "bundleId": "com.mattel163.uno2", "releaseDate": "2025-09-17T07:00:00Z", "trackId": 1635937463, "trackName": "UNO Wonder", "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Mattel163 Limited", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-06-29T03:02:28Z", "releaseNotes": "UNO Wonder가 7월 1일 UNO Teams 콜라보를 맞이합니다! 전용 Team 카드가 더 많은 전략적 선택지를 제공합니다. 카드를 내는 타이밍, 협력의 순간—모든 선택이 결과를 바꿀 수 있습니다. 팀원과 함께 호흡을 맞춰 결정적인 순간에 역전승을 거머쥐세요!", "version": "1.0.22.1", "wrapperType": "software", "currency": "KRW", "description": "완전히 새로운 공식 UNO 게임!\nUNO Wonder에서 펼쳐지는 짜릿한 크루즈 모험에 모두 탑승하세요! 기억에 남을 여정을 따라 흥미진진한 새로운 변화를 더한 클래식 UNO를 즐기세요. 모험용 티켓을 받으세요!\n\n공식 UNO 플레이\n여러분이 알고 사랑하는 정통 UNO를 이제 경이로운 변화를 더해 즐기세요! 리버스를 사용하여 상대에 도전하고, 드로우 2를 쌓아 올리며, 가장 먼저 \"UNO!\"를 외치는 레이스를 펼쳐보세요. 세대를 이어 가족을 하나로 묶어온 클래식 카드 게임이 주머니 속에서 펼쳐집니다!\n\n새로운 규칙을 발견하세요\n9개의 혁신적인 새로운 액션 카드로 완전히 새로운 UNO를 경험해 보세요! 와일드 모두 건너뛰기는 즉시 다시 플레이할 수 있게 해주고, 토네이도 넘버는 모든 숫자 카드를 제거합니다. 매 경기마다 새로운 전략을 펼치세요!\n\n세계 여행하기\n14개의 멋진 항로를 따라 고급스러운 글로벌 크루즈를 떠나고, 상징적인 명소들을 방문하며, 여행 중에 새로운 친구들을 사귀세요. 바르셀로나, 피렌체, 로마, 산토리니, 몬테카를로와 같은 수백 개의 활기찬 도시를 개방하세요! 각 목적지는 독특한 이야기를 들려줍니다. 손끝에서 세계의 경이로움을 탐험하세요!\n\n재미있는 스티커 수집하기\n모든 목적지에서 아름답게 디자인된 스티커로 여러분의 여정을 자랑하세요! 세트를 완성하여 독점 보상을 잠금 해제하고 업적을 자랑하세요. \n\n에픽 보스를 물리치세요\n이보다 짜릿한 UNO 플레이는 없습니다! 3,000개 이상의 레벨을 정복하고 모험을 방해하는 강력한 보스들과 맞서 실력을 시험해 보세요. UNO에서 갈고 닦은 기술을 활용하여 승리로 가는 길을 여세요!\n\n언제 어디서나 플레이하세요\nUNO Wonder는 집이나 다른 곳에서 혼자 플레이하기에 완벽합니다! Wi-Fi가 없다고요? 문제 없습니다! 편한 속도로 플레이하고, 언제든지 UNO Wonder를 일시 중지하세요! 편하게 UNO를 나만의 방식대로 즐기세요!\n\nUNO Wonder에서 새로운 모험을 시작하세요! 지금 새로운 경이로움을 탐험하는 항해를 시작하세요!\n\n커뮤니티에 가입하여 다른 플레이어들을 만나고 UNO Wonder 이야기를 나누세요! Facebook: https://www.facebook.com/UNOWonder \n\nUNO Wonder가 마음에 드시나요? UNO! Mobile을 플레이해 보세요! 더욱 흥미진진한 멀티플레이어 경험이 펼쳐집니다!", "minimumOsVersion": "12.0", "genreIds": ["6014", "7005", "7003"], "genres": ["게임", "카드", "캐주얼"], "price": 0.0, "userRatingCount": 17}]}