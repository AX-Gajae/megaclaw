dAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/funcat-games-limited/id1675439351?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/ca/15/eb/ca15eb18-7fe9-177c-23dc-a3e155417a50/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/ca/15/eb/ca15eb18-7fe9-177c-23dc-a3e155417a50/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/100x100bb.jpg", "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/ca/15/eb/ca15eb18-7fe9-177c-23dc-a3e155417a50/AppIcon-0-0-1x_U007emarketing-0-8-0-0-85-220.png/512x512bb.jpg", "screenshotUrls": [], "minimumOsVersion": "12.0", "artistId": 1675439351, "artistName": "Funcat Games Limited", "genres": ["게임", "롤플레잉", "어드벤처"], "genreIds": ["6014", "7014", "7002"], "bundleId": "com.tokyoghoulkr.ios", "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Funcat Games Limited", "trackId": 6670229520, "trackName": "도쿄 구울: Awakening", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-17T06:23:27Z", "version": "4.0", "wrapperType": "software", "currency": "KRW", "description": "도쿄 구울 애니 공식 라이선스 RPG! 「도쿄 구울: Break the Chains」, 현재 「도쿄 구울: Awakening」로 진화! \n짜릿한 액션 ! 간편한 조작! 모든 캐릭터 대폭 강화! 그리고 2000 뽑기 증정 이벤트 진행 중! \n\n[세계관 소개]\n도쿄. 이곳에는 인간의 모습으로 인간을 잡아먹는 \"구울\"이라는 괴물들이 살아가고 있다. 평소 독서를 좋아하는 대학생 카네키 켄은 단골 커피숍인 \"안테이크\"에서 카미시로 리제라는 소녀를 만난다. 둘은 나이, 경험뿐만 아니라 좋아하는 책까지 비슷하여 친해지게 된다. 하지만... 그녀와의 서점 데이트 이후 자신의 운명을 바꿔놓은 사고에 휘말려 \"구울\"의 기관을 이식받게 되는데...\n\n카네키 켄은 이 비뚤어진 세계에서 의문과 갈등을 안고, 피할 수 없는 뒤틀린 일들에 서서히 뒤얽히게 된다.\n\n[게임 소개]\n◆ 다양한 캐릭터 등장\n3D 모델링으로 재현된 캐릭터들의 실감나는 전투!\n30명 이상의 캐릭터로 드림팀을 구성하세요!\n\n◆ 인기 애니메이션 \"도쿄 구울\" 스토리 재현\n3D 캐릭터 모델링으로 오리지널 장면 완벽 재현!\n여전히 스릴 넘치고 매혹적인 갈등의 세계를 체험해 보세요!\n\n◆전략적 전투 플레이\n궁극기 발동 타이밍과 캐릭터 조합으로 승패 결정! \n적절한 타이밍에 스킬을 사용하여 전세를 역전시켜 보세요!\n\n◆풍부한 콘텐츠\n인간과 구울의 갈등을 다룬 스토리, 혼자서 즐기는 던전 콘텐츠, 다른 플레이어와 함께 즐기는 협동 콘텐츠, PVP 실시간 전투 콘텐츠 등 다양한 콘텐츠가 가득합니다!", "averageUserRating": 4.56951, "languageCodesISO2A": ["KO"], "fileSizeBytes": "344622080", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 2007, "trackContentRating": "12+", "trackCensoredName": "도쿄 구울: Awakening", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%8F%84%EC%BF%84-%EA%B5%AC%EC%9A%B8-awakening/id6670229520?uo=4", "contentAdvisoryRating": "12+", "averageUserRatingForCurrentVersion": 4.56951, "releaseDate": "2025-03-13T07:00:00Z", "releaseNotes": "일부 알려진 버그 수정.", "price": 0.0, "userRatingCount": 2007}]}