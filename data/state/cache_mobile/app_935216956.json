adAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/97/3f/c1/973fc1ac-d8d0-028d-055d-db313fe3bd86/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/60x60bb.jpg", "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/97/3f/c1/973fc1ac-d8d0-028d-055d-db313fe3bd86/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/512x512bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/97/3f/c1/973fc1ac-d8d0-028d-055d-db313fe3bd86/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/100x100bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/3909/id541419307?uo=4", "genres": ["게임", "시뮬레이션", "엔터테인먼트", "롤플레잉"], "artistId": 541419307, "artistName": "3909", "price": 7700.0, "genreIds": ["6014", "7015", "6016", "7014"], "releaseDate": "2014-12-12T08:55:29Z", "trackId": 935216956, "trackName": "Papers, Please", "bundleId": "co.3909.papersplease", "isVppDeviceBasedLicensingEnabled": true, "sellerName": "3909 LLC", "currentVersionReleaseDate": "2023-07-17T08:16:59Z", "releaseNotes": "다양한 작은 수정 사항", "version": "1.4.12", "wrapperType": "software", "currency": "KRW", "description": "디스토피아 서류 스릴러.\n비평가들의 찬사를 받고, 수상 경력에 빛나는 국경 조사관 게임.\n______________________________________\n\n\"축하합니다.\"\n\"10월 노동 복권 추첨이 끝났습니다. 당신이 뽑혔습니다.\"\n\"빠른 배치를 위해, 그레스틴 국경 검문소의 입국부에 보고하십시오.\"\n\"동 그레스틴에 있는 당신 가족에게 아파트가 제공될 예정입니다. 8급 아파트입니다.\"\n\"아스토츠카에 영광 있으라.\"\n______________________________________\n\n스토리\n\n공산주의 국가인 아스토츠카는 이웃 콜레치아와의 6년 전쟁을 막 끝내고 국경 도시인 그레스틴의 절반을 되찾았습니다.\n\n이민 조사관으로서 당신의 임무는 콜레치아에서 아스토츠카의 그레스틴 쪽으로 오는 사람들의 흐름을 통제하는 것입니다. 수많은 이민자와 일자리를 찾는 방문객 중에는 숨은 밀수꾼, 스파이, 테러리스트 등이 있습니다.\n\n여행자가 제공한 서류와 입국부의 검사, 검색, 지문 검사 시스템을 이용하여 아스토츠카에 입국할 수 있는 사람과 거부되거나 체포될 사람을 결정해야 합니다.\n______________________________________\n\n주의\n\n이 게임은 성인용 주제, 실사가 아닌 노출, 픽셀화된 폭력의 짧은 순간이 포함되어 있습니다.\n\n______________________________________\n\n수상 이력\n\n◉ Best Game of 2013 - The New Yorker\n◉ Best Game of 2013 - Wired Magazine\n◉ Top Indie Game 2013 - Forbes Magazine\n◉ Best Strategy & Simulation Game 2014 - BAFTA\n◉ Grand Prize Winner 2014 - Independent Games Festival\n◉ Excellence in Design Winner - IGF 2014\n◉ Excellence in Narrative Winner - IGF 2014\n◉ GameCity Prize Winner 2014 - GameCity\n◉ Cultural Innovation Award 2013 - SXSW\n◉ Best PC Game 2014 - LARA Game Awards\n◉ Innovation Award - GDCA 2014\n◉ Most Innovative 2014 - Games For Change\n◉ Best Gameplay 2014 - Games For Change\n◉ Best Game of 2013 - Ars Technica\n◉ Best Game of 2013 - PC World\n◉ Best PC Game of 2013 - Destructoid\n◉ Best Story of 2013 - Destructoid\n... 등 수많은 상을 수상하였습니다.", "averageUserRatingForCurrentVersion": 3.98413, "minimumOsVersion": "11.0", "sellerUrl": "https://papersplea.se", "averageUserRating": 3.98413, "trackCensoredName": "Papers, Please", "languageCodesISO2A": ["EU", "CS", "EN", "FR", "DE", "ID", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TR", "UK"], "fileSizeBytes": "64624640", "formattedPrice": "￦7,700", "contentAdvisoryRating": "17+", "userRatingCountForCurrentVersion": 63, "trackViewUrl": "https://apps.apple.com/kr/app/papers-please/id935216956?uo=4", "trackContentRating": "17+", "primaryGenreName": "Games", "primaryGenreId": 6014, "userRatingCount": 63}]}