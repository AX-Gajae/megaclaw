hone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "kind": "software", "advisories": [], "minimumOsVersion": "16.4", "userRatingCountForCurrentVersion": 234, "averageUserRatingForCurrentVersion": 4.65812, "sellerUrl": "https://baceline.io/ko/privacy-policy", "languageCodesISO2A": ["KO"], "fileSizeBytes": "152386560", "formattedPrice": "무료", "trackContentRating": "4+", "trackCensoredName": "베이스라인 | 테니스 대회, 코트 예약, 친구찾기", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%B2%A0%EC%9D%B4%EC%8A%A4%EB%9D%BC%EC%9D%B8-%ED%85%8C%EB%8B%88%EC%8A%A4-%EB%8C%80%ED%9A%8C-%EC%BD%94%ED%8A%B8-%EC%98%88%EC%95%BD-%EC%B9%9C%EA%B5%AC%EC%B0%BE%EA%B8%B0/id6741500563?uo=4", "averageUserRating": 4.65812, "contentAdvisoryRating": "4+", "genres": ["스포츠", "라이프스타일"], "artistId": 1889352632, "artistName": "Jungyoon Hwang", "price": 0.0, "sellerName": "Jungyoon Hwang", "trackId": 6741500563, "trackName": "베이스라인 | 테니스 대회, 코트 예약, 친구찾기", "primaryGenreName": "Sports", "primaryGenreId": 6004, "genreIds": ["6004", "6012"], "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-31T14:15:43Z", "releaseNotes": "새로워진 BACELINE 2.5.6\n\n[참가 접수 완료 화면 개편]\n대회 참가 접수를 마치면 바로 결제하거나 참가를 취소할 수 있어요.\n접수 순번과 결제 안내를 한 화면에서 명확하게 확인할 수 있어요.\n가상계좌는 발급 후 30분 동안 유지되며, 시간이 지나면 참가가 자동으로 취소돼요.\n\n[더 매끄러워진 결제]\n카카오페이, 카드 결제를 마치고 앱으로 돌아왔을 때 결제가 끊기지 않고 그대로 이어져요.\n코트 예약과 대회 참가 결제 모두 더 빠르고 안정적으로 완료돼요.\n\n[안정성 개선]\n화면 전환과 목록 스크롤을 더 부드럽게 다듬고, 일부 기기에서 발생하던 앱 종료 문제를 수정했어요.\n\n업데이트하고 더 편해진 예약과 결제를 경험해 보세요.", "version": "2.5.6", "wrapperType": "software", "currency": "KRW", "description": "베이스라인 - 테니스·피클볼 대회와 AI 영상 분석\n\n테니스 치는 사람이라면 이제 다 베이스라인에서.\n전국 대회 참가부터 AI 영상 분석, 코트 예약까지 한 번에 해결.\n\n\n[AI 비주얼 스튜디오]\n\n◆ 움직임 분석 (NEW)\nAI가 내 스윙 데이터를 분석해서 부상 예방 포인트와 실력 향상 조언을 알려줌.\n레이더 차트로 내 스윙의 강점과 약점을 한눈에.\n\n◆ AI 스윙 분석 & 7종 스트로크 인식\n포핸드, 백핸드, 서브는 기본이고 발리, 슬라이스, 오버헤드까지 7가지 스트로크를 인식.\n스트로크별 파워와 바이오메카닉스 데이터를 수치로 확인.\n\n◆ AI 공 추적\nAI가 공 궤적을 정밀 추적. 클라우드 처리로 정확도가 대폭 향상됨.\n내가 어디로 공 보냈는지, 상대가 어떻게 받았는지 전부 보임.\n\n◆ AI 자동 하이라이트\n경기 영상 올리면 AI가 알아서 하이라이트 만들어줌.\n멋진 장면만 쏙쏙 골라내서 자동 편집. 공 궤적 렌더링까지.\n\n\n[비디오 에디터]\n\n◆ 프로처럼 영상 편집\n테니스 영상 편집이 이렇게 쉬울 줄이야.\n타임라인 편집, 하이라이트 추출, 텍스트 추가까지.\n편집 끝나면 바로 인스타에 올리면 됨.\n\n\n[대회 & 코트]\n\n◆ 전국 테니스·피클볼 대회 참가\n공식 대회 한눈에 보고 바로 신청.\n검색하고 누르면 끝.\n\n◆ 전국 코트 실시간 현황 & 예약\n코트 찾고 바로 예약.\n대회 날 코트별 경기 진행 상황도 실시간 확인.\n\n\n[소셜 & 랭킹]\n\n◆ 친구 찾기 & 파트너 매칭\n테니스 친구 찾고, 코트 예약할 때 바로 초대.\n혼자 치기 싫으면 여기서 파트너 구하면 됨.\n\n◆ 전국 랭킹 & 리더보드\n내 순위 실시간 확인.\n전국에서 내가 몇 등인지 바로 보임.\n\n◆ 무료 AI 실력 측정 (PSR)\n경기 데이터 기반 내 레벨 객관적으로 분석.\n내 실력 궁금하면 ㄱㄱ\n\n\n[간편 결제]\n\n◆ 간편 결제 & 참가 인증서\n대회 참가비 결제는 탭 2번이면 완료.\n\n[공식 채널]\nInstagram @baceline_tennis\nWebsite www.baceline.io\n\n테니스든 피클볼이든\n베이스라인 하나면 충분.", "bundleId": "com.plsr.app", "releaseDate": "2025-02-25T08:00:00Z", "userRatingCount": 234}]}