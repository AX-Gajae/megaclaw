adAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9d/1b/f5/9d1bf5f4-c528-9112-9906-818a9517b1f1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/dire-wolf-digital/id815343758?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9d/1b/f5/9d1bf5f4-c528-9112-9906-818a9517b1f1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9d/1b/f5/9d1bf5f4-c528-9112-9906-818a9517b1f1/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/100x100bb.jpg", "artistId": 815343758, "artistName": "Dire Wolf Digital", "genres": ["게임", "보드", "전략"], "price": 17000.0, "isVppDeviceBasedLicensingEnabled": true, "sellerName": "Dire Wolf Digital LLC", "genreIds": ["6014", "7004", "7017"], "trackId": 1575414319, "trackName": "Dune: Imperium", "primaryGenreName": "Games", "primaryGenreId": 6014, "currentVersionReleaseDate": "2026-06-29T14:59:40Z", "releaseNotes": "새로운 확장팩에서 강력한 샌드웜을 소환하세요!\n\n아트레이데스 가문을 배신하고 몰락시킨 뒤, 황제 샤담 코리노 4세는 하코넨 가문에게 다시 한번 아라키스의 지배권을 넘겼습니다. 하지만 무앗딥이라는 수수께끼의 전사가 프레멘 사이에서 세력을 키우며, 황제와 그 동맹들의 계략을 위협하고 있습니다.\n\n이 Dune: Imperium Digital의 대형 확장팩은 새로운 제국 덱, 새롭게 재구성된 교전, 새로운 지도자, 요원을 보낼 수 있는 개편된 칸을 통해 핵심 플레이 경험을 완전히 탈바꿈합니다.\n\nUprising에서는 승리를 쟁취하기 위해 새로운 수단을 활용하며, 군사력과 정치적 술수 사이의 균형을 계속 유지해야 합니다. 스파이가 여러분의 계획을 뒷받침하고, 중요한 계약이 자원을 늘려줄 것입니다. 아니면 프레멘의 방식을 익혀 강력한 샌드웜을 타고 전장에 뛰어드세요!\n\n포함 내역\n\n지도자 9명\n\n제국 덱 카드 69장\n\n계책 카드 44장\n\n교전 카드 16장\n\n새로운 저장소 카드 - 길을 닦아라\n\n새로운 시스템\n\n샌드웜\n\n계약\n\n스파이\n\n새로운 도전\n\n새로운 소규모 전투 규칙 및 점수 수정치\n\n새로운 업적", "version": "4.0.9", "wrapperType": "software", "currency": "KRW", "description": "Dune의 세계에 빠져드세요.\n\n\n수상에 빛나는 Dune: Imperium 보드 게임에서 아라키스를 누비며 최강의 전략과 음모를 체험하세요.\n\n\n\"온라인, AI와의 로컬, 또는 강력한 하갈 가문과 결투를 벌이세요.\n\n지도자로서 자신의 실력을 입증해줄 업적을 달성하세요.\n\n지혜와 재치를 극한으로 밀어붙일 여러 가지 도전을 수행하세요.\n\n계속 바뀌며 절대 겹치지 않는 소규모 전투 모드에 참가하여 배지를 따세요!\n\n\n스파이스를 제어하세요. 우주를 지배하세요.\n아라키스. 듄. 사막 행성. 사방으로 펼쳐진 황무지에서 깃발을 높이 드세요. 랜드스래드 대가문의 지도자가 되어 군사와 스파이를 지휘하세요. 누구를 조종하고, 누구를 배신하실 건가요? 폭군 황제. 비밀스러운 베네 게세리트. 영악한 우주 항행 길드. 깊은 사막의 거친 프레멘. 제국의 힘을 손에 넣을 수 있습니다. 그리고 그걸 손에 넣을 방법은 전쟁만은 아닙니다.\nDune: Imperium은 덱 빌딩과 일꾼 배치를 매끄럽게 섞은 새롭고 깊이 있는 테마 전략 게임으로, 제국의 운명이 당신의 결정에 달려 있습니다. 당신은 정치적 동맹과 군사력 중 어느 것을 선택하시겠습니까? 전투력과 음모 중 어느 것을 선택하시겠습니까? 의회에서의 자리와 날카로운 칼 중... 어느 것을 선택하시겠습니까? 카드는 이미 뽑았습니다. 선택은 당신의 것입니다. 제국이 기다립니다.", "bundleId": "com.direwolfdigital.dune", "averageUserRatingForCurrentVersion": 4.89831, "sellerUrl": "https://www.direwolfdigital.com/dune-imperium-digital/", "languageCodesISO2A": ["CS", "EN", "FR", "DE", "IT", "JA", "KO", "PL", "ZH", "ES", "ZH", "UK"], "fileSizeBytes": "811314176", "formattedPrice": "￦17,000", "trackContentRating": "9+", "minimumOsVersion": "15.0", "userRatingCountForCurrentVersion": 236, "trackCensoredName": "Dune: Imperium", "trackViewUrl": "https://apps.apple.com/kr/app/dune-imperium/id1575414319?uo=4", "contentAdvisoryRating": "9+", "averageUserRating": 4.89831, "releaseDate": "2024-03-13T07:00:00Z", "userRatingCount": 236}]}