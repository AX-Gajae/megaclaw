hone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": ["iosUniversal"], "averageUserRatingForCurrentVersion": 0, "contentAdvisoryRating": "4+", "trackCensoredName": "실내 온도계 - 방 온도 측정기 및 날씨", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%8B%A4%EB%82%B4-%EC%98%A8%EB%8F%84%EA%B3%84-%EB%B0%A9-%EC%98%A8%EB%8F%84-%EC%B8%A1%EC%A0%95%EA%B8%B0-%EB%B0%8F-%EB%82%A0%EC%94%A8/id6785022525?uo=4", "averageUserRating": 0, "languageCodesISO2A": ["AR", "AZ", "EN", "FR", "DE", "HU", "ID", "IT", "JA", "KO", "NE", "FA", "PL", "PT", "RU", "ZH", "ES", "TR", "UK", "VI"], "fileSizeBytes": "36729856", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 0, "trackContentRating": "4+", "artistId": 1665717789, "artistName": "Tirin", "genres": ["날씨", "유틸리티"], "price": 0.0, "genreIds": ["6001", "6002"], "trackId": 6785022525, "trackName": "실내 온도계 - 방 온도 측정기 및 날씨", "releaseDate": "2026-07-01T07:00:00Z", "releaseNotes": "원활한 실시간 날씨 및 기온 확인을 위해 성능을 최적화하고 소소한 버그를 수정했습니다.", "primaryGenreName": "Weather", "primaryGenreId": 6001, "sellerName": "tirin bilgi teknolojileri ticaret limited sirketi", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-22T21:53:14Z", "version": "2.0.0", "wrapperType": "software", "currency": "KRW", "description": "실내 온도계로 간편하게 실시간 실내 온도 추정치와 현지 날씨 정보를 확인해 보세요!\n\n실내 온도계는 방 안의 실내 온도를 모니터링하고 추정하는 데 도움을 주는 스마트 유틸리티 앱입니다. 스마트폰 기기 자체에는 외부 공기 온도를 측정하는 온도 센서가 내장되어 있지 않기 때문에, 본 앱은 현지 실외 날씨 정보, 집안의 단열 수준, 낮 시간 자외선(UV) 지수 및 사용자의 피드백을 수집하여 실내 온도를 계산하는 열역학 보정 모델을 사용합니다.\n\n아기 방의 온도가 적절하게 유지되고 있는지 확인하거나, 에어컨이나 난방기를 조절할 때, 혹은 오늘 날씨를 확인하고 싶을 때 실내 온도계가 직관적이고 깔끔한 대시보드를 제공해 드립니다.\n\n► 주요 특징:\n• 스마트 실내 온도 추정: 실외 날씨, 낮 시간 태양 복사열, 건물의 단열 등급을 반영하여 계산된 실내 온도 추정치를 보여줍니다.\n• 실시간 로컬 날씨: 현재 위치의 날씨, 상대 습도, 기압, 풍속 및 자외선(UV) 지수를 즉시 확인할 수 있습니다.\n• 맞춤형 체감 보정 마법사: 현재 느끼는 체감 수준(추움, 적절함, 더움)을 선택하거나 실제 실물 온도계 값을 입력하여 실내 온도 추정치를 즉시 보정할 수 있습니다.\n• 단열 등급 설정: 거주 환경의 단열 상태(높음, 보통, 낮음)를 지정하여 모델의 예측 정확도를 높일 수 있습니다.\n• 스마트 쾌적성 팁: 최적의 실내 공기 상태를 유지하기 위해 환기 타이밍, 냉난방 권장 알림 등 맞춤 팁을 제공합니다.\n\n► 작동 방식 (열역학 온도 추정):\n모바일 기기 내부에는 공기 온도를 직접 측정하는 센서가 없으므로, 본 앱은 외부 날씨 예보 데이터, 습도, 자외선 지수를 분석합니다. 여기에 건물의 단열 등급과 사용자의 보정 오프셋을 더하여 현재 실내 온도를 수학적으로 정밀하게 계산해 냅니다.\n\n※ 주의: 본 앱은 외부 날씨와 주거 구조를 바탕으로 실내 온도를 시뮬레이션하여 산출하는 수학적 추정 모델입니다. iPhone 기기 자체에는 주변 공기 온도를 재는 물리적 온도 센서가 탑재되어 있지 않아, 기기만으로 100% 일치하는 온도를 측정하는 것은 기술적으로 불가능합니다. 최상의 정확도를 위해 기기 보정 기능을 이용해 주시기 바랍니다.\n\n► PREMIUM 가입으로 특별한 기능 잠금 해제:\n3일 무료 체험 기간 동안 Pro 버전을 자유롭게 경험해 보세요:\n• 실시간 및 연속적인 실내 온도 추정 기능.\n• 스마트 쾌적성 분석 및 환기 타이밍 직접 알림.\n• 100% 광고 없는 쾌적한 화면 구성.\n• 고해상도의 현지 날씨 분석 및 UV 지수 분석 예보.\n\n---\n참고: 본 앱은 실외 날씨 및 건물 매개변수를 기반으로 실내 온도를 시뮬레이션하여 보여주는 추정 및 기록 도구이며, 실제 물리적 온도계가 아니므로 100%의 일치 정밀도를 보장하지 않습니다. 의료용 혹은 임상 체온 측정 목적의 체온계로 사용할 수 없습니다.\n\n개인정보 처리방침: https://doc-hosting.flycricket.io/room-thermometer-privacy-policy/e38496c5-8831-4c8e-a47d-6418fee3792f/privacy\n이용 약관: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/", "minimumOsVersion": "15.6", "bundleId": "room.thermometer.indoor.ambient.temperature.home.checker.weather", "userRatingCount": 0}]}