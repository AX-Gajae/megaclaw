iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "isGameCenterEnabled": false, "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/sohta-itoh/id965803614?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/87/a1/8a/87a18a9f-45d3-e3dc-6184-84009978e6a7/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/87/a1/8a/87a18a9f-45d3-e3dc-6184-84009978e6a7/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/100x100bb.jpg", "minimumOsVersion": "11.0", "releaseNotes": "일부 공항 및 항공사 제거 및 추가", "languageCodesISO2A": ["EN", "JA", "KO", "ZH"], "fileSizeBytes": "3948544", "formattedPrice": "￦1,100", "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 0, "artistId": 965803614, "artistName": "Sohta Itoh", "genres": ["여행", "교육"], "price": 1100.0, "bundleId": "com.ydbs.threeltr", "trackId": 965849712, "trackName": "3 레터 퀴즈", "genreIds": ["6003", "6017"], "releaseDate": "2015-03-19T00:41:29Z", "primaryGenreName": "Travel", "primaryGenreId": 6003, "sellerName": "Sohta Itoh", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2022-11-05T17:32:46Z", "version": "2.4.0", "wrapperType": "software", "currency": "KRW", "description": "\"3 레터 퀴즈\"는 공항 코드와 항공사 코드를 기억하는 퀴즈 앱입니다.\n항공사, 여행사, 무역사, 물류회사, 항공관제, 공군 등 공항 코드나 항공사 코드의 암기가 필요한 관계자에게 추천하는 앱입니다.\n\n*** 내용 ***\n\n전세계 512개 공항 및 도시 코드, 123개 항공사 코드를 배울 수 있습니다.\n자신의 연습을 위해 공항 코드와 항공사 코드를 추가할 수도 있습니다.\n\n*** 코드 유형 ***\n\n - IATA 공항 코드 (3레터 코드)\n - ICAO 공항 코드 (4레터 코드)\n - IATA 항공사 코드 (2레터 코드)\n - ICAO 항공사 코드 (3레터 코드)\n\n*** 기능 ***\n\n(1) Quiz (명칭->코드)\n\n공항 이름과 항공사 이름이 화면에 무작위로 표시되고 해당 코드에 대답합니다.\n각 코드의 정답률이 기록됩니다.\n집중적으로 연습하고 싶은 공항이나 항공사에 체크를 해서 반복적으로 학습할 수 있습니다.\n\n(2) Quick Learning (명칭->코드)\n\n공항 이름과 항공사 이름이 무작위로 차례로 화면에 표시됩니다.\n짧은 시간 내에 많은 공항 코드와 항공사 코드를 효율적으로 학습할 수 있습니다.\n\n(3) Quick Learning (코드->명칭)\n\n공항 코드와 항공사 코드가 무작위로 표시됩니다.\n짧은 시간에 효율적으로 많은 공항 코드와 항공사 코드를 배울 수 있습니다.\n\n(4) 일람표\n\n공항 코드와 항공사 코드가 표 형식으로 나열됩니다.\n자신의 연습을 위해 새로운 공항 코드와 항공사 코드를 추가할 수 있습니다.\n\n(5) 지도\n\n공항의 위치가 지도에 표시됩니다.\n표시하는 공항을 국가별, 레벨별로 좁힐 수 있습니다.\n\n*** 언어 ***\n\n이 응용 프로그램은 영어, 일본어, 중국어 (간체), 한국어의 4 언어를 지원합니다.", "userRatingCountForCurrentVersion": 0, "trackCensoredName": "3 레터 퀴즈", "trackViewUrl": "https://apps.apple.com/kr/app/3-%EB%A0%88%ED%84%B0-%ED%80%B4%EC%A6%88/id965849712?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 0, "userRatingCount": 0}]}