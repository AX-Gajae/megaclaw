honeAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/sparkling-society-games-b-v/id726048972?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/7e/cc/cb/7ecccb18-fca2-c063-aff2-31a79c18d40c/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/7e/cc/cb/7ecccb18-fca2-c063-aff2-31a79c18d40c/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/100x100bb.jpg", "languageCodesISO2A": ["AR", "DA", "NL", "EN", "FR", "DE", "ID", "IT", "JA", "KO", "MS", "NB", "FA", "PL", "PT", "RU", "ZH", "ES", "SV", "TH", "TR", "VI"], "fileSizeBytes": "369648640", "formattedPrice": "무료", "trackContentRating": "4+", "sellerUrl": "http://www.sparklingsociety.net/", "userRatingCountForCurrentVersion": 659, "averageUserRatingForCurrentVersion": 4.67982, "currentVersionReleaseDate": "2026-07-23T08:23:33Z", "artistId": 726048972, "artistName": "Sparkling Society Games B.V.", "genres": ["게임", "시뮬레이션", "엔터테인먼트", "가족"], "bundleId": "com.sparklingsociety.cityisland5", "releaseNotes": "버그 수정 및 성능 개선", "trackId": 1176872889, "genreIds": ["6014", "7015", "6016", "7009"], "sellerName": "Sparkling Society Games B.V.", "isVppDeviceBasedLicensingEnabled": true, "primaryGenreName": "Games", "primaryGenreId": 6014, "version": "5.9.0", "wrapperType": "software", "currency": "KRW", "description": "당신의 도시를 건설하세요\n“City Island 5 - 오프라인 건설 타이쿤 심 게임”은 스파클링 소사이어티(Sparkling Society)사에서 선보이는 새로운 도시 건설 게임으로, 여러분을 하나의 섬에서 시작하는 작은 도시의 시장으로 만들어드립니다. 비행선을 보내 세계를 탐사하고 아름다운 새 섬을 발견해 새로운 도시를 건설하세요. 대부분의 도시 건설 게임에서는 하나의 도시만을 관리할 뿐입니다. 하지만 “City Island 5 - 오프라인 건설 타이쿤 심 게임”에서는 수평선을 확장하고 하늘을 넓혀가며 각각 다른 테마와 다른 모습으로 건설할 도시를 발견할 수 있지요. 또한 오프라인으로도 플레이할 수 있어 인터넷이 없거나 와이파이에 연결되지 않아도 나만의 도시를 건설할 수 있는 게임입니다. 수백만 명의 플레이어들과 함께 가장 인기 있는 캐주얼 도시 건설 게임을 모바일로 즐겨보세요! \n\n작은 마을에서 도시로, 초거대도시까지\n마을처럼 작을 도시에서 시작하지만, 더 많은 건물을 건설하고 새로운 섬을 발견해 더 크게 성장할 수 있습니다. City Island심 게임 시리즈의 건설 게임은 퀘스트와 다양한 콘텐츠로 가득 차 있어 심심할 틈이 없는 무료 오프라인 게임입니다. 이웃의 마을와 도시를 방문하거나 나만의 도시를 방문하세요.\n\n목표와 목적이 담긴 도시 건설\n도시를 생생하게 시뮬레이션하며, 무료로 신나게 즐길 수 있는 캐주얼한 오프라인 도시 건설 게임입니다. “City Island 5 - 오프라인 건설 타이쿤 심 게임”에서라면 절대 심심할 겨를이 없다는 뜻이죠! 수백 가지 건물의 잠금을 풀고 새롭게 건설한 후에는 수십 가지 퀘스트를 통해 보물상자를 받고 그 안의 멋진 물건을 만나보세요. 원하는 방식으로 섬의 도시를 설계해 건설하고, 친구들과 서로 도우며 플레이 하세요. 이 캐주얼한 타이쿤 시뮬레이션 게임에서 멋진 여러 건물과 섬을 만나세요. 그리고 장기적으로는 많은 돈을 모아 작은 도시를 성장시키고 내가 원하는 모든 디자인을 실현해 보세요.\n\n“City Island 5 - 오프라인 건설 타이쿤 심 게임”도시 건설 게임 특징:\n▶ 가장 인기 있는 최신 캐주얼 도시 건설 게임을 모바일로 즐겨보세요!\n▶ 이 완벽한 건설 시뮬레이션 게임에서 수집하고 업그레이드하며 도시를 꾸미고 다른 섬을 탐험하세요!\n▶ 보상을 수집하고 보물상자를 받으세요!\n▶ 오프라인이나 온라인으로 즐길 수 있습니다. 인터넷 연결 없이 플레이할 수 있습니다\n▶ 수십 가지의 멋진 섬에 나만의 도시를 건설할 수 있는 재미있는 도시 건설 게임이 다시 돌아왔습니다!\n▶ 나만의 도시를 만들고 다른 플레이어들의 도시도 감상하세요!\n▶ 평가와 피드백 남겨주시는 것을 잊지 마세요!\n\nTerms of Use: https://www.sparklingsociety.net/terms-of-service/", "averageUserRating": 4.67982, "trackCensoredName": "City Island 5: 도시 건설", "trackViewUrl": "https://apps.apple.com/kr/app/city-island-5-%EB%8F%84%EC%8B%9C-%EA%B1%B4%EC%84%A4/id1176872889?uo=4", "contentAdvisoryRating": "4+", "minimumOsVersion": "13.0", "releaseDate": "2018-12-16T10:15:35Z", "trackName": "City Island 5: 도시 건설", "price": 0.0, "userRatingCount": 659}]}