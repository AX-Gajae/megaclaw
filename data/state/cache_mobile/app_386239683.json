yh.png/406x228bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple128/v4/c9/a3/44/c9a344f2-64cf-b466-da55-0f18fcd6ece9/mzl.uhamlupg.png/406x228bb.png"], "ipadScreenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/Purple128/v4/bb/2f/c7/bb2fc71e-77a6-c967-3695-45c46389eb2d/mzl.iohdovcu.jpg/480x360bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple118/v4/1d/cd/ee/1dcdee00-5506-4dad-ee33-acfa29a84deb/mzl.roqeinib.jpg/480x360bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple128/v4/99/3c/fe/993cfe5d-3784-7b44-db92-e9968ab2938e/mzl.impwewym.jpg/480x360bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple118/v4/32/15/8d/32158dd5-9c34-891a-63e3-847d5268e2c2/mzl.ayzkmxfg.jpg/480x360bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple128/v4/51/0b/1a/510b1a95-eddd-e91a-947e-87cb50394167/mzl.wlotkprm.jpg/480x360bb.jpg"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/b5/5c/0e/b55c0e3e-acc4-7408-89d9-4c0ef47f38b5/AppIcon-1x_U007emarketing-0-10-0-85-220.png/512x512bb.jpg", "minimumOsVersion": "8.0", "artistId": 428934441, "artistName": "Pixelbite", "genres": ["게임", "캐주얼", "엔터테인먼트", "레이싱"], "price": 1100.0, "releaseDate": "2011-11-02T05:45:55Z", "bundleId": "com.ea.recklessracing.ipad.bv", "primaryGenreName": "Games", "primaryGenreId": 6014, "genreIds": ["6014", "7003", "6016", "7013"], "trackId": 386239683, "trackName": "Reckless Racing HD", "isVppDeviceBasedLicensingEnabled": true, "sellerName": "Pixelbite", "currentVersionReleaseDate": "2020-10-14T06:09:33Z", "releaseNotes": "* Minor bugfixes", "version": "1.5.2", "wrapperType": "software", "currency": "KRW", "description": "비포장도로를 달리는 레이서가 되어보세요! Retina 디스플레이에 최적화된 Reckless Racing은 전통적인 톱 다운 레이스 방식의 게임 플레이와 최첨단 기술을 사용한 그래픽으로 무장하였습니다. 미끄러지듯 부드럽고 정확한 조작이 가능해졌으며 온라인 멀티 플레이를 통해 친구와 레이스 경주를 펼칠 수 있습니다. 핸들을 꼭 잡고 출발 준비를 하세요. iPhone®과 iPod touch®과 iPad®에선 역시 Reckless Racing입니다!\n\n게임 평론가들의 말을 들어보자\n\"내가 이제까지 해본 톱 다운 레이스 방식의 게임 중 단연 최강.\" - 해외 유명 응용 프로그램 평론 사이트 Touch Arcade의 Eli Hoddap\n\"필이 팍 꽂힌 게임, 깨끗하고 사랑스러운 화면, 반짝이는 강물, 비포장도로의 끝에 보이기 시작하는 큰 목조 교회 표현도 놀랍다. - 해외 유명 응용 프로그램 게임 사이트 Pocket Gamer의 Will Wilson\n\n당신이 깜짝 놀랄 만한 화질\n눈알이 튀어나올 정도로 깜짝 놀랄 만한 화질을 구현하였고, 세세한 부분까지 사실적으로 표현한 그래픽을 보면 직접 진흙탕에서 운전하는 듯한 느낌을 받게 될 것입니다. Retina 디스플레이에서 Reckless Racing의 위력이 얼마나 대단한지 눈으로 직접 확인하세요.\n\n레이스에서의 무모한 도전\n비포장도로 아니면 아스팔트, 트럭 아니면 경주용 자동차, 선택은 당신에게 달려 있습니다. 초보자를 위한 기초 교육을 받고 다양한 운전 기술을 습득하세요. 실력에 따라 금, 은, 동 난이도의 레이스를 즐길 수 있습니다.\n\n자동차 선택과 운전 실력 시험\n레이스 기술을 터득하고, 매우 세세하게 구현된 5가지 트랙에서 경주를 펼치세요. Otis, Lurlene, Bubba가 경주하는 듯한 느낌의 자동차들과 경쟁하게 됩니다! 숨겨진 역주행 트랙을 찾아내서 역주행으로도 적수가 없다는 것을 확인시켜주세요.\n\n3가지 레이스 모드\n이 게임을 시작하는 순간 무법 레이싱의 세계에 흠뻑 빠지게 될 것입니다. Dirt Rally, Hot Lap 기록 대결, Delivery 기록 대결 3가지 모드가 준비되어 있어 각각 다른 레이서과 직접 경쟁하거나 완주 기록을 비교하게 됩니다. Reckless Racing에서 다양한 재미를 만끽하세요!", "averageUserRating": 4.7, "trackCensoredName": "Reckless Racing HD", "trackViewUrl": "https://apps.apple.com/kr/app/reckless-racing-hd/id386239683?uo=4", "contentAdvisoryRating": "4+", "languageCodesISO2A": ["EN", "FR", "DE", "IT", "ES"], "fileSizeBytes": "63305728", "formattedPrice": "￦1,100", "userRatingCountForCurrentVersion": 10, "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 4.7, "sellerUrl": "http://www.pixelbite.se", "userRatingCount": 10}]}