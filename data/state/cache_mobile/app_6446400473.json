icy\n​​Terms of Use: https://appliks.com/terms-of-use", "averageUserRating": 4.16667, "trackCensoredName": "Parallel Space ‒ Dual Accounts", "trackViewUrl": "https://apps.apple.com/kr/app/parallel-space-dual-accounts/id6446400473?uo=4", "contentAdvisoryRating": "4+", "minimumOsVersion": "15.6", "bundleId": "com.mindateq.parallelspace", "userRatingCount": 36}]}