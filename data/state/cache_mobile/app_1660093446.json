cc85200bc_5.png/392x696bb.png"], "ipadScreenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/70/29/b6/7029b692-da5c-9628-cd97-6afee0217323/0ded5169-3d40-4e33-9a24-f49ae89ae21e_9.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/7b/a4/f9/7ba4f9c4-2f58-0f81-4019-9e8c0b3c14f5/dd8b1e3e-4c43-44a8-99b0-05781ac94005_11.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/a9/be/f7/a9bef725-b844-20b1-a5eb-2418aff29ea2/bcc771bd-25e0-4fd9-9bae-bdbd6beefeec_10.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/c2/99/4d/c2994d06-1dde-befb-3416-80465a7fa136/968d77d5-565c-4062-8162-40e79d83e482_12.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/06/98/ee/0698ee0b-14d1-c5a9-c455-0f2bb643f2c6/9f8db26e-d1a8-44fb-85f5-f78f50e1eb4b_36.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/a8/e5/e8/a8e5e8a6-b3da-b18e-3215-9fb4da769699/9f568baa-c8f4-4220-94a3-11aaebfabd3f_37.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/16/4e/a6/164ea686-d4c0-b88c-b454-6b75a4470ea6/4716275c-6914-4d5e-a694-7144a1957d06_39.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8a/23/84/8a23840b-7861-ef58-1864-53c38a147ea4/dee48491-546a-45c7-b328-eb252a8e9588_38.png/576x768bb.png"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/47/b4/33/47b43392-a4b7-56bc-d420-a4028d5e2763/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/512x512bb.jpg", "trackCensoredName": "프린트", "trackViewUrl": "https://apps.apple.com/kr/app/%ED%94%84%EB%A6%B0%ED%8A%B8/id1660093446?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 4.60138, "artistId": 1587214013, "artistName": "Mustafa Uz", "genres": ["비즈니스", "생산성"], "price": 0.0, "primaryGenreName": "Business", "primaryGenreId": 6000, "releaseNotes": "- bug fix", "isVppDeviceBasedLicensingEnabled": true, "genreIds": ["6000", "6007"], "sellerName": "Mustafa Uz", "releaseDate": "2023-01-31T08:00:00Z", "trackId": 1660093446, "trackName": "프린트", "currentVersionReleaseDate": "2025-08-12T13:59:02Z", "version": "1.7", "wrapperType": "software", "currency": "KRW", "description": "스마트 프린터 앱을 사용하면 사진과 문서를 쉽게 인쇄할 수 있습니다. iPhone 또는 iPad에서 인쇄할 수 있습니다. 문서를 선택하거나 카메라로 스캔하고 Wi-Fi 프린터로 보내면 됩니다.\n\n스마트 프린터 앱을 사용하면 모든 종류의 파일을 인쇄할 수 있습니다. AirPrint 프린터용 올인원 프린터 및 스캐너 앱입니다.\n\n스마트 프린터 앱에는 iPhone 또는 iPad 카메라를 사용하여 문서를 스캔하는 스캐너가 내장되어 있습니다.\n\n스캔한 문서를 인쇄하기 전에 편집하고 필터를 추가하십시오. 스캐너를 사용하면 문서를 빠르게 스캔하고 즉시 프린터로 보낼 수 있습니다.\n\n카메라 롤에서 최고의 순간을 선택하고 인쇄하세요. 여러 장의 사진을 한 번에 인쇄할 수 있습니다.\n\niPhone에서 파일에 액세스할 수 있습니다. iCloud 파일에도 액세스할 수 있습니다. 이 앱을 사용하면 PNG, JPEG 및 PDF 파일을 인쇄할 수 있습니다.\n\n인쇄하고 싶은 텍스트나 메모가 있습니까? 이 앱은 메모를 입력, 붙여넣기 또는 가져오기 및 쉽게 인쇄할 수 있는 메모장을 제공합니다.\n\n구독 정보:\n\n$4.99 / 매주\n\n현재 기간이 종료되기 최소 24시간 전에 자동 갱신을 해제하지 않으면 구독이 자동으로 갱신됩니다. 계정은 현재 기간이 끝나기 24시간 이내에 갱신 비용이 청구됩니다. 결제는 구매 확인 시 App Store 계정으로 청구됩니다. 구매 후 언제든지 Apple ID 계정 설정에서 자동 갱신을 관리하거나 끌 수 있습니다.\n\n개인정보 보호정책\n\nhttps://docs.google.com/document/d/18-tCFauF7hgGpY7881tja3Vh-A1l6XL1uTcJEQb4ij4\n\n이용약관\n\nhttps://docs.google.com/document/d/1k1RqmG3arlz44qHvyyvIboOdu0s0tFv_", "bundleId": "printer.app", "averageUserRatingForCurrentVersion": 4.60138, "languageCodesISO2A": ["AR", "HR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HE", "HI", "HU", "ID", "IT", "JA", "KO", "MS", "NB", "PL", "PT", "RO", "RU", "ZH", "SK", "ES", "SV", "TH", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "153973760", "formattedPrice": "무료", "trackContentRating": "4+", "userRatingCountForCurrentVersion": 434, "minimumOsVersion": "14.0", "userRatingCount": 434}]}