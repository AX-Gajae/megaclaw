r-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/29/7f/83/297f835a-d61e-bcc4-9d90-54bfefd591d5/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "screenshotUrls": [], "ipadScreenshotUrls": [], "userRatingCountForCurrentVersion": 185308, "trackCensoredName": "스도쿠 - 클래식 로직 퍼즐 게임", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%8A%A4%EB%8F%84%EC%BF%A0-%ED%81%B4%EB%9E%98%EC%8B%9D-%EB%A1%9C%EC%A7%81-%ED%8D%BC%EC%A6%90-%EA%B2%8C%EC%9E%84/id1193508329?uo=4", "contentAdvisoryRating": "12+", "averageUserRating": 4.73386, "genres": ["게임", "엔터테인먼트", "보드", "퍼즐"], "price": 0.0, "artistId": 1190815537, "artistName": "Easybrain Ltd", "bundleId": "com.easybrain.sudoku", "sellerName": "Easybrain Ltd", "releaseDate": "2017-03-30T09:32:35Z", "trackId": 1193508329, "trackName": "스도쿠 - 클래식 로직 퍼즐 게임", "currentVersionReleaseDate": "2026-07-24T07:25:38Z", "releaseNotes": "- 성능 및 안정성 향상.\n\n스도쿠을 즐기셨으면 하는 바램입니다. 게임을 더 재밌게 즐기실 수 있도록 몇 가지 기능을 향상시켰습니다. 저희는 모든 리뷰를 주의 깊게 확인합니다. 이 게임을 좋아하시는 이유 또는 개선됐으면 하는 점들을 피드백으로 남겨주세요. 스도쿠으로 두뇌를 활발하게 유지하세요!", "version": "7.17.0", "wrapperType": "software", "currency": "KRW", "description": "AppStore에서 가장 많은 다운로드 수를 기록한 스도쿠 앱 중 하나인 이 앱으로 즐겁게 두뇌를 훈련하세요! 스도쿠는 누구나 즐길 수 있는 게임으로 매일 수백만 명이 플레이하고 있습니다! Sudoku.com 앱에 있는 수천 개의 클래식 스도쿠 퍼즐로 두뇌를 활발히 사용하며 스트레스를 풀고 휴식을 취하세요. 지금 설치하고 플레이해보세요!\n\n초심자 및 고급 플레이어들을 위한 클래식 스도쿠. 긴장을 풀거나 머리를 쓰고 싶을 때 — 즐거운 시간을 보내고 싶을 때! 스도쿠에서 두뇌를 자극하는 잠깐의 휴식을 취하시거나 머릿속을 정리해보세요. 어디에서나 좋아하는 게임과 함께 할 수 있습니다. 모바일에서 즐기는 스도쿠도 종이와 연필로 즐길 때와 마찬가지로 좋습니다.\n\n원하시는 레벨을 선택하세요. 쉬운 레벨을 선택하여 두뇌를 훈련시키거나 전문가 레벨을 선택하여 좀 더 본격적인 두뇌훈련을 해보세요. 스도쿠에는 게임을 더욱 쉽게 하실 수 있도록 도와드리기 위한 힌트, 자동 확인, 중복 강조 표시 등의 기능이 있습니다. 이 기능들을 활용하시거나 이 기능들의 도움 없이 문제를 푸실 수 있습니다 — 원하는 대로 선택하실 수 있습니다! 또한 스도쿠의 각 퍼즐은 단 하나의 정답만을 가지고 있습니다.\n\n환상적인 스도쿠 게임을 경험해보세요.\n\n· 가능성이 높은 숫자들을 추적해서 메모해보세요. 각각의 셀을 채우실 때마다 메모가 자동으로 업데이트됩니다!\n· 힌트는 게임이 막혔을 때 해결책을 찾을 수 있도록 안내해줍니다.\n· 일일 도전을 완료하고 특별한 트로피를 획득하세요\n· 시즌 이벤트에 참여하여 독특한 메달을 받으세요\n· 통계를 확인하고 진행 내용을 추적하세요\n· 자신의 한계에 도전하신 후 나중에 실수에 대해 알아보시거나 \"자동 확인\" 기능을 활성화시켜 플레이하면서 동시에 실수를 확인해보세요.\n· 행, 열, 블록에서 숫자가 중복되는 것을 방지하기 위해 중복 숫자를 강조 표시해보세요.\n· iMessage용 닌자 스티커로 자신을 재미있게 표현하세요!\n\n언제나, 어디에서나, 스도쿠으로 두뇌 개발에 도전하세요!", "minimumOsVersion": "15.0", "averageUserRatingForCurrentVersion": 4.73386, "sellerUrl": "https://easybrain.com", "languageCodesISO2A": ["AR", "EN", "FR", "DE", "HI", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "262206464", "formattedPrice": "무료", "trackContentRating": "12+", "genreIds": ["6014", "6016", "7004", "7012"], "primaryGenreName": "Games", "primaryGenreId": 6014, "isVppDeviceBasedLicensingEnabled": true, "userRatingCount": 185308}]}