roMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": ["iosUniversal"], "averageUserRatingForCurrentVersion": 4.79115, "sellerUrl": "https://lessmore.games", "averageUserRating": 4.79115, "trackCensoredName": "Forge Master – Idle RPG", "languageCodesISO2A": ["EN"], "fileSizeBytes": "300892160", "formattedPrice": "무료", "contentAdvisoryRating": "12+", "trackViewUrl": "https://apps.apple.com/kr/app/forge-master-idle-rpg/id6746636289?uo=4", "trackContentRating": "12+", "userRatingCountForCurrentVersion": 881, "artistId": 1579865033, "artistName": "Lessmore GmbH", "genres": ["게임", "롤플레잉", "전략"], "price": 0.0, "bundleId": "com.hariwn.legendofcivilizations", "trackName": "Forge Master – Idle RPG", "trackId": 6746636289, "releaseDate": "2025-08-29T07:00:00Z", "genreIds": ["6014", "7014", "7017"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Lessmore GmbH", "isVppDeviceBasedLicensingEnabled": true, "releaseNotes": "Added Clan Tech Tree and additional small changes/bug fixes. \n\nThank you for playing!", "version": "2.7.0", "wrapperType": "software", "currency": "KRW", "description": "다양한 문명의 무기를 제작하고 장비하세요!\n석기시대의 장비부터 시작하여, 중세시대의 무기까지 단련해보세요.\n대장간을 업그레이드해 근대, 우주 시대, 그리고 양자 시대의 장비를 제작할 수 있습니다!\n\n이 모험을 시작할 준비가 되셨나요?\n\n시대를 넘어 무기를 단련하라!\n\n끝없이 발전하는 온라인 세계로 들어오세요.\n이 경쟁형 멀티플레이 게임에서 당신은 다양한 문명의 무기와 방어구를 제작하고, 새로운 기술을 연구하며, 펫을 육성하고, 전 세계 플레이어와 함께 리더보드 순위를 겨룹니다.\n\n플레이어들과 온라인으로 대결하라\n\n전 세계의 플레이어와 실시간 전투를 펼치세요!\n가장 강력한 장비를 장착하고, 영웅의 고유 능력을 활용해 승리를 거두세요.\n승리할 때마다 보상을 획득하고, 글로벌 리더보드에서 순위를 올리세요.\n또는 클랜 대전에서 팀을 대표해 명예를 쌓을 수도 있습니다.\n\n연구하고 성장하라\n\n기술 트리를 통해 새로운 기술을 연구하여 전투와 제작에서 이점을 얻으세요.\n새로운 제작 방식을 발견하고, 영웅의 능력치를 강화하며, 시대가 발전할수록 효율성을 향상시킬 수 있습니다.\n\n당신만의 영웅을 성장시키세요\n\n다양한 스킬을 해금하고 업그레이드하여 영웅의 전투 스타일을 자유롭게 커스터마이즈하세요.\n빠른 공격, 강력한 방어, 전략적인 플레이 등 — 자신에게 맞는 조합을 찾아 최고의 빌드를 완성하세요.\n\n펫을 수집하고 육성하세요\n\n전투에서 함께 싸울 펫을 부화시켜 육성하세요.\n각 펫은 고유한 능력과 특성을 가지고 있으며, 전투에서 당신을 돕습니다.\n시간이 지날수록 성장하고 강력해져 완벽한 지원팀을 이룹니다.\n\n클랜을 만들고 함께 경쟁하라\n\n다른 플레이어들과 함께 클랜을 만들거나 참여하세요.\n전략을 공유하고 협력하여 클랜 전투에서 승리해 보상을 획득하세요.\n가장 활발한 클랜은 클랜 리더보드 상위권에 오르게 됩니다.\n\n채팅으로 소통하라\n\n실시간 채팅 시스템을 통해 다른 플레이어들과 교류하세요.\n전략을 논의하거나, 클랜 전투를 계획하거나, 진행 상황을 공유할 수 있습니다.\n항상 누군가가 온라인 상태이므로, 언제든 함께 경쟁하거나 이야기를 나눌 수 있습니다.\n\n시대를 넘어 무기를 단련하고, 새로운 기술의 시대를 개척하며,\n끊임없이 진화하는 이 온라인 세계에서 당신의 실력을 증명하세요.\n\n지금 바로 단련을 시작하고 — 당신의 영웅이 얼마나 강해질 수 있는지 확인해보세요!", "minimumOsVersion": "13.0", "currentVersionReleaseDate": "2026-07-14T11:41:11Z", "userRatingCount": 881}]}