ne16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "features": ["iosUniversal"], "advisories": [], "kind": "software", "trackCensoredName": "Brain Puzzle 2: Logic Twist", "trackViewUrl": "https://apps.apple.com/kr/app/brain-puzzle-2-logic-twist/id6747063674?uo=4", "contentAdvisoryRating": "12+", "userRatingCountForCurrentVersion": 2197, "averageUserRating": 4.55485, "averageUserRatingForCurrentVersion": 4.55485, "sellerUrl": "https://www.smallstepinfo.com/", "minimumOsVersion": "13.0", "languageCodesISO2A": ["AR", "FR", "DE", "HI", "ID", "JA", "KO", "MS", "PT", "RU", "ZH", "ES", "TH", "ZH", "VI"], "fileSizeBytes": "354377728", "formattedPrice": "무료", "trackContentRating": "12+", "releaseNotes": "일부 버그 수정", "genres": ["게임", "퍼즐", "엔터테인먼트", "캐주얼"], "trackId": 6747063674, "trackName": "Brain Puzzle 2: Logic Twist", "price": 0.0, "artistId": 1473677344, "artistName": "SmallStep Dev Team", "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Guangzhou SmallStep Information Technology Co., Ltd", "genreIds": ["6014", "7012", "6016", "7003"], "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-05-12T19:33:53Z", "version": "1.1.0", "wrapperType": "software", "currency": "KRW", "description": "이번에는 전작의 유머러스한 스토리텔링과 두뇌를 자극하는 디자인을 이어가며, 더 풍부하고 놀라운 퍼즐 경험을 선사합니다.\n\n이 완전히 새로운 후속작에서는 기발한 플롯을 따라가며 단서와 인터랙티브 요소를 영리하게 활용해, 기이하지만 정교하게 구성된 일련의 스테이지를 해결하게 됩니다.\n\n각 장면에는 신중하게 디자인된 퍼즐, 관례를 따르지 않는 논리, 예상치 못한 반전이 가득해, 고정관념을 벗어나 생각하고, 추리와 창의성이 완벽하게 조화된 즐거움을 누릴 수 있습니다.\n\n복잡한 시스템은 필요 없습니다. 그저 탭하고, 스와이프하고, 탐험하세요! 누구나 즐길 수 있는 재미있고 부담 없는 두뇌 챌린지입니다. 막히더라도 걱정 마세요. 우리의 믿음직한 \"브레인 버디\"가 유쾌한 힌트를 주어 새로운 아이디어를 불러일으키고 앞으로 나아갈 수 있게 도와줍니다.\n\n게임 특징\n\n더 크고, 더 이상한 스토리 – 유행하는 농담과 영리한 반전이 혼합된 터무니없는 시나리오가 웃음과 광란의 창의성을 자극합니다!\n\n다르게 생각하기 – 이 퍼즐들은 겉보기와 다릅니다… 논리를 뒤집어 예상치 못한 해결책을 찾아보세요.\n\n간단하고 재미있는 조작 – 탭, 드래그, 해결. 학습 곡선 없이 바로 뛰어들어 즐기세요.\n\n제한 없는 힌트 – 막힌다고? 필요한 만큼 유용한 힌트를 받을 수 있습니다.\n\n지금 합류하셔서 상상력의 한계에 도전하세요! 창의력과 재치를 활용해 이 터무니없고 유쾌한 퍼즐 어드벤처를 정복하고, 매번 해결할 때의 스릴을 느껴보세요.\n\n 이건 시작에 불과합니다! 더 많은 스테이지와 미친 듯한 스토리가 준비 중입니다. 기대해 주세요!", "releaseDate": "2025-09-03T07:00:00Z", "bundleId": "com.brain.logic.joygame.ios", "userRatingCount": 2197}]}