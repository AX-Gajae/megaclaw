, "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "isGameCenterEnabled": true, "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/0c/2d/41/0c2d413c-a3ff-9f45-68d0-b892cdbe4b3f/AppIcon-0-1x_U007emarketing-0-85-220-0-7.png/512x512bb.jpg", "kind": "software", "features": ["gameCenter", "iosUniversal"], "artistViewUrl": "https://apps.apple.com/kr/developer/devolver/id457410262?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/0c/2d/41/0c2d413c-a3ff-9f45-68d0-b892cdbe4b3f/AppIcon-0-1x_U007emarketing-0-85-220-0-7.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/0c/2d/41/0c2d413c-a3ff-9f45-68d0-b892cdbe4b3f/AppIcon-0-1x_U007emarketing-0-85-220-0-7.png/100x100bb.jpg", "languageCodesISO2A": ["EN"], "fileSizeBytes": "225599488", "formattedPrice": "￦6,600", "userRatingCountForCurrentVersion": 1375, "trackContentRating": "12+", "minimumOsVersion": "9.0", "averageUserRatingForCurrentVersion": 4.80654, "artistId": 457410262, "artistName": "Devolver", "genres": ["게임", "카드", "어드벤처"], "price": 6600.0, "currentVersionReleaseDate": "2019-04-11T18:19:50Z", "trackId": 1342309192, "trackName": "Reigns: 왕좌의 게임", "releaseDate": "2018-10-18T07:00:00Z", "genreIds": ["6014", "7005", "7002"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Devolver Digital, Inc.", "isVppDeviceBasedLicensingEnabled": true, "releaseNotes": "당신은 벽을 방어 할 수 있습니까? 100 개의 새로운 카드로 새로운 업데이트!", "sellerUrl": "http://reignsgame.com", "version": "1.15", "wrapperType": "software", "currency": "KRW", "description": "\"Reigns: 왕좌의 게임\"은 빛나는 수상 경력의 HBO® TV 드라마 Game of Thrones®을 계승한 게임이자 Neria에서 개발하고 Devolver Digital에서 배급한 유명 스와이프 게임 시리즈인 Reigns의 후속작입니다. 멜리산드레의 불 같은 시야를 통해, 세르세이 라니스터, 존 스노우, 대너리스 타르가르옌으로서 철왕좌를 주장하십시오. 칠왕국의 적대적인 세력과 복잡한 관계를 조심스럽게 알아나가세요. 정치적 경쟁자들을 앞지르기 위하여 무자비한 전술을 사용하고 당신의 변덕스러운 기수에게 불굴의 매력을 휘두르세요. 당신의 통치를 이어갈 수 있도록 백성들에게 균형과 호의를 유지하십시오. 그리고, 언젠가 다가올, 겨울의 공포에서 살아남으십시오.\n\n강력한 인물들: 세르세이 라니스터, 존 스노우, 대너리스 타르가르옌, 티리온 라니스터, 산사 스타크 등의 인물들의 입장에서 철왕좌에 앉아 통치권을 휘둘러 보십시오. 서서히 해금되는 왕과 여왕의 역할을 번갈아 플레이하면서, 각자의 스토리에서 독특하게 발생하는 난관과 수수께끼들에 맞서 보십시오.\n\n자신의 의지를 관철해 보십시오: 웨스테로스의 백성들로부터 간절한 부탁이나 예상치 못한 부탁을 들었을 때, 한순간의 좌우 넘김만으로 칠왕국의 운명을 영원토록 바꿔버릴 수 있습니다. 특정한 인물이 골칫거리로 다가온다면, 이들이 자신의 왕권에 방해가 되지 않도록 카드를 반으로 찢어버릴 수도 있습니다. 하지만 어떤 대가를 치르게 될지는 알 수 없습니다…\n\n웨스테로스를 다시 그려보십시오: 멜리산드레가 본 시야는 여러분이 게임을 플레이할 배경이 되어줍니다. 철왕좌에 앉을 수 있었던 자들이 TV 시리즈의 스토리와는 다른 길을 택했더라면 어떤 운명을 맞게 되었을지 한번 상상해 보십시오. 직접 세르세이가 되어 바엘로르의 대셉트를 재건하거나, 산사 스타크가 되어 제이미 라니스터와 결혼한다면 칠왕국의 운명은 어떻게 될지 확인해 보십시오.\n\n제왕에게 걸맞는 미니 게임: 최강의 권력을 쥔 지배자라도 가끔씩은 걱정거리를 제쳐두고 보다 사소한 일에 몰두할 시간이 필요하다는 점은 예나 지금이나 똑같습니다. 마상 시합부터 선술집에서의 난투까지, 사소하게 즐기는 유희거리에도 마땅한 결과가 따라옵니다!\n\nReigns 사상 최대 스케일: Reigns 시리즈의 팬 여러분은 사상 최대 규모와 최고의 심도를 자랑하는 게임에 크게 만족하실 것입니다. 이번 작품은 단순히 왕좌의 게임의 스토리를 다시 읊어주는 수준이 아니라, 여러분의 뜻에 따라 새로운 모험을 만들어낼 수 있는 기회를 제공합니다.\n\n상징적인 배경 음악: 웨스테로스의 세계와 그 주민들의 운명을 Ramin Djawadi가 작곡한 웅장한 배경 음악에 걸맞도록 결정해 보십시오.\n\n©2018 Home Box Office, Inc 판권 소유. HBO 및 관련된 트레이드마크는 Home Box Office, Inc의 자산입니다.", "bundleId": "com.devolver.reignsGoT", "trackCensoredName": "Reigns: 왕좌의 게임", "trackViewUrl": "https://apps.apple.com/kr/app/reigns-%EC%99%95%EC%A2%8C%EC%9D%98-%EA%B2%8C%EC%9E%84/id1342309192?uo=4", "contentAdvisoryRating": "12+", "averageUserRating": 4.80654, "userRatingCount": 1375}]}