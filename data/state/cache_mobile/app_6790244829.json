성을 복붙해보세요.", "minimumOsVersion": "15.0", "averageUserRating": 4.36667, "trackViewUrl": "https://apps.apple.com/kr/app/%EC%8A%A4%EA%BE%B8-seukku/id6790244829?uo=4", "contentAdvisoryRating": "12+", "trackCensoredName": "스꾸 Seukku", "primaryGenreName": "Lifestyle", "primaryGenreId": 6012, "genreIds": ["6012", "6027"], "releaseDate": "2026-07-15T07:00:00Z", "bundleId": "cc.seukku.app", "genres": ["라이프스타일", "그래픽 및 디자인"], "userRatingCount": 30}]}