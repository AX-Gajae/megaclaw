, "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": ["iosUniversal"], "minimumOsVersion": "16.0", "averageUserRatingForCurrentVersion": 4.75563, "sellerUrl": "https://discord.com/", "languageCodesISO2A": ["EN"], "fileSizeBytes": "231688192", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 176240, "trackContentRating": "12+", "trackCensoredName": "Discord - 대화, 플레이, 어울리기", "trackViewUrl": "https://apps.apple.com/kr/app/discord-%EB%8C%80%ED%99%94-%ED%94%8C%EB%A0%88%EC%9D%B4-%EC%96%B4%EC%9A%B8%EB%A6%AC%EA%B8%B0/id985746746?uo=4", "contentAdvisoryRating": "12+", "averageUserRating": 4.75563, "genres": ["소셜 네트워킹", "게임"], "artistId": 658886503, "artistName": "Discord Inc.", "price": 0.0, "releaseDate": "2015-05-21T07:08:40Z", "sellerName": "Discord Inc.", "isVppDeviceBasedLicensingEnabled": true, "trackId": 985746746, "trackName": "Discord - 대화, 플레이, 어울리기", "genreIds": ["6005", "6014"], "primaryGenreName": "Social Networking", "primaryGenreId": 6005, "currentVersionReleaseDate": "2026-07-27T17:58:47Z", "releaseNotes": "Discord가 더 나은 공간이 되도록 노력하고 있어요. 여기에는 버그 수정과 성능 향상이 포함됩니다. 자세한 정보는 앱의 내 프로필로 가서 \"새로운 기능\"으로 스크롤을 내려보세요.", "version": "339.0", "wrapperType": "software", "currency": "KRW", "description": "Discord는 게임을 위해 설계되었으며 친구들과 편안하게 시간을 보내거나 커뮤니티를 만들기에 아주 좋은 공간이에요. 커스터마이즈로 자기만의 공간을 만들고 친구들을 모아 좋아하는 게임을 하면서 대화하거나, 그냥 함께 시간을 보낼 수도 있죠.\n\n재미와 게임을 위한 그룹 채팅\n∙ Discord는 친구들과 게임하며 편안하게 시간을 보내거나, 심지어 국제 커뮤니티를 구축하는 데도 좋은 공간이에요. 커스터마이즈로 자기만의 공간을 만들고 대화하고, 게임하고, 어울리세요.\n\n더 재미있는 그룹 채팅\n∙ 사용자 지정 이모지, 스티커, 사운드보드 효과 등을 만들어 음성, 영상, 텍스트 채팅에 개성을 더하세요. 아바타, 사용자 지정 상태를 설정하고, 자신만의 프로필을 작성해 채팅에서 나만의 방식을 보여주는 거죠.\n\n같은 공간에 있는 듯한 방송\n∙ 고품질, 저지연 방송 덕분에 게임을 플레이하거나, 쇼를 시청하거나, 사진을 보거나, 심지어 숙제를 할 때도 마치 소파에 앉아 같이 시간을 보내는 것 같은 기분을 느낄 수 있어요.\n\n통화 없이 언제든 자유롭게 참가 가능\n∙ 통화를 걸거나 초대할 필요 없이 쉽게 음성이나 텍스트 채팅에 참여하거나 나갈 수 있어서 게임 세션 전, 후, 그리고 도중에도 친구들과 대화할 수 있어요.\n\n접속 중인 사람 확인\n∙ 누가 접속 중인지, 게임을 하는지, 아니면 쉬고 있는지 확인해보세요. 지원되는 게임에서는 친구들이 어떤 모드나 캐릭터로 플레이하고 있는지 확인하고 바로 참여할 수 있어요.\n\n언제나 함께 즐길 콘텐츠\n∙ 함께 영상을 보거나, 자체 게임을 즐기거나, 음악을 듣거나, 인터넷을 탐색하며 밈을 공유해보세요. 텍스트, 전화, 영상 채팅, 게임 등을 모두 그룹 채팅에서 원활하게 즐겨보세요.\n\n게임을 할 때마다 모일 수 있는 곳\n∙ PC, 휴대폰, 콘솔 어디서든 Discord에서 친구들과 어울릴 수 있어요. 다양한 기기 간에 쉽게 전환하고, 친구들과의 여러 그룹 채팅을 관리하는 도구를 활용하세요.\n\n[선택적 접근 권한]\n∙ 카메라 - Discord는 카메라로 사진을 찍어 다른 사람들이 음성 및 영상 통화에서 귀하를 볼 수 있게 합니다.\n∙ 마이크 - Discord는 마이크를 사용하여 음성 통화 시 대화할 수 있습니다.\n∙ 연락처 - Discord는 연락처를 사용해 이미 알고 있는 사람들을 Discord에서 찾을 수 있습니다.\n∙ 사진 라이브러리 - Discord는 사진 라이브러리를 사용하여 사진과 비디오를 다운로드하거나 아바타, 서버 아이콘 등으로 이미지를 업로드하고, 친구와 커뮤니티에 사진과 비디오를 전송할 수 있습니다.\n∙ 선택적 액세스에 대한 동의를 거부할 수 있습니다.", "bundleId": "com.hammerandchisel.discord", "userRatingCount": 176240}]}