ir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/capcom/id308807391?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/00/c6/6f/00c66fb0-2155-e80e-c811-b67de1795236/AppIcon-1x_U007emarketing-0-7-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/00/c6/6f/00c66fb0-2155-e80e-c811-b67de1795236/AppIcon-1x_U007emarketing-0-7-0-85-220.png/100x100bb.jpg", "userRatingCountForCurrentVersion": 109, "averageUserRatingForCurrentVersion": 4.2844, "languageCodesISO2A": ["EN", "FR", "DE", "JA", "KO", "ZH", "ZH"], "fileSizeBytes": "1033885696", "formattedPrice": "￦16,500", "trackContentRating": "12+", "sellerUrl": "https://www.capcom-games.com/product/ko-kr/aceattorney-trilogy-app/", "minimumOsVersion": "13.3", "price": 16500.0, "genres": ["게임", "시뮬레이션", "엔터테인먼트", "어드벤처"], "artistId": 308807391, "artistName": "CAPCOM", "trackId": 1621065119, "trackName": "역전재판 123 나루호도 셀렉션", "bundleId": "jp.co.capcom.gyakusai123", "genreIds": ["6014", "7015", "6016", "7002"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "CAPCOM Co., Ltd", "isVppDeviceBasedLicensingEnabled": true, "releaseNotes": "일부 시스템 관련 오류가 수정되었습니다.", "currentVersionReleaseDate": "2022-07-04T00:59:46Z", "version": "1.00.01", "wrapperType": "software", "currency": "KRW", "description": "■■주의■■\n구입 및 이용 전에 반드시 【구입하기 전에】, 【지원 기기에 대한 주의 사항】을 확인해 주시기 바랍니다.\n\n=== 게임 소개 ===\n\n변호사가 되어 누명을 벗겨라!\n\n시리즈의 원점이 되는 변호사, \"나루호도 류이치\"가 주인공인 인기 있는 세 작품이 하나의 타이틀이 되어 돌아왔다!\n나루호도 3부작 「역전재판 소생하는 역전」, 「역전재판 2」, 「역전재판 3」의 14화를 모두 수록!\n\n고해상도의 그래픽으로 더 아름답고 현장감 넘치는 법정 배틀을 느껴보자!\n\n일본어와 영어 이외에도 프랑스어, 독일어, 중국어(간체/번체), 한국어도 지원!\n옵션에서 언어를 변경하면 다양한 언어로 「역전재판123」를 플레이 가능.\n\n세 작품에서의 저장 데이터 개수가 10개로 증가! 각각의 언어에서 10개씩 데이터 저장이 가능!\n\n【게임 개요】\n살인 사건이 발생했다! 누명을 쓴 의뢰인을 구하고 사건의 진상을 밝혀라!\n\n- 탐정 파트\n사건과 관련된 「정보」와 「증거품」을 찾자!\n\n- 법정 파트\n「검사」와 「증인」의 거짓말을 간파하여 사건의 진상을 파헤치자!\n\n진실은 단 하나! 증언의 모순을 파헤쳐 의뢰인의 무죄를 증명하라!\n\n※ 일반 대화에서 대사 버튼을 길게 누르면 대사를 스킵할 수 있습니다.\n※ 과거 가정용 게임기기용으로 발매된 게임과 같은 시나리오입니다.\n\n【구입하기 전에】\n일단 구입하신 이후에는 이유를 불문하고 환불(다른 상품 및 다른 서비스 등으로의 교환을 포함)이 불가능합니다.\n\n【지원 기기에 대한 주의 사항】\n지원 기기(기종/OS)에 대한 자세한 사항은 본 앱의 공식 사이트(아래의 URL 참조)를 확인해 주십시오.\nhttps://www.capcom-games.com/product/ko-kr/aceattorney-trilogy-app/\n\n※지원 기기 이외에서도 본 앱의 구입이 가능한 경우가 있습니다만, 정상적으로 작동하지 않을 수도 있습니다.\n송구합니다만 지원 기기(기종/OS) 이외에서 이용하시는 경우에는 동작에 대한 보증 및 환불이 불가능하니 미리 양해 부탁드립니다.\n\n【캡콤의 다양한 타이틀을 즐겨 보세요!】\nApp Store 검색창에 \"capcom\" 또는 앱 명을 입력해서 검색해 보세요!", "averageUserRating": 4.2844, "trackCensoredName": "역전재판 123 나루호도 셀렉션", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%97%AD%EC%A0%84%EC%9E%AC%ED%8C%90-123-%EB%82%98%EB%A3%A8%ED%98%B8%EB%8F%84-%EC%85%80%EB%A0%89%EC%85%98/id1621065119?uo=4", "contentAdvisoryRating": "12+", "releaseDate": "2022-06-09T07:00:00Z", "userRatingCount": 109}]}