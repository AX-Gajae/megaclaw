lar", "iPhone16-iPhone16", "iPhone16Plus-iPhone16Plus", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "Watch10-Watch10", "Watch10Cellular-Watch10Cellular", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "Watch11-Watch11", "Watch11Cellular-Watch11Cellular", "WatchSE3-WatchSE3", "WatchSE3Cellular-WatchSE3Cellular", "WatchUltra3-WatchUltra3", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "bundleId": "com.firerabbit.games.fmc.lux.full", "sellerUrl": "http://firerabbit.com/fixmycar_luxurysports/game/ko/itunes/full/", "languageCodesISO2A": ["AR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HU", "ID", "IT", "JA", "KO", "MS", "NB", "NN", "PL", "PT", "RO", "RU", "ZH", "ES", "SV", "TH", "TR", "VI"], "userRatingCountForCurrentVersion": 1, "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 5, "averageUserRating": 5, "trackCensoredName": "픽스 마이 카 : 럭셔리 스포츠 카 제작과 레이스", "trackViewUrl": "https://apps.apple.com/kr/app/%ED%94%BD%EC%8A%A4-%EB%A7%88%EC%9D%B4-%EC%B9%B4-%EB%9F%AD%EC%85%94%EB%A6%AC-%EC%8A%A4%ED%8F%AC%EC%B8%A0-%EC%B9%B4-%EC%A0%9C%EC%9E%91%EA%B3%BC-%EB%A0%88%EC%9D%B4%EC%8A%A4/id921345116?uo=4", "contentAdvisoryRating": "4+", "genres": ["게임", "레이싱", "시뮬레이션"], "artistId": 517370882, "artistName": "FireRabbit Inc.", "price": 3300.0, "isVppDeviceBasedLicensingEnabled": true, "sellerName": "FireRabbit Inc.", "releaseDate": "2014-10-14T19:16:35Z", "primaryGenreName": "Games", "primaryGenreId": 6014, "genreIds": ["6014", "7013", "7015"], "trackId": 921345116, "trackName": "픽스 마이 카 : 럭셔리 스포츠 카 제작과 레이스", "currentVersionReleaseDate": "2016-12-05T01:13:56Z", "releaseNotes": "Apple에서 제공하는 이 업데이트는 해당 앱의 성능을 개선합니다. 새로운 기능은 포함되어 있지 않습니다.\n\n페이스북 팬 페이지 피드백을 기반으로 사운드 업그레이드 장면과 이미지 확장, 도우미 파일 향상과 특성이 추가됨", "version": "20.1", "wrapperType": "software", "currency": "KRW", "description": "정비공처럼 나만의 럭셔리 스포츠 카를 만들고 스피드 레이서처럼 달려보세요! 커스텀 부품(림, 스피커, ....)을 주문해 설치하고, 새로 도색하여 레이싱 카를 완성하세요. 그리고 달리는 겁니다!\n\n자동차를 처음부터 끝까지 조립해서 (키트카) 타보고 싶은 적 있나요? 정비공들이 취미로 하는 것처럼요. 명예롭게, 파워풀하고 멋지게? 끝내주게? 물론 할 수 있습니다! \n\n여기 그 모든 것을 다 해볼 수 있는 엄청난 자동차, 스포츠카 시뮬레이터가 있습니다. 필요한 정비 기술까지 가르쳐 드리니 아무 걱정 마세요. \n\n풀버전입니다! 상상할 수 있는 모든 부품과 옵션을 제공합니다. 진행 힌트 및 해답 등 모든 지원 시스템이 포함되어 있습니다. 자동차를 통째로 만들고, 나사 하나하나를 건드려 본 뒤, 레이싱 게임을 평생 즐기실 수 있습니다.\n\n업그레이드하고 변형할 부품들을 주문하고 채워넣으세요. 프레임을 용접하고, 패널을 조립하고, 엔진을 고르고, 성능을 튜닝하고, 각종 손질로 최고의 차를 만들어 보세요. 커스텀 가죽 시트, 터보 키트, 앰프, 바퀴, 휠, 내장재, 뭐든지 바꿀 수 있습니다. \n\n옵션과 개조를 여러분이 모두 컨트롤할 수 있다는 것만 기억하세요. - 카탈로그과 매장에서 부품을 고를 때부터 말입니다! 여러분은 부자이고, 자금에 제한이 없습니다. 무엇이든 마음먹은대로 됩니다!\n\n이 게임은 지금 이 설명을 읽고 계신 한국어를 비롯해 여러 언어를 지원하며, 기기의 언어 설정에 따라 자동으로 로딩됩니다. 게임을 진행하면서 매 단계마다 자동으로 저장되므로, 이전 단계로 되돌리거나 쉬었다 다시 할 수 있습니다. \n\n리뷰 코멘트에 해답을 적지 말아주세요. 다른 이들의 재미를 망치게 됩니다. 대신에 페이스북(FireRabbit), 트위터(@FireRabbit_Inc)에서 저희를 찾아 주시거나 게임 페이지를 방문해 주세요: \n\nhttp://firerabbit.com/fixmycar_luxurysports/game/ko/\n\n게임 내 과업의 예입니다.\n\n*** 근사한 엔진을 찾아라!!! - 카탈로그에서 커스텀 엔진을 주문한다.\n\n*** 커스텀 휠 만들기 - 최적의 휠 없이 레이싱을 할 순 없지. (림과 타이어 모두)\n\n*** 롤 케이지 용접 - 강철 파이프를 찾아 롤 케이지를 만든다.\n\n*** 브레이크 오일 추가 - 브레이크가 작동하려면 브레이크액이 필요하다.\n\n*** 변속기 장착 - 트랜스미션(변속기)를 찾아 핀을 이용해 고정시킨다.\n\n*** 듀얼 이그조스트 용접 - 배기장치 부품을 모두 찾아 조립 구역 안에서 용접한다\n\n*** 서스펜션 시스템 조립 - 부품을 모두 찾아 전방 및 후방 서스펜션을 조립한다.\n\n*** 바디 도색 - 드디어 차에 도색을 할 시간이 되었다.\n\n*** 커스텀 스포일러 - 카탈로그에서 스포일러 주문\n\n*** 레이싱 좌석 장착 - 럭셔리 레이싱 좌석을 주문해 설치한다.\n\n*** 엔진오일 추가 - 자동차는 오일이 필요하다. 오일을 찾아 넣자\n\n*** 스테레오 시스템 추가 - 럭셔리 매립형 스테레오 시스템 추가\n\n*** 스피커 장착 - 비슷한 스피커 네 개를 찾아 자동차에 추가한다.\n\n*** 레이싱 페달 추가 - 레이싱에서 더 유리하려면 가벼운 페달이 필요하다.\n\n*** 계기판 장착 - 얼마나 빠르게 달리고 있는지 보려면, 이게 필요하다.\n\n*** 카본 사이드 레일 추가 - 카본 사이드 레일이 없으면 본체가 완성되지 않는다.\n\n*** 주요 도구 찾기 - 망치, 임팩트 렌치, 전동 드릴, 펜치를 가져온다.", "minimumOsVersion": "6.0", "formattedPrice": "￦3,300", "fileSizeBytes": "100968448", "userRatingCount": 1}]}