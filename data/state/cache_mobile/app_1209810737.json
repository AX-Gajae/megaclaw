iPadPro11FourthGen", "iPadPro11FourthGenCellular-iPadPro11FourthGenCellular", "iPadProSixthGen-iPadProSixthGen", "iPadProSixthGenCellular-iPadProSixthGenCellular", "iPhone15-iPhone15", "iPhone15Plus-iPhone15Plus", "iPhone15Pro-iPhone15Pro", "iPhone15ProMax-iPhone15ProMax", "iPadAir11M2-iPadAir11M2", "iPadAir11M2Cellular-iPadAir11M2Cellular", "iPadAir13M2-iPadAir13M2", "iPadAir13M2Cellular-iPadAir13M2Cellular", "iPadPro11M4-iPadPro11M4", "iPadPro11M4Cellular-iPadPro11M4Cellular", "iPadPro13M4-iPadPro13M4", "iPadPro13M4Cellular-iPadPro13M4Cellular", "iPhone16-iPhone16", "iPhone16Plus-iPhone16Plus", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/weawow/id1209810736?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a5/67/7d/a5677deb-cb89-9733-da57-d3fad8269635/AppIcon-0-0-1x_U007epad-0-11-0-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/a5/67/7d/a5677deb-cb89-9733-da57-d3fad8269635/AppIcon-0-0-1x_U007epad-0-11-0-0-85-220.png/100x100bb.jpg", "minimumOsVersion": "12.0", "userRatingCountForCurrentVersion": 1019, "averageUserRatingForCurrentVersion": 4.90481, "sellerUrl": "https://weawow.com/ko", "languageCodesISO2A": ["AR", "AZ", "BE", "BN", "BG", "CA", "HR", "CS", "DA", "NL", "EN", "ET", "FI", "FR", "KA", "DE", "EL", "HE", "HI", "HU", "ID", "IT", "JA", "KN", "KO", "LV", "LT", "ML", "MR", "NB", "NN", "PS", "FA", "PL", "PT", "PA", "RO", "RU", "SR", "ZH", "SK", "SL", "ES", "SV", "TA", "TE", "TH", "ZH", "TR", "UK", "UR", "VI", "CY"], "fileSizeBytes": "56859648", "formattedPrice": "무료", "trackContentRating": "4+", "releaseNotes": "각 언어의 일부 단어나 텍스트를 수정했습니다.\n일부 레이아웃 문제가 해결되었습니다.", "artistId": 1209810736, "artistName": "weawow", "genres": ["날씨", "여행"], "price": 0.0, "bundleId": "com.weawow", "releaseDate": "2021-06-17T07:00:00Z", "trackId": 1209810737, "trackName": "날씨 및 위젯 Weawow", "genreIds": ["6001", "6003"], "primaryGenreName": "Weather", "primaryGenreId": 6001, "sellerName": "weawow Inc.", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-15T19:50:36Z", "version": "3.1.2", "wrapperType": "software", "currency": "KRW", "description": "Weawow는 비교 가능한 여러 기상 정보 제공업체, 애니메이션 날씨 지도 및 레이더, 고도의 맞춤 설정이 가능한 레이아웃과 위젯, 그리고 전 세계의 아름다운 날씨 사진을 제공하는 무료 날씨 앱입니다.\n광고나 추적은 전혀 없습니다. Weawow는 사용자가 정말로 필요로 하는 날씨 정보를 가장 쾌적한 방식으로 제공합니다.\n\n\nWOW 날씨 경험\n\n날씨 사진은 각 장소의 실제 기상 상황을 반영하므로 맑음, 흐림, 비, 눈 여부를 시각적으로 즉시 이해할 수 있습니다.\n황금빛 노을, 고요한 설경, 흘러가는 구름. 이러한 장면들은 일상에 평온함을 선사합니다.\n이 WOW 경험을 통해 Weawow는 사람들을 연결하고 더 평화로운 세계에 기여하는 것을 목표로 합니다.\n\n\n날씨 예보 비교\n\n현대의 예보 기술은 특히 몇 시간 이내의 단기 예측에서 크게 향상되었습니다.\n그러나 불안정한 기상 조건에서는 예보가 다를 수 있습니다.\nWeawow를 사용하면 여러 날씨 예보 제공업체의 예보를 이해하기 쉬운 그래프로 나란히 비교하여 더 확실한 결정을 내릴 수 있습니다.\n예:\n- 대부분의 제공업체가 \"비 없음\"이라고 하면 우산을 두고 외출할 수 있습니다.\n- 예보가 엇갈릴 때는 두 가지 가능성에 모두 대비할 수 있습니다.\n\n지원하는 날씨 제공업체:\nNWS (NOAA), DWD, Meteo France, AEMET, MET Norway, Apple Weather, Xweather, Weatherbit, World Weather Online, OpenWeather.\nAccuWeather와 Foreca는 기부를 통해 이용 가능합니다 (한 번의 기부로 영구적으로 잠금 해제됩니다).\n\n\n상세 날씨 데이터\n\n시간별 예보 및 최대 14일간의 일별 예보로 상세한 날씨 데이터를 확인할 수 있습니다.\n- 기온, 체감온도, 강수량, 강수확률, 바람, 돌풍, 기압, 습도, 이슬점, 운량, UV 지수, 시정, 강설량, 일사량.\n- 대기질: AQI, PM2.5, PM10, NO2, SO2, CO, 오존 (데이터 소스: CAMS, ECMWF).\n- 각국의 공식 기상 경보.\n- 꽃가루 (AccuWeather 제공, 미국 지역 한정).\n\n일출, 일몰, 골든 아워, 블루 아워, 그리고 최대 1개월 후까지의 월상(달의 위상)을 애니메이션과 함께 확인할 수 있습니다.\n사진 촬영 타이밍을 계획하는 데 유용합니다.\n\n\n날씨 지도와 레이더\n\n부드럽게 애니메이션되는 지구본으로 세계의 날씨를 표시합니다.\n- 강수, 레이더, 기온, 습도, 이슬점, 구름, 눈, 대기질 레이어.\n- 바람 애니메이션.\n- 기압 등압선.\n- 최대 14일간의 예보.\n\n\n심플한 인터페이스\n\n- 아래로 스크롤하기만 하면 필요한 정보를 얻을 수 있습니다. 각 섹션을 탭하면 상세 정보가 표시됩니다.\n- 즐겨찾는 날씨 장소를 북마크할 수 있으며 좌우 스와이프로 빠르게 전환할 수 있습니다. 검색 기록의 별 아이콘을 탭하여 장소를 저장하세요.\n- 지원 언어: 한국어, 영어, 일본어 및 기타 50개 이상의 언어.\n\n\n맞춤 설정\n\n사용자의 요구에 맞춰 앱을 자유롭게 설정할 수 있습니다.\n- 날씨 데이터 선택.\n- 레이아웃 재정렬.\n- 우선순위 설정.\n- 날씨 아이콘 선택.\n- 라이트 / 다크 / 자동 테마.\n- 상세 지도 설정.\n\n\n날씨 위젯\n\n1x1의 작은 크기부터 전체 화면 레이아웃까지, 맞춤 설정 가능한 날씨 위젯을 홈 화면에 추가할 수 있습니다.\n- 14가지 스타일: 현재 날씨, 오늘 예보, 시간별, 일별, 그래프, 시계 등.\n- 바람, UV 지수, 대기질 등 맞춤 설정 가능한 데이터.\n\n\n날씨 알림\n\n잠금 화면이나 알림 패널에서 날씨 예보를 항상 확인할 수 있습니다.\n- 8가지 알림 레이아웃: 시간별, 일별, 그래프 유형 등.\n- 바람, UV 지수, 대기질 등 맞춤 설정 가능한 데이터.\n- 상태 표시줄에 현재 기온 표시.\n\n\n기부 및 지원\n\nWeawow는 무료로 사용할 수 있습니다.\n기부를 통해 프로젝트를 지원해 주신 사용자는 AccuWeather나 Foreca와 같은 추가 날씨 제공업체를 잠금 해제할 수 있습니다.\n기부는 완전히 자발적인 선택 사항입니다.\n\n\n날씨 사진 업로드\n\nWeawow 웹사이트에서 나만의 날씨 사진을 업로드할 수 있습니다.", "contentAdvisoryRating": "4+", "averageUserRating": 4.90481, "trackCensoredName": "날씨 및 위젯 Weawow", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%82%A0%EC%94%A8-%EB%B0%8F-%EC%9C%84%EC%A0%AF-weawow/id1209810737?uo=4", "userRatingCount": 1019}]}