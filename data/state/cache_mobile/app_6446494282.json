iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/f0/19/f5/f019f5a3-47f1-b007-751e-146cb6a99d1e/AppIcon-0-0-1x_U007ephone-0-11-0-sRGB-85-220.png/512x512bb.jpg", "screenshotUrls": [], "features": [], "averageUserRating": 4.34188, "trackCensoredName": "모바일팩스 및 문서 스캔어플: 팩스 송수신・FAX", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%AA%A8%EB%B0%94%EC%9D%BC%ED%8C%A9%EC%8A%A4-%EB%B0%8F-%EB%AC%B8%EC%84%9C-%EC%8A%A4%EC%BA%94%EC%96%B4%ED%94%8C-%ED%8C%A9%EC%8A%A4-%EC%86%A1%EC%88%98%EC%8B%A0-fax/id6446494282?uo=4", "contentAdvisoryRating": "4+", "isVppDeviceBasedLicensingEnabled": true, "artistId": 1678098112, "artistName": "Plekmin Trade, S.L.", "genres": ["비즈니스", "생산성"], "price": 0.0, "bundleId": "faxer.send.fax", "primaryGenreName": "Business", "primaryGenreId": 6000, "trackId": 6446494282, "trackName": "모바일팩스 및 문서 스캔어플: 팩스 송수신・FAX", "sellerName": "PLEKMIN TRADE SL", "releaseNotes": "앱 성능이 개선되었습니다.\n별 5개 평가에 진심으로 감사드립니다 :) ＊＊＊＊＊", "currentVersionReleaseDate": "2026-07-29T06:13:41Z", "version": "2.12.0", "wrapperType": "software", "currency": "KRW", "description": "iPhone에서 국제적으로 팩스를 보내고 받아보세요 — 빠르고 쉽게! 당신의 기기를 주머니 속 휴대용 팩스로 변신시켜 드립니다.\n40개 이상의 국가에서 제공되며, 미국, 캐나다, 한국, 독일, 일본 등 많은 국가들이 포함됩니다.\n\n팩스 사무실을 방문하거나 오래된 기기를 사용할 필요 없이 시간을 절약하세요.\n- 이동 중에도 스마트폰 연락처에 있는 사람들에게, 아니면 직접 수신자를 추가하여 문서와 파일을 전송할 수 있습니다.\n- iPhone에서 바로 팩스를 수신하고 언제든 액세스 가능한 개인 팩스 수신함으로 전환할 수 있습니다.\n\n■ 주요 기능: \n\n› 모든 종류의 파일 전송\n가장 일반적인 형식(PDF, JPEG, DOC, DOCX, TXT, XLS, XLXS)으로 문서를 업로드하고 전송합니다.\n모든 문서 유형에서 가능한 최고의 팩스 품질이 제공됩니다.\n동시에 최대 5개의 주소로 팩스를 전송합니다. \n\n› 기기에서 팩스 수신\n전용 팩스 번호를 받아 언제 어디서나 팩스를 수신할 수 있습니다.\n수신한 팩스를 앱 내에서 확인하고 저장하여 디지털 기록을 정리하세요.\n실제 기계 없이 휴대전화만 있으면 됩니다.\n\n› 무제한 업로드 옵션 \n카메라로 바로 문서를 스캔합니다. \n미디어 및 사진 라이브러리에서 이미지를 업로드합니다.\n문서 아카이브에서 파일을 추가합니다.\n\n› 알림\n팩스를 전송하는 데 성공했거나 프로세스 도중 문제가 발생하면 즉각 알림을 받습니다. \n수신함에 새로운 팩스가 도착했을 때 알림을 받습니다.\n\n› 팩스 커버 페이지 추가\n팩스 전송 시 더 자세한 정보를 제공하기 위해 커버 페이지를 포함합니다.\n팩스에 텍스트 메시지를 추가합니다.\n수신자의 이름과 연락처로 전문 템플릿을 빠르고 쉽게 작성합니다.\n\n› 강력한 추적\n시간순으로 모든 팩스를 추적하여 관리합니다. \n전송한 문서와 현재 전송되고 있는 팩스를 검토합니다. \n팩스 번호, 전송 상태, 팩스 시간 및 날짜 등 중요 정보를 확인합니다.\n수신한 팩스에 언제든지 액세스하여, 필요할 때 다운로드하거나 공유합니다.\n\n■ 자세한 정보: \n\n필요에 따라 구독을 활성화하고 취소하세요.’ \n\n이용약관:\nhttps://faxer.app/terms-of-use\n개인정보보호정책:\nhttps://faxer.app/privacy-policy\n\n앱 지원이 필요한 경우 연락처:\ninfo@faxer.app\n\n지금 앱을 다운로드하여 모바일 기기를 휴대용 팩스기로 바꿔보세요!", "averageUserRatingForCurrentVersion": 4.34188, "sellerUrl": "https://faxer.app/", "minimumOsVersion": "16.0", "languageCodesISO2A": ["NL", "EN", "FR", "DE", "IT", "JA", "KO", "RU", "ZH", "ES", "SV", "ZH", "TR", "VI"], "fileSizeBytes": "180859904", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 585, "trackContentRating": "4+", "genreIds": ["6000", "6007"], "releaseDate": "2024-05-22T07:00:00Z", "userRatingCount": 585}]}