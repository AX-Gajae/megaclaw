원과 함께하는 레이드\n혼자서 맞서기 버거운 강력한 레이드 보스!\n길드원과 힘을 합쳐 도전하고, 풍성한 보상을 나눠 가지세요.\n\n카오스 페스티벌 — 지휘관들의 전략 대결\n다른 지휘관들과 전략으로 맞붙는 경쟁 콘텐츠!\n치밀한 조합과 배치로 상대를 제압하고, 더 높은 층을 향해 등반하세요.\n꼭대기에 오른 자만이 진정한 최강 지휘관입니다.\n----------------------------------------------------\n연합군 본진까지 모든 길은 전장이다.\n실력과 전략, 그 모든 것을 걸고 우주의 전설이 되어보세요!", "minimumOsVersion": "15.0", "averageUserRating": 4.25427, "sellerUrl": "https://rocketdan21.blogspot.com", "languageCodesISO2A": ["EN", "FR", "DE", "ID", "JA", "KO", "MS", "PT", "ES", "TH", "ZH", "VI"], "fileSizeBytes": "790012928", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 586, "trackContentRating": "12+", "averageUserRatingForCurrentVersion": 4.25427, "trackCensoredName": "벙커디펜스: 빠른 무한 물량 막기", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%B2%99%EC%BB%A4%EB%94%94%ED%8E%9C%EC%8A%A4-%EB%B9%A0%EB%A5%B8-%EB%AC%B4%ED%95%9C-%EB%AC%BC%EB%9F%89-%EB%A7%89%EA%B8%B0/id6753645951?uo=4", "contentAdvisoryRating": "12+", "artistId": 1624407423, "artistName": "Teamsparta Inc.", "userRatingCount": 586}]}