, "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "features": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/annhouse-co-ltd/id1790117724?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/73/79/4d/73794de5-7d05-9dad-562f-250363ca5ade/AppIcon-0-0-1x_U007ephone-0-1-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/73/79/4d/73794de5-7d05-9dad-562f-250363ca5ade/AppIcon-0-0-1x_U007ephone-0-1-0-85-220.png/100x100bb.jpg", "advisories": [], "sellerUrl": "https://www.mega-mgccoffee.com/about/brand/", "fileSizeBytes": "47989760", "languageCodesISO2A": ["EN"], "formattedPrice": "무료", "trackContentRating": "4+", "minimumOsVersion": "16.0", "averageUserRatingForCurrentVersion": 1.8773, "price": 0.0, "currentVersionReleaseDate": "2026-07-23T06:01:57Z", "genres": ["음식 및 음료"], "artistName": "Annhouse Co., Ltd", "primaryGenreName": "Food & Drink", "primaryGenreId": 6023, "trackId": 1473428031, "trackName": "메가MGC커피", "isVppDeviceBasedLicensingEnabled": true, "bundleId": "co.kr.waldlust.megacoffee", "releaseDate": "2019-08-02T07:00:00Z", "genreIds": ["6023"], "sellerName": "Annhouse Co., Ltd", "releaseNotes": "[v2.1.3] 업데이트 내용\n품질 개선 및 안정화 작업을 통해 앱 성능을 개선했습니다.", "version": "2.1.3", "wrapperType": "software", "currency": "KRW", "description": "더 빠르게, 더 간편하게.\n메가MGC커피를 APP으로 즐기는 가장 스마트한 방법!\n\n매장 줄 서기? \n이제는 APP으로 미리 주문하고 바로 픽업하세요.\n\n혼자 마실 때도, 여럿이 함께 주문할 때도\n메가MGC커피 APP 하나면 충분합니다.\n\n[메가MGC커피 APP 주요 기능]\n■ 퀵오더\n내 취향 그대로, 터치 한 번이면 주문 끝!\n가장 빠른 주문으로 매장에서 바로 수령하세요.\n\n■ 메가오더 & 픽업 예약\n언제 어디서나 다양한 메뉴 주문 가능!\n예약 시간에 맞춰 편리하게 픽업할 수 있어요.\n\n■ 함께오더\n비회원 친구에게도 주문 링크 전송 OK!\n여럿이 모아 한 번에 결제하는 스마트 오더.\n\n■ MY메뉴\n자주 먹는 나만의 메뉴를 저장해 두면\n매번 고르지 않아도 간편하게 주문할 수 있어요.\n\n■ 메가월렛\n쿠폰, 상품권, 스탬프를 한눈에!\n혜택을 한곳에 모아 쉽고 편하게 사용하세요.\n\n■ 선물하기\n커피 한 잔에 마음을 담아 선물해보세요.\n메시지 카드로 따뜻한 마음도 함께 전할 수 있어요.\n\n\n[이용 시 유의사항]\nWi-Fi와 모바일 데이터 환경에서 모두 이용할 수 있어요.\n단, 모바일 데이터 이용 시에는 통신사 요금제에 따라\n추가 요금이 부과될 수 있습니다.\n\nAPP은 멤버십 서비스 도입 매장에서만 사용 가능합니다.\nAPP 사용 전, 매장 내 이용 가능 여부를 꼭 확인해 주세요.\n\n최소 아이폰 지원 OS 버전이 16.0으로 상향되었으며,\n해당 소프트웨어 버전 이상만 지원 가능합니다.\n\n\n앱 접근 권한 안내\n메가MGC커피 앱 서비스 사용을 위해 다음 접근 권한 허용이 필요합니다.\n\n[필수적 접근 권한]\n없음\n\n[선택적 접근 권한]\n- 저장공간 및 기기정보 :\n이미지 데이터 및 요청사항 저장, 서비스 분석 및 통계, 푸시발송, 오류정보 확인\n- 알림 :\n이벤트, 쿠폰, 혜택, 주문 등 앱 내 서비스를 푸시알림으로 제공\n- 위치 : \n단말기의 위치정보 기능 사용\n- 카메라 및 갤러리\n이미지 첨부 시 사용\n- 주소록\n선물하기, 함께오더 연락처 검색 시 사용\n- 생체인증\n로그인 및 메가간편카드 결제 시 사용\n\n선택 권한을 허용하지 않아도 메가MGC커피 앱 이용이 가능하지만, 일부 서비스 이용에 제한이 있을 수 있습니다.\n\n\n[개발자 연락처]\n- APP 문의: 1855-3478\n- 고객센터: 1588-8298", "averageUserRating": 1.8773, "trackCensoredName": "메가MGC커피", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%A9%94%EA%B0%80mgc%EC%BB%A4%ED%94%BC/id1473428031?uo=4", "contentAdvisoryRating": "4+", "userRatingCountForCurrentVersion": 1524, "artistId": 1790117724, "userRatingCount": 1524}]}