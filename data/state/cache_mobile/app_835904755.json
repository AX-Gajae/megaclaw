humb/Purple118/v4/d3/67/10/d3671090-34f9-a645-a3b7-15c174eb9dbc/AppIcon-1x_U007emarketing-85-220-7.png/512x512bb.jpg", "minimumOsVersion": "8.0", "averageUserRating": 0, "trackCensoredName": "커플 전희 섹스카드 게임", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%BB%A4%ED%94%8C-%EC%A0%84%ED%9D%AC-%EC%84%B9%EC%8A%A4%EC%B9%B4%EB%93%9C-%EA%B2%8C%EC%9E%84/id835904755?uo=4", "contentAdvisoryRating": "17+", "artistId": 835904758, "artistName": "Afinode", "genres": ["게임", "롤플레잉", "카드", "엔터테인먼트"], "price": 3300.0, "bundleId": "afinode.makemehot", "sellerName": "Afinode, s.r.o.", "primaryGenreName": "Games", "primaryGenreId": 6014, "releaseDate": "2014-04-22T03:07:41Z", "trackId": 835904755, "trackName": "커플 전희 섹스카드 게임", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2017-12-21T15:36:26Z", "releaseNotes": "Apple에서 제공하는 이 업데이트는 해당 앱의 성능을 개선합니다. 새로운 기능은 포함되어 있지 않습니다.\n\n두 가지 새로운 유형의 덱 – 랜덤 및 엑스트라\n16가지의 새로운 작업\n새로 출시된 무한 게임모드", "version": "1.6", "wrapperType": "software", "currency": "KRW", "description": "‘나를 핫하게 만들기’는 커플을 위한 간단한 전희 에로틱 카드 게임입니다.\n\n게임 규칙은 매우 간단합니다. 첫 화면의 일반적인 카드 덱은 핫한(그리고 더 핫한) 행동에 대한 카드를 포함합니다. 첫번째 파트너가 덱에서 카드를 뽑은 후에, 두번째 파트너는 미리 정해진 시간 제한 동안 그 카드의 쓰여진 행동을 수행해야 합니다.\n\n그러나 이것이 항상 누구를 기쁘게 할 수 있는 것인지 분명하지 않다는 것을 알아야 합니다. 다이아몬드 카드가 뽑혔을 때는  카드를 뽑은 파트너가 그 행동을 수행해야 합니다.\n\n이 에로틱 게임에서, 당신은 미리 정해진 행동을 담은 덱을 사용할 수도 있고, 당신 자신이 생각한 행동으로 만들 수도 있습니다. 당신 자신의 카드 덱을 준비하기 위해 75개의 행동 중 몇 가지를 사용하거나 당신이 상상한 것을 이용하고 자신의 것을 만들 수 있습니다.\n\n이 카드 게임은 취향에 관계없이 모든 커플에게 적합합니다. 그래서 어떤 커플이든 그들의 사생활에 흥을 돋울 수 있습니다.\n\n빠른 시작을 위해, 당신 기대에 일치하도록 빠르게 수정할 수 있는, 7개의 미리 정해진 카드 덱을 찾을 수 있습니다. \n\n‘나를 핫하게 만들기’는 성인만을 위한 전희 에로틱 게임입니다. 당신이 성인이 아니라면 인스토록 하지 마세요!", "userRatingCountForCurrentVersion": 0, "languageCodesISO2A": ["AR", "CA", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HE", "HU", "ID", "IT", "JA", "KO", "MS", "NB", "PL", "PT", "RO", "RU", "ZH", "SK", "ES", "SV", "TH", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "29284352", "formattedPrice": "￦3,300", "trackContentRating": "17+", "averageUserRatingForCurrentVersion": 0, "genreIds": ["6014", "7014", "7005", "6016"], "userRatingCount": 0}]}