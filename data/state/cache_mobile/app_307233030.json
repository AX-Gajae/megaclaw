d0-3733-80f7ce7dd212/pr_source.jpg/576x768bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/0d/32/b2/0d32b2d2-1852-6636-d398-a1b620777dbc/pr_source.jpg/576x768bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/d1/96/f6/d196f6a0-de8b-e179-ba96-9b62852d944f/pr_source.jpg/576x768bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/0d/c2/fb/0dc2fb61-1ea6-0a53-6bff-e00895424c1f/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple116/v4/2a/16/a2/2a16a2c5-7cfe-3b42-b0e0-059e5faef3c0/pr_source.jpg/552x414bb.jpg"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/c6/7d/d2/c67dd28c-a62e-4cfa-f4f4-50dc7595ead7/ODEdeluxe-Icons-0-0-1x_U007emarketing-0-7-0-85-220.jpeg/512x512bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/enfour-inc/id284965604?uo=4", "minimumOsVersion": "12.0", "trackViewUrl": "https://apps.apple.com/kr/app/oxford-deluxe-ode-and-ote/id307233030?uo=4", "contentAdvisoryRating": "9+", "artistId": 284965604, "artistName": "Enfour, Inc.", "genres": ["참고", "교육"], "price": 33000.0, "releaseDate": "2009-03-27T01:46:53Z", "bundleId": "jp.co.enfour.ode", "genreIds": ["6006", "6017"], "sellerName": "Enfour, Inc.", "primaryGenreName": "Reference", "primaryGenreId": 6006, "trackId": 307233030, "trackName": "Oxford Deluxe (ODE and OTE)", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-14T16:02:31Z", "version": "17.0", "wrapperType": "software", "currency": "KRW", "description": "옥스퍼드 영영사전과 옥스퍼드 유의어사전에 원어민 발음의 음성 데이터가 추가된【디럭스 판】등장 ! 평생을 두고 사용할 수 있는 영영사전!\n\n옥스퍼드 영영사전과 옥스퍼드 유의어사전을 하나의 애플리케이션에 탑재하여, 옥스퍼드가 공인하는 7만2천여개의 원어민 발음 음성 데이터를 수록했습니다. \n\n일반적인 사전 애플리케이션과는 차원이 다른, 언제 어디서나 편리하게 사용할 수 있는 독립된 최고의 영영사전 애플리케이션으로 완성시켰습니다. 본격적인 영어공부를 가능케하는 영영사전으로 자신있게 추천합니다. \n\n■특징\n・인쇄판 사전을 통째로 수록\n・사전 앞뒤의 머릿말 및 사용법, 부록까지 모두 수록\n・각기 다른 3가지 방법에 의한 독자적인 삼중 검색시스템으로 적절한 검색 결과 제시\n・입력과 연동된 예측 실시간 검색 기능\n・철자오류 지적 기능 탑재\n・생소한 단어를 검색할 때 편리한 와일드카드 검색기능\n・타 애플리케이션을 통한 검색 써포트\n・편집 가능한 북마크 기능\n・자기만의 플래시 카드 작성 기능\n・직접 만드는 퀴즈 문제집 기능\n・자동 이력 기능\n・영영사전, 유의어사전 및 부록과의 상호 하이퍼링크 기능\n・완벽한 오프라인 사용 환경(3G 및Wi-Fi불필요)\n・모든 단어에 대해 심층적인 설명을 제공하는 \"AI 선생님\"\n・AI 강화 애너그램 생성기\n・\"Today\" & LockScreen widgets\n・iPhone, iPod, iPad and macOS support\n\n● 옥스퍼드 유의어사전(Oxford Dictionary of English:ODE)은 단일 영영사전 부문에서는  ‵으뜸′이라 할 수 있습니다. \n  최신의 Corpus 통계 연구를 토대로 완벽한 영어를 구현했습니다. 영어에 의한, 영어를 위한 최고의 사전입니다. \n● 옥스퍼드 유의어사전(Oxford Dictionary of English:ODE)에 수록되어 있는 동의어 및 반의어는 다른 어떤 사전보다도 권위가 있습니다. \n최신의 Corpus 통계 연구를 토대로 새로운 어휘를 수록, 각 요소마다 어드바이스를 표기하여 보다 심층적인 정보를 제공합니다.  WordFinder도 완벽하게 수록했습니다. 이에 따라 알파벳 검색뿐만 아니라, 예를 들어, 동물 울음소리에 의한 검색이나 게임에서 사용하는 2글자 단어, 3글자 단어와 같은 특정 카테고리 검색도 가능합니다. \n네이티브 음성 데이터\n옥스퍼드가 공인한 72000개 이상의 고품질 음성 데이터를 수록했으며, 모두가 사전과 링크되어 있습니다. \n\n자사 제품인 타 사전 애플리케이션과의 링크도 가능(※)하므로 번거로운 조작 없이 학습의 폭을 넓힐 수가 있습니다. \n\n이번 기회에 꼭, 저희 회사가 제공하는 다른 종류의 사전 애플리케이션도 함께 이용해 보시기 바랍니다. \n\nPowered by Enfour's -\"UniDict® Engine 16\"\n\n※일부 제품과 버전의 경우 대응하지 못하는 것도 있습니다. \n ________________\n\nThis application is distributed with the written permission of Oxford University Press.\n\nOxford Dictionary of English (ODE), Second Edition revised\n© Oxford University Press 2005\nOxford Thesaurus of English (OTE) \nSecond Edition revised\n© Oxford University Press 2006\nSoundfiles from the Shorter Oxford English Dictionary\n© Oxford University Press 2002\nAll rights reserved\nOxford University Press\nhttp://www.oup.com", "averageUserRating": 4.88235, "languageCodesISO2A": ["AR", "BN", "BS", "MY", "KM", "CA", "HR", "CS", "DA", "NL", "EN", "EO", "FI", "FR", "DE", "EL", "HE", "HI", "HU", "IS", "ID", "GA", "IT", "JA", "KO", "KU", "LO", "LT", "MK", "MS", "MN", "NB", "FA", "PL", "PT", "PA", "RO", "RU", "ZH", "SI", "SL", "ES", "SW", "SV", "TL", "TH", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "581240832", "formattedPrice": "￦33,000", "trackContentRating": "9+", "userRatingCountForCurrentVersion": 17, "averageUserRatingForCurrentVersion": 4.88235, "sellerUrl":