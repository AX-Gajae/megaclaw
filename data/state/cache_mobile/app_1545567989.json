r-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/e5/97/11/e59711dd-051b-99cd-cc8f-62970ff6650b/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "minimumOsVersion": "15.0", "trackCensoredName": "Number Match - 숫자 퍼즐", "trackViewUrl": "https://apps.apple.com/kr/app/number-match-%EC%88%AB%EC%9E%90-%ED%8D%BC%EC%A6%90/id1545567989?uo=4", "averageUserRating": 4.58967, "contentAdvisoryRating": "12+", "artistId": 1190815537, "artistName": "Easybrain Ltd", "genres": ["게임", "퍼즐", "보드", "엔터테인먼트"], "price": 0.0, "bundleId": "com.easybrain.number.puzzle.game", "releaseDate": "2021-10-11T07:00:00Z", "genreIds": ["6014", "7012", "7004", "6016"], "trackId": 1545567989, "trackName": "Number Match - 숫자 퍼즐", "primaryGenreName": "Games", "primaryGenreId": 6014, "isVppDeviceBasedLicensingEnabled": true, "sellerName": "Easybrain Ltd", "currentVersionReleaseDate": "2026-07-15T06:40:52Z", "releaseNotes": "- 성능 및 안정성 향상\n\n저희는 언제나 여러분의 리뷰를 읽고 게임을 개선하기 위하여 노력하고 있습니다. 저희가 하는 일이 마음에 들고 개선 사항을 제안하고 싶으시면 피드백을 남겨주세요. Number Match 퍼즐로 즐겁게 두뇌를 단련하세요!", "version": "1.31.0", "wrapperType": "software", "currency": "KRW", "description": "Number Match는 숫자의 쌍을 맞춰 보드를 비우는, 단순하지만 중독성 있는 숫자 퍼즐입니다. 두뇌를 강화하며 여가를 보내기에 안성맞춤인 게임이죠. 집중력과 논리를 단련하고 최고 기록을 경신해보세요!\n\n어린 시절 종이와 펜으로 하던 놀이를 모바일 버전으로 즐겨보세요. 이제 언제 어디서나 추억의 숫자 게임을 즐길 수 있습니다. 물론 종이와 펜보다 모바일에서 무료로 즐기는 숫자 매치 퍼즐 게임이 훨씬 편하죠.\n\n게임 방법:\n\n• 게임의 목표는 보드를 비우는 것입니다.\n• 숫자 그리드에서 같은 숫자 쌍(1과 1, 7과 7 등)이나 합이 10이 되는 숫자 쌍(6과 4, 8과 2 등)을 찾으세요.\n• 숫자를 하나씩 탭 해 보드에서 없애면 점수를 획득합니다.\n• 가로, 세로, 대각선 방향은 물론 한 선의 마지막 숫자와 그다음 선의 첫 번째 숫자까지도 한 쌍으로 연결할 수 있습니다.\n• 없앨 수 있는 숫자가 없을 때는 남은 숫자로 아래쪽에 선을 추가할 수 있습니다.\n• 진행이 막힐 땐 힌트를 사용할 수 있습니다.\n• 숫자 퍼즐 그리드에서 숫자를 모두 지우면 승리합니다.\n\n퍼즐을 풀 방법은 아주 많습니다. 하지만 보기보다 쉽지 않죠. 중독성 있는 게임플레이로 즐겁게 두뇌를 자극하세요!\n\n특징:\n\n• 누구나 즐길 수 있는 논리 퍼즐\n• 쉽게 질리지 않는 즐거운 게임플레이\n• 특별한 트로피를 받을 수 있는 일일 도전\n• 특별한 메달을 받을 수 있는 시즌 이벤트\n• 막힘 없는 진행을 도와주는 힌트\n• 시간제한 없는 느긋한 휴식 같은 게임\n• 최고의 개발사에서 출시한 새로운 숫자 게임!\n\nNumber Match 퍼즐로 즐겁게 두뇌를 단련하세요! 언제 어디서나 숫자 게임을 즐겨 보세요!", "userRatingCountForCurrentVersion": 7628, "languageCodesISO2A": ["AR", "EN", "FR", "DE", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "259530752", "formattedPrice": "무료", "trackContentRating": "12+", "sellerUrl": "https://easybrain.com", "averageUserRatingForCurrentVersion": 4.58967, "userRatingCount": 7628}]}