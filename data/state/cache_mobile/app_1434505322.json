-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "averageUserRatingForCurrentVersion": 4.82901, "bundleId": "com.zynga.pottermatch", "languageCodesISO2A": ["AR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HE", "ID", "IT", "JA", "KO", "MS", "NB", "PL", "PT", "RO", "RU", "SR", "ZH", "ES", "SV", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "405240832", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 4474, "trackContentRating": "9+", "trackCensoredName": "해리포터: 퍼즐과 마법 - 퍼즐게임", "trackViewUrl": "https://apps.apple.com/kr/app/%ED%95%B4%EB%A6%AC%ED%8F%AC%ED%84%B0-%ED%8D%BC%EC%A6%90%EA%B3%BC-%EB%A7%88%EB%B2%95-%ED%8D%BC%EC%A6%90%EA%B2%8C%EC%9E%84/id1434505322?uo=4", "contentAdvisoryRating": "9+", "sellerUrl": "https://www.zynga.com", "averageUserRating": 4.82901, "artistId": 295913422, "artistName": "Zynga Inc.", "genres": ["게임", "엔터테인먼트", "퍼즐", "가족"], "price": 0.0, "releaseNotes": "여러분이 가장 좋아하는 퍼즐 게임에서 여름의 열기가 뜨거워지고 있어요!\n- 말이 안 나올 정도? 새로운 메시지 반응을 클럽 채팅에서 이용해 보세요\n- 새 장면, 퀴디치 테스트에서 완전히 새로운 퍼즐에 도전하기\n- 새로운 마법 같은 순간 시즌이 곧 시작됩니다. 새 앨범을 채울 준비를 하세요!", "releaseDate": "2021-01-20T08:00:00Z", "trackId": 1434505322, "trackName": "해리포터: 퍼즐과 마법 - 퍼즐게임", "genreIds": ["6014", "6016", "7012", "7009"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Zynga Inc.", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-27T19:36:58Z", "version": "114.0.362", "wrapperType": "software", "currency": "KRW", "description": "한 번도 경험해 보지 못한 방식의 해리포터 게임을 만나보세요! 마법을 걸고, 도전을 극복하고 마법사 세계의 놀라움을 경험하며 내 모바일 기기에서 마법 같은 놀라운 매치 3 퍼즐을 풀어보세요! 해리포터 게임에서 레벨을 완료하며 매치 3 실력을 증명해 보이고, 퀘스트에 도움이 되는 새로운 주문을 잠금 해제하여 더욱 어려운 매치 3 퍼즐에 도전하세요. 무료 퍼즐 게임에서 마법처럼 장난스러운 매치 3 도전에 대비해 주문을 업그레이드해 보세요.\n\n매치 3 모험을 진행하며 여러분이 사랑하는 해리포터 영화의 마법사 세계 캐릭터들이 등장하는 순간들을 다시 체험해 보세요. 해리와 론, 헤르미온느가 트롤을 쓰러트리고, 프레드와 조지가 장난을 치고, 해그리드가 호그와트에서 마법 동물들을 돌보고 있답니다! 매치 3 퍼즐을 도와줄 신비한 동물을 모으면서 마법사 세계의 놀라운 요소들에 대해 알아보세요. 해리포터 팬에게는 최고의 매칭 게임이랍니다! 기상천외한 마법이 펼쳐지는 매치 3 게임에서 ‘지팡이를 휘두르고 주문을 외우며’ 나만의 마법 여행을 떠날 준비를 하세요! 전략과 추억에 팬 커뮤니티까지 조합해 잊을 수 없는 한 번의 여행을 선사하는 어른들을 위한 매칭 게임입니다.\n\no 매일 즐기는 미니 게임으로 퍼즐 뿐만 아니라 다양한 요소가 있습니다! 숨은 물건 찾기와 같은 재미있는 미니 게임들을 통해 매일 다른 활동을 즐겨보세요. 어른들을 위한 더 많은 매치 게임도 있습니다.\n\no 주문을 획득하고 업그레이드하세요. 윙가르디움 레비오사 같은 주문을 사용해 장애물을 제거하고 해저드를 극복해 매치 3 퍼즐에서 승리하세요.\n\no 해리포터의 마법을 즐겨보세요. 최고의 퍼즐로 가득한 전략 게임에서 새로운 매치 3 퍼즐을 풀면서 기억에 남는 해리포터 영화의 장면과 대사를 다시 만나볼 수 있습니다. 여러분이 마법사 세계를 여행하는 동안 예언자 일보를 통해 해리가 호그와트에서 어떤 모험을 하고 있는지 전해줍니다.\n\no 퍼즐을 풀면 보상이 주어집니다. 오늘의 미션과 기간 한정 이벤트를 완료해 파워업, 골드는 물론 퍼즐 풀이에 도움이 되는 다양한 보상이 가득한 한정 이벤트 상자를 받으세요.\n\no 클럽에서 친구들과 함께하세요. 클럽 멤버들과 힘을 모아 리더보드 순위를 올리고 나만의 기록을 남기세요. 클럽 챌린지나 호그와트 전투와 같은 협력 챌린지에서 클럽 멤버들과 함께하며 달콤한 승리를 맛보세요. 내 안의 경쟁심리를 깨워 벨라트릭스, 내기니와 같은 어둠의 세력을 물리쳐야 합니다!\n\no 매일 다양하게 준비된 이벤트도 만나보세요! 결투나 빗자루 레이스와 같은 절대 질리지 않는 무료 게임은 물론 멋진 매치 3 게임들이 기다리고 있습니다! 각각의 매치 3 게임들은 서로 다른 도전과 미스터리를 품고 있습니다.\n\no 신비한 동물을 획득하세요. 놀라운 마법사 세계의 수많은 동물들이 도전적인 매치 3 퍼즐 풀이에 도움을 주고 여러분의 타일 매치 실력을 높여줍니다. 각각의 신비한 동물들은 고유한 스킬과 혜택을 지니고 있어 어렵고 재미있는 무료 게임을 완료하는 데에 도움을 줍니다.\n\no 아바타를 꾸며보세요. 가장 좋아하는 호그와트 기숙사에 들어가 지팡이를 고르고 마음에 드는 머리모양과 장신구로 아바타를 꾸며 마법 같은 호그와트에서의 퍼즐 풀이 여행에서 멋지게 뽐내보세요!\n\n추가 고지\nZynga의 개인 정보 및 기타 데이터 수집 및 사용에 대한 자세한 정보는  https://www.take2games.com/privacy의 개인정보 보호정책에서 확인하세요. 본 애플리케이션의 사용에는 https://www.take2games.com/legal 에 명시된 Zynga 이용 약관이 적용됩니다. 이 게임은 무료로 플레이할 수 있으며, 추가 콘텐츠와 프리미엄 화폐는 앱 내 구매로 이용할 수 있습니다.\n\n해리포터: 퍼즐과 마법은 무료로 다운로드할 수 있으며 선택 가능한 게임 내 구매 기능이 있습니다.(랜덤 아이템 포함) 랜덤 아이템의 등장 확률에 대한 정보는 게임 내에서 확인할 수 있습니다. 게임 내 구매를 끄고 싶은 경우 스마트폰이나 태블릿의 설정에서 게임 내 구매 기능을 꺼주십시오.\n\n해리포터: 퍼즐과 마법 TM & © Warner Bros. Entertainment Inc. Software code © Zynga Inc. 해리 포터, 포트키 게임, 캐릭터, 이름 및 기타 관련 표시 © 및 TM Warner Bros. Entertainment Inc. Publishing Rights © JKR. (s26)\"", "minimumOsVersion": "15.0", "userRatingCount": 4474}]}