-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/fc/8f/51/fc8f5157-9daa-b107-5fd9-0012dcc2d1f4/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "minimumOsVersion": "15.0", "bundleId": "com.nexon.devcat.mm", "averageUserRating": 3.32612, "trackCensoredName": "마비노기 모바일", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%A7%88%EB%B9%84%EB%85%B8%EA%B8%B0-%EB%AA%A8%EB%B0%94%EC%9D%BC/id1441742921?uo=4", "contentAdvisoryRating": "12+", "artistId": 523546006, "artistName": "NEXON Company", "genres": ["게임", "캐주얼", "롤플레잉"], "price": 0.0, "releaseDate": "2025-03-24T07:00:00Z", "trackId": 1441742921, "trackName": "마비노기 모바일", "sellerName": "NEXON Korea Corporation", "genreIds": ["6014", "7003", "7014"], "primaryGenreName": "Games", "primaryGenreId": 6014, "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-22T21:10:28Z", "releaseNotes": "- [콘텐츠] 사이드 게임 - 라사의 마법학교: 변신 숨바꼭질\n- [이벤트] 캣스티벌", "version": "3.1.50011", "wrapperType": "software", "currency": "KRW", "description": "신규 레이드 ‘카브락’ 업데이트와 함께\n에린에 찾아온 여름을 즐겨보세요!\n고양이와 함께하는 캣스티벌 이벤트도 참여해보세요.\n \n■ 업데이트 소개 ■\n \n▶ 신규 8인 레이드 ‘카브락’\n생명을 앗아가는 메마른 숨결, 대지를 삼키는 재앙을 마주하라!\n동료 모험가와 함께 거대한 용 카브락에 맞서 싸워보세요.\n \n▶ 캣스티벌\n캣스티벌을 기념하여 다양한 이벤트 진행 중! \n고양이가 모여들어 모험가의 연주에 맞춰 합창하고,\n모험가 스스로 고양이로 변신하여 미션을 해결하는 등 색다른 재미를 느껴보세요. 고양이를 모티브로 한 악기와 패션 무기도 이벤트에서 선물로 얻으실 수 있어요!\n \n▶ 여름맞이 업데이트\n에린에도 여름이 찾아왔어요! \n시원한 바닷가 콜헨에서 즐기는 다양한 이벤트로\n무더위를 잊어보세요.\n  \n■ 게임 특징 ■\n \n▶ 새롭게 펼쳐지는 에린의 이야기\n마비노기 IP의 이야기가 마비노기 모바일에서 새롭게 펼쳐집니다.\n여신의 부름에서 시작되는 여정, 당신만의 새로운 이야기를 만들어 가세요.\n \n▶ 쉽고 간편한 성장과, 나만의 조합으로 전투 클리어!\n레벨업 카드로 고민 없이 간편하게 성장!\n룬 각인에 따라 바뀌는 스킬을 통해 나만의 조합으로 전투를 헤쳐나가 보세요.\n \n▶ 감성 가득한 생활 콘텐츠\n에린에서의 생활을 더욱 풍성하게 만들어주는 다양한 생활 콘텐츠를 경험해 보세요.\n낚시, 요리, 채집 등 힐링 가득한 생활 콘텐츠가 여러분을 기다리고 있어요.\n \n▶ 함께하는 낭만\n캠프파이어 앞에서 함께 춤을 추고 악기를 연주하며 시간을 보내는 건 어떨까요?\n다양한 소셜 활동을 통해 새로운 인연과 함께하는 만남과 모험을 즐겨 보세요.\n \n▶ 또 다른 나를 만나는 시간\n에린에서는 내가 원하는 모습을 자유롭게!\n다양한 패션 아이템과 섬세한 염색으로 나만의 개성 있는 룩을 완성시켜 보세요!\n\n■ 스마트폰 앱 접근권한 안내 ■\n앱 이용 시 아래와 같은 서비스를 제공하기 위해 접근 권한을 요청하고 있습니다.\n\n▶ 선택적 접근권한\n- 사진: 영상을 저장하고, 사진 및 동영상 업로드를 하는데 필요합니다.\n- 카메라: 고객센터 문의에 필요한 사진 및 동영상을 첨부, 제출하기 위해 필요합니다.\n- 광고식별자: 맞춤형 광고 제공 및 서비스 이용 분석을 위해 필요합니다.\n- 마이크: 고객센터 문의에 필요한 동영상을 촬영하기 위해 필요합니다.\n※ 선택적 접근권한의 허용에 동의하지 않아도 서비스 이용이 가능합니다. \n\n▶ 접근권한 철회 방법\n- 설정 > 개인정보보호 > 해당 접근권한 선택 > 접근권한 동의 또는 철회 선택", "languageCodesISO2A": ["EN", "KO"], "fileSizeBytes": "331088896", "formattedPrice": "무료", "trackContentRating": "12+", "averageUserRatingForCurrentVersion": 3.32612, "userRatingCountForCurrentVersion": 8181, "userRatingCount": 8181}]}