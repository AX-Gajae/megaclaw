", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": ["iosUniversal"], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/50/0c/48/500c48d6-d7db-1388-7ef3-6da090275201/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "averageUserRating": 4.53242, "contentAdvisoryRating": "4+", "trackCensoredName": "AdGuard Ad Blocker for Safari", "trackViewUrl": "https://apps.apple.com/kr/app/adguard-ad-blocker-for-safari/id1047223162?uo=4", "minimumOsVersion": "13.0", "genres": ["유틸리티", "생산성"], "artistId": 1440147258, "artistName": "Adguard Software Limited", "price": 0.0, "releaseNotes": "앱의 안정성을 높이고 사소한 버그를 수정하기 위한 기술 업데이트입니다.", "releaseDate": "2015-10-24T07:27:36Z", "trackId": 1047223162, "trackName": "AdGuard Ad Blocker for Safari", "genreIds": ["6002", "6007"], "primaryGenreName": "Utilities", "primaryGenreId": 6002, "sellerName": "Adguard Software Limited", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-01T14:43:10Z", "version": "4.5.21", "wrapperType": "software", "currency": "KRW", "description": "Safari에서 광고를 차단하세요. YouTube 광고까지 포함됩니다. 고급 DNS 필터링으로 추적을 차단하고 개인정보를 보호하세요. 무료로 이용할 수 있으며, 수백만 사용자가 신뢰하는 앱입니다.\n\n방해 없는 Safari 브라우징\n배너, 팝업, 자동 재생 영상 등 방해되는 광고를 차단합니다. YouTube 광고도 포함됩니다. 웹페이지를 정리하고, 원하는 콘텐츠에만 집중할 수 있습니다.\n\n추적 차단 및 개인정보 보호\n기업이 사용자의 활동을 추적하기 위해 사용하는 숨겨진 스크립트와 디지털 지문을 차단합니다. 개인 데이터 수집을 방지하고 안전하게 브라우징할 수 있습니다.\n\n더 빠른 로딩과 데이터 절약\n광고와 무거운 스크립트를 제거해 페이지 로딩 속도를 개선합니다. 브라우징이나 스트리밍 시 데이터 사용량과 배터리 소모를 줄일 수 있습니다.\n\nSafari를 넘어서는 DNS 보호\n암호화된 DNS 필터링으로 Safari뿐만 아니라 기기 전반에서 원치 않는 요청을 차단합니다. DNS 요청을 ISP, 네트워크, 제3자로부터 보호합니다. 공용 Wi-Fi에서도 안전하게 연결할 수 있습니다. 자녀의 기기에서는 성인 콘텐츠를 차단하는 가족용 DNS를 사용할 수 있습니다.\n\n무료로 시작, Pro 기능까지 지원\n기본 기능은 무료로 제공됩니다. Safari 광고 차단과 기본 개인정보 보호 기능을 바로 이용할 수 있으며, 계정 등록은 필요하지 않습니다. Pro 기능에서는 YouTube 고급 광고 차단, DNS 기반 앱 보호, 사용자 규칙 및 보안 필터를 사용할 수 있습니다. 7일 무료 체험 후 앱 내에서 간편하게 업그레이드할 수 있습니다.\n\n차단 현황을 한눈에 확인\n내장된 통계 기능으로 차단된 광고와 추적기를 확인할 수 있습니다. 보호 상태와 활동 데이터를 실시간으로 확인할 수 있습니다.\n\n사용자 정의 설정으로 완벽한 제어\n- 허용 목록과 차단 목록을 직접 설정\n- DNS 서버 선택\n- 사용자 규칙을 통한 필터링 설정\n\n강력한 필터링 기술\nAdGuard 자체 필터와 다양한 인기 필터 목록을 사용합니다. 악성 광고, 피싱, 의심스러운 콘텐츠로부터 보호합니다.\n\n신뢰할 수 있는 투명성\n광고 차단 분야에서 17년 이상의 경험을 쌓아왔습니다. GitHub에서 전체 소스 코드를 공개하고 있어 누구나 확인할 수 있습니다. 허용 광고 정책 없이, 타협 없는 보호를 제공합니다.\n\n쾌적한 Safari 브라우징 환경\n페이지를 더 깔끔하게 유지하고 방해 요소를 줄일 수 있습니다. 강력한 개인정보 보호로 더욱 안전하게 Safari를 이용할 수 있습니다. iOS용 AdGuard를 통해 Safari 브라우징과 DNS 보호를 직접 관리할 수 있습니다.\n\n개인정보처리방침: https://adguard.com/privacy.html\n이용약관: https://adguard.com/eula.html\nX: @AdGuard\nFacebook: facebook.com/AdGuardEn/\n고객 지원: support@adguard.com", "bundleId": "com.adguard.AdguardExtension", "languageCodesISO2A": ["BE", "HR", "CS", "DA", "NL", "EN", "FR", "DE", "HU", "ID", "IT", "JA", "KO", "NB", "FA", "PL", "PT", "RO", "RU", "SR", "ZH", "SK", "SL", "ES", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "84408320", "formattedPrice": "무료", "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 4.53242, "sellerUrl": "http://adguard.com/", "userRatingCountForCurrentVersion": 2545, "userRatingCount": 2545}]}