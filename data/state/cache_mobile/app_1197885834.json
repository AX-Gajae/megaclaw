dAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/8c/e2/d7/8ce2d735-34c9-235b-39e6-e0e16df799f5/Thermometer-AppIcon-0-0-1x_U007emarketing-0-8-0-sRGB-85-220.png/512x512bb.jpg", "trackCensoredName": "Thermo - 실시간 온도계", "trackViewUrl": "https://apps.apple.com/kr/app/thermo-%EC%8B%A4%EC%8B%9C%EA%B0%84-%EC%98%A8%EB%8F%84%EA%B3%84/id1197885834?uo=4", "bundleId": "com.monirapps.thermomete", "contentAdvisoryRating": "4+", "averageUserRating": 5, "artistId": 1833017712, "artistName": "Stolanapp", "price": 0.0, "releaseDate": "2017-01-24T18:12:57Z", "releaseNotes": "새로운 기능: 세계 지도를 통해 지구상의 어느 곳이든 실시간으로 온도를 확인하세요!", "genreIds": ["6001", "6012"], "trackId": 1197885834, "trackName": "Thermo - 실시간 온도계", "primaryGenreName": "Weather", "primaryGenreId": 6001, "sellerName": "Stolanapp", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-24T14:38:12Z", "version": "5.4.2", "wrapperType": "software", "currency": "KRW", "description": "써모 - 실시간 온도계\n\n실시간으로 정확한 실외 온도를 제공합니다.\n\nThermo를 사용하면 어디에 있든 현재 실외 온도와 상세한 날씨 정보를 즉시 확인할 수 있습니다. 집을 나서기 전에 외부 온도를 확인하거나 하루 동안 변화하는 날씨를 모니터링하고 싶을 때, Thermo는 깔끔하고 직관적인 인터페이스를 통해 신뢰할 수 있는 정보를 제공합니다.\n\n실시간 온도 정보 (전 지역별)\n\n현재 위치의 실시간 온도 정보를 확인하거나 전 세계 어느 도시든 검색해 보세요. 자동 위치 정보 확인 및 빠른 데이터 업데이트 기능으로 언제나 현재 온도를 알 수 있습니다. 화씨와 섭씨 중 원하는 단위로 간편하게 전환할 수 있습니다.\n\n대화형 온도 지도 및 레이더\n\n확대/축소 가능한 실시간 지도에서 온도 정보를 확인하세요. 원하는 위치를 탭하면 자세한 기상 정보를 즉시 볼 수 있습니다. 통합 레이더 기능을 통해 날씨 패턴을 파악하고 주변의 변화를 실시간으로 추적할 수 있습니다.\n\n습도와 체감온도는 데이터와 같습니다.\n\n습도 수준을 모니터링하고 체감 온도를 확인하여 날씨 조건이 쾌적함에 실제로 어떤 영향을 미치는지 더 잘 이해하세요. Thermo는 필수적인 대기 데이터를 하나의 명확한 인터페이스에 통합합니다.\n\n믿을 수 있는 예측\n\n정확한 일일 및 7일 예보로 미리 계획을 세우세요. 명확한 그래프와 상세한 데이터를 통해 기온 변화와 변화하는 날씨 상황을 자신 있게 예측할 수 있습니다.\n\n스마트 알림 및 즉각적인 업데이트\n\n시기적절한 알림과 일일 업데이트를 통해 최신 정보를 받아보세요. Thermo는 앱을 계속 열지 않아도 중요한 온도 변화와 날씨 상황을 알려줍니다.\n\n강력한 위젯\n\n홈 화면에 온도 위젯을 추가하여 현재 날씨를 즉시 확인하세요. 명확하고 빠르게 정보를 확인할 수 있도록 설계된 위젯은 필수 정보를 한눈에 제공합니다.\n\n단순함과 정밀함을 위해 설계되었습니다.\n\nThermo는 디지털 온도계의 신뢰성과 최첨단 기상 기술의 강력한 기능을 결합한 제품입니다. 빠르고 정확하며 사용하기 쉬운 Thermo는 필요할 때 필요한 실외 온도 정보를 제공합니다.\n\n서비스 약관: Apple의 서비스 약관은 앱 내에서 제공되는 모든 구독 서비스에 적용됩니다. 자세한 내용은 다음 링크를 참조하세요. [https://www.apple.com/legal/internet-services/itunes/dev/stdeula](https://www.apple.com/legal/internet-services/itunes/dev/stdeula", "averageUserRatingForCurrentVersion": 5, "minimumOsVersion": "15.6", "sellerUrl": "https://thermometer.web.ipapps.vaybay.fr/", "languageCodesISO2A": ["AF", "SQ", "AM", "AR", "HY", "AZ", "EU", "BE", "BN", "BG", "MY", "KM", "CA", "HR", "CS", "DA", "NL", "EN", "ET", "FI", "FR", "GL", "KA", "DE", "EL", "GU", "HE", "HI", "HU", "IS", "ID", "IT", "JA", "KN", "KK", "KO", "KY", "LO", "LV", "LT", "MK", "MS", "ML", "MR", "MN", "NE", "NB", "FA", "PL", "PT", "PA", "RO", "RU", "SR", "ZH", "SI", "SK", "SL", "ES", "SW", "SV", "TA", "TE", "TH", "ZH", "TR", "UK", "UR", "VI", "ZU"], "fileSizeBytes": "151308288", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 3, "trackContentRating": "4+", "genres": ["날씨", "라이프스타일"], "userRatingCount": 3}]}