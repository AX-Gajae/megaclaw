r-iPadAir13M4Cellular"], "features": ["iosUniversal"], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/3a/af/ed/3aafedfa-34b1-f80b-c8d5-c9e74c21bc22/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/512x512bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/haoplay-limited/id1518979561?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/3a/af/ed/3aafedfa-34b1-f80b-c8d5-c9e74c21bc22/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/3a/af/ed/3aafedfa-34b1-f80b-c8d5-c9e74c21bc22/AppIcon-1x_U007emarketing-0-8-0-85-220-0.png/100x100bb.jpg", "advisories": [], "minimumOsVersion": "12.0", "artistId": 1518979561, "artistName": "HaoPlay Limited", "price": 0.0, "genres": ["게임", "액션", "어드벤처"], "trackId": 6475638448, "trackName": "메탈슬러그: 각성", "isVppDeviceBasedLicensingEnabled": true, "genreIds": ["6014", "7001", "7002"], "primaryGenreName": "Games", "primaryGenreId": 6014, "bundleId": "com.haoplay.jk.metalslug", "currentVersionReleaseDate": "2026-06-01T19:23:35Z", "releaseNotes": "1. S7 신규 시즌 개막\n2. 신규 캐릭터 등장\n3. 신규 무기 업데이트\n4. 신규 메인 스토리 업데이트", "version": "1.20.1", "wrapperType": "software", "currency": "KRW", "description": "거꾸로 가는 시간, 부패의 성벽! \n① 신규 스토리 - 거꾸로 가는 시간\n종말로 향해가는 지구의 운명을 바꾸기 위해 마르코는 홀로 모덴 전쟁 이전의 세계선으로 돌아갔고 우연히 부패한 군단의 음모를 파헤치게 됩니다. 마르코는 극한의 포위를 뚫고 앤드류 타운으로 정보를 가져가지만 이제 막 정규군 총사령관에 오른 지도자—모덴이 그를 맞이합니다. 이번만큼은 숙적끼리 손을 잡고 희망의 불씨를 다시 지피겠다고 맹세합니다. 이때 부패의 땅 깊은 곳에서는 또 다른 시간여행자가 운명의 만남을 기다리고 있습니다...\n\n② 신규 영웅 - 레오나\n부모를 잃은 고아이자 용병 부대 교관 하이데른의 양녀로, 어린 시절부터 엄격한 군사 교육을 받으며 자랐다. 성인이 된 후, 그녀는 하이데른 용병단의 최연소 지휘관이 되었다. \n비극적인 어린 시절은 그녀를 과묵하고 고립된 성격으로 만들었으며, 일반적인 사회생활을 거의 하지 못하게 되었고 사회적 불안증까지 앓게 되었다. 그녀는 “가장 완벽한 병사”라 불리며, 목표 명확하고 강한 실행력을 발휘하며 미션을 극도로 간결하고 효율적으로 수행하는 능력을 지녔다. 하지만 지휘관으로서 다른 이들과의 소통 능력이 부족한 점은 그녀의 약점이 되었다. 그녀에게는 아무리 어려운 미션이라도 부하들에게 작업을 분배하는 것보다 훨씬 쉽다. 용병들은 대개 이 지휘관을 까다롭게 여기지 않으며, 오히려 그녀의 뛰어난 개인 능력과 전장에서의 침착함 덕분에 레오나에게는 충성스러운 추종자들이 생겨났다. \n레오나는 양아버지 하이데른을 매우 존경하고 숭배한다. 기술 수준이 급속히 발전하는 시대에도 그녀는 양아버지가 선물한 단검을 고수하며, 오로지 하이데른의 최강의 칼날이 되기를 원한다. 그녀의 전투 능력은 남다르며, 그녀의 칼날은 총알과 장갑을 베어버릴 수 있어 명실공히 냉병기 전설의 전사라 불릴 만하다. 그녀는 한때 페레그린 팰컨스와 스패로우즈와 함께 미래의 모덴군에 맞서 싸운 적이 있다. '문라이트 쏘우'는 미래 기술의 방어선을 뚫는 데 성공했고, 그 힘은 시공조차 요동치게 했다. 쓰레기섬에서 한순간 번뜩인 날카로움은 나비의 날갯짓처럼 바다를 넘어, 가까운 미래에 엄청난 폭풍을 일으키게 된다…그러나 레오나가 이 모든 것을 알게 되었을 때, 그녀는 운명을 바꿀 비밀을 이미 알고 있었다. 시간을 되돌릴 수 있다면, 그녀는 미래를 바꾸기 위해 최선을 다할 것이다!\n\n③ 신규 무기 - 라이트 블레이드\n빛을 검으로 다루며, 전장을 지배한다. 냉병기와 화기가 결합된 또 하나의 명작. 탄두 내부에는 특수 광류제가 내장되어 있어, 발사 시 빛나는 궤적을 그려낸다. 이 궤적은 탄도를 보여주고 목표를 지시하는 역할을 하며, 냉염 코어의 강화 과정을 거쳐 전장을 지배하는 날카로운 무기로 완성되었다.\n\n④ 신규 콘텐츠 — 무기 마스터 시즌\n “무기 마스터 시즌 신규 스테이지 추가!\n신규 스테이지는 안개 도시 특유의 분위기를 모티브로, 사이버펑크 산악 도시의 하드코어 미학을 융합해 입체적인 전장을 구현했다.\n지휘관들은 스테이지에서 홍야동, 장강 케이블카, 모노레일 관통 전철, 18제 등 유명 랜드마크를 직접 체험하며, 안개 도시 충칭의 매력을 마음껏 느낄 수 있다.\n\n공식 커뮤니티에서 메탈슬러그: 각성에 대한 더 많은 정보를 확인할 수 있습니다.\nYoutube: @MetalSlugAwakeningMobile\n네이버 Cafe: https://cafe.naver.com/metalslugawakening\nDiscord: https://discord.gg/metalslugawakening\n\n©SNK CORPORATION ALL RIGHTS RESERVED.", "averageUserRatingForCurrentVersion": 4.8182, "languageCodesISO2A": ["EN", "FR", "DE", "JA", "KO", "PT", "ZH", "ES"], "fileSizeBytes": "4126119936", "formattedPrice": "무료", "trackContentRating": "12+", "averageUserRating": 4.8182, "sellerUrl": "https://www.haoplay.com", "trackCensoredName": "메탈슬러그: 각성", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%A9%94%ED%83%88%EC%8A%AC%EB%9F%AC%EA%B7%B8-%EA%B0%81%EC%84%B1/id6475638448?uo=4", "contentAdvisoryRating": "12+", "userRatingCountForCurrentVersion": 9318, "sellerName": "HaoPlay Limited", "releaseDate": "2024-07-17T07:00:00Z", "userRatingCount": 9318}]}