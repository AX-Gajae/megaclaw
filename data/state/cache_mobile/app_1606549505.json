Max-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "isGameCenterEnabled": false, "advisories": [], "kind": "software", "averageUserRatingForCurrentVersion": 4.72771, "sellerUrl": "https://www.dreamgames.com", "averageUserRating": 4.72771, "trackCensoredName": "로얄 킹덤 (Royal Kingdom)", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%A1%9C%EC%96%84-%ED%82%B9%EB%8D%A4-royal-kingdom/id1606549505?uo=4", "contentAdvisoryRating": "12+", "languageCodesISO2A": ["AR", "CA", "HR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "HU", "ID", "IT", "JA", "KO", "NB", "PL", "PT", "RO", "RU", "ZH", "SK", "ES", "SV", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "329454592", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 27982, "trackContentRating": "12+", "releaseNotes": "환상적인 신규 업데이트를 맞이할 준비를 하세요!\n\n• 새로운 레벨 100개를 만나 보세요! 재미있고 신나는 도전을 즐겨 보세요!\n\n• 최신 아이템 '거대 땅요정'을 잠금 해제하세요! 방패를 꽉 쥔 거대 땅요정은 당신의 용감한 기사입니다!\n\n• 새로운 적 '흡혈귀'를 물리치세요! 밤이 되면 흡혈귀의 부름에 응답하는 박쥐들을 조심하세요!\n\n• 새로운 구역 '비밀의 언덕'을 탐험하세요! 왕국을 확장해 가며 새로운 장소들을 확인해 보세요!\n\n• 새로운 시즌 '아카데미 컬렉션'과 함께 지혜의 세계로 들어가 보세요! 시즌 기간 동안 모든 카드를 모아 올빼미 토큰을 획득하세요!\n\n지금 로얄 킹덤을 플레이하세요!", "artistId": 1482155846, "artistName": "Dream Games", "genres": ["게임", "퍼즐", "캐주얼"], "price": 0.0, "releaseDate": "2024-11-21T08:00:00Z", "bundleId": "com.dreamgames.royalkingdom", "trackName": "로얄 킹덤 (Royal Kingdom)", "trackId": 1606549505, "genreIds": ["6014", "7012", "7003"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Dream Games Dijital Teknolojiler A.S.", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-27T08:00:36Z", "version": "32221", "wrapperType": "software", "currency": "KRW", "description": "로얄 매치 제작진이 선보이는 새로운 매치 3 퍼즐 모험 '로얄 킹덤'에서 더 많은 왕실 사람들을 만나 보세요!\n \n로버트 왕의 동생인 리처드 왕은 물론, 벨라 공주와 마법사 등 매력 넘치는 새 캐릭터들과 함께 전설적인 왕국을 세우기 위한 여정을 떠나세요! 매치 3 퍼즐을 풀어 새로운 땅을 탐험하고 어둠의 왕과 그 군대를 물리치세요!\n \n매치 3 퍼즐을 마스터하세요\n재미있지만 까다로운 퍼즐을 풀며 자신의 실력을 시험하고 최고의 매치 3 전문가가 되세요! 짜릿한 레벨에서 승리하고 특별한 장애물을 극복하세요!\n \n왕국을 건설하고 탐험하세요\n건설자의 도움을 받아 왕족에게 걸맞은 왕국을 만드세요. 퍼즐을 풀며 동전을 획득하고 의회 광장부터 대학, 공주의 탑까지 다양한 구역을 잠금 해제하세요.\n \n어둠의 왕을 물리치세요\n매치 3 퍼즐을 풀어 어둠의 왕의 공격으로부터 왕국을 지키세요. 어둠의 왕의 성과 사악한 부하들을 파괴해 어둠의 왕을 몰락시키세요. 매치해가며 승리를 거머쥐세요!\n \n지배력을 확장하세요\n순위를 높여 순위표에서 상위권에 오르고, 퍼즐 풀기의 달인이 되어 푸짐한 보상을 받고, 게임을 진행하며 미지의 땅을 발견해 왕국을 확장하세요!\n \n훌륭한 그래픽을 즐기세요\n로얄 킹덤의 근사한 그래픽과 매끄러운 애니메이션에 푹 빠져 보세요. 지금까지 경험해 보지 못한 완벽하고 매력적인 퍼즐 게임을 즐길 수 있어요.\n \n주저하지 말고 지금 로얄 킹덤을 다운로드하고 고귀한 모험가들의 대열에 합류하세요! 수많은 재미와 도전 의식을 자극하는 플레이, 마법 같은 세계까지! 왕족에게 걸맞은 퍼즐 게임입니다!\n\n도움이 필요하신가요? 로얄 킹덤 앱의 지원 페이지를 방문하시거나, contact@dreamgames.com로 메시지를 보내주세요.", "minimumOsVersion": "13.0", "userRatingCount": 27982}]}