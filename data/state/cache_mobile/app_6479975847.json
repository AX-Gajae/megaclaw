o", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "features": ["iosUniversal"], "kind": "software", "advisories": [], "userRatingCountForCurrentVersion": 16, "averageUserRatingForCurrentVersion": 5, "sellerUrl": "http://www.babal.cc", "languageCodesISO2A": ["EN"], "fileSizeBytes": "25149440", "formattedPrice": "무료", "trackContentRating": "4+", "minimumOsVersion": "13.0", "trackCensoredName": "PKKP:2인용 요리 게임", "trackViewUrl": "https://apps.apple.com/kr/app/pkkp-2%EC%9D%B8%EC%9A%A9-%EC%9A%94%EB%A6%AC-%EA%B2%8C%EC%9E%84/id6479975847?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 5, "price": 0.0, "bundleId": "com.babal.cc.cook", "artistId": 861213613, "artistName": "嘉琪 范", "genres": ["게임", "캐주얼", "가족", "엔터테인먼트"], "primaryGenreName": "Games", "primaryGenreId": 6014, "currentVersionReleaseDate": "2026-07-27T06:48:00Z", "releaseDate": "2024-03-27T07:00:00Z", "releaseNotes": "2인용 레스토랑에 새로운 스테이지 추가\n게임 아이템 기능을 미세하게 조정했습니다.\n일부 버그를 수정했습니다.\n레벨 밸런스 조정", "version": "1.3.9", "wrapperType": "software", "currency": "KRW", "description": "[동일 화면 듀얼 협력 / 로컬 네트워크 온라인 지원]\nPKKP 시리즈 최신 듀오 게임'렛츠쿡!'을 플레이할 수 있다.\n이번에는 친구와 함께 식당을 운영해야 합니다.\n모든 요리를 빠르고 정확하게 만들고 뜨거울 때 고객 앞에 놓는다.\n당신과 당신의 친구, 한 사람은 요리사로 음식을 만들어야 하고, 다른 한 사람은 웨이터로 음식을 손님 앞에 배달해야 합니다.\n함께 잘 협력하여 더 높은 점수를 만들자.\n【게임 특색】\n우리는 다양한 시나리오에 따라 게임을 수행하기 위해 다양한 게임 모드를 제공합니다.싱글 모드, 듀얼 로컬 모드, 듀얼 온라인 모드 등 세 가지 놀이가 포함된다.\n현재 게임에서 도전할 수 있는 관문은 수백 개에 달한다.만들 수 있는 음식 종류도 다양하다.도전해 주시길 정말 기대합니다!\n더 많은 관문과 더 풍부한 음식 종류를 지속적으로 업데이트할 것입니다...\n물론 더 많은 재미있는 새로운 게임도 곧 나타날 예정이니 기대해주세요!\n【게임 방법 설명】\n우리는 다양한 시나리오에 따라 게임을 수행하기 위해 다양한 게임 모드를 제공합니다.\n- 로컬 듀얼 스크린 게임\n친구, 가족과 같은 장치에서 언제 어디서나 게임을 즐길 수 있습니다.두 사람이 동일한 화면을 공유합니다.스크린의 왼쪽은 요리사 캐릭터의 조작 구역이다. 이 게이머는 주로 고객의 수요에 따라 신속하고 정확하게 맛있는 음식을 만드는 것을 책임진다.스크린의 오른쪽 반쪽은 웨이터 캐릭터의 조작 구역이며, 오른쪽 게이머는 고객이 음식을 주문하고, 음식을 올리고, 계산하고, 식탁을 청소하는 일을 책임져야 한다.두 명의 플레이어는 호흡이 잘 맞아서 이 식당을 더 잘 운영해야 한다.\n물론 당신 혼자라면 여전히 좌우 두 캐릭터를 동시에 조작해 게임을 할 수 있다.그러나 이것은 매우 어려운 도전이 될 것이다. 만약 한 사람이 정말 관문을 완성하지 못한다면, 주변의 친구를 불러 도와주는 것도 무방하다. 이렇게 하면 더욱 수월할 뿐만 아니라 즐거움도 더 많아질 것이다.\n- 로컬 더블 온라인 게임\n우선 로컬 온라인은 양측이 로컬 동일한 와이파이에 연결하거나 모바일 블루투스 기능을 켜고 앱에 충분한 네트워크 권한이 있는지 확인해야 한다는 점에 유의해야 한다.\n당신은 단지 온라인 방을 만들고 주변 사람들이 가입하기를 기다리면 두 장치에서 게임의 모든 종료를 체험할 수 있습니다.\n- 싱글 게임\n\"만약 당신이 요리에 매우 열중하고 있다면, 이 패턴은 당신에게 아주 적합합니다.\"싱글 게임 모드에서는 요리사 역할을 맡아 음식 만들기에 총력을 기울일 예정이다.", "trackId": 6479975847, "trackName": "PKKP:2인용 요리 게임", "genreIds": ["6014", "7003", "7009", "6016"], "isVppDeviceBasedLicensingEnabled": true, "sellerName": "嘉琪 范", "userRatingCount": 16}]}