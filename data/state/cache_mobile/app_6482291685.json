, "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": [], "contentAdvisoryRating": "4+", "averageUserRating": 0, "trackCensoredName": "Cuspart: GPS", "trackViewUrl": "https://apps.apple.com/kr/app/cuspart-gps/id6482291685?uo=4", "averageUserRatingForCurrentVersion": 0, "sellerUrl": "https://www.cuspart.com", "languageCodesISO2A": ["CA", "HR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "HU", "ID", "IT", "JA", "KO", "NB", "PL", "PT", "RO", "RU", "ZH", "ES", "SV", "ZH", "TR", "UK"], "fileSizeBytes": "43399168", "formattedPrice": "￦1,100", "userRatingCountForCurrentVersion": 0, "trackContentRating": "4+", "artistId": 1479052908, "artistName": "Mustafa Tolga DALBUDAK", "genres": ["스포츠"], "price": 1100.0, "releaseDate": "2024-04-05T07:00:00Z", "releaseNotes": "What’s New?\n\nWith this update, we’re making it easier than ever to master your environment:\n\n• Enhanced Precision: Improved GPS accuracy for precise speed and distance tracking.\n• Sleek Interface: Subtle UI enhancements for a more intuitive experience. \n• Performance Boost: Under-the-hood optimizations for smoother performance. \n• Stability Improvements: Minor bug fixes to enhance overall reliability.", "genreIds": ["6004"], "trackId": 6482291685, "trackName": "Cuspart: GPS", "primaryGenreName": "Sports", "primaryGenreId": 6004, "sellerName": "Mustafa Tolga DALBUDAK", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-02-03T02:17:42Z", "version": "1.33.4551", "wrapperType": "software", "currency": "KRW", "description": "Cuspart는 귀하의 iPhone을 정밀한 주행 계측 장비로 변신시킵니다.\n\n정확성을 요구하는 자동차 마니아를 위해 제작된 Cuspart는 고성능 GPS 속도계와 첨단 가속 성능 타이머를 결합했습니다. 폐쇄된 트랙이나 통제된 환경에서의 테스트를 위해 설계되었습니다.\n\n트랙에서 차량의 제로백(0-100km/h) 성능을 측정하든, 일상 주행을 위한 신뢰할 수 있는 디지털 속도계가 필요하든, Cuspart는 명확성과 속도를 위해 설계된 직관적인 인터페이스를 통해 실시간 데이터를 제공합니다.\n\n핵심 기능\n\n정밀 가속 타이머\n지능형 자동 출발/정지 감지 기능으로 차량의 성능을 정확하게 수치화하세요. Cuspart는 차량의 움직임을 인식하여 수동 조작 없이도 정확한 스프린트 타임을 포착합니다.\n• 가속 테스트: 제로백(0–100km/h), 100–200km/h 및 0–60mph 측정 지원.\n• 드래그 퍼포먼스: 1/4마일(400m), 1/2마일, 100미터 및 1000미터를 포함한 표준 거리를 추적합니다.\n• 자동 로그 저장: 모든 주행 기록은 향후 분석을 위해 히스토리에 자동 저장됩니다.\n\n다이내믹 대시보드 모드\n주행 환경과 개인 취향에 가장 적합한 디스플레이 스타일을 선택하세요:\n• 아날로그 게이지: 전통적인 스포츠카 대시보드에서 영감을 받은 클래식한 바늘형 속도계.\n• 디지털 대시: 고속 주행 시 즉각적인 가독성을 위해 최적화된 고대비 대형 디지털 디스플레이.\n• 지도 연동: 인터랙티브 지도에서 실시간 경로와 위치를 추적하며 속도를 모니터링할 수 있습니다.\n\n성능 분석 및 히스토리\n단순한 시간 측정을 넘어 상세한 성능 인사이트를 제공합니다:\n• 속도 그래프: 가속 곡선을 시각화하여 출력 특성과 기어 변속 시점을 더 잘 이해할 수 있습니다.\n• 상세 기록: 정확한 날짜와 시간 스탬프가 찍힌 모든 저장된 주행 기록을 검토하여 시간 경과에 따른 성능 향상을 추적하세요.\n\n헤드업 디스플레이 (HUD)\n야간 주행 시 시인성과 집중력을 높이세요. HUD 모드는 속도계를 전면 유리에 반사시켜, 전방 도로에서 눈을 떼지 않고도 핵심 정보를 확인할 수 있게 해줍니다.\n\n커스터마이징\n• 단위: 미터법(km/h)과 야드파운드법(mph) 시스템 간을 즉시 전환할 수 있습니다.\n• 디자인: 세심하게 최적화된 다크 테마는 눈부심을 줄이고 모든 조명 조건에서 탁월한 가독성을 보장합니다.\n\n지금 Cuspart를 다운로드하고 iPhone을 전문가급 성능 및 속도 추적 도구로 활용해 보세요.\n\n면책 조항:\nCuspart는 GPS 데이터를 사용하여 속도와 거리를 계산합니다. 정확도는 기기 하드웨어, 위성 신호 품질 및 환경 조건에 따라 달라질 수 있습니다. 항상 교통 법규를 준수하고 책임감 있게 애플리케이션을 사용하십시오.", "minimumOsVersion": "16.6", "bundleId": "com.gps-speed.Gps-Speed6161-a-cuspart-deneme", "userRatingCount": 0}]}