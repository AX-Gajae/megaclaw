ar", "iPadPro13M4-iPadPro13M4", "iPadPro13M4Cellular-iPadPro13M4Cellular", "iPhone16-iPhone16", "iPhone16Plus-iPhone16Plus", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "averageUserRatingForCurrentVersion": 3.34211, "averageUserRating": 3.34211, "languageCodesISO2A": ["EN"], "fileSizeBytes": "110743552", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 38, "trackContentRating": "4+", "trackCensoredName": "AI 원카드", "trackViewUrl": "https://apps.apple.com/kr/app/ai-%EC%9B%90%EC%B9%B4%EB%93%9C/id6456793607?uo=4", "minimumOsVersion": "12.0", "contentAdvisoryRating": "4+", "sellerUrl": "http://mujaedal.com/", "artistId": 1700604441, "artistName": "MINSEUNG LEE", "genres": ["게임", "카드", "캐주얼"], "price": 0.0, "bundleId": "com.Mujaedal.AIOneCard", "genreIds": ["6014", "7005", "7003"], "isVppDeviceBasedLicensingEnabled": true, "releaseDate": "2023-08-03T07:00:00Z", "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "MINSEUNG LEE", "trackId": 6456793607, "trackName": "AI 원카드", "currentVersionReleaseDate": "2023-12-29T07:06:14Z", "releaseNotes": "커스텀 규칙 저장 기능(프리셋) 추가\n프로필 사진 변경 추가\n채팅 이모지 추가\n카드 정렬 기능 추가\n기타 버그 수정", "version": "5.1.2", "wrapperType": "software", "currency": "KRW", "description": "+ 게임 방법\n\n‘AI 원카드’는 참가자들이 각자 카드 5장을 가지고 게임을 시작하여 가지고 있는 카드를 모두 규칙에 따라 내게 되면 승리하는 게임입니다.\n\n카드는 터치한 상태로 끌어다 놓는 방식으로 낼 수 있습니다.\n\n자신의 낼 수 있는 카드를 모두 내면 ‘턴종료’ 버튼을 눌러 자신의 차례를 마쳐야합니다.\n\n기본적으로 숫자(2 ~ 10), 알파벳 문자(A, J, Q, K), 문양(하트, 다이아, 스페이드, 클로버)이 같은 카드를 낼 수 있으며 숫자나 알파벳 문자가 같으면 계속해서 낼 수 있습니다. 단 문양이 같은 카드는 한 번만 낼 수 있습니다.\n\n공격카드와 특수카드 등을 사용할 수 있어 게임이 더욱 즐겁습니다.\n\n공격카드에는 2, A, 조커카드 이렇게 3종류가 있습니다. 공격카드의 방어는 더블 공격입니다. 즉 공격카드를 받은 사람이 다른 공격카드를 내는 것입니다. 2카드로 공격 받은 경우에는 다른 2카드로 A카드로 공격 받은 경우에는 다른 A카드로 더블 공격이 가능합니다. 단 2카드를 A카드로 받아 더블 공격하거나 A카드를 2카드로 받아서 더블 공격하려면 문양이 같아야 합니다. 예컨대 하트 2카드로 공격한 경우에 A카드로 더블 공격하려면 내려는 A카드는 하트 문양이어야 합니다. 조커 카드는 언제나 공격이나 더블 공격이 가능합니다. 흑백 조커카드는 스페이드 A카드와 컬러 조커카드로 더블 공격이 가능합니다. 컬러 조커카드의 공격은 흑백 조커카드로만 더블 공격이 가능합니다.\n\n특수카드에는 J, Q, K카드가 있습니다. J카드를 내면 다음 차례를 건너뛰게 됩니다. Q카드를 내면 게임의 진행 방향이 반대로 바뀝니다. K카드를 내면 한 번 더 카드를 낼 수 있는 기회가 주어집니다. 만약 낼 수 있는 카드가 없어서 카드를 내지 않고 ‘턴종료’ 버튼을 누르면 한 장의 카드가 추가됩니다.\n\n1, 2, 3등에게는 경쾌한 소리와 함께 금, 은, 동메달이 주어지며 4등에게는 상장이 주어집니다. 게임 중 20장 이상의 카드를 가지게 되면 폭발음과 함께 파산딱지를 받게 되는 수모를 겪으며 자신의 게임을 마치게 됩니다.\n\n자세한 게임 방법은 ‘AI 원카드’ 앱 내의 게임 방법을 참고하십시오. 게임 방법은 실제로 게임을 하면서 익히는 것이 좋습니다.\n\n+ 업데이트는 사용자들의 의견을 참고하여 최대한 빠르게 이루어지도록 노력하겠습니다.", "userRatingCount": 38}]}