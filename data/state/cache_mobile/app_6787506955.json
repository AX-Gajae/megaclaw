r11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/61/36/01/613601c5-6695-a7d9-cceb-b91c3734a80b/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "minimumOsVersion": "18.6", "averageUserRating": 0, "releaseNotes": "- bug fix on video player", "trackCensoredName": "xFileCrypt - Encrypted Storage", "trackViewUrl": "https://apps.apple.com/kr/app/xfilecrypt-encrypted-storage/id6787506955?uo=4", "contentAdvisoryRating": "4+", "artistId": 1705596895, "artistName": "K2 Labs", "genres": ["유틸리티", "생산성"], "price": 17000.0, "bundleId": "com.k2labs.xFileCrypt", "releaseDate": "2026-07-09T07:00:00Z", "primaryGenreName": "Utilities", "primaryGenreId": 6002, "trackId": 6787506955, "trackName": "xFileCrypt - Encrypted Storage", "sellerName": "K2 Labs FZE", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-22T19:55:54Z", "genreIds": ["6002", "6007"], "version": "1.0.4", "wrapperType": "software", "currency": "KRW", "description": "xFileCrypt is a private, encrypted file vault for your most sensitive photos, videos, and documents. Every file is locked with AES-256-GCM encryption the moment it enters the app and stays encrypted at rest. Nobody can read your files without your PIN, not even us.\n\nHow it works\nWhen you import a file, xFileCrypt encrypts it on your device before writing anything to disk. Your original filename, folder structure, and file content are all sealed inside an encrypted container. Files are stored under random names with no connection to the originals. There is no server, no account, and no way to recover your data without your recovery phrase.\n\nYour key, your vault\nYour encryption key is derived from a 12-word recovery phrase generated on your device. The phrase is shown once at setup and never stored anywhere. Lose it and the vault cannot be recovered. Keep it safe and your files are protected forever, on any device.\n\nPIN protection with lockout\nAccess is protected by a 6-digit PIN you choose independently of your device passcode. After failed attempts the app enforces escalating lockouts: 2 minutes, then 10 minutes, then 2 hours. After that, only your recovery phrase can restore access.\n\nOptional Dropbox backup\nConnect your personal Dropbox account to back up your encrypted vault to the cloud. Dropbox receives only random-looking binary blobs with no filenames or folder structure. Even with full Dropbox access, nobody can tell what is inside. Restore your entire vault to a new device in one tap.\n\nBuilt-in file editor\nCrop and rotate photos without ever exporting them. Trim videos to the exact clip you want. Crop videos to any region of the frame. Every edit is re-encrypted and saved back to the vault. Your files never leave the app in plaintext.\n\nWhat xFileCrypt protects\nPersonal photos and videos you do not want in your camera roll\nSensitive documents, contracts, and IDs\nPrivate notes and recordings\nAnything you would not want someone to find if they picked up your phone\n\nTechnical specs\nCipher: AES-256-GCM\nKey derivation: PBKDF2-SHA512, 2,048 iterations\nRecovery: 12-word BIP39 mnemonic (128-bit entropy)\nKey storage: iOS Keychain, device-only\nCloud: optional Dropbox backup, end-to-end encrypted\nRequires iOS 18.6 or later", "averageUserRatingForCurrentVersion": 0, "languageCodesISO2A": ["EN"], "fileSizeBytes": "10451968", "formattedPrice": "￦17,000", "userRatingCountForCurrentVersion": 0, "trackContentRating": "4+", "userRatingCount": 0}]}