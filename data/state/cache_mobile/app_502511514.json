 Accompany\n\tTannoy\n\tTraction Sound\n\tTurbosound\n\tTW Audio", "languageCodesISO2A": ["EN"], "fileSizeBytes": "17396736", "formattedPrice": "￦4,400", "userRatingCountForCurrentVersion": 0, "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 0, "userRatingCount": 0}]}