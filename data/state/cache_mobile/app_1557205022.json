b.jpg", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/99/93/a5/9993a5a6-252b-4794-9ac2-a41d3bf841b4/094b75dc-97a4-4c62-a170-40594223b889_6_Ucd94_Ucc9c_Ud56d_Uacf5_Uad8c_Ud0d0_Uc0c9_Uc870_Uac74.jpg/392x696bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource116/v4/49/d5/55/49d555d1-70ba-8516-d5c8-3db6e29c1f5e/2d05229c-271d-46a0-b2b0-692516769ebf_7_Ucd94_Ucc9c_Ud56d_Uacf5_Uad8c_Ud0d0_Uc0c9_Uacb0_Uacfc.jpg/392x696bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/PurpleSource112/v4/69/63/ed/6963ed52-cb8e-88c0-b003-2c49ba5e8635/c5dc8667-ae1e-4dee-b950-c240b94733f7_8_Ube14_Ub85c_Uadf8.jpg/392x696bb.jpg"], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "trackCensoredName": "Meta On Meta", "trackViewUrl": "https://apps.apple.com/kr/app/meta-on-meta/id1557205022?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 3.30769, "bundleId": "com.metaonmeta.application", "price": 0.0, "trackId": 1557205022, "trackName": "Meta On Meta", "genreIds": ["6003"], "primaryGenreName": "Travel", "primaryGenreId": 6003, "releaseDate": "2021-04-07T07:00:00Z", "currentVersionReleaseDate": "2026-01-07T00:36:06Z", "isVppDeviceBasedLicensingEnabled": true, "sellerName": "Metaonmeta Co.,Ltd.", "releaseNotes": "구석 구석 버그를 수정했습니다.", "version": "3.11", "wrapperType": "software", "currency": "KRW", "description": "항공권 검색의 끝판왕, 메타온메타!\n메타 온 메타(Meta On Meta)에서는 한번 입력한 검색 조건으로 구글/스카이스캐너에서 항공권을 검색하고 저장할 수 있다. 내가 저장한 항공권은 어제랑 같은 가격인지 언제든지 터치 한번으로 가격 다시 확인할 수 있다. 어디가 가장 싼지 터치 한번으로 사이트 마다 다시 검색할 수 있으며, 항공권의 가격 변화를 그래프로 확인할 수 있다. 내가 찾은 항공권과 비슷하면서 더 싸고 좋은 항공권을 자동으로 추천한다. 추천 항공권 탐색 탭에서는 특가 항공권, 에러 패어, 초저가 다구간 항공권들을 볼 수 있다.\n\n메타온메타는 회원제 집단지성 항공 탐색 서비스다.\n기본 서비스는 무료이고 다른 회원이 검색한 항공권을 보기 위해서는 이용권을 구입하고 이용한다.\n\nMetaOnMeta에서는 항공권만 찾아도 돈을 벌 수 있다.\n회원들이 결제한 이용권 금액의 일정 비율을 회원들에게 돌려주는 방식으로 리워드 시스템을 운영하기 때문이다.\n내가 검색한 항공권을 다른 회원이 보면 실시간으로 포인트가 쌓이고, 쌓인 포인트는 익월 초 MoM 캐시로 전환되며, MoM 캐시가 1만원 이상 모이면 언제든지 출금 가능하다.\n바쁘면 집단지성의 도움을 받고, 항공 검색이 재미있다면 틈틈이 검색해서 도움도 주고 돈도 번다.", "sellerUrl": "https://www.metaonmeta.com/", "minimumOsVersion": "13.0", "languageCodesISO2A": ["EN"], "fileSizeBytes": "27081728", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 26, "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 3.30769, "artistId": 1557205024, "artistName": "주식회사 메타온메타", "genres": ["여행"], "userRatingCount": 26}]}