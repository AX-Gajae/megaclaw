d": 6747925463, "trackName": "melotap", "currentVersionReleaseDate": "2026-01-11T23:28:27Z", "genreIds": ["6014", "7011", "6016", "7003"], "primaryGenreName": "Games", "primaryGenreId": 6014, "version": "1.3", "wrapperType": "software", "currency": "KRW", "description": "melotap is a calm, musical rhythm game designed for relaxation and flow.\n\nEnjoy a clean and minimal rhythm experience focused on melody. Choose from a variety of melodic tracks, including calming classical and folk pieces. There are more than 80 hand-arranged tracks, with new tunes added weekly to keep things fresh and enjoyable.\n\nEach level is carefully arranged with natural fingering, making every tap feel satisfying and giving you the sense of really playing the music.\n\nWith simple gameplay, soft visuals, and beautiful hand-drawn illustrations, Melotap is designed to be both enjoyable to listen to and beautiful to look at.\n\nMelotap is calm and meditative but offers enough challenge to keep you focused. Like learning an instrument, it is relaxing but playing well feels rewarding.\n\nFeatures:\n• Handcrafted rhythm levels with classical and folk tunes\n• More than 80 tracks with new tunes added weekly\n• Clean, minimal design with hand-drawn illustrations\n• Smooth and satisfying taps with subtle haptics\n• Relaxing and engaging with just the right level of challenge\n\nDownload Melotap and enjoy a rhythm game that is calm, musical, and thoughtfully designed.", "trackCensoredName": "melotap", "trackViewUrl": "https://apps.apple.com/kr/app/melotap/id6747925463?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 0, "userRatingCount": 0}]}