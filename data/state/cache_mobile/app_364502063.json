_source.png/392x696bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/75/66/da/7566da4c-86c1-0383-9f41-ba693c191f06/pr_source.png/392x696bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/1e/49/3c/1e493cf7-0b6b-531c-2a58-77832adcdd06/pr_source.png/392x696bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/85/34/b6/8534b6cd-2e4a-b078-5a74-a3beba466f9a/pr_source.png/392x696bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple113/v4/65/f0/89/65f089cb-de3f-5953-bdd4-c68d7dd0dacb/pr_source.png/392x696bb.png"], "ipadScreenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/17/a5/f4/17a5f4bf-70d9-617f-f592-79b3877ef871/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/e3/a5/38/e3a53835-4e15-c17b-3e0f-0325d87ae04f/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/91/4c/e1/914ce152-2b0b-0101-3a95-947bfcd6bd3c/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/a9/d7/6b/a9d76ba4-df28-f590-2232-aa7f45fa5d09/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/01/c3/7c/01c37ce2-0b90-0915-238c-0eb6e067a010/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/8c/60/e4/8c60e4b4-1353-e139-bade-cf30a4e6850b/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/44/18/8e/44188e79-2d18-5e05-b6d1-1d42daa92389/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple124/v4/0c/25/ca/0c25cafb-23fe-fedd-3614-7c381bd2d3a7/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/ee/0f/1b/ee0f1b97-6c4d-867a-e5bb-abb3610a2ddd/pr_source.png/576x768bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple114/v4/22/ef/cb/22efcbe6-0aa3-c7f1-7993-8c06d9366d63/pr_source.png/576x768bb.png"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple123/v4/65/4c/e3/654ce352-faec-7822-29e3-dc99635581d1/AppIcon-0-1x_U007emarketing-0-0-GLES2_U002c0-512MB-sRGB-0-0-0-85-220-0-0-0-10.png/512x512bb.jpg", "contentAdvisoryRating": "4+", "trackCensoredName": "PDF Reader Pro Edition®", "trackViewUrl": "https://apps.apple.com/kr/app/pdf-reader-pro-edition/id364502063?uo=4", "averageUserRating": 4.7, "minimumOsVersion": "10.0", "isVppDeviceBasedLicensingEnabled": true, "price": 3300.0, "genres": ["비즈니스", "생산성"], "trackName": "PDF Reader Pro Edition®", "trackId": 364502063, "primaryGenreName": "Business", "primaryGenreId": 6000, "genreIds": ["6000", "6007"], "currentVersionReleaseDate": "2019-06-25T13:41:49Z", "releaseNotes": "• 특히 새로운 iPhone 및 iPad Pro 용으로 설계된 완전히 새로운 사용자 인터페이스.\n• iOS 12에 최적화되었습니다.\n• iPhone Xs, Xr 및 새로운 iPad Pro 지원.\n• 성능 향상. 이 업데이트에는 안정성 향상 기능이 포함되어 있습니다.\n• 더 나은 성능을 위해 업데이트되었습니다.\n• 버그 수정 및 성능 향상.", "version": "9", "wrapperType": "software", "currency": "KRW", "description": "**Tabby Awards 최고의 iPad – 생산성/문서 앱 부문수상**\n\nPDF Reader Pro Edition은 PDF 파일을 읽고, 관리하며 주석을 다는 가장 강력한 앱으로서, iOS12에서 아주 잘 작동합니다.\niPad에 최적화된 최고의 모바일 PDF reader.\niPad를 위해 특별히 제작된, 정말 강력하고 최적화된 PDF reader 엔진.\n\n최신 업데이트로, PDF 파일을 실시간으로 공유 및 공동 작업을 할 수 있습니다.\n애플사 @work 캠페인의 일부입니다.\n\nPDF Reader Pro Edition의 뛰어난 기능 중 일부는 다음과 같습니다:\n\n-  실시간 온라인 공동 작업 및 채팅.\n인터넷을 통해 실시간으로 동일한 파일을 다른 사용자와 공동 작업하고 주석을 추가할 수 있으며, 동시에 진행 상황에 대해 채팅을 할 수 있습니다.\n여러분이 변경하는 내용을 다른 사용자가 실시간으로  볼 수 있습니다.\n\n-  새로운 EasyReview 모드-\n\n이 놀라운 새 기능으로 이전보다 훨씬 빠르고 쉽게 PDF 문서를 손질할 수 있습니다. 변경할 필요가 있는 텍스트의 일부를 탭해서 문서 편집기(Word와 유사)에서 수정하기만 하면 됩니다. 쉽게 식별할 수 있도록 텍스트는 삭제 표시가 되고 새 텍스트는 다른 색상으로 나타납니다. PDF파일을 저장하면 모든 변경 사항은 표준 주석으로 나타납니다(텍스트 교체 및 텍스트 삽입 주석).\n\n-  PDF 양식 지원\nPDF 양식을 iPad에서 직접 작성할 수 있습니다.\n\n-  전체 주석/하이라이트 지원\niPad에서 직접 문서의 아무 곳에나 메모를 추가할 수 있습니다.\n형광펜, 스탬프, 스티커 메모, 텍스트 상자, 밑줄, 취소선, 동적 스탬프(날짜 및 시간), 프리핸드 그리기, 서명, 자유 형광펜, 선, 화살표, 직사각형과 타원, Apple Preview 및 Adobe Acrobat과 완벽 호환.\n\n-  iOS 12과 아주 잘 병합하도록 특별히 디자인된 완전히 새로운 사용자 인터페이스.\n\n-  (피닉스 대학 전자책 등) Vitrium*의 보호를 받는 PDF 파일을 지원하는 유일한 모바일 PDF Reader 응용 프로그램.\n\n-  새 PDF 파일 만들기\nPDF 파일의 페이지를 발췌해서 이메일을 보내거나 기존 파일의 페이지를 사용해서 새 문서를 만듭니다.\n\n-  공유 및 공동 작업\n공동 작업자 및 친구와 연결해서 PDF 파일과 주석을 실시간으로 공유 및 공동 작업을 할 수 수 있습니다.\n\n-  회전 기능\n한 페이지나 전체 문서를 회전할 수 있습니다.\n\n-  보관함 폴더\n중요한 PDF 파일을 안전하게 저장할 수 있습니다.\n\n-  북마크/개요\nPDF 파일의 페이지에 북마크를 할 수 있습니다.\niPad에서 직접 개요를 추가해서 문서의 목차를 만들거나 수정할 수 있습니다.\n\n-  리플로우 모드.\n\n-  웹에서 PDF 파일을 다운로드하기 위한 화면전체 웹 브라우저.\n\n-  스캐너\n여러 페이지의 문서를 PDF 포맷으로 만들 수 있습니다.\n\n-  문서 관리자\n문서를 복사, 잘라내기, 붙이기, 삭제할 수 있습니다.\n\n-  PDF 하이퍼핑크 지원\n문서 내에서 앞뒤로 건너뛰어 이동할 수 있습니다.\n원래 페이지로 신속하게 돌아갈 수 있는 뒤로 점프 버튼.\n\n-  텍스트 검색\nPDF 파일 상의 어떤 단어도 쉽게 찾을 수 있습니다.\n\n-  이메일 첨부파일 저장\n메일 앱에서 직접 첨부파일을 열거나, 다음에서 열기 기능을 사용해서 iPad에 있는 기타 다른 응용프로그램에서 PDF 파일을 열 수 있습니다.\n\n-  Safari에서 PDF 파일 다운로드\n다음에서 열기 기능을 사용해서 Safari에서 PDF Reader Pro Edition으로 PDF 파일을 다운로드할 수 있습니다.\n\n-  파일 전송\nAirdrop, USB 또는 WiFi 공유 기능을 사용하여 Mac 또는 PC에서 쉽고 안전하게 PDF 파일을 복사 할 수 있습니다.\n\n-  인쇄\nPDF 파일 및 주석을 앱에서 직접 인쇄할 수 있습니다.\n\n-  파일 이메일 전송\nPDF 파일을 앱에서 직접 이메일로 보낼 수 있습니다. 전체 문서를 주석과 함께 보내거나 PDF 파일의 특정 페이지만 보낼 수도 있습니다. PDF 파일의 병합 복사본을 보낼 수도 있습니다. 이 옵션은 문서에 있는 주석을 압축 및 병합해서 수정할 수 없게 합니다.\n\n-  클라우드 지원\nPDF 파일을 iCloud, Dropbox, Box.net, Google Drive 및 SugarSync에 다운로드/업로드할 수 있습니다.\n\n-  프리젠테이션에 아주 좋습니다\nAirPlay나 HDMI  케이블을 사용해서 문서에 주석을 다는 동안 실시간으로 외부 디스플레이에 보여줄 수 있습니다.\n\nPDF Reader Pro Edition의 모든 훌륭한 기능을 이미 즐기고 있는 수십만의 사용자와 함께 하세요. \n\n더 놀라운 기능이 곧 나옵니다!!", "averageUserRatingForCurrentVersion": 4.7, "languageCodesISO2A": ["EN", "FR", "DE", "IT", "JA", "KO", "PT", "RU", "ZH", "ES", "ZH"], "fileSizeBytes": "69447680", "formattedPrice": "￦3,300", "userRatingCountForCurrentVersion": 10, "trackContentRating": "4+", "sellerUrl": "http://www.pdf-reader-pro-edition.com", "artistId": 298779208, "artistName": "iTECH DEVELOPMENT SYSTEMS INC.", "sellerName": "iTECH DEVELOPMENT SYSTEMS INC.", "releaseDate": "2010-04-01T22:54:03Z", "bundleId": "pdfreader.ipad.app", "userRatingCount": 10}]}