ular", "iPhone16-iPhone16", "iPhone16Plus-iPhone16Plus", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "kind": "software", "features": ["iosUniversal"], "sellerUrl": "https://www.fifthstarlabs.com", "averageUserRatingForCurrentVersion": 4.85046, "languageCodesISO2A": ["NL", "EN", "FR", "DE", "IT", "JA", "KO", "PT", "RU", "ZH", "ES", "SV", "ZH"], "fileSizeBytes": "470631424", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 2715, "trackContentRating": "4+", "trackCensoredName": "스카이 가이드", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%8A%A4%EC%B9%B4%EC%9D%B4-%EA%B0%80%EC%9D%B4%EB%93%9C/id576588894?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 4.85046, "genreIds": ["6006", "6017"], "artistId": 451087546, "artistName": "Fifth Star Labs LLC", "genres": ["참고", "교육"], "primaryGenreName": "Reference", "primaryGenreId": 6006, "isVppDeviceBasedLicensingEnabled": true, "sellerName": "Fifth Star Labs LLC", "trackId": 576588894, "trackName": "스카이 가이드", "currentVersionReleaseDate": "2026-07-23T14:13:56Z", "releaseNotes": "+ 심우주 기호\n설정에서 이 토글을 사용하면 하늘 뷰에서 은하, 성운, 성단을 강조하여 표시합니다.\n\n+ 시야각 회전 미리보기\n더욱 흥미로운 구도를 위해 하늘 뷰에서 천체 사진 시야각 회전을 실시간으로 미리 보세요.\n\n+ 좌표 선택기\n적경/적위, 고도-방위각, 은하 좌표계 간에 빠르게 전환하려면 좌표를 탭하세요.", "version": "12.2.1", "wrapperType": "software", "currency": "KRW", "description": "별의 아름다움을 지구에서 직접 체험해 보세요. 머리 위에서 스카이 가이드®를 잡고 있으면 별, 별자리, 행성 또는 위성을 자동으로 식별합니다! 사용하기 쉽고 강력하며, 환상적인 별 관측 경험을 즐길 수 있습니다!\n\n저게 별일까요, 아니면 화성일까요? 밤하늘에 있는 것이 무엇인지 이제 그 어느 때보다도 더 쉽게 알 수 있습니다. 스카이 가이드의 AR 모드는 형상들을 실제 하늘 위에 겹쳐서 표현하므로 하늘의 모습을 더 쉽게 이해할 수 있습니다. 별자리를 알아보고 싶은데 종이로 된 별자리표는 번거로워서 사용하고 싶지 않으세요? 이제는 문제 없습니다.\n\n한 줄기의 빛이 밤하늘을 가로지르며 점점 더 밝아집니다. 도대체 뭘까요? 이젠 더 이상 궁금해 할 필요가 없습니다. 반짝이는 위성을 추적하세요. 국제 우주 정거장이 여러분이 계신 장소 위를 비행하려고 할 때 완벽하게 알림을 받으세요. 스카이 가이드와 함께라면 '잘 가, 외계인' 그리고 '안녕, 우주 비행사'를 외치게 될 겁니다!\n\n영화 같은 시간 컨트롤 기능으로 과거와 미래로 여행하세요. 늦은 밤 달이 어디에 떠 있을지 정확히 파악하여 완벽한 사진을 찍거나, 역사상 가장 위대한 혜성의 목격자가 되어 보세요.\n\n궁수자리, 토성, 다음 번 거대 유성우 등 무엇을 찾든지 풍부한 정보와 그래픽을 자랑하는 스카이 가이드가 여러분의 호기심을 충족시켜 드립니다. 또한, 스카이 가이드의 맞춤형 캘린더를 통하여 일식, 월식과 같은 위치 기반 이벤트에 대한 최신 정보를 받으세요.\n\n비행기에서 창가쪽 좌석에 앉아 계세요? 오지에서 캠핑을 하시나요? 스카이 가이드는 언제든 작동합니다. 스카이 가이드는 Wi-Fi, 데이터 통신, GPS가 없어도 작동하므로 어디를 가든 손 안에서 모든 걸 파악할 수 있습니다.\n\n\n구독 옵션:\n\n스카이 가이드 PLUS\n더 많은 탐색 가능.\n\n우주는 거대하고, 신인 우주 탐험가를 위한 필수 기능을 갖춘 스카이 가이드 PLUS는 더 많은 것을 보여 줍니다. PLUS는 우주에 대한 체험을 한 단계 업그레이드합니다.\n\n\n스카이 가이드 PRO\n최고의 모바일 천문 경험.\n\n스카이 가이드 PLUS가 여러분의 호기심을 자극한다면 스카이 가이드 PRO는 여러분을 압도할 수 있습니다. 이 버전은 PLUS의 모든 기능을 갖추고 있으며, 수준 높은 천문학 애호가를 위한 강력한 기능이 추가되어 있습니다.\n\n\n스카이 가이드로 별들과 좀 더 친숙한 인연을 쌓은 수백 만명의 사용자와 함께하세요. 회원님의 하늘을 보는 태도가 영원히 바뀔 수도 있습니다.\n\n\n이용 약관: https://www.fifthstarlabs.com/terms-of-use", "bundleId": "com.fifthstarlabs.skyguide", "minimumOsVersion": "18.0", "releaseDate": "2013-05-06T19:45:52Z", "price": 0.0, "userRatingCount": 2715}]}