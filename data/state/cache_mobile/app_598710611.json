://is1-ssl.mzstatic.com/image/thumb/Purple7/v4/15/07/70/15077086-9896-4693-3342-a908cb90fc4b/pr_source.jpg/480x360bb.jpg", "https://is1-ssl.mzstatic.com/image/thumb/Purple7/v4/37/cf/90/37cf909c-d6f7-6621-aba8-d8fea3b9fd65/pr_source.jpg/480x360bb.jpg"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple115/v4/a5/75/21/a575210b-8387-ec57-a58d-90dc01384ac8/AppIcon-1x_U007emarketing-0-0-GLES2_U002c0-512MB-sRGB-0-0-0-85-220-0-0-0-8.png/512x512bb.jpg", "minimumOsVersion": "9.0", "contentAdvisoryRating": "9+", "trackCensoredName": "이집트 세네트 (고대 이집트 게임)  신비한 사후 여행", "trackViewUrl": "https://apps.apple.com/kr/app/%EC%9D%B4%EC%A7%91%ED%8A%B8-%EC%84%B8%EB%84%A4%ED%8A%B8-%EA%B3%A0%EB%8C%80-%EC%9D%B4%EC%A7%91%ED%8A%B8-%EA%B2%8C%EC%9E%84-%EC%8B%A0%EB%B9%84%ED%95%9C-%EC%82%AC%ED%9B%84-%EC%97%AC%ED%96%89/id598710611?uo=4", "averageUserRating": 4.125, "artistId": 598710614, "artistName": "Mohamed Ezzat", "genres": ["게임", "보드", "교육", "카드"], "price": 3300.0, "isVppDeviceBasedLicensingEnabled": true, "releaseDate": "2013-02-09T23:22:56Z", "primaryGenreName": "Games", "primaryGenreId": 6014, "currentVersionReleaseDate": "2021-05-24T19:46:12Z", "releaseNotes": "+ Added Support For Latest iOS, and Enhanced Devices Compatibility.", "sellerName": "Mohamed Ezzat", "genreIds": ["6014", "7004", "6017", "7005"], "trackName": "이집트 세네트 (고대 이집트 게임)  신비한 사후 여행", "trackId": 598710611, "version": "1.1.0", "wrapperType": "software", "currency": "KRW", "description": "======  수상 ====== \n◆ 2013 이집트 e-컨텐츠 어워드 1등 수상작.\n◆ 2013 W3 어워드 은상 수상작.\n◆ 2012 이집트 게임 콘테스트 우승작. \n◆ 전자 오락&게임부문 2013 월드 서밋 어워드 후보로 지명됨.\n\n\n이집트 세네트 (고대 이집트 게임)\n신비한 사후 여행 - 파라오 투탕카멘 왕이 가장 좋아하던 취미 \n황금관과 석관 옆의 투탕카멘 왕의 무덤에서 발견된 세계에서 가장 오래된 보드 게임 유물\n\n미라의 입을 열어주는 의식을 거행한 후에, 테베(룩소르) 건너편 나일 강 서쪽 둑의 킹즈 밸리로 더 잘 알려진 곳 근처에 있는 퀸즈 밸리의 숨겨진 무덤 내부에서 보이지 않는 적에 도전하며 오시리스의 지하 세계를 통과하는 내세 여행을 시작하게 됩니다.\n\n세네트는 선 왕조 및 고대 이집트로부터 이어져온 보드 게임으로 , 초창기에는 주사위 놀이, 체커 및 체스 게임으로 알려진 기록이 있습니다. 세네트 게임의 시기를 나타내는 BC 3500년 경의 가장 오래된 상형 문자. 이집트어로 게임의 전체 이름은 \"패싱 게임\"을 의미했습니다.\n\n수천년 동안 게임이 있어왔지만, 대략 3500~5000년 전에 이집트인들에 의해 창안된 고대 게임인 세네트 보다 더 오래 된 게임은 없습니다. 이 2인용 보드 게임은 귀족과 농민들 모두에게 인기 있는 오락의 형태로 유래된 것으로 보여집니다. 하지만 BC 13세기 중반에, 세네트는 좀 더 종교적인 의식으로 발전했습니다. 이 기간에 대한 일부 묘사들은 이 게임이 두 사람이 아닌, 영혼을 가진 죽은 플레이어가 보이지 않는 적과 경쟁하며 플레이한다는 것을 보여줍니다.\n\n사후에 지옥 층을 통해 영혼이 이동하는 것 처럼 말이 보드를 이동하며 보드는 내세에 대한 메타포가 되었습니다. 사후에 호루스에 도달하고 지옥을 탈출하는 것이 이집트인들의 목표였던 것처럼 마지막 칸에 도달하여 보드를 탈출하는 것이 이 게임의 목표입니다.\n\n이집트 세네트는 행운과 전략을 결합한 도전적인 게임이고, 고대 이집트 사원의 실제 사진, 예술적으로 제작된 그래픽과 울림이 있는 무덤 같은 공간에 놓여진 고대 스톤 게임 보드 및 조각 애니메이션을 특징으로 합니다. 제례 음악에 움직이는 돌 조각 음향 효과가 더해져 선 왕조 시대 이집트의 분위기를 재현해 줍니다.", "bundleId": "EgyptianSenet", "languageCodesISO2A": ["NL", "EN", "FR", "DE", "IT", "JA", "KO", "PT", "RU", "ZH", "ES", "ZH"], "sellerUrl": "https://ezzatstudios.github.io", "averageUserRatingForCurrentVersion": 4.125, "fileSizeBytes": "62980096", "formattedPrice": "￦3,300", "userRatingCountForCurrentVersion": 8, "trackContentRating": "9+", "userRatingCount": 8}]}