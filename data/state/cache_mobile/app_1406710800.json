12/0edf1230-3f6e-fbb3-7f72-f2aa844d100a/AppIcons-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "features": ["gameCenter", "iosUniversal"], "trackCensoredName": "Stardew Valley", "trackViewUrl": "https://apps.apple.com/kr/app/stardew-valley/id1406710800?uo=4", "contentAdvisoryRating": "12+", "averageUserRating": 4.73078, "artistId": 1620477446, "artistName": "ConcernedApe", "price": 7700.0, "trackId": 1406710800, "trackName": "Stardew Valley", "releaseDate": "2018-10-23T15:26:39Z", "genreIds": ["6014", "6016", "7014", "7015"], "sellerName": "ConcernedApe LLC", "primaryGenreName": "Games", "primaryGenreId": 6014, "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-03-19T00:31:54Z", "releaseNotes": "버그 수정 .", "version": "1.6.15.1", "wrapperType": "software", "currency": "KRW", "description": "각종 수상 경력에 빛나는 농장 RPG에서 농촌으로 떠나 새로운 삶을 경험해 보세요! 50시간 이상의 게임플레이 컨텐츠와 자동 저장 기능 및 다양한 컨트롤 설정 등 모바일에 최적화된 기능이 추가되었습니다.\n\n**Golden Joystick 혁신상 수상**\n**BAFTA Games Awards 2017년 올해의 게임 후보**\n___\n\n내가 꿈꾸던 농장을 만들어 보세요:\n\n■ 웃자란 초원을 생명이 넘치는 농장으로 바꿔 보세요\n\n■ 행복한 동물들을 키우고 다양한 계절 곡물을 심고 내 방식대로 농장을 꾸며 보세요\n\n■ 농부와 집을 꾸며 보세요! 수백 가지 아이템을 선택할 수 있답니다\n\n■ 12명의 상대 중의 한 명과 정착해 가정을 꾸릴 수도 있습니다\n\n■ 계절별로 열리는 축제와 마을 주민 퀘스트를 통해 지역사회의 일부가 되어 보세요\n\n■ 다양하고 신비로운 동굴을 탐험하면서 위험한 몬스터와 보물을 만나 보세요\n\n■ 낚시터에서 느긋한 오후를 보내거나 바닷가에서 꽃게잡이를 즐겨보세요\n\n■ 사료를 만들고 곡식을 기르고 수제품을 생산해 맛있는 요리를 만들어 보세요\n\n■ iOS상의 터치 스크린 게임플레이를 위해 모바일판 한정으로 자동 선택 기능과 농기구를 빠르게 전환하는 기능 및 광산에서 몬스터를 빨리 해치울 수 있는 자동 공격 기능 등이 추가되었습니다.\n\n■ 자동 저장 기능으로 하던 게임을 그대로 이어서 플레이 하세요.(앱을 종료해도 저장됩니다!)\n\n■ 터치 스크린, 가상 조이스틱, GameVice, MFI 서포트 등 다양한 컨트롤 설정으로 내게 편한 방식으로 게임을 즐겨 보세요.\n\n■ 한국어 게임 내 완벽 지원\n\n■ 이제 '두 손가락으로 확대' 기능을 지원합니다 \n\n■ 싱글플레이어 콘텐츠 최신 업데이트 - 새로운 마을 업그레이드와 연애 이벤트, 작물, 낚시터, 모자, 의상, 새로운 애완동물이 포함되어 있습니다! 게다가 이게 전부가 아닙니다...\n___\n\n\"최고의 스타듀 밸리는 항상 가지고 다닐 수 있는 버전이다... 이 게임은 정말 멋지고 여러분을 실망시키지 않을 것이다.\" - TouchArcade\n\n\"그저 단순한 농장 게임이 아니다...끝없는 콘텐츠와 마음으로 가득하다.\" Giant Bomb\n\n\"스타듀 밸리는 지난 수 년간 플레이해 본 게임 중 가장 풍부하고 마음이 따뜻해지는 경험을 선사했다.\" CG Magazine\n\n\"스타듀 밸리는 농장 시뮬레이션과 RPG 요소를 아름답게 융합해 매력적이고 몰입감 있는 농촌 세계를 만들어냈다.\" IGN\n\n\"농촌의 삶이 이렇게 만족스럽고 가깝게 느껴진 적이 있을까\" The Telegraph\n___\n\n**버전 1.6 업데이트를 통해 스토리 컨텐츠가 업데이트 되었습니다. 멀티플레이어 기능은 아직 지원하지 않습니다\n***인앱 구매 없음", "sellerUrl": "https://stardewvalley.net/", "averageUserRatingForCurrentVersion": 4.73078, "userRatingCountForCurrentVersion": 24827, "languageCodesISO2A": ["EN", "FR", "DE", "HU", "IT", "JA", "KO", "PT", "RU", "ES", "TR"], "fileSizeBytes": "463694848", "formattedPrice": "￦7,700", "trackContentRating": "12+", "minimumOsVersion": "13.0", "bundleId": "com.chucklefish.stardewvalley", "genres": ["게임", "엔터테인먼트", "롤플레잉", "시뮬레이션"], "userRatingCount": 24827}]}