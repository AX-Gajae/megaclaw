honeAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "features": [], "artistViewUrl": "https://apps.apple.com/kr/developer/dark-dome/id1875297665?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9e/e3/bb/9ee3bb96-f8ef-1eb1-ad73-fa7b4df6757a/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/9e/e3/bb/9ee3bb96-f8ef-1eb1-ad73-fa7b4df6757a/AppIcon-0-0-1x_U007emarketing-0-0-0-10-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/100x100bb.jpg", "sellerUrl": "http://darkdome.com", "languageCodesISO2A": ["AR", "BN", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HI", "HU", "ID", "IT", "JA", "KO", "NB", "FA", "PL", "PT", "RO", "RU", "ZH", "ES", "SV", "TE", "TH", "ZH", "TR", "UR", "VI"], "fileSizeBytes": "88206336", "formattedPrice": "￦4,400", "userRatingCountForCurrentVersion": 2, "trackContentRating": "12+", "averageUserRatingForCurrentVersion": 5, "artistId": 1875297665, "artistName": "Dark Dome", "genres": ["게임", "어드벤처", "퍼즐"], "price": 4400.0, "releaseDate": "2026-03-13T07:00:00Z", "trackId": 6758866520, "trackName": "Haunted Laia", "genreIds": ["6014", "7002", "7012"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "Dark Dome Studios SAC", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-05-12T14:13:12Z", "releaseNotes": "게임 플레이 경험 향상을 위해 소소한 조정이 이루어졌습니다.", "version": "3.0", "wrapperType": "software", "currency": "KRW", "description": "새로운 가족이 히든 타운(Hidden Town)에 이사 왔지만, 입주한 날부터 집 안에서 정체불명의 존재들에게 괴롭힘을 당하기 시작합니다. 며칠 후, 그들은 아무런 흔적도 남기지 않고 사라졌습니다. 무슨 일이 있었을까요? 그들은 어디로 간 걸까요? 라이아를 도와 미스터리를 풀고 그녀의 실종 뒤에 숨겨진 비밀을 밝혀내세요.\nHaunted Laia는 Hidden Town 이스케이프 룸 게임 시리즈의 다섯 번째 에피소드입니다. 이 포인트 앤 클릭 퍼즐 게임에서, 당신은 자신의 기억 속을 탐험하며 어떻게 이곳에 오게 되었는지 알아내고, 가족을 구출해 집으로 돌아가기 위해 탈출해야 합니다.\nDark Dome의 이스케이프 룸 게임은 원하는 순서대로 플레이할 수 있습니다. 모든 이야기는 서로 연결되어 있으며, 점차 Hidden Town의 모든 비밀이 밝혀집니다. 이 공포 미스터리 게임은 The Ghost Case와 Another Shadow와도 연결되어 있습니다.\n이 서스펜스 스릴러 게임에서 만나게 될 요소들:\n라이아의 집, 동굴, 그리고 빨간 문 뒤의 방 곳곳에 배치된 수많은 퍼즐과 두뇌 게임.\n잊을 수 없는 주인공이 등장하는 긴장감 넘치는 몰입형 추리 스토리.\n깊이 있는 사운드트랙과 어우러진 독특하고 인상적인 그래픽 스타일로, 공포 미스터리 어드벤처에 완전히 몰입할 수 있습니다.\n숨겨진 업적: 게임 전체에 숨겨진 10마리의 도마뱀을 모두 찾아보세요. 매우 교묘하게 숨겨져 있으니 구석구석 탐색하세요.\n완성도 높은 힌트 시스템. 진행이 막힐 경우 언제든지 힌트를 사용해 스토리를 이어갈 수 있습니다.\n프리미엄 버전: 프리미엄 버전을 구매하면 Hidden Town의 추가 스토리를 담은 독점 비밀 장면을 플레이할 수 있으며, 더 많은 퍼즐과 수수께끼가 포함되어 있습니다. 또한 모든 광고가 제거되어 광고 없이 모든 힌트를 바로 사용할 수 있습니다.\n플레이 방법: 터치하여 환경 속 사물과 캐릭터와 상호작용하세요. 숨겨진 아이템을 찾고, 인벤토리 아이템을 사용하거나 조합해 새로운 아이템을 만들어 모험을 계속하세요. 당신의 추리력을 시험하고 미스터리 사건을 해결하세요.\n미스터리 사건 해결: 공포의 퍼즐을 완성하라 사건의 중심으로 깊이 들어가 당신의 탐정 능력을 시험해 보세요. 모든 단서는 진실에 한 걸음 더 다가가게 하지만, 방심은 금물입니다. 어둠이 당신을 집어삼키기 전에 탈출 퍼즐을 풀 수 있을까요?\n“Dark Dome 이스케이프 룸 게임의 수수께끼 같은 이야기 속으로 빠져들어 모든 비밀을 밝혀내세요. Hidden Town에는 아직 풀리지 않은 미스터리가 많이 남아 있습니다.”", "minimumOsVersion": "12.0", "averageUserRating": 5, "contentAdvisoryRating": "12+", "trackCensoredName": "Haunted Laia", "trackViewUrl": "https://apps.apple.com/kr/app/haunted-laia/id6758866520?uo=4", "bundleId": "com.darkdome.haunted.laia", "userRatingCount": 2}]}