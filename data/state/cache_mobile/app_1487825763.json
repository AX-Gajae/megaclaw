me": "Great Detail Ltd", "isVppDeviceBasedLicensingEnabled": true, "genres": ["스포츠", "스포츠", "시뮬레이션", "게임"], "price": 0.0, "genreIds": ["6004", "7016", "7015", "6014"], "releaseDate": "2020-04-18T07:00:00Z", "trackName": "Awesome Golf Simulator", "trackId": 1487825763, "sellerName": "Great Detail Ltd", "currentVersionReleaseDate": "2026-06-24T12:49:46Z", "version": "3.10.2", "wrapperType": "software", "currency": "KRW", "description": "**** Supported Launch Monitors **** \n- Bushnell Launch Pro and LPi\n- FlightScope Mevo Gen2, Mevo Plus and above \n- Foresight GC3, GC3S, GCQuad, QuadMAX, GCHawk and Falcon\n- Garmin Approach R10 and Approach R50\n- Rapsodo MLM2PRO\n- Square Golf\n \n**** Device Requirements **** \n- For the best experience, this app needs access to the internet. For FlightScope owners, this means having both WiFi and mobile data enabled. \n- This product will work without an internet connection, but some features (e.g. Stats Tracking, Leaderboards, Competitions) will be unavailable. \n \nGolf really is awesome!  \n \nUsing one of the supported launch monitors, Awesome Golf takes shot tracking and golf simulators to an awesome new level. Step onto the tee and play unique golf courses, splash into shark-infested swimming pools, take on nearest the pin and long drive challenges, or even blow up a boat or two, if you’re quick enough! \n  \nAs well as its iconic games modes, Awesome Golf offers a state-of-the-art practise facility. The intuitive interface allows you select your club and analyse an unprecedented amount of data – all on one screen. Watch as your shots are traced from the moment they leave the clubface with instant feedback. This accurate, reliable, ball flight tracing delivers an unrivalled experience with data parameters available on every key club and ball statistic. Give yourself the insights for progressive analysis and development. \n  \nWhether you are a golfer, non-golfer, a gamer, or an avid player, Awesome Golf gives you everything you want – all on one screen.     \n \nUse in conjunction with the Awesome Golf Community app to have a record of all your session stats on your mobile phone. Every app download plants one tree with Ecologi. \n \nTerms of Service \nhttps://www.awesome-golf.com/TermsOfService.html \n \nPrivacy Policy \nhttps://www.awesome-golf.com/PrivacyPolicy.html", "languageCodesISO2A": ["EN", "FR", "DE", "IT", "JA", "KO", "PT", "ZH", "ES"], "fileSizeBytes": "1630954496", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 11, "trackContentRating": "4+", "sellerUrl": "http://www.awesome-golf.com", "averageUserRatingForCurrentVersion": 4.81818, "primaryGenreName": "Sports", "primaryGenreId": 6004, "bundleId": "com.greatdetail.AGS-Suite", "userRatingCount": 11}]}