r-iPadAir13M4Cellular"], "features": ["iosUniversal"], "advisories": [], "kind": "software", "artistViewUrl": "https://apps.apple.com/kr/developer/gro-play/id575995023?uo=4", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/0d/ee/66/0dee6672-6f7a-99d0-59c9-ea8e94f4a727/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/0d/ee/66/0dee6672-6f7a-99d0-59c9-ea8e94f4a727/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/100x100bb.jpg", "screenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/86/70/bb/8670bb81-a6cb-e6dd-9ac8-b70be91c894d/pr_source.png/406x228bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/17/b2/4e/17b24eb1-9d5f-675c-569c-b6add68be619/pr_source.png/406x228bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/2f/5d/33/2f5d334a-8d76-4fd7-e76e-b4f172c7a2a5/pr_source.png/406x228bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/27/27/09/272709ec-acee-a44a-702d-7bc8adbbafe4/pr_source.png/406x228bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/80/b3/48/80b34859-a356-7fbe-69e8-9e0580501a10/pr_source.png/406x228bb.png"], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/0d/ee/66/0dee6672-6f7a-99d0-59c9-ea8e94f4a727/AppIcon-0-0-1x_U007emarketing-0-0-0-7-0-0-sRGB-0-0-0-GLES2_U002c0-512MB-85-220-0-0.png/512x512bb.jpg", "bundleId": "com.groplay.grorecycling", "price": 6600.0, "artistId": 575995023, "artistName": "Gro Play", "genres": ["게임", "가족", "음악", "교육"], "trackId": 663552636, "trackName": "Grow Recycling", "primaryGenreName": "Games", "primaryGenreId": 6014, "genreIds": ["6014", "7009", "7011", "6017"], "isVppDeviceBasedLicensingEnabled": true, "releaseDate": "2013-06-27T07:00:00Z", "currentVersionReleaseDate": "2024-02-14T22:28:00Z", "releaseNotes": "* 새로운 앱 아이콘\n* 더 작은 앱 크기\n* 향상된 성능", "version": "1.2.4", "wrapperType": "software", "currency": "KRW", "description": "** Grow Recycling는 미국과 유럽 내 수천 개의 학교와 유치원에서 환경보호 교육을 위해 사용되고 있습니다! **\n\n쓰레기 맛을 본 적이 있나요?\n당연히 없겠죠. 하지만 어떤 친구들에겐 오래된 신발 상자나 빈 깡통도 정말 맛있답니다! 멋진 우리의 분리수거함에게 매일 쓰레기를 주세요. 하지만 누가 어떤 쓰레기를 좋아할까요? 다양한 쓰레기를 주면서 누가 어떤 쓰레기를 좋아하는지 알아보세요. 분리수거함의 반응을 보면 각 캐릭터들이 선호하는 쓰레기를 알아낼 수 있을 겁니다.\n\n하지만 이렇게 모인 쓰레기는 전부 어디로 갈까요? 흥이 넘치는 재활용 기계와 함께 놀면서 직접 분류하고 모은 쓰레기로 새로운 제품을 만들어 보세요. 레버를 당기고, 버튼을 클릭하고, 톱니바퀴를 돌리고, 음악에 맞춰 신나게 놀아 보세요. 레모네이드 병, 잼 병, 파인애플 통 등 다양하고 편리한 제품을 만들어보세요. 토끼 반자 친구들을 위해 소풍을 계획했는데, 당신도 초대되었답니다!\n\n소풍에 남은 음식과 쓰레기는 허기진 분리수거함에게는 맛있는 간식이랍니다. 다시 분리수거함을 찾아가서 다시 한 번 분리수거를 시작하세요!\n\nGROW RECYCLING은 놀면서 재활용에 대해 배울 수 있는 순환 어린이 앱입니다. 재미있는 놀이 앱이지만, 아이들과 부모들이 지구의 자원을 아끼고 사랑하는 법을 가르쳐주는 교육적인 앱이기도 합니다.\n\n특징\n?? 각기 독특한 개성을 지닌 9가지 분리수거함 캐릭터\n?? 6가지 재활용 기계 (각자 개성 넘치는 음악 보유)\n?? 100가지가 넘는 쓰레기\n?? 언어 제한 없음\n?? 어린이 친화적인 인터페이스\n?? 직접 손으로 제작한 환경\n?? 앱 내 구매 없음\n?? 타 업체 광고 없음\n\nOMEP 세계 회장을 역임하고 UNESCO에서 유아교육 및 친환경 개발 분야 회장인 Ingrid Pramling Samuelsson은 “Gro Play는 어린이들에게 환경보호에 대한 기초 지식을 경험할 기회를 제공합니다.”라고 평했습니다.\n\nGro Play의 CEO이자 공동 창업자인 Patricia Richter는 “놀이는 가장 즐거운 교육 방식일 뿐만 아니라, 가장 강력한 교육 방식이기도 합니다. 저희는 어린이와 부모들에게 즐거운 시간을 선사하면서 영감을 불어넣어주고자 합니다. 우리 모두가 함께 힘을 모으면 더욱 친환경적인 사회를 만들 수 있을 것입니다.”라고 말했습니다.\n\nGRO PLAY 정보\n저희는 스웨덴 스톡홀름에 위치하여 친환경 교육 장난감, 게임, 앱을 제공하는 독립 창작 스튜디오입니다.\n\n구독\n페이스북: http://www.facebook.com/GroPlay \n인스타그램: http://www.instagr.am/GroPlay \n트위터: http://www.twitter.com/GroPlay \n웹사이트: http://www.GroPlay.com", "trackCensoredName": "Grow Recycling", "trackViewUrl": "https://apps.apple.com/kr/app/grow-recycling/id663552636?uo=4", "contentAdvisoryRating": "4+", "sellerUrl": "https://www.groplay.com/apps/gro-recycling/", "languageCodesISO2A": ["AR", "DA", "EN", "FI", "FR", "DE", "JA", "KO", "NB", "PT", "RU", "ZH", "ES", "SV"], "fileSizeBytes": "129451008", "formattedPrice": "￦6,600", "userRatingCountForCurrentVersion": 1, "trackContentRating": "4+", "averageUserRating": 5, "minimumOsVersion": "12.0", "averageUserRatingForCurrentVersion": 5, "sellerName": "Gro Play Digital AB", "userRatingCount": 1}]}