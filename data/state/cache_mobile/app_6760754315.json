PadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/1e/1a/ff/1e1aff74-c00f-dff6-5144-491cf85f5a38/AppIcon-1x_U007emarketing-0-8-0-sRGB-85-220-0.png/512x512bb.jpg", "averageUserRating": 4.53143, "contentAdvisoryRating": "12+", "trackCensoredName": "꿈의 여행자: 별빛 여정", "trackViewUrl": "https://apps.apple.com/kr/app/%EA%BF%88%EC%9D%98-%EC%97%AC%ED%96%89%EC%9E%90-%EB%B3%84%EB%B9%9B-%EC%97%AC%EC%A0%95/id6760754315?uo=4", "releaseNotes": "1. 새로운 스토어 이미지 및 게임 아이콘\n2. 게임 성능 최적화", "price": 0.0, "trackId": 6760754315, "trackName": "꿈의 여행자: 별빛 여정", "genreIds": ["6014", "7014"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "HONG KONG TANYOU LIMITED", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-14T07:00:00Z", "version": "2.0", "wrapperType": "software", "currency": "KRW", "description": "환상적인 꿈의 대륙을 바탕으로 구현된 힐링의 판타지 세계.\n당신은 ‘별빛 여행자’로서 잊힌 전설을 찾고, 사도의 조각을 모으며\n광활한 오픈월드 속에서 당신만의 모험 여정을 떠나보세요.\n\n▣ 게임 소개 ▣\n■ 손쉽고 짜릿한 타격감 이빠이!\n\"가벼운 터치로 터지는 화려한 이펙트! 초보자도 순식간에 마스터하는 짜릿한 액션!\"\n\"수호자 변신 순간, 스킬 세트가 완전히 뒤바뀐다! 한방컷의 남다른 타격감의 정상!\"\n\n■ 귀여운 펫과 함께, 설레는 발걸음!\n\"내 곁을 따르는 깜찍한 펫과 함께라면 걷는 것만으로도 설렌다! 산책도 모험이 되는 순간!\"\n\"광활한 오픈월드, 귀요미 펫들의 깜짝 순간! 캐주얼하지만 결코 심심하지 않은 여정!\"\n\n■ 함께하는 모험, 운명 같은 만남!\n\"실시간 파티 플레이, 던전을 함께 뚫다 보면 어느새 운명 같은 동료가 되어 있다!\"\n\"게임 속에서 시작된 인연, 파티원에서 소울메이트로! 함께라서 더 특별한 MMORPG!\"\n\n■ 5대 직업, 자유로운 전직의 재미!\n\"지루할 틈 없는 직업 체험의 끝판왕! 원하는 직업 수시로 전환 가능!\"\n\"전직은 자유롭게! 언제든 새로운 길을 열 수 있다. 당신의 선택이 당신을 만든다.\"\n\n■ 지루할 틈 없는 다채로운 라이프 콘텐츠!\n\"싸움만? 지루해! 요리부터 보물 찾기, 포획까지 – 살아 숨 쉬는 라이프 콘텐츠로 하루가 짧다.\"\n\"포획, 낚시, 요리, 그리고 숨겨진 보물 탐색! 모험가의 하루는 다채롭게 펼쳐진다.\"\n\n[필수권한]\n저장공간(기기사진, 미디어, 파일) 엑세스 허용\n- 게임을 실행하는데 필요한 파일을 단말기에 저장하기 위해 이 권한이 필요합니다.\n- 리소스 다운로드를 위해 SD카드 쓰기/읽기권한을 요청합니다.\n- 저장공간(기기사진, 미디어, 파일) 엑세스 권한에 저장소를 사용할 수 있는 권한이 포함되어 있으며, 해당 권한이 없을 때 게임 이용에 필요한 정보를 읽기/쓰기가 불가능하여 권한이 필요합니다.\n\n- 공식라운지: https://game.naver.com/lounge/DreamTraveler/home", "minimumOsVersion": "15.6", "languageCodesISO2A": ["EN", "KO", "ZH", "ZH"], "fileSizeBytes": "581612544", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 350, "trackContentRating": "12+", "bundleId": "com.dreamwalker.kr.ios", "averageUserRatingForCurrentVersion": 4.53143, "releaseDate": "2026-07-14T07:00:00Z", "artistId": 1778586532, "artistName": "HONG KONG TANYOU LIMITED", "genres": ["게임", "롤플레잉"], "userRatingCount": 350}]}