하세요.\n\n맞춤 설정: 반구 조정과 같은 설정으로 MOON을 선호도에 맞게 조정하여 개인화된 경험을 보장하세요.\n\n멋진 시각적 효과: 달 표면의 경이로움을 기기로 가져오는 아름다운 애니메이션, 계층적 우주 경관을 즐기세요.\n\n별 하프 기능: 상호 작용적인, 천체 별 하프 경험을 위해 흔들어 보세요.\n\n포괄적 지원: MOON은 iOS 12+를 위해 제작되었으며 iPhone, iPad, Apple Watch를 완벽하게 지원하여 모든 기기에서 원활한 사용자 경험을 보장합니다.\n\n달의 변화와 함께 최신 상태를 유지하세요. MOON은 달의 규칙적인 패턴과 연결되어 있습니다. 유용한 알림과 단순한 인터페이스로 달을 따라가는 쉽고 매력적인 방법을 즐기세요. MOON은 단순한 앱이 아니라, 달의 매혹적인 세계로의 쉬운 접근입니다.\n\n서비스 약관: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/\n개인정보 처리방침: https://moonapp.me/privacy.html", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 530, "trackContentRating": "4+", "trackCensoredName": "MOON - Current Moon Phase", "trackViewUrl": "https://apps.apple.com/kr/app/moon-current-moon-phase/id660036257?uo=4", "contentAdvisoryRating": "4+", "sellerUrl": "https://moonapp.me", "languageCodesISO2A": ["EN", "FR", "DE", "IT", "KO", "PT", "RU", "ZH", "ES"], "averageUserRatingForCurrentVersion": 4.62453, "averageUserRating": 4.62453, "fileSizeBytes": "150304768", "trackName": "MOON - Current Moon Phase", "trackId": 660036257, "genreIds": ["6001", "6002"], "isVppDeviceBasedLicensingEnabled": true, "price": 0.0, "userRatingCount": 530}]}