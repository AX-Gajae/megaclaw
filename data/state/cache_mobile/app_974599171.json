r", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "trackCensoredName": "Mimpi Dreams", "trackViewUrl": "https://apps.apple.com/kr/app/mimpi-dreams/id974599171?uo=4", "contentAdvisoryRating": "9+", "averageUserRating": 4.77712, "sellerUrl": "http://mimpi-dreams.com", "languageCodesISO2A": ["EN"], "fileSizeBytes": "161219584", "formattedPrice": "￦1,100", "userRatingCountForCurrentVersion": 839, "trackContentRating": "9+", "averageUserRatingForCurrentVersion": 4.77712, "artistId": 483227571, "artistName": "Silicon Jelly s.r.o.", "genres": ["게임", "퍼즐", "엔터테인먼트", "어드벤처"], "price": 1100.0, "primaryGenreName": "Games", "primaryGenreId": 6014, "genreIds": ["6014", "7012", "6016", "7002"], "releaseDate": "2016-03-17T10:02:09Z", "trackId": 974599171, "trackName": "Mimpi Dreams", "sellerName": "Silicon Jelly s.r.o.", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2018-09-23T16:20:33Z", "releaseNotes": "- Memory optimization\n- Loading optimization\n- Fixed other small problems in Mars level\n- Tweaks in first five levels\n- Fixed a few problems with achievements\n- Fix missing Achievements in Game Center.\n- Fixed 95% of crashes on old IOS devices.", "version": "6.1", "wrapperType": "software", "currency": "KRW", "description": "PocketGamer.com 8/10:\n\"나는 얼굴에 미소를 지으면서 플레이해요.\n즐거운 경험이에요...\"\nHarry Slater\n\nMimpi는 모든 것에 오줌을 싸서, 개가 하는 것처럼 그의 꿈 영역을 표시합니다.\n7개의 그림 세계 환경을 처리함으로써 친구들을 구하도록 그를 돕습니다.\n일부 퍼즐 요소로 모험과 플랫포머의 혼합입니다.\nMimpi Dreams은 캐주얼한 게임이며, 강력한 도전을 기대하지 않고, 이 게임을 즐겁게 마치실 바랍니다.\n\n특징\n● 개의 꿈을 과학적으로 아주 정확한 현실적인 시뮬레이터 :)\n● 플랫포머, 퍼즐 및 모험을 조합한 캐주얼한 게임 플레이\n● 탐험할 6+1개의 다른 세계: 리톱스 숲, 테슬라 풍경, 병 해변, 동화 및 중세 성!\n● 수상 경력이 있는 오리지널의 속편 - 예, Mimpi 1 있음\n\nMimpi 소개\nMimpi는 많이 자는 걸 좋아하는 게으른 강아지입니다.\n그의 꿈에서, 그는 구출하거나 구조가 필요한 누구든지 구출하고 구조하는 개영웅이 됩니다.\n잃어버린 해적선이 되고, 해방되고자 하는 실험용 쥐 또는 용에 의래 갖힌 공주이 되십시오. Mimpi 영웅이 구하고자 여기에 있습니다.\n물론, Mimpi는 사이드킥없이 이를 실시할 수 없으며 그것은 당신입니다!\n\nMimpi와 당신은 그의 꿈의 매이커입니다.\nMimpi의 꿈을 이뤄 그가 영웅이 되도록 도우십시오. Mimpi가 레벨을 통과하고, 퍼즐을\n 풀도록 허용하기 위해 장애물을 이동하고, 그의 꿈에서 생물체들과 대화하도록 Mimpi를\n 도우십시오.\n\n팔로우\nFacebook에서 Mimpi의 팬이 되고 최신 업데이트를 획득하십시오:\n www.facebook.com/TheRealMimpi", "bundleId": "com.siliconjelly.mimpi2", "minimumOsVersion": "9.0", "userRatingCount": 839}]}