s", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "averageUserRatingForCurrentVersion": 4.25345, "sellerUrl": "https://ninetysixpercent.com/", "minimumOsVersion": "15.0", "languageCodesISO2A": ["EU", "EN", "JA", "KO", "ZH", "ZH"], "fileSizeBytes": "1280001024", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 797, "trackContentRating": "12+", "trackCensoredName": "던전슬래셔", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%8D%98%EC%A0%84%EC%8A%AC%EB%9E%98%EC%85%94/id1620305888?uo=4", "contentAdvisoryRating": "12+", "averageUserRating": 4.25345, "artistId": 1620305890, "artistName": "gihyeon lim", "genres": ["게임", "액션", "어드벤처"], "price": 0.0, "bundleId": "com.nspgames.dungeonslasher", "releaseDate": "2022-05-18T07:00:00Z", "genreIds": ["6014", "7001", "7002"], "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "gihyeon lim", "trackId": 1620305888, "trackName": "던전슬래셔", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-28T07:52:46Z", "releaseNotes": "버그를 수정하였습니다.", "version": "0.770.4", "wrapperType": "software", "currency": "KRW", "description": "먼 과거 세계를 정복하고자 하는 '네크로맨서 아듄'과 아듄에 맞서 세상을 지키고자 하는 용사가 있었습니다.\n그 용사는 최후의 최후까지 아듄에게 맞서 싸웠으나 결국 봉인되고 말았죠.\n오랜 시간이 지난 지금 봉인에서 깨어날 시간이에요 용사님.\n가슴속에 품은 작은 불씨를 지펴 잃어버린 힘을 되찾아 아듄을 쓰러뜨리고 세상의 빛을 되찾아주세요.\n\n\n\n===============================================\n\n\n\n▣소개▣\n\n\n\n이전까지의 모바일 게임은 잊어라!\nPC, 콘솔 게임에서만 느끼던 재미를 모바일에서!\n언제 어디서나 쉽게 즐기는 횡스크롤 액션 로그라이크!\n\n다양한 플레이어블 캐릭터, 화려한 스킬과 유물을\n연구하고 조합하며 수많은 스테이지를 클리어하세요!\n\n\n\n===============================================\n\n\n\n▣특징▣\n\n\n\n【횡스크롤 로그라이크】\n\n\n\n매일 똑같이 반복되는 지겨운 게임들이 질리지 않으신가요?\n각양각색의 스킬과 다양한 유물들을 연구하고 조합해 보세요!\n\n이제껏 경험해 본 적 없는 새로운 재미를 느끼실 수 있습니다.\n나만의 조합을 이용하여 앞에 펼쳐진 시련들을 극복하세요!\n\n\n\n\n\n【다이나믹한 2D 액션】\n\n\n\n고퀄리티 픽셀 그래픽으로 만들어진 짜릿한 액션을 체험하고 싶으신가요?\n각 스테이지의 특징을 담은 개성 넘치는 보스들과 강력한 히든 보스!\n\n여러 보스의 고난도 패턴들을 파악하고 돌파하며,\n공략과 컨트롤의 재미를 체험해 보세요!\n\n\n\n\n\n【다양한 캐릭터와 무기들, 귀여운 펫과 코스튬】\n\n\n\n대충 만든 캐릭터, 외형만 화려한 무기에 실망한 적 있으신가요?\n다채로운 매력을 보유한 플레이어블 캐릭터와 강력한 전용 무기들을\n나만의 조합에 추가하여 더욱 강해진 캐릭터를 체험하실 수 있습니다!\n\n전투를 도와주는 귀여운 펫들과 취향을 저격하는 코스튬을 착용하여,\n나의 모험에 새로운 재미를 더하여 보세요!\n\n\n\n\n\n【극한에 도전하라! 도전모드】\n\n\n\n매판 랜덤으로 변경되는 맵과 몬스터들을 과연 극복할 수 있을까요?\n용사를 막아서는 위험한 함정들과 더욱 강력해진 몬스터들!\n\n더욱 어려워진 던전을 클리어하고 특별한 보상을 획득하며,\n플레이어블 캐릭터의 한계를 돌파하고 숨겨진 능력을 획득하세요!\n\n\n\n\n\n【성장을 통한 더욱 다채로운 RPG플레이】\n\n\n\n무궁무진한 성장의 재미를 느껴보고 싶으신가요?\n수많은 던전을 클리어하고 보상을 획득하고 성장하며,\n더욱 강하고 다채로운 플레이를 체험하세요!\n\n\n아듄과의 전쟁에서 패배한 후 아듄이 점령하며 잔혹해진 세상\n여러분들이 이 세상의 깨어난 용사가 되어주세요!\n\n\n\n\n===============================================\n◈공식 카페: https://cafe.naver.com/dungeonslasher\n◈공식 유튜브 : https://www.youtube.com/channel/UCEmLz43Im9YyD92cVJbUWMg\n◈공식 트위터 : https://x.com/DungeonSlasher0?s=20\n◈공식 디스코드 : https://discord.gg/h7vRxjW6qm\n===============================================", "userRatingCount": 797}]}