r-iPadAir13M4Cellular"], "features": ["iosUniversal"], "advisories": [], "kind": "software", "screenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/0d/f9/ae/0df9ae65-1ebb-5a7b-6e96-fb120edd56ce/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/60x60bb.jpg", "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/0d/f9/ae/0df9ae65-1ebb-5a7b-6e96-fb120edd56ce/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/512x512bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/0d/f9/ae/0df9ae65-1ebb-5a7b-6e96-fb120edd56ce/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/100x100bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/easybrain-ltd/id1190815537?uo=4", "ipadScreenshotUrls": [], "minimumOsVersion": "15.0", "artistId": 1190815537, "artistName": "Easybrain Ltd", "genres": ["게임", "보드", "퍼즐", "엔터테인먼트"], "price": 0.0, "trackId": 1505735640, "trackName": "킬러 스도쿠 by Sudoku.com", "genreIds": ["6014", "7004", "7012", "6016"], "bundleId": "com.easybrain.sudoku.killer", "releaseDate": "2020-08-06T07:00:00Z", "sellerName": "Easybrain Ltd", "isVppDeviceBasedLicensingEnabled": true, "primaryGenreName": "Games", "primaryGenreId": 6014, "currentVersionReleaseDate": "2026-07-22T08:22:09Z", "releaseNotes": "- 성능 및 안정성 향상.\n\n킬러 스도쿠를 즐기셨으면 합니다. 게임을 더 재밌게 즐기실 수 있도록 몇 가지 기능을 향상했습니다. 저희는 모든 리뷰를 주의 깊게 확인합니다. 이 게임을 좋아하시는 이유 또는 개선됐으면 하는 점들을 피드백으로 남겨주세요. 킬러 스도쿠 으로 두뇌를 활발하게 유지하세요!", "version": "4.4.0", "wrapperType": "software", "currency": "KRW", "description": "중독성 있는 킬러 스도쿠 퍼즐을 즐겨보세요! 한층 강화된 게임성으로 수많은 퍼즐을 풀며 즐겁게 두뇌를 자극하세요!\n\nSudoku.com 개발팀이 새롭게 선보이는 두뇌 훈련 퍼즐에 도전해보세요!\n\nSudoku.com의 킬러 스도쿠는 초보자와 숙련자 모두가 즐길 수 있는 게임입니다. 클래식 스도쿠보다는 어렵지만, 실력과 상관없이 모든 플레이어가 즐길 수 있도록 접근성을 높였습니다. 강화된 게임성으로 어렵지 않게 게임 규칙을 따라가다 보면 금세 스도쿠 마스터가 될 수 있을 것입니다. 킬러 스도쿠를 통해, 연필과 종이를 사용하던 클래식한 스도쿠 퍼즐을 색다른 느낌으로 플레이해보세요.\n\n특징:\n\n* 스도쿠를 색다른 방법으로 플레이해볼 수 있는 킬러 스도쿠 퍼즐\n* 수천 개에 달하는 레벨\n* 특별한 트로피를 받을 수 있는 일일 도전\n* 특별한 메달을 받을 수 있는 시즌 이벤트\n* 난관에 봉착했을 때 도움이 되는 힌트와 메모\n* 두뇌를 자극하는 다양한 게임플레이\n* 탁월한 실력을 갖춘 개발팀의 신작!\n\n게임 방법:\n\n* 모든 행과 열, 3x3의 공간을 클래식 스도쿠와 똑같이 채워야 합니다.\n* 모든 셀은 점선으로 표시되는 도형의 일부입니다.\n* 도형 안의 각 셀에 들어가는 숫자의 합은 각 도형 왼쪽 위에 있는 숫자와 같아야 합니다.\n* 각 행과 열, 3x3의 공간에 들어가는 모든 숫자의 합은 항상 45가 되어야 합니다.\n* 각 케이지나 행, 열, 3x3의 공간에는 똑같은 숫자가 반복될 수 없습니다.\n\n킬러 스도쿠의 세계에 빠져들어 보세요! 언제 어디서든 스도쿠를 즐기세요!", "averageUserRatingForCurrentVersion": 4.7964, "sellerUrl": "https://easybrain.com", "trackCensoredName": "킬러 스도쿠 by Sudoku.com", "languageCodesISO2A": ["AR", "EN", "FR", "DE", "HI", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "242827264", "formattedPrice": "무료", "contentAdvisoryRating": "12+", "userRatingCountForCurrentVersion": 19057, "trackViewUrl": "https://apps.apple.com/kr/app/%ED%82%AC%EB%9F%AC-%EC%8A%A4%EB%8F%84%EC%BF%A0-by-sudoku-com/id1505735640?uo=4", "trackContentRating": "12+", "averageUserRating": 4.7964, "userRatingCount": 19057}]}