x696bb.png"], "ipadScreenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/Purple91/v4/a9/32/45/a9324556-a960-1b54-0d99-f1251f61ddc6/pr_source.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/cf/9e/8a/cf9e8a80-652a-3119-1f16-22590c1abc01/pr_source.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple122/v4/93/e8/fe/93e8fe5c-1e24-901a-224a-ebf18066ef83/pr_source.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple111/v4/35/d8/75/35d87553-78e4-cd3b-36d5-61f7da0b9115/pr_source.png/552x414bb.png"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple126/v4/71/57/22/71572284-2bfa-c267-b825-9c4c1967088b/AppIcon-1x_U007emarketing-0-7-0-85-220.png/512x512bb.jpg", "averageUserRating": 2.33002, "contentAdvisoryRating": "17+", "userRatingCountForCurrentVersion": 303, "artistId": 406239141, "artistName": "CloudMosa, Inc.", "genres": ["유틸리티", "생산성"], "price": 7700.0, "genreIds": ["6002", "6007"], "bundleId": "com.cloudmosa.puffin", "releaseDate": "2010-12-13T03:26:13Z", "trackId": 406239138, "trackName": "Puffin Cloud Browser", "primaryGenreName": "Utilities", "primaryGenreId": 6002, "sellerName": "CloudMosa, Inc.", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2023-08-29T17:42:17Z", "releaseNotes": "1. Fix bugs.\n2. Support the latest iOS devices.\n3. Apply the features of Puffin Cloud Browser.", "version": "5.3.0", "wrapperType": "software", "currency": "KRW", "description": "Puffin 웹브라우저는 엄청나게 신속합니다. 일단 사용자가  Puffin을 사용하는 드릴을 경험하면, 보통의 핸드폰 인터넷은 마치 고문처럼 느껴집니다.  Puffin Pro 웹브라우저는 시리즈의 최상급의 버전이며.\n\n기막히게 빠르다: Puffin은 제원이 한정된 기기에서의 작업부하를 클라우드로 이전하여 모바일브라우징을 빠르게하며 제원요구성의 웹페이지는 전화기나 태블릿에서 초고속으로 작동합니다. \n\n클라우드 보호: Puffin서버로 가는 Puffin앱의 모든 트래픽은 암호화되어 근처의 해커로부터보호됩니다. Puffin을 통해 공공적 비보장성의 와이파이를 사용하는 데 안전하나 대부분의 브라우저에 대해서는 전혀 안전하지 않습니다. \n\n최고의 웹 게임 환경: 클라우드 서버를 지속적으로 개선하여 최상의 웹 게임 환경을 제공하고 있습니다.\n\n대역폭을 저장합니다: Puffin은 웹데이터를 기기에 전송하는 자신의 압축 알고리듬을 사용하며이는 통상의 웹브라우징 상에서 귀하의 대역폭의 90%까지 저장할 수 있습니다. (스트리밍 플래시컨텐츠나 동영상은 보통의 사용 대역폭보다 더 넓은 대역폭을 요구함을 주지하십시오.)\n\n특징: \n* 믿기지 않는 로딩 속도 \n* 클라우드를 통한 최고의 웹 게임 환경 \n* 전체적인 신규 탭 브라우징 \n* 클라우드로 다운로드(파일 당 1G 까지) \n* 극장모드 \n* 조정가능한 플래시 품질\n* 가상의 트랙패드(마우스 시뮬레이터) \n* 가상의 게임패드 \n* 툴바와 슬라이드바에 대한 색상 테마 \n* 가장 빠른 자바스크립트 엔진 \n* 전체적인 웹 경험(데스크톱 보기 및 핸드폰 보기)\n* 신규 가명 탭\n* Synchronize Chrome bookmarks automatically\n\n==== 제약 사항 ====\n* Puffin 웹브라우저의 데이터 센터는 미국 내에 위치하여 클라우드 서버는 미국 지리적 코드에서만 접근할 수 있습니다.\n* 미국 이외 지역의 사용자에 대해서는 로컬 컨텐츠, 특히 지역적 관심의 동영상이 귀국의 지역 제한으로 미국에서 접근이 가능하지 않을 수 있습니다.  \n보다 상세한 정보는, 자주 하는 질문난을 클릭하여 알아보세요: https://help.puffin.com/faq\n\n==== 권장 ====\n모든 사용자에 대해 전체 버전 구매 이전에 무상 버전을 시도해보시길 제안합니다.", "sellerUrl": "https://www.puffin.com", "trackContentRating": "17+", "averageUserRatingForCurrentVersion": 2.33002, "trackCensoredName": "Puffin Cloud Browser", "languageCodesISO2A": ["BN", "DA", "NL", "EN", "FR", "DE", "HI", "ID", "IT", "JA", "KO", "MS", "MR", "NB", "NN", "PL", "PT", "RU", "ZH", "ES", "SV", "TA", "TE", "TH", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "89110528", "formattedPrice": "￦7,700", "trackViewUrl": "https://apps.apple.com/kr/app/puffin-cloud-browser/id406239138?uo=4", "minimumOsVersion": "8.0", "userRatingCount": 303}]}