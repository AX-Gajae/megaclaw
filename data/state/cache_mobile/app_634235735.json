Quest 팀의 또 다른 수상작입니다. 우리는 Terry Cavanagh의 게임 매체와 장르 탐구에 대한 공헌을 기념하여 Duet을 “Hex-like”라고 칭할 것입니다.", "sellerUrl": "https://www.duetgame.com", "languageCodesISO2A": ["NL", "EN", "FR", "DE", "IT", "JA", "KO", "PT", "RU", "ZH", "ES", "ZH", "TR"], "fileSizeBytes": "116609024", "formattedPrice": "￦4,400", "userRatingCountForCurrentVersion": 130, "trackContentRating": "4+", "minimumOsVersion": "13.0", "averageUserRatingForCurrentVersion": 4.67692, "bundleId": "com.kumobius.duet", "averageUserRating": 4.67692, "trackCensoredName": "Duet Game", "trackViewUrl": "https://apps.apple.com/kr/app/duet-game/id634235735?uo=4", "contentAdvisoryRating": "4+", "genreIds": ["6014", "6016", "7001", "7003"], "artistId": 449069247, "artistName": "Kumobius", "userRatingCount": 130}]}