hone16Plus", "iPhone16Pro-iPhone16Pro", "iPhone16ProMax-iPhone16ProMax", "iPadMiniA17Pro-iPadMiniA17Pro", "iPadMiniA17ProCellular-iPadMiniA17ProCellular", "iPhone16e-iPhone16e", "iPadA16-iPadA16", "iPadA16Cellular-iPadA16Cellular", "iPadAir11M3-iPadAir11M3", "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "isVppDeviceBasedLicensingEnabled": true, "genres": ["게임", "보드", "퍼즐", "엔터테인먼트"], "price": 0.0, "trackId": 1452992954, "trackName": "Nonogram.com - 노노그램 숫자퍼즐 게임", "bundleId": "com.easybrain.nonogram", "releaseDate": "2019-04-28T03:04:11Z", "primaryGenreName": "Games", "primaryGenreId": 6014, "currentVersionReleaseDate": "2026-02-23T11:17:28Z", "releaseNotes": "- 성능 및 안정성 개선\n\n저희는 게임을 더욱 개선하기 위해 여러분의 모든 리뷰를 주의 깊게 확인하고 있습니다. 왜 저희 게임을 좋아하시는지와 어떤 점을 개선했으면 좋겠는지에 대한 피드백을 남겨주세요. Nonogram.com으로 정신을 활기차게 단련하세요!", "version": "5.24.0", "wrapperType": "software", "currency": "KRW", "description": "Nonogram.com은 방대한 픽처 크로스 퍼즐 컬렉션이 준비된 중독성 있는 로직 게임입니다. 노노그램은 단순하되 도전 정신을 자극하는 게임플레이로 다양한 연령층에서 인기를 얻었습니다. 전 세계의 플레이어와 함께 숫자 단서에 기반한 퍼즐을 풀고 숨겨진 그림을 발견하세요!\n\nNonogram.com에서는 다양한 난이도와 카테고리의 퍼즐 수천 가지를 만나 보실 수 있습니다. 퍼즐은 주기적으로 업데이트돼서 게임이 지루해지지 않죠. 노노그램을 막 시작한 플레이어든 노련한 플레이어든 기분 좋은 심심풀이로 즐길 수 있는 게임입니다. 노노그램 퍼즐을 풀며 정신을 단련하고 진정한 Nonogram.com의 달인이 되세요!\n\n노노그램은 바쁜 하루를 보내고 마음을 차분히 가라앉히기 좋은 수단이기도 합니다. 일과에서 벗어나 마음을 사로잡는 퍼즐의 세계로 뛰어드세요! 숫자 단서를 참고하며 백지에서 그림을 완성해 나가는 과정을 즐기세요.\n\n픽처 크로스 퍼즐을 푸는 기본 규칙과 논리부터 설명해 드리겠습니다.\n\n• 사각형을 색칠하고 숨겨진 그림을 드러내세요.\n• 단서와 숫자를 이용해 퍼즐을 푸세요.\n• 각 열의 위에 있는 숫자는 위에서 아래로 읽습니다.\n• 각 행의 왼쪽에 있는 숫자는 왼쪽에서 오른쪽으로 읽습니다.\n• 색을 칠하면 안 되는 사각형을 알아내면 X로 표시하세요.\n• 실수하면 추가 생명을 얻으세요.\n\nNonogram.com 특징:\n\n• 이미지가 반복되지 않는 다양한 노노그램 퍼즐을 색칠할 수 있습니다.\n• 시즌 이벤트: 여러 난이도의 노노그램을 풀어 기간 한정 이벤트를 완료하세요. 특별한 엽서를 모두 드러내고 수집해야 합니다. 업데이트를 확인하며 단 하나의 이벤트도 놓치지 마세요!\n• 일일 도전: 매일 퍼즐을 풀고 특별한 월간 트로피를 받으세요!\n• 토너먼트: 다른 플레이어와 경쟁하고 최대한 많은 노노그램 그림을 색칠하세요. 더 어려운 퍼즐을 골라 실력을 키우고 더 많은 점수를 얻으며 최고의 상품을 차지하세요!\n• 노노그램을 풀다가 막히면 힌트를 이용하세요.\n• 자동 크로스 기능으로 이미 모든 사각형을 알맞게 색칠한 줄의 그리드를 자동으로 채울 수 있습니다.\n\n노노그램은 한번 시작하면 배우기 쉽고 꽤 중독성 있는 퍼즐입니다. Nonogram.com으로 자신을 시험하며 재미있는 시간을 마음껏 즐기세요!", "languageCodesISO2A": ["AR", "EN", "FR", "DE", "HI", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "221393920", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 40790, "trackContentRating": "12+", "minimumOsVersion": "15.0", "trackCensoredName": "Nonogram.com - 노노그램 숫자퍼즐 게임", "trackViewUrl": "https://apps.apple.com/kr/app/nonogram-com-%EB%85%B8%EB%85%B8%EA%B7%B8%EB%9E%A8-%EC%88%AB%EC%9E%90%ED%8D%BC%EC%A6%90-%EA%B2%8C%EC%9E%84/id1452992954?uo=4", "contentAdvisoryRating": "12+", "sellerUrl": "https://easybrain.com", "averageUserRating": 4.7161, "averageUserRatingForCurrentVersion": 4.7161, "genreIds": ["6014", "7004", "7012", "6016"], "sellerName": "Easybrain Ltd", "artistId": 1190815537, "artistName": "Easybrain Ltd", "userRatingCount": 40790}]}