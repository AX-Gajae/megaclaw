, "iPadAir11M3Cellular-iPadAir11M3Cellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": ["https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/1b/6a/63/1b6a6366-188f-9fd4-0417-145d6a411172/f4581693-af0a-4d92-9014-2f1b0892efcf_iPad_-_01.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/d4/9f/44/d49f44d6-b871-9466-00b9-1d7941de14c1/b9f0445e-ad43-4e64-bbfb-f525f065f61a_iPad_-_02.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/15/0f/c2/150fc284-0d28-83dc-6939-f1373d18546d/c8b03151-3f80-485b-bc33-8e726ff63026_iPad_-_03.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/fa/d6/65/fad665fa-0a3e-58e8-5996-4df99ec6aac3/6793ddf9-52d7-4df2-bcce-b1e03533483c_iPad_-_05.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/db/7e/a6/db7ea6ec-3373-7980-7f97-fde37a7f865c/5bb3e761-b81d-4ba8-bc84-c0cfb0a4a8ca_iPad_-_09.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/13/b3/5a/13b35abe-7420-d4e0-4a72-4e657ef47a5a/b87ae1e9-e9f0-406b-95ec-abb678bcb96e_iPad_-_10.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/cb/ca/21/cbca2104-d210-ff59-bed9-4dff47e49156/53c66c8a-9447-48ee-97ca-2f9a17b09f05_iPad_-_08.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/44/55/e7/4455e798-06e7-42db-290d-370522a61b4d/c25deb03-1dd4-4232-84d7-37f08e677709_iPad_-_04.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/b8/e4/da/b8e4da75-5366-c22a-ef84-c4e0c9c82387/56d2c2ea-17e2-462c-bb7f-a369a3249e69_iPad_-_06.png/552x414bb.png", "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/ef/a4/a7/efa4a727-175e-08cf-312c-c637100e0366/66322885-4630-41f2-8c0e-d3bc222b4767_iPad_-_07.png/552x414bb.png"], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/dc/ce/4b/dcce4bb3-019a-e5d8-cd60-21b8c0dd101a/AppIconsFree-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg", "trackCensoredName": "Weather NOW: 날씨와 레이더 미세먼지 위젯 앱", "trackViewUrl": "https://apps.apple.com/kr/app/weather-now-%EB%82%A0%EC%94%A8%EC%99%80-%EB%A0%88%EC%9D%B4%EB%8D%94-%EB%AF%B8%EC%84%B8%EB%A8%BC%EC%A7%80-%EC%9C%84%EC%A0%AF-%EC%95%B1/id1371461117?uo=4", "contentAdvisoryRating": "4+", "averageUserRating": 4.65825, "minimumOsVersion": "17.6", "artistId": 302677215, "artistName": "DeluxeWare", "genres": ["날씨", "유틸리티"], "price": 0.0, "releaseDate": "2018-07-07T12:37:41Z", "bundleId": "deluxeware.Weather", "primaryGenreName": "Weather", "primaryGenreId": 6001, "trackId": 1371461117, "trackName": "Weather NOW: 날씨와 레이더 미세먼지 위젯 앱", "genreIds": ["6001", "6002"], "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-26T22:31:03Z", "releaseNotes": "• 앱 전반의 안정성과 반응성 향상\n• 버그 수정 및 전반적인 성능 개선\n\nWeather Now는 더욱 발전된 레이더 기술로 계속 진화하며, 전 세계의 비, 폭풍, 강수, 실시간 날씨를 더 정확하게 확인할 수 있도록 도와줍니다.", "version": "2.12.8", "wrapperType": "software", "currency": "KRW", "description": "Weather Now – 당신의 프리미엄 날씨 파트너\n\n날씨를 추측하지 마세요 — 하루를 직접 컨트롤하세요.\nWeather Now는 정확한 예보, 실시간 도플러 레이더, 생생한 실시간 비주얼, 그리고 중요한 날씨 정보를 손쉽게 확인할 수 있는 프리미엄 위젯을 제공합니다.\n\n더 똑똑하게 계획하고, 더 안전하게 여행하며, 맑은 하늘, 갑작스런 폭풍, 바람 변화 등 모든 순간을 즐기세요.\n\nWeather Now가 특별한 이유\n\t• 전 세계 어디서나 초정밀 시간별 및 14일 예보\n\t• 온도, 바람, 강수량, 폭풍을 보여주는 실시간 도플러 레이더\n\t• 실시간 날씨 레이어가 적용된 인터랙티브 3D 지구본\n\t• 프리미엄 위젯 – 홈 및 잠금 화면에 다양한 크기, 디자인, 레이아웃과 온도, 강수량, 바람, 시간별 추세 차트 포함\n\t• 기상 악화 전 신속한 경보\n\t• Apple Watch 지원 – 실시간 컴플리케이션과 즉각 업데이트\n\t• 스마트 제안이 포함된 초고속 도시 검색\n\n프리미엄으로 업그레이드 – 예보의 힘을 극대화하세요\n\t• 여러 전문 기상 데이터 소스로 최고의 정확도 제공\n\t• 전 세계 무제한 저장 위치\n\t• 실시간 레이더, 바람 흐름, 기압계, 구름, 강수량 등 지도 완전 접근\n\t• 전문가가 사용하는 전문급 폭풍 추적 도구\n\t• 아침 및 저녁 알림과 상세 일일 정보\n\n모든 상황에 적합\n\t• 야외 행사 계획? 비가 올 정확한 시점을 확인하세요.\n\t• 여행 중? 여정의 모든 지점 날씨를 추적하세요.\n\t• 등산이나 사진 촬영? 완벽한 조건을 포착하세요.\n\nApple Watch 준비 완료 – 손목에서 실시간 예보와 알림 확인.\n가족 공유 – 하나의 프리미엄 구독으로 가족 전체 이용 가능.\n\n구독 옵션\n\t• 1개월 – 단기 이용\n\t• 1년 (7일 무료 체험 포함) – 무제한 프리미엄 최고의 가치\n\n결제는 구매 시 Apple ID로 청구됩니다. 기간 종료 24시간 전까지 취소하지 않으면 자동 갱신됩니다. 계정 설정에서 언제든지 관리 및 취소 가능. 사용하지 않은 기간은 환불되지 않습니다.\n\n이용약관: weathernow.app/term-of-use.html\n개인정보처리방침: weathernow.app/privacy.html", "languageCodesISO2A": ["AR", "CA", "HR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HE", "HI", "HU", "ID", "IT", "JA", "KO", "MS", "NB", "PL", "PT", "RO", "RU", "ZH", "SK", "ES", "SV", "TH", "ZH", "TR", "UK", "VI"], "fileSizeBytes": "95989760", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 951, "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 4.65825, "sellerUrl": "https://www.weathernow.app", "sellerName": "Evgeny Tormozov", "userRatingCount": 951}]}