ellular", "iPadAir13M3-iPadAir13M3", "iPadAir13M3Cellular-iPadAir13M3Cellular", "iPhone17Pro-iPhone17Pro", "iPhone17ProMax-iPhone17ProMax", "iPhone17-iPhone17", "iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "screenshotUrls": [], "ipadScreenshotUrls": [], "appletvScreenshotUrls": [], "artworkUrl512": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/55/d1/b6/55d1b69f-5ea6-c192-cea6-8f026aabb675/AppIcon-0-0-1x_U007emarketing-0-11-0-85-220.png/512x512bb.jpg", "averageUserRating": 4.63157, "contentAdvisoryRating": "4+", "userRatingCountForCurrentVersion": 38, "artistId": 1771608219, "artistName": "Penendi LLC", "genres": ["유틸리티", "생산성"], "price": 0.0, "genreIds": ["6002", "6007"], "bundleId": "com.penendi.cameradetector", "releaseDate": "2024-11-01T07:00:00Z", "trackId": 6736358051, "trackName": "몰래카메라 탐지기 - SpyFy", "primaryGenreName": "Utilities", "primaryGenreId": 6002, "sellerName": "Penendi LLC", "isVppDeviceBasedLicensingEnabled": true, "currentVersionReleaseDate": "2026-07-17T01:37:08Z", "releaseNotes": "• 안정성 향상 — 네트워크 및 블루투스 스캔 중 드물게 발생하던 충돌 수정\n• 더 명확한 스캔 결과와 안내\n• 지원되는 모든 언어의 번역 업데이트\n• 일반적인 버그 수정 및 성능 개선", "version": "2.3", "wrapperType": "software", "currency": "KRW", "description": "AI 이미지 분석, WiFi·블루투스 기기 확인, 자기장 신호 점검을 한곳에서 이용하세요. 결과의 의미와 의심스러운 기기를 추가로 확인하는 방법을 명확하게 안내합니다.\n\n주요 기능:\n\nWi-Fi 네트워크 스캔\nWi-Fi 네트워크에 연결된 기기 중 잠재적으로 스파이 카메라나 기타 의심스러운 기기일 수 있는 것을 감지합니다. 이 기능은 네트워크상의 위협을 식별하여 디지털 프라이버시를 향상시킵니다.\n\n블루투스 스캔\n블루투스 스캔을 통해 주변의 의심스러운 블루투스 기기를 빠르게 찾습니다. 이 앱은 주변의 숨겨진 기기를 식별하여 사전 예방적 프라이버시 조치를 취할 수 있도록 돕습니다.\n\nAI 환경 스캔\nAI 기반 카메라 분석을 통해 주변을 스캔하여 잠재적인 숨겨진 카메라나 기타 스파이 기기를 감지합니다. 이 기능은 환경 스캔을 사용하여 의심스러운 기기가 있을 수 있는 영역을 알려줍니다.\n\n자기장 스캔\n자기장 스캔 기능은 자기장의 변화를 감지하여 잠재적인 숨겨진 전자 기기를 찾습니다. 이 도구는 금속 표면이나 숨겨진 영역에 숨겨진 기기를 식별하는 데 효과적입니다.\n\nAI 카메라 감지기를 사용하는 이유?\nAI 카메라 감지기는 잠재적인 스파이 카메라와 숨겨진 기기를 감지하는 데 특화되어 있으며, AI 기반 기술을 사용하여 호텔 객실, Airbnb, 직장 또는 기타 개인 환경에서 보안을 강화합니다. 직관적인 기능과 실용적인 결과로 숨겨진 카메라를 찾고 프라이버시를 보호할 수 있습니다.\n\n사용 사례:\n\n호텔 객실의 잠재적 숨겨진 카메라 감지\nAirbnb와 같은 단기 임대 숙소에서 프라이버시 강화\n직장에서 의심스러운 기기 찾기\n집이나 사무실에서 스파이 카메라 감지\nAI 카메라 감지기는 최신 AI 기술을 사용하여 숨겨진 카메라를 찾고 프라이버시를 강화하는 이상적인 도구입니다.\n\n구독 세부 정보:\n\n구독으로 모든 기능 잠금 해제.\n구매 확인 시 iTunes 계정으로 요금이 청구됩니다.\n현재 기간 종료 최소 24시간 전에 자동 갱신을 해제하세요.\n자동 갱신 요금은 각 청구 주기 종료 24시간 전에 발생합니다.\n계정 설정에서 구독을 관리하세요.\n\n개인정보 처리방침: https://www.penendi.com/privacy\n이용 약관: https://www.penendi.com/terms", "sellerUrl": "https://www.penendi.com", "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 4.63157, "trackCensoredName": "몰래카메라 탐지기 - SpyFy", "languageCodesISO2A": ["AR", "CA", "HR", "CS", "DA", "NL", "EN", "FI", "FR", "DE", "EL", "HE", "HI", "HU", "ID", "IT", "JA", "KO", "MS", "NB", "PL", "PT", "RO", "RU", "ZH", "SK", "ES", "SV", "TH", "TR", "UK", "VI"], "fileSizeBytes": "82479104", "formattedPrice": "무료", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%AA%B0%EB%9E%98%EC%B9%B4%EB%A9%94%EB%9D%BC-%ED%83%90%EC%A7%80%EA%B8%B0-spyfy/id6736358051?uo=4", "minimumOsVersion": "16.6", "userRatingCount": 38}]}