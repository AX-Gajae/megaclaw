 (UGC) 단조로운 플레이에 지치셨나요? 전 세계 플레이어들이 만든 멋진 트랙을 플레이하거나, 나만의 트랙을 만들어 보세요!\n\n- 지금 다운로드하고 리듬에 몸을 맡겨 보세요!", "bundleId": "com.rollcraft.block", "averageUserRating": 4.33333, "trackCensoredName": "RollerCraft: 롤링 대시", "trackViewUrl": "https://apps.apple.com/kr/app/rollercraft-%EB%A1%A4%EB%A7%81-%EB%8C%80%EC%8B%9C/id6502975107?uo=4", "contentAdvisoryRating": "12+", "sellerUrl": "http://www.sg-minimax.com/", "languageCodesISO2A": ["EN", "JA", "KO", "ZH", "ZH"], "fileSizeBytes": "817803264", "formattedPrice": "무료", "userRatingCountForCurrentVersion": 3, "trackContentRating": "12+", "averageUserRatingForCurrentVersion": 4.33333, "userRatingCount": 3}]}