iPhoneAir-iPhoneAir", "iPadPro11M5-iPadPro11M5", "iPadPro11M5Cellular-iPadPro11M5Cellular", "iPadPro13M5-iPadPro13M5", "iPadPro13M5Cellular-iPadPro13M5Cellular", "iPhone17e-iPhone17e", "iPadAir11M4-iPadAir11M4", "iPadAir11M4Cellular-iPadAir11M4Cellular", "iPadAir13M4-iPadAir13M4", "iPadAir13M4Cellular-iPadAir13M4Cellular"], "advisories": [], "kind": "software", "artworkUrl60": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/bc/6e/31/bc6e31f3-6d91-1e57-523d-f2edf911bd12/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/60x60bb.jpg", "artworkUrl100": "https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/bc/6e/31/bc6e31f3-6d91-1e57-523d-f2edf911bd12/AppIcon-0-0-1x_U007emarketing-0-8-0-85-220.png/100x100bb.jpg", "artistViewUrl": "https://apps.apple.com/kr/developer/actionfit/id1516168822?uo=4", "userRatingCountForCurrentVersion": 49, "sellerUrl": "https://actionfit.co.kr", "languageCodesISO2A": ["AR", "NL", "EN", "FR", "DE", "ID", "IT", "JA", "KO", "PL", "PT", "RU", "ZH", "ES", "TH", "ZH", "TR", "VI"], "fileSizeBytes": "435120128", "formattedPrice": "무료", "trackContentRating": "4+", "averageUserRatingForCurrentVersion": 3.63265, "genres": ["게임", "엔터테인먼트", "캐주얼", "퍼즐"], "artistId": 1516168822, "artistName": "ACTIONFIT", "price": 0.0, "trackId": 6759546053, "trackName": "머지냥탐정 : 미스터리 머지", "genreIds": ["6014", "6016", "7003", "7012"], "releaseDate": "2026-03-17T07:00:00Z", "currentVersionReleaseDate": "2026-07-24T10:12:15Z", "primaryGenreName": "Games", "primaryGenreId": 6014, "sellerName": "ACTIONFIT Ltd.", "isVppDeviceBasedLicensingEnabled": true, "releaseNotes": "- 신규 메타 추가\n- 5인 PVP 추가\n- 신규 인앱상품 추가\n- 마이너 버그 픽스", "version": "1.3.4(134)", "wrapperType": "software", "currency": "KRW", "description": "귀여운 고양이 탐정과 함께 미스터리를 해결하세요!\n\n평화로워 보이는 이 마을에는 곳곳에 숨겨진 비밀과 사건들이 있습니다.\n영리한 고양이 탐정과 그의 충실한 조수와 함께 사건을 조사하고, 머지를 통해 단서를 모아 각 사건의 진실을 밝혀보세요.\n\n아이템을 머지하고, 사건 현장을 조사하며, 마을 곳곳에 숨겨진 비밀을 밝혀보세요.\n\nMerge and Investigate\n\n다양한 아이템을 머지하여 새로운 단서와 도구를 발견하세요\n\n아이템을 조합해 수사에 필요한 도구를 만들어보세요\n\n머지를 통해 숨겨진 증거를 찾아보세요\n\n퍼즐을 하나씩 풀며 사건의 진실에 가까워지세요\n\n머지를 할 때마다 진실에 한 걸음 더 가까워집니다.\n\nA Charming Cat Detective Story\n\n고양이 탐정과 그의 충실한 조수의 모험을 따라가 보세요.\n\n각 챕터마다 새로운 사건이 기다리고 있습니다.\n\n사라진 고양이\n\n이웃 고양이들 사이의 다툼\n\n마을 곳곳에서 벌어지는 수상한 사건들\n\n모든 사건의 진실을 밝혀 마을에 평화를 되찾아 주세요.\n\nExplore the Town\n\n이야기가 진행될수록 새로운 장소와 챕터가 열립니다.\n\n다양한 사건 현장을 조사하세요\n\n개성 넘치는 고양이 캐릭터들을 만나보세요\n\n마을 곳곳에 숨겨진 단서를 발견하세요\n\n깊이 탐험할수록 더 많은 비밀이 드러납니다.\n\nCute Yet Intriguing Mysteries\n\n이 게임은 단순한 머지 게임이 아닙니다.\n\n편안한 머지 플레이와 함께 흥미로운 미스터리 스토리를 즐겨보세요.\n귀여운 캐릭터들과 함께하는 특별한 머지 미스터리 어드벤처를 경험할 수 있습니다.\n\n아이템을 머지하고 퍼즐을 풀며 고양이 탐정과 함께 사건의 진실을 밝혀보세요.", "trackViewUrl": "https://apps.apple.com/kr/app/%EB%A8%B8%EC%A7%80%EB%83%A5%ED%83%90%EC%A0%95-%EB%AF%B8%EC%8A%A4%ED%84%B0%EB%A6%AC-%EB%A8%B8%EC%A7%80/id6759546053?uo=4", "contentAdvisoryRating": "4+", "minimumOsVersion": "15.0", "averageUserRating": 3.63265, "trackCensoredName": "머지냥탐정 : 미스터리 머지", "bundleId": "com.actionfit.ios.merge.cat.detective", "userRatingCount": 49}]}