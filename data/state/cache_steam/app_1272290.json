":"시뮬레이션"}],"screenshots":[{"id":0,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/2de3183bcb67b3b293084ae2d2fb9b22b639d438\/ss_2de3183bcb67b3b293084ae2d2fb9b22b639d438.600x338.jpg?t=1763400547","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/2de3183bcb67b3b293084ae2d2fb9b22b639d438\/ss_2de3183bcb67b3b293084ae2d2fb9b22b639d438.1920x1080.jpg?t=1763400547"},{"id":1,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/289fb1736954b246f218dd658b0ccfd9909654d3\/ss_289fb1736954b246f218dd658b0ccfd9909654d3.600x338.jpg?t=1763400547","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/289fb1736954b246f218dd658b0ccfd9909654d3\/ss_289fb1736954b246f218dd658b0ccfd9909654d3.1920x1080.jpg?t=1763400547"},{"id":2,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/d4a345678c27bc280f3806b7c7d70511dc7eead1\/ss_d4a345678c27bc280f3806b7c7d70511dc7eead1.600x338.jpg?t=1763400547","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/d4a345678c27bc280f3806b7c7d70511dc7eead1\/ss_d4a345678c27bc280f3806b7c7d70511dc7eead1.1920x1080.jpg?t=1763400547"},{"id":3,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/9c987745a55ed2560b9165dc3e14ba4842627e00\/ss_9c987745a55ed2560b9165dc3e14ba4842627e00.600x338.jpg?t=1763400547","path_full":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/9c987745a55ed2560b9165dc3e14ba4842627e00\/ss_9c987745a55ed2560b9165dc3e14ba4842627e00.1920x1080.jpg?t=1763400547"},{"id":4,"path_thumbnail":"https:\/\/shared.akamai.steamstatic.com\/store_item_assets\/steam\/apps\/1272290\/1d1edf98ab53114229aac9aec9d4cd8e97b89f28\/ss_1d1edf98ab53114229aac9aec9d4cd8e97b89f28.600x338.jpg?t=1763400547","path_full":"https:\/\/shared.aka