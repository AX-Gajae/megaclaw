blished_datetime": "2018-08-07T20:55:14.869241", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22307, "title": "음악소녀 [2023년 판권 만료작]", "subject": "고기와 아이돌", "description": "신곡 발매를 앞두고 사무소로 집합하라는 이야기를 듣게 된 음악소녀 멤버들. 다음날 아침, 기대에 들떠 사무소로 향한 멤버들은 신곡 발매가 중지되었다는 청천벽력 같은 소식을 듣게 되는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18041/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2023-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-15T00:10:14.635936", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22308, "title": "음악소녀 [2023년 판권 만료작]", "subject": "아이돌의 눈물은 종이비행기에 태워서", "description": "촬영을 위해 무인도에 가게 된 음악소녀. 하지만 음악소녀의 리더 코토코의 모습이 어딘지 이상했다. 그리고 그날 밤, 해변에서 서성대는 코토코를 발견한 사사메. 그때, 코토코에게 누군가 접근하는 걸 보고 위험하다 생각한 사사메가 달려드는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18042/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.100000", "progressbar": null, "item_expire_datetime": "2023-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-21T22:25:40.946638", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22309, "ti