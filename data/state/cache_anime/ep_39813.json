iew": true, "access_info_list": [], "running_time": "0:24:32.033000", "progressbar": null, "item_expire_datetime": "2023-07-13T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-06-04T00:00:00.181954", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40490, "title": "리스너즈 [2023년 판권 만료작]", "subject": "틴 스피릿", "description": "지미 스톤프리에 대한 정보를 얻기 위해 명문 프리크 신 학교를 찾은 에코 일행. 하지만 프리크 신 학교의 교장 킴은 에코에게 지미의 정보를 넘겨주는 대신 플레이어 사이에서 금지된 틴 스피릿 캔의 출처를 알아내 줄 것을 부탁한다. 이에 에코와 뮤는 잠시 학교에서 지내면서 대체 누가 금지된 틴 스피릿을 제작하여 몰래 사용하고 있는지 조사에 나선다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/06/39467/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:09", "progressbar": null, "item_expire_datetime": "2023-07-13T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-06-11T00:00:00.102592", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40585, "title": "리스너즈 [2023년 판권 만료작]", "subject": "비트에 몸을 맡기고", "description": "신입 플레이어로서 시험대에 오른 뮤와 에코. 둘은 아마조네스 군단, 웬디&리사와 대결을 펼친다. 가까스로 두 번째 대결에서 승리하게 되어 전하로부터 지미에 대한 얘기를 듣게 되는데, 거기서 뮤는 자신이 지미의 여동생이라는 것을 짐작하게 되고 에코와 함께 지미를 찾으러 놈의 나라로 향한다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/06/39484/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": "2023-07-13T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-06-18T00:00:00.128361", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40657, "title": "리스너즈 [2023년 판권 만료작]", "subject": "굿바이 블루 스카이", "description": "지미를 찾으러 놈의 나라로 온 에코와 뮤. 뮤는 여행길에서 갑작스레 쓰러진 에코를 부축하고는 그를 살리기 위해 놈의 나라로 들어선다. 하지만 그곳은 과거 페스에서 많은 미미나시와 사람들이 죽어 황폐해진 도시였으며, 나라를 지키는 로즈와 미미나시가 되어버린 영혼들만 남아있었다. 그래서 플레이어에게 좋지 않은 감정이 남아 있던 로즈는 그런 뮤를 경계하기 시작한다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/06/39753/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": "2023-07-13T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-06-25T00:00:00.118020", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40835, "title": "리스너즈 [2023년 판권 만료작]", "subject": "분노의 날", "description": "어릴 적 미미나시의 공습에서 지미를 보고 플레이어를 동경하기 시작한 라이드. 성인이 되고 그저 주어진 일을 기계처럼 하며 사회의 통제 아래 살아가게 된다. 친구, 리치와 함께 항상 자유를 꿈꾼 그들은 니르를 만나 용기와 희망을 얻게 되면서 라이드는 플레이어로 변모하게 된다. 하지만 그들의 꿈은 그리 오래가지 못한 채 순식간에 잿더미로 변해버린다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/06/39863/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": "2023-07-13T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2