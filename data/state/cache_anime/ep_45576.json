time": "0:23:16", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132147, "name": "(더빙) 가면라이더 위저드 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-11T00:00:28.258463", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2015-01-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93001, "title": "(더빙) 가면라이더 위저드", "subject": "크리스마스의 기적", "description": "수호는 구울의 공격을 받고 있던 기찬을 구해 면영당으로 돌아온다. 하지만 기찬은 오늘은 희망의 날이라며 모두의 충고에도 불구하고 밖으로 나간다. 그리고 열심히 알바를 해서 번 돈으로 보육원 아이들을 위한 선물을 산다. 어렸을 때 크리스마스에 받았던 선물을 기억하며 자신도 누군가에게 희망을 줄 수 있는 사람이 되고 싶었던 것이다. 하지만 피닉스가 나타나 아이들에게 줄 선물을 불태우고, 그것을 본 기찬은 절망에 빠진다. 위저드로 변신한 수호는 기찬의 언더월드로 들어가 팬텀을 쓰러뜨린다. 그리고 그곳에서 생각지도 못한 사람을 만나는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/03/105266/v30/91c66aa681f0/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:15.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132148, "name": "(더빙) 가면라이더 위저드 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-11T00:00:28.654771", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2015-01-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93002, "title": "(더빙) 가면라이더 위저드", "subject": "또 한 명의 마법사", "description": "라온을 보고 흥미를 느낀 와이즈맨은 만티코어를 보내 라온을 공격하게 한다. 밥을 먹으려던 라온은 만티코어와 구울들의 습격에 당황하고, 그곳에 수호가 달려와 팬텀을 상대하는데, 마지막 순간 수호는 만티코어의 독에 당하게 된다. 한편, 점술사로 변한 만티코어는 지나가던 라온을 붙잡아 점을 봐주겠다며 한적한 곳으로 끌고 간다. 그리고 라온이 팬텀과 