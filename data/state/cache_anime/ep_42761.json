 나가노 취재에 나선 하루노와 시네포토부 일행. 가고 싶은 장소를 각자 이야기하던 중, 스케이트보드를 타고 언덕을 내려가는 모습을 액션캠으로 촬영하고 싶다는 이야기를 꺼낸 안. 촬영을 위해서는, 보드를 탈 줄 아는 사람이 한 명 더 필요했는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/05/93854/v30/1d962e2d9c03/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:11.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118612, "name": "모노 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118611, "name": "모노 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-02T01:30:06.095562", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-06-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82244, "title": "모노", "subject": "시험에 나오는 나가노 · 토야마 여행 제2탄", "description": "빠르게 카미코치에 도착한 하루노와 시네포토부 일행. 카코도 합류하려고 하지만, 무더위와 바이크 문제로 험난한 하루를 보낸다. 겨우 합류에 성공하고, 쿠로베 댐으로 향하는 카코와 일행. 건설 당시의 다큐멘터리를 보고 감동하고, 드디어 대망의 댐 카레를 목전에 두는데...", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94241/v30/25131c28f050/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:11.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118901, "name": "모노 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118900, "name": "모노 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-09T01:30:06.085887", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-06-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82245, "title": "모노", "subject": "시험에 나오는 나가노 · 토야마 여행 제3탄", "description": "다양한 명소를 탐방한 나가노 취재 여행의 마지막 날. 토가쿠시에 도착하여 소바 만들기 체험에 참가한 일행은 어른팀과 고등학생팀으로 나뉘어 소바 만들기 대결을 시작한다! 마지막으로 '닌자 비밀장치 저택'에 방문한 일행. 그곳에서 일행을 기다리고 있던 것은...?!", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94407/v30/56e5b47f675b/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:11.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119207, "name": "모노 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119206, "name": "모노 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-16T01:30:06.239673", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82246, "title": "모노", "subject": "야마나시 빙수 맵 완전 제패", "description": "여름 방학을 겨우 이틀 남겨 둔 시점. 올해의 여름을 돌아보던 시네포토부 멤버들은, 문득 이번 여름에 빙수를 먹지 않았다는 사실을 깨닫고... 후회 없는 여름 방학을 보내기 위해, '야마나시 빙수 맵'을 전부 제패하겠다는 목표를 가지고 여름 방학 마지막 여행을 떠난다!", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94614/v30/dc67a88b4ba7/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:11.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119470, "name": "모노 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119469, "name": "모노 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "