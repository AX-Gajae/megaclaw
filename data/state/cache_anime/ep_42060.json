{"count": 12, "next": null, "previous": null, "results": [{"id": 71152, "title": "하나노이 군과 상사병", "subject": "만나서 반가워", "description": "어느 날 집으로 돌아가던 길에, 얼굴 천재 두뇌 천재이자 옆 반 학생인 하나노이 군이 차이는 모습을 목격하고만 히나세 호타루. 연애에 흥미가 없는 호타루는 어째서 사랑 같은 걸 하는 걸까 하고 고민하면서도, 눈이 내리는 공원에서 홀로 앉아있는 그에게 별생각 없이 우산을 씌워주었다. 그러다 훗날, 호타루는 하나노이에게 사귀어 달라고 고백받게 되었는데.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/79803/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 101792, "name": "하나노이 군과 상사병 1 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 101791, "name": "하나노이 군과 상사병 1 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-04-10T00:30:08.846852", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-04-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71293, "title": "하나노이 군과 상사병", "subject": "처음 생긴 남친", "description": "하나노이 군과 시험 삼아 사귀는 관계가 된 호타루. 하지만 지금까지 연애와는 거리가 멀었던 탓에, 하나노이를 어떻게 대해야 할지를 몰랐다. 그런 상황에 호타루는 츠키하로부터 하나노이가 해주었던 것을 이번엔 호타루가 해주면 어떻겠냐는 조언을 받아 이를 시도해 보기로 했는데.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80038/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 101970, "name": "하나노이 군과 상사병 2 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 101969, "name": "하나노이 군과 상사병 2 소장", "list_price": 1500, "period": "0 day", "promot