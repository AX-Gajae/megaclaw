ation_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5140, "title": "창궁의 파프너 2기 : EXODUS", "subject": "신세계로", "description": "아자젤 형과 17대의 적기가 타츠미야 섬에 쳐들어 오자, 신참 파일럿과 선배들은 함께 싸우러 나간다. 생각지 못한 전법을 제안하며 새 파일럿들은 임무를 훌륭하게 완수해 섬을 지켜냈다. 이제 섬 밖으로 미와와 함께 갈 파견부대의 구성이 완료되고, 미지의 바깥 세상으로 출발한다. 이들은 과연, 원하는 희망을 찾게될 것인가?", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4229/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3640, "name": "창궁의 파프너 2기: EXODUS 5 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2017-05-08T22:12:22.250923", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5141, "title": "창궁의 파프너 2기 : EXODUS", "subject": "축복의 때", "description": "드디어 미와와 파견 호위부대가 스리나가르에 도착한다. 미와는 큰 나무 형태의 미르와 빨리 얘기하고 싶어하고, 결국 이들은 미르가 있는 바르카 신전으로 향한다. 한편, 타츠미야 섬에서는 섬의 코어가 자각한다. 코어는 마카베 사령관과 모든 이를 소집하고, 카즈키와 소우시 역시 불러오게 한다. 그리고 카즈키와 소우시에게 미와와 미와가 원하는 모든 것을 구해줄 것을 명령하며 즉각 출격하라고 요구한다. 이들은 무사히 임무를 완수할 수 있을까?", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4230/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3641, "name": "창궁의 파프너 2기: EXODUS 6 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2017-05-08T22:12:22.300082", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5142, "title": "창궁의 파프너 2기 : EXODUS", "subject": "신차원 전투", "description": "파견부대는 공격을 받고 미와에겐 큰 변화가 일어난다. 워커를 앞세운 우시아 형 1대와 스핑크스 B형 4대가 타츠미야 섬에 쳐들어오고, 파프너부대가 출격한다. 하지만 파프너 부대의 공격 방법을 무기를 재빨리 파악하는 페스툼에게 맥없이 무너지며 위기를 맞는데… 깨어난 츠바키는 '너희가 바라던 힘은 저런 게 아니다'라는 알 수 없는 말을 한다. 과연 타츠미야 섬은 이 위기를 넘기고, 섬을 지킬 수 있을까?", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4231/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3642, "name": "창궁의 파프너 2기: EXODUS 7 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2017-05-08T22:12:22.395919", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5143, "title": "창궁의 파프너 2기 : EXODUS", "subject": "평화를 꿈꾸며", "description": "공격 받은 파견부대에서 카즈키와 소우시가 복귀한 후, 다시 부대를 구하기 위해 출격하게 되지만, 이번에는 단 두 사람뿐이고 출격 장치 또한 불안하기만 하다. 하지만 이들은 동료를 구하겠다는 마음과 미래의 평화를 염원하는 마음을 안고 떠나게 되는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4232/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3643, "name": "창궁의 파프너 2기: EXODUS 8 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_dateti