가 어렵네.\n어! 저건…메카니멀?!\n너희들! 얼티밋 세븐은 너희가 가지고 있기엔 위험해.\n우리한테 넘기는 게 모두를 위해 좋을 걸?\n거부한다면…뭐 세계 챔피언의 실력으로 뺏는 수밖에!", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94209/v30/5b260deee1a3/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:03.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118972, "name": "(더빙) 터닝메카드 갓 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118971, "name": "(더빙) 터닝메카드 갓 8 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-10T18:00:07.544927", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-06-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82954, "title": "(더빙) 터닝메카드 갓", "subject": "오름과 샤나의 반격", "description": "우아아! 어떡하지!?\n지은이가 메카니멀에 관심을 보이고 있나봐..!\n자꾸 에반을 수상하게 보는 것 같단 말이지?\n게다가 주희까지 내가 뭔갈 숨기고 있다느니, 수상하다느니 의심하고…\n이 와중에 오름, 샤나! 너흰 또 에반을 노리고 왔다구?", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94374/v30/f527f61eb27a/Thumbnail.0000029.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:07.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119222, "name": "(더빙) 터닝메카드 갓 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119221, "name": "(더빙) 터닝메카드 갓 9 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-17T18:00:06.849853", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-06-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82955, "title": "(더빙) 터닝메카드 갓", "subject": "래피드 파이어와의 대결", "description": "찬…지난번 배틀에서 내가 승리하긴 했지만,\r\n난 그걸로 이겼다고 생각하지 않아!\r\n이번엔 나한테도 얼티밋 세븐이 있어.\r\n각자의 메카니멀 포스를 걸고 제대로 싸워보자, 찬!\r\n내가 너한테 동정 따윌 받아야할 만큼 약하지 않다는 걸 똑똑히 보여주마.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94525/v30/e52a9b276261/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:54.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119503, "name": "(더빙) 터닝메카드 갓 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119502, "name": "(더빙) 터닝메카드 갓 10 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-24T18:00:06.853956", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-06-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82956, "title": "(더빙) 터닝메카드 갓", "subject": "돌아온 반다인", "description": "찬…너에게 진 이후로, 난 많은 걸 잃었다.\r\n보스의 신뢰, 다크 섀도우에서의 지위, 그리고 자신감까지....\r\n하지만 그 덕분에 강해질 수 있었지.\r\n지금의 나는…절대 그 누구한테도 지지 않아.\r\n내 앞길을 가로막는 녀석은, 반드시…반드시 쓰러뜨린다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94723/v30/29b5111ca940/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:53.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119628, "name": "(더빙) 터닝메카드 갓 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119627, "name": "(더빙) 터닝메카드 갓 11 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-07-01T18:00:07.490989", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-07-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82957, "title": "(더빙) 터닝메카드 갓", "subject": "오빠의 비밀", "description": "휴…말하는 미니카, 대체 어디에 숨어있는 걸까?\r\n오빠도, 이소벨 언니도,\r\n분명 뭔가 아는데 나한테만 숨기고 있는 것 같단 말이지.\r\n흥, 됐어! 나 혼자 꼭 찾아내서 오빠한테 보여주고 말겠어!\r\n어? 근데 여긴 어디지…?\r\n나 설마 길을 잃은 거야?", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/94946/v30/e5883a393677/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:45.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119759, "name": "(더빙) 터닝메카드 갓 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119758, "name": "(더빙) 터닝메카드 갓 12 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-07-08T18:00:08.932558", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-07-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82958, "title": "(더빙) 터닝메카드 갓", "subject": "네 상대는 나다!", "description": "용찬이가 반다인에게 졌다니…믿을 수가 없어.\r\n분명 여동생 일로 조급해져서 실력을 발휘하지 못한 걸 거야.\r\n기다려, 용찬아.\r\n내가 반다인을 쓰러뜨리고 메카니멀 포스를 되찾아올게!\r\n그런데 무슨 수로 반다인을 찾지…\r\n어? 저건 나찬이랑…다크 섀도우?", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95402/v30/13787dad1774/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:48.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 120238, "name": "(더빙) 터닝메카드 갓 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 120237, "name": "(더빙) 터닝메카드 갓 13 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-07-15T18:00:08.844880", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-07-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82959, "title": "(더빙) 터닝메카드 갓", "subject": "다크 섀도우 기지에 잠입하라!", "description": "프랭클린 박사님을 구출하기 위해 다크 섀도우의 기지에 잠입한 우리!\r\n용찬이랑 우람이도 우리를 도와주겠대!\r\n좋아! 이대로 순조롭게 임무 성공!…하는 줄 알았는데,\r\n용찬아? 너 갑자기 왜 그러는 거야?\r\n이소벨은 또 어디로 가버린 거지?", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/96327/v30/fa1c28bfbf5a/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:59.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 121200, "name": "(더빙) 터닝메카드 갓 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 121199, "name": "(더빙) 터닝메카드 갓 14 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2025-08-05T18:00:07.682104", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2025-08-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82960, "title": "(더빙) 터닝메카드 갓", "subject": "유적의 파수꾼", "description": "함께 다크 섀도우에 맞설 동료가 필요해진 우린,\r\n이 근처에 스핑크스라는 메카니멀이 숨어 있다는 이야길 듣고 찾아가기로 했지!\r\n그리고 한참을 헤매다가 드디어 스핑크스를 발견! 했는데…\r\n뭐!? 수수께끼를 맞혀야만 힘을 빌려주겠다고?!\r\n그게 대체 무슨…?", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/08/96439/v30/fe97504406a7/Thumbnail.00000