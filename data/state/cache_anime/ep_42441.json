{"count": 12, "next": null, "previous": null, "results": [{"id": 81252, "title": "동패 part 1", "subject": "소년", "description": "심야의 마작 가게에서 교복 차림의 소년이 한 남자에게 승부를 제안한다. 남자는 자신이 질 리 없다며 우습게 여겼지만, 뛰어난 기억력을 발휘하는 소년 앞에 격침당한다. 그 소년은 통칭 '얼음의 K'. 그와 뒷세계 레이트 마작과의 만남은 3개월 전으로 거슬러 올라간다.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90841/v30/a2e0cbd80f97/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115569, "name": "동패 part 1 1 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115568, "name": "동패 part 1 1 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:09.890691", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81253, "title": "동패 part 1", "subject": "소녀", "description": "인터넷 마작에서 알게 된 맛짱으로부터 리얼 마작을 권유받은 케이. 그러나 맛짱은 처음부터 케이를 봉으로 삼을 생각이었다. 맛짱 일행의 팀플레이에 농락당하며 점점 궁지에 몰리는 케이. 그런 케이를 구한 것은 아미나라는 소녀가 내뱉은 한마디였다.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90842/v30/114ff45d80e7/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115571, "name": "동패 part 1 2 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115570, "name": "동패 part 1 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02