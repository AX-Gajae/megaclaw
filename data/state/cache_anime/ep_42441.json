: 700, "period": "7 day", "promotion": null}, {"id": 115574, "name": "동패 part 1 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:10.805676", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81256, "title": "동패 part 1", "subject": "새끼발가락", "description": "오린회의 1군 입단 최종 테스트를 받게 된 케이가 정신을 차렸을 땐 왼쪽 새끼발가락이 이미 잘린 상태였다. 봉합 가능한 시간은 앞으로 약 4시간. 마작 가게에서 돈을 불리면 발가락을 되찾을 수 있지만, 마취와 통증으로 머리가 잘 돌아가지 않는다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90845/v30/f7a39d5a7a82/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115577, "name": "동패 part 1 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115576, "name": "동패 part 1 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:11.119310", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81257, "title": "동패 part 1", "subject": "선택", "description": "1군에 합류하고 나서 대타 작사로서의 역할을 착실히 해나가는 케이. 그러던 중 1군의 선발 멤버 결정전에서도 훌륭하게 경쟁 상대를 무찌른다. 그러나 오린회 두목 타카츠는 세키와 연결되어 있는 케이를 의심의 눈초리로 바라본다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90846/v30/c869da50a01f/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115579, "name": "동패 part 1 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115578, "name": "동패 part 1 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:11.374652", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81258, "title": "동패 part 1", "subject": "흑막", "description": "케이는 도지마와 함께 콤비로 오린회 대 타야오 조직의 대타 마작에 임한다. 상대편의 대타 작사는 세키와 완전히 달라진 모습의 하타케야마였다. 파멸이라는 이름의 도박을 즐기는 하타케야마를 본 도지마는 경악스러운 선언을 한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90918/v30/e9d430c94611/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115581, "name": "동패 part 1 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115580, "name": "동패 part 1 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:11.651845", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81259, "title": "동패 part 1", "subject": "결사", "description": "타카츠는 이 승부의 흑막이 세키라는 것과 케이가 배신자임을 확신한다. 방총할 패를 집는 케이를 보고 방아쇠에 손가락을 거는 타카츠. 팽팽한 긴장감이 감도는 순간 케이는 스스로 자신이 배신자라고 선언한 뒤 믿을 수 없는 행동에 나선다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90863/v30/87f210f0f598/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115583, "name": "동패 part 1 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115582, "name": "동패 part 1 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:11.909494", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81260, "title": "동패 part 1", "subject": "종국", "description": "세키를 배신하고 그 책임을 지기 위해 할복한 케이. 출혈이 멈추지 않는 고통 속에서도 케이는 마작을 계속 이어가지만, 남은 시간은 얼마 되지 않는다. 점점 한계가 다가오고 있는 가운데 케이는 목숨을 건 대승부를 펼쳐나간다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90871/v30/f6c5671d1dd6/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115585, "name": "동패 part 1 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115584, "name": "동패 part 1 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:12.230397", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81261, "title": "동패 part 1", "subject": "혜안", "description": "타카츠 조직과 사사야마 조직이 치열한 싸움을 벌이는 마작 도박장. 케이를 학교에 보내고 대신하여 마작을 진행하는 마츠모토. 그러나 돌아온 케이가 마주한 것은 양 손가락이 잘린 마츠모토의 모습이었고, 그를 꺾은 건 아이라는 이름의 여자였다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90922/v30/06e6b9501590/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115587, "name": "동패 part 1 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115586, "name": "동패 part 1 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:12.605512", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81262, "title": "동패 part 1", "subject": "암귀", "description": "케이는 모든 수를 읽는 아이의 눈 때문에 궁지에 몰리고, 결국 자신의 모든 손가락을 걸고 승부하게 된다. 공포에 질린 케이에게 마츠모토는 도망치지 말라며 격려하고, 정신이 든 케이는 자신의 패를 오픈하며 이해할 수 없는 행동을 한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90923/v30/272fae2b8786/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115589, "name": "동패 part 1 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115588, "name": "동패 part 1 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:12.853469", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 81263, "title": "동패 part 1", "subject": "가치", "description": "쇼신회와의 세력권을 건 승부에 대타 작사로 나선 케이. 상대측 대타로 등장한 것은 반 친구인 우에노와 소꿉친구 유우였다. 유우는 케이의 비밀을 알려주겠다는 말에 따라왔을 뿐이었으나, 쇼신회는 유우를 인질로 삼아 케이를 흔들려고 한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/90924/v30/c77626a8105e/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115591, "name": "동패 part 1 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115590, "name": "동패 part 1 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-21T00:00:13.278248", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00092", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}]}