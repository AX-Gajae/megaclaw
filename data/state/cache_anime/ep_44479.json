essbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 133287, "name": "(자막) 디지몬 어드벤처 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 133286, "name": "(자막) 디지몬 어드벤처 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-01-23T00:00:13.026894", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2026-01-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90444, "title": "(자막) 디지몬 어드벤처", "subject": "전광! 캅테리몬", "description": "오로지 기계만이 움직이는 공장에서 사람을 찾아 헤매는 아이들. 하지만 아이들 앞에 나타난 것은 철로 만들어진 안드로몬이었다. 안드로몬의 무시무시한 공격에 위기에 빠지는 아이들. 이들을 구하기 위해 눈부신 번개와 함께 새로운 용사가 탄생한다. 아이들이 위험에 처하면 디지몬이 진화한다는 사실을 알아챈 아이들. 하지만 디지몬을 난폭하게 만드는 검은 톱니바퀴의 음모는 이제 막 시작된 것이었다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102836/v30/6f1e67f66fa9/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:10", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 133289, "name": "(자막) 디지몬 어드벤처 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 133288, "name": "(자막) 디지몬 어드벤처 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-01-30T00:00:14.925591", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2026-01-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90445, "title": "(자막) 디지몬 어드벤처", "subject": "팔몬, 분노의 진화!", "description": "워메몬의 습격을 받은 아이들은 장난감 마을에 도착한다. 하지만 검은 톱니바퀴에 조종당하고 있던 퍼펫몬은 아이들의 감정을 빼앗고, 아구몬을 장난감 상자 안에 가두어버린다. \"퍼펫몬