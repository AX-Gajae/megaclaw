otion": null}], "published_datetime": "2021-11-11T21:30:00.042768", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50610, "title": "경계전기", "subject": "토벌", "description": "세 번째 파일럿 시온과 합류한 아모우 일행. 시온의 파트너 AI 나유타를 포함함 세 사람과 세 AI들은 소란스럽게 새로운 본부로 향한다. 한편, 북미 동맹군의 브래드는 특명을 받고 고스트를 추적하고 있었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/52796/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67204, "name": "경계전기 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67203, "name": "경계전기 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-18T21:30:00.049745", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50732, "title": "경계전기", "subject": "재건의 망치 소리", "description": "야타가라스의 본부에서 멀리 떨어진 곳에 전화를 피해 어느 일본인 가족이 찾아왔다. 하지만 그들이 사는 곳은 물도 전기도 들어오지 않는 폐촌이었다. 아모우와 야타가라스 멤버들은 대가족의 생활 환경을 개선하기 위해 활동을 개시하는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/53438/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67373, "name": "경계전기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67372, "name": "경계전기 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-25T21:30:00.032621", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50858, "title": "경계전기", "subject": "자치구", "description": "아모우 일행과 장을 보러 나온 가신은 그곳에서 친형제처럼 같이 자란 스에나가 유세이와 재회한다. 야타가라스를 떠난 유세이는 일본인을 위해서 자치구를 만들고 그곳을 운영해 나가고 있었다. 그런 유세이를 보고 기뻐하는 가신이었는데......", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/12/53618/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67582, "name": "경계전기 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67581, "name": "경계전기 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-12-02T21:30:00.048417", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-12-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51021, "title": "경계전기", "subject": "원정", "description": "제르망의 의뢰를 받고, 아모우 일행은 도호쿠에서 활동하고 있는 레지스탕스 조직을 돕기 위해 도호쿠로 향한다. 도후쿠로 향하는 배 위, 얼마 전 스에나가와 있었던 일로 가신의 표정은 밝지 않았다. 한편, 일행이 향하는 도호쿠에는 알렉세이 제레노이 소령이 기다리고 있었는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/12/53764/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67811, "name": "경계전기 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67810, "name": "경계전기 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-12-09T21:30:00.035668", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-12-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51178, "title": "경계전기", "subject": "포위망", "description": "브래드 대위는 접촉해온 제르망의 정보로 고스트가 숨어 있는 장소를 알게 된다. 경계하면서도 진위 판별을 정보국에 확인시키는 브래드. 한편, 우도 일행은 아시아군의 움직임이 지금까지와는 다르다는 것을 눈치채고 있었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/12/53915/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 68020, "name": "경계전기 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 68019, "name": "경계전기 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-12-16T21:30:00.036627", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-12-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51395, "title": "경계전기", "subject": "오키노시마전 (전편)", "description": "고스트는 오키노시마에 있다. 그 정보를 얻은 아모우 일행은 조사 끝에 아시아군이 고스트와 전투를 벌인 끝에 퇴각했다는 사실과, 일본인들이 섬에 남겨져 있다는 사실을 알게 된다. 그들은 고스트의 토벌과 일본인 구출을 위해 작전을 준비하는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/12/54241/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_d