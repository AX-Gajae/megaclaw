sode_products": [{"id": 69854, "name": "소녀전선 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 69853, "name": "소녀전선 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-02T01:41:35.453475", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52706, "title": "소녀전선", "subject": "SILENCE 02 침묵 02", "description": "철혈의 습격을 격퇴한 이후 M4 SOPMOD II 일행은 ST AR-15를 구출하러 가자고 탄원했지만, 장시안이 재출격을 승인하지 않아 크게 풀이 죽고 말았다. 그런 상황에서 정찰 임무에 임하는 전술인형들 앞에 나타난 상급 인형 '헌터'와 압도적인 물량의 병력으로 가득 찬 철혈의 기지. 초조한 마음으로 구출을 궁리하는 M4A1 일행의 눈앞에서 갑자기 상황은 크게 변했는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55303/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:51.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70141, "name": "소녀전선 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70140, "name": "소녀전선 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-09T01:00:00.048448", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52808, "title": "소녀전선", "subject": "THE MESSAGE 01 메시지 01", "description": "철혈의 거점 제압에 성공하고 M4A1 일행은 ST AR-15와 재회했다. 그 후 상부로부터 특수 소대 호위를 명령받은 장시안은 전술인형들을 출격시켰는데, 그곳은 AR팀과 인연이 있기도 한 S09 지역이었다. 철혈과의 격전이 펼쳐지는 가운데 M16A1으로부터 통신으로 자신은 무사하다는 소식이 전해져 이에 안심했으나, 내리는 비와 함께 M16A1에게 살며시 다가오는 자가 있었는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/as