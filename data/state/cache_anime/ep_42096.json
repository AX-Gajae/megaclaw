ing": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2024-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73758, "title": "속삭이듯 사랑을 노래하다", "subject": "과거와 노래와 비밀", "description": "학교 축제 때 무대에 서기 위해 학생회실을 찾은 SSGIRLS는 전 보컬 시호와 맞붙는다. 밴드를 탈퇴한 시호는 아키와 불화가 있는 것 같은데... 반면, 애인 사이가 된 히마리와 요리는 손을 잡고 집에 가며 사이가 더욱 가까워진다. 그러던 중, 모모카를 찾아 시호와 하지메와 요리 연구부를 찾아오는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/83267/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106714, "name": "속삭이듯 사랑을 노래하다 7 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-23T00:00:09.032316", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2024-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73759, "title": "속삭이듯 사랑을 노래하다", "subject": "한때의 꿈과 친구와", "description": "시호가 이끄는 밴드 '로렐라이'의 오디션 무대는 압도적이었다. SSGIRLS도, 로렐라이도 오디션에 합격하지만, 아키는 오디션 후에 시호한테 들은 말 때문에 동요한다. 하지만 요리는 아키한테 시호는 지금보다 SSGIRLS에 있었을 때 더 즐거워 보였다고 말해준다. 아키는 시호와 제대로 마주하기로 마음먹는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/83268/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106833, "name": "속삭이듯 사랑을 노래하다 8 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-30T00:0