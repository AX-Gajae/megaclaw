: [{"id": 74058, "name": "아머드 사우루스 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-07-01T00:00:00.153841", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2022-03-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55259, "title": "아머드 사우루스", "subject": "설원 원정", "description": "설원지대로 원정을 떠나야한다는 레시아스. 더 강한 적들이 나타났으니, 링커들에게 신형 아머를 입혀야 한다고 주장한다. 사령관은 고민 끝에, 테스트가 끝나지 않은 신형 아머를 링커들에게 입 히기로 결정한다. 설원지대에 도착한 링커들은 이상기후에 고생하며 기계 맘모스와 전투를 벌이지만 추위에 적응 못한 공룡들 때문에 고전을 하게 된다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/55902/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:36.300000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74057, "name": "아머드 사우루스 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-07-01T00:00:00.153841", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2022-03-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55260, "title": "아머드 사우루스", "subject": "설원의 귀재", "description": "기계 맘모스와 전투를 벌이는 링커들. 추위에 적응 못한 공룡들 때문에 고전하는데, 유라시아지부 소속의 유리가 지원을 나와 위기를 넘긴다. 하지만 그들이 다시 나타날 것이라는 가디언즈의 말 에, 세나는 아머를 입지 않고 현지 적응 훈련을 하겠다고 말한다. 세나는 트리케라톱스의 등에 올 라타 하염없이 내리는 눈을 감상하고, 진은 추위에 웅크린 적룡에게 눈뭉치를 던져 포효하게 만 든다. 아인은 랩터들이 끄는 눈썰매를 타며 놀고, 용후는 익룡과 비행하며 속마음을 털어놓는다. 그렇게 시간을 보낸 링커들과 공룡들은 교감이 상승하고, 두 번째 전투에서 기계 맘모스를 거뜬 히 물리친다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/56056/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:58.266000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74056, "name": "아머드 사우루스 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-07-01T00:00:00.153841", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2022-03-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55261, "title": "아머드 사우루스", "subject": "링커 대전", "description": "아시아지부로 전학을 오게 된 유리. 그러자 링커들은 환영의 의미로 오랜만에 링커대전을 펼친다. 공룡 똥냄새 참기, 랩터 꼬리잡기, 공룡 타고 달리기 등 모든 종목에 엄청난 기량을 보이는 유리. 하지만 아시아지부에서 가장 난이도 높은 대결이 남았다. 다름 아닌, ‘세나를 웃겨라!’. 링커들은 단 한번도 세나가 웃는 모습을 본 적 없다. 역시나 유리는 첫 패배를 맛본다. 세나는 그런 링커들 모습을 한심해 하는데, 모범생 용후가 팔 걷어 부치고 나서서 세나 웃기기에 성공한다. 그날 밤, 사령부는 고아인 줄만 알았던 세나 엄마의 연락을 받고 발칵 뒤집힌다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/56162/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:02.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74055, "name": "아머드 사우루스 20 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-07-01T00:00:00.153841", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2022-03-24", "rating_components": []}, "access_type": null, "is_available": false}]}