t/assets/2026/04/105634/v30/442c34d165eb/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:27.300000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132800, "name": "피닉스맨 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 132799, "name": "피닉스맨 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-04-27T00:00:14.337737", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-04-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91506, "title": "피닉스맨", "subject": "새로운 비클 삼총사 트라이 기어", "description": "아비타는 제네오브(목소리)에게 피닉스맨의 부활에 쓰인 힘이 사실은 본인의 힘이었음을 말하며, 그 때문에 힘이 약해졌음을 알린다. 그리고 피닉스맨의 전력을 더 강화하기 위해 또다시 특훈에 들어간다. 다음날, 아람시에선 미래형 버클 전시회가 열리고 현우,민아,지호는 전시회에서 미래형 버기카와 바이크, 드론을 보게된다. 하지만 전시장에 강화된 스파이더몬이 나타나고, 피닉스맨으로 변신한 현우는 전시장에 있던 트라이 기어 드론, 호버, 버기를 사용해 우위를 차지한다", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105889/v30/be707aaab61e/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:29.600000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132802, "name": "피닉스맨 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 132801, "name": "피닉스맨 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-05-04T00:00:13.170646", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-04-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91507, "title": "피닉스맨", "subject": "컴바인! 트라이 기어", "description": "베마에는 시민들의 후각을 마비시키기 위해 도시 곳곳에 악취 가스를 퍼뜨리고, 리자드몬을 위장시켜 악취 가스통을 지키게 한다. 피닉스맨은 스파이더몬의 공격에 맞서면서도 초감각 모드를 발동하여 지독한 냄새를 감수하고 악취의 근원지인 리자드몬과 가스통을 찾아내고, 새로 얻은 트라이 기어 삼총사(바이크, 버기, 드론)를 컴바인 트라이 기어로 강화한다", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107635/v30/a56b34919e17/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:45.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132804, "name": "피닉스맨 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 132803, "name": "피닉스맨 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-05-11T00:00:12.706060", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-04-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91508, "title": "피닉스맨", "subject": "현우의 드림카, 스프린터", "description": "피닉스맨이 유리한 상황에서 베마에가 리자드몬을 강화 리자드몬으로 강화시킨다. 잠시 위험을 맞은 피닉스맨은 곧 아비타가 데려온 맹금류 친구들의 도움으로 리자드몬을 물리친다. \r\n집으로 돌아온 현우는 레이싱 게임을 시작하고, 거기서 현우의 드림 카인 스프린터를 발견해 기뻐한다. 하지만 예민한 스프린터 카의 운전에 난항을 겪는다. 하지만 쉴 틈 없이 베마에가 한 번 더 괴물을 보내 시청을 공격한다. 드릴 형태의 괴물과 고전하던 중 피닉스맨은 전시되어 있던 '스프린터' 자동차를 발견하고, 피닉스 기어로 스프린터를 사용해 스프린터 모드로 전환한다", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107633/v30/7f54da60ecb3/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:40", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 135288, "name": "피닉스맨 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 135287, "name": "피닉스맨 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-05-18T00:00:13.185716", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-04-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91509, "title": "피닉스맨", "subject": "수상한 사람들", "description": "피닉스맨은 지호의 조언을 떠올려 예민한 기어인 '피닉스 스프린터'와 교감하며 초감각 모드로 드릴로이드를 격퇴하는 데 성공하지만 , 피닉스맨의 출현 패턴을 분석해 정체를 추적하던 부시장이 현우의 동네에 감시 요원을 보내며 위기가 찾아온다. 수상함을 느낀 현우는 괴한의 차량을 추격해 부시장의 아지트를 찾아내고 잠입 조사를 하던 중 , 뜻밖에도 그곳을 몰래 감시하고 있던 아빠의 모습을 발견하며 큰 충격에 빠진다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107636/v30/056524e6f42f/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:17.566000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 135317, "name": "피닉스맨 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 135316, "name": "피닉스맨 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-05-25T00:00:12.303645", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-05-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91510, "title": "피닉스맨", "subject": "아빠의 정체", "description": "부시장의 아지트를 감시하던 피닉스맨은 아빠가 국가정보국 소속 요원이라는 놀라운 정체를 알게 되고 , 스피드 위도우의 공격으로 위기에 처한 아빠를 '피닉스 스프린터' 모드로 변신해 구해낸다. 아빠는 기절시킨 부시장을 경찰에 넘기며 피닉스맨에게 가족을 부탁하고 다시 해외 출장(임무)을 떠나며 , 한편 베마에는 지구를 파괴하기 위한 '우주파동폭탄'을 준비하며 새로운 위협을 예고한다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107637/v30/c107315acadd/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:34", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 135319, "name": "피닉스맨 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 135318, "name": "피닉스맨 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-06-01T00:00:12.023758", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-05-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91511, "title": "피닉스맨", "subject": "정체불명의 타이거맨", "description": "베마에가 완성한 '우주파동폭탄'이 아람시 상공에서 비명의 진동을 일으키며 도시를 위기에 빠뜨리자, 현우는 피닉스맨으로 변신해 폭탄을 막으려 하지만 강력한 파동 에너기에 밀려 고전하게되고, 이때 호랑이 기운을 내뿜는 정체불명의 히어로 '타이거맨'이 나타나 강력한 파괴력으로 폭탄의 방어막을 무력화하며 피닉스맨을 돕고, 두 히어로는 합동 공격으로 폭탄을 파괴하여 도시를 구해낸다. 전투 후 타이거맨은 \"아직은 때가 아니다\"라는 수수께끼 같은 말을 남긴 채 사라지고, 현우는 그의 정체에 의문을 품으며 새로운 국면을 맞이하게 된다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108623/v51/13fe7c6eb818/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:38.397000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 136535, "name": "피닉스맨 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 136534, "name": "피닉스맨 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-06-15T00:00:11.476724", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2026-06-03", "rating_components": []}, "access_type": null, "is_available": false}]}