sification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13750, "title": "데이트 어 라이브 [2019년 판권 만료작]", "subject": "삼중광소곡", "description": "시도는 쿠루미와 데이트를 신청하지만, 운 나쁘게 토오카 오리가미와 시간이 겹치고 만다.\n돌아가며 정신 없이 세 명을 상대하는 시도는 숨이 턱밑까지 차오르는데...\n그만 시도가 자리를 비운 사이, 프락시너스가 쿠루미를 놓쳐버리고 만다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11871/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": "2019-04-12T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:10:48.336038", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13751, "title": "데이트 어 라이브 [2019년 판권 만료작]", "subject": "광란의 악몽", "description": "시도는 태연히 쿠루미를 죽인 마나를 향해 분노와 공포로 범벅된 힐난을 쏟아놓는다.\n그럼에도 마나는 태연함을 잃지 않고, 시도를 향해 이렇게 이야기한다.\n나이트메어, 토키사키 쿠루미는 죽여도 죽지 않는 특이한 정령이라고...\n", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11873/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.033000", "progressbar": null, "item_expire_datetime": "2019-04-12T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:10:48.289514", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13752, "title": "데이트 어 라이브 [2019년 판권 만료작]", "subject": "불꽃의 정령", "description": "코토리는 시도의 질