000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-05-21T02:00:10.965918", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-05-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93688, "title": "공주 기사는 야만족의 신부", "subject": "봉마는 인간의 업보", "description": "검은 진흙의 ‘침전물’, 즉 마물이 말시어스를 집어삼키려고 하자, 육체와 정신을 좀먹히는 말시어스까지 \r\n같이 쓰러트리려고 하는 베올. 하지만, 세라피나는 결코 내버리지 않고 몸을 던져 그녀를 구하려고 하는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108263/v51/33ec7513b034/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-05-28T02:00:10.975834", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-05-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93689, "title": "공주 기사는 야만족의 신부", "subject": "흐름은 침전물을 정화", "description": "세라피나뿐만 아니라, 침전물의 원인을 제공했던 말시어스도 ‘정화식’이라 불리는 의식에 참가하게 되었다. \r\n세라피나는 말시어스, 체치와 함께 느긋하게 시간을 보내며 정화식을 맞이한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108529/v51/528745a1c143/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-04T02:00:11.019787", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93690, "title": "공주 기사는 야만족의 신부", "subject": "약정은 목걸이의 모양", "description": "위스텔레시아에게 배운 방법으로, 세라피나는 드디어 ‘약혼 목걸이’를 벗을 수 있었다. \r\n하지만, 어째서인지 원래대로 돌아오지 않는다. 목걸이를 다시 차기 위해서는 베올에게 기습을 하여 \r\n‘어떠한 행동’을 해야 하는 듯한데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108825/v51/de39cf82a3bd/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-11T02:00:11.571570", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93691, "title": "공주 기사는 야만족의 신부", "subject": "상상은 마음의 저울", "description": "세라피나의 마음은 조국에 대한 책무와 자신의 행복 사이에서 흔들리고 있었다. \r\n지금부터 어떻게 해야 할지 고민하던 세라피나는, 베올에게 ‘어떻게 살아가고 싶은지’ \r\n상상해 볼 것을 권유받아, 베올과의 미래를 상상하기 시작한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/109383/v51/34fb0606fd26/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-18T02:00:11.922882", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93692, "title": "공주 기사는 야만족의 신부", "subject": "탕 증기는 산기슭 아래 장막", "description": "화룡 ‘홍련 이리’에게 포착당한 세라피나 일행. 압도적인 힘 앞에 손쓸 도리가 없었지만, 키마키를 \r\n비롯한 광부들의 지원 사격 덕분에 갱도로 대피한다. 그러나 홍련 이리의 집요한 추격과 함께, \r\n갱도 속으로 강렬한 브레스가 쏟아지는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/109901/v51/a6898b894bd8/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-25T02:00:11.711526", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93693, "title": "공주 기사는 야만족의 신부", "subject": "탐구는 광부의 기원", "description": "광부 마을의 문명 수준에 압도당하면서도 세라피나 일행은 세 현로 중 한 명, 발하스의 공방으로 향한다. \r\n발하스로부터 받은 수정 투구 ‘은정화’는 아무리 봐도 동물 귀 모양의 머리 장식처럼 보였지만, 그 투구에는 \r\n터무니없는 힘이 숨겨져 있었다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/07/110185/v51/59af7de8b768/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-07-02T02:00:11.805365", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-07-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93694, "title": "공주 기사는 야만족의 신부", "subject": "홍련은 강자의 위풍", "description": "홍련 이리와의 결전이 시작된다. 광부들의 지원 사격을 받으며 홍련 이리와 대치하는 세라피나와 