r": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-01-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3442, "title": "NEW 아기공룡 둘리", "subject": "희동이", "description": "길동과 티격태격 하루를 보내는 둘리네 집에 엄청난 말썽꾸러기 희동이가 찾아왔어여. 희동이네 부모님은 영국으로 유학을 떠나셨대요. 희동이와 함께 살게된 둘리는 너무너무 괴로워요. 희동이는 툭하면 놀아달라고 귀찮게 보채고… 게다가 가족들 모두 희동이만 예뻐하고 둘리는 구박만 하니 도저희 서러워서 함께 살수가 없어요. 가출을 결심하는 둘리!! 과연 둘리는 빼앗긴 관심을 돌려받을수 있을까요?", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2971/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:26.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3116, "name": "아기공룡 둘리 3 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:18:59.811954", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-01-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3443, "title": "NEW 아기공룡 둘리", "subject": "타임코스모스여행", "description": "둘리네집 마당에 외계인 '도우너'가 떨어졌어여. 도우너가 타고온 타임 코스모스는 시공을 마음대로 오가는 엄청난 기계라네요. 하지만 희동이의 다정한(?) 손길에 바로 망가져버렸어요. 다행히 같은 별의 과거와 현재를 오가는 데엔 지장 없다는 도우너의 말에 둘리는 엄마를 만나러 과거로 떠나게되는데…과연 둘리는 보고싶은 엄마를 만날 수 있을까요?", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2972/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:32.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3117, "name": "아기공룡 둘리 4 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:18:59.884048", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-01-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3444, "title": "NEW 아기공룡 둘리", "subject": "슬픈 길동이", "description": "길동이 아저씨는 슬퍼요. 왜냐구요? 둘리는 아저씨를 TV에 넣고 놀리고, 도우너는 아저씨를 애완동물 취급을 하며 놀리고, 게다가 이 둘이 힘을 합쳐 집 기둥뿌리를 뽑아 버리기까지 하니까요. 과연 길동이 아저씨는 이녀석들을 용서할 수 있을까요?", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2973/v4/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:04", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3118, "name": "아기공룡 둘리 5 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:18:59.957277", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-02-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3445, "title": "NEW 아기공룡 둘리", "subject": "스타탄생", "description": "길동씨의 이웃집의 가수지망생 마이콜. 툭하면 들려오는 노랫소리에 길동 아저씨는 너무너무 괴로워하네요. 덩달아 둘리와 도우너는 노래란 이런거야 라며 가르치기까지 하네요. 아무리 봐도 가망성이 없는 마이콜을 위해 '핵폭탄과 유도탄들' 이라는 팀을 결성해 가요제에 참가한데요. 둘리와 친구들은 과연 입상할 수 있을까요?", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2974/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:18.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3119, "name": "아기공룡 둘리 6 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.054412", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3446, "title": "NEW 아기공룡 둘리", "subject": "도우너, 엄마를 찾아서", "description": "바이올린처럼 생긴 도우너의 타임코스모스는 시공을 오가는 줄만 알았더니 새로운 기능이 숨겨져 있었어요. 둘리가 타임코스모스를 연주하자마자 길동씨가 갓난애기가 되는게 아니겠어요? 둘리의 모성(?)본능을 자극하는 아기 길동씨 탓에 젖동냥을 다니게 되는데… 둘리 엄마, 도우너 아빠밑의 아기 길동씨는 잘 자랄수있을까요?", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2975/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:09.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3120, "name": "아기공룡 둘리 7 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.109941", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-02-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3447, "title": "NEW 아기공룡 둘리", "subject": "또치 또치 또치", "description": "길동씨네 집 쓰레기통을 뒤지던 또치가 말썽쟁이 둘리와 만났어요. 또치는 어찌나 잘난척이 심한지. 서커스단에서 배운 재주를 자랑하려다가 길동씨의 귀중한 LP판을 모조리 깨먹고 쫒겨나는데요. 길동씨는 또치를 잡으러 다니는 무서운 아저씨에게 또치의 위치를 발설하는데… 과연 또치는 무사히 서커스단의 검은 손길로 부터 도망칠 수 있을까요?", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2976/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:21.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3121, "name": "아기공룡 둘리 8 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.166247", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-02-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3448, "title": "NEW 아기공룡 둘리", "subject": "거짓말", "description": "환절기가 되자 피부가 거북이 등처럼 거칠어진 둘리는 욕실에서 대형 스킨 로션을 발견하고 온 몸에 듬뿍 바릅니다. 다음날 아침이 되어 일어나보니 온몸에 붉은 반점과 뽀드락지가 마치 해삼 멍게처럼 솟아나 있는게 아니겠어요!! 길동씨는 둘리에게 피부암 말기라고, 이제 죽을 날이 얼마 남지 않았다고 겁을 주는데...과연 둘리의 운명은 어떻게 될까요???\n", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2977/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3122, "name": "아기공룡 둘리 9 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.212259", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-03-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3449, "title": "NEW 아기공룡 둘리", "subject": "골두기별 왕자님", "description": "폐허가 된 골두기별을 되살리려고 골두기별 왕자님은 보물성이 쮜꾸별을 찾아왔어요. 하지만 도착한 곳은 둘리와 친구들이 살고 있는 지구별이란 걸 알고나 있는 걸까요? 둘리와 친구들은 골두기별 왕자님에게 뺴앗은(?) 보물지도를 보고 진짜 보물성인 쮜꾸별을 찾아 떠난 둘리… 과연 보물은 누가 차지하게 될까요?", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2978/v15/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:26.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3123, "name": "아기공룡 둘리 10 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.269302", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-03-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3450, "title": "NEW 아기공룡 둘리", "subject": "쇠귀신", "description": "어느 날 부터인가 냉장고 속에 넣어둔 맛잇는 음식들이 하룻밤만 자고나면 없어져요. 길동 아저씨는 둘리와 친구들의 짓이라고 단정하고 둘리를 추궁해보지만, 둘리와 친구들은 억울하기만 하다네요. 어느 날 밤, 둘리는 드디어 냉장고 속을 비운 범인을 잡는데. 범인은 원숭이도 아니면서 원숭이같고, 사람도 아니면서 사람같은 희안하고 뭔가 특별해 보이는 녀석인데요. 둘리는 이 녀석을 키우겠다는 군요… 아 불쌍한 길동 아저씨 ㅜ.ㅜ", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2979/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:30.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3124, "name": "아기공룡 둘리 11 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.312773", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-03-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3451, "title": "NEW 아기공룡 둘리", "subject": "유니콘(상)", "description": "TV속에서 유니콘을 보더니 희동이가 문방구의 유니콘인형을 사달라고 떼를 쓰지뭐예요. 온갖 불쌍한척 다해서 간신히 얻어낸 유니콘 인형은 보통 인형이 아니였어요. 밤에는 진짜 유니콘이 되어 둘리와 친구들을 태우고 하늘을 날아다니지 않겠어요? 어디든 날아다닐 수 있는 유니콘에게 희동이는 영국에 계신 엄마가 보고싶다고 부탁을 하는데… 희동이는 과연 엄마를 만날수 있을까요?", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2980/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:12.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3125, "name": "아기공룡 둘리 12 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.358233", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-03-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3452, "title": "NEW 아기공룡 둘리", "subject": "유니콘(하)", "description": "희동이 엄마를 찾아 영국에 도착한 둘리와 친구들. 12시간 안에 집으로 돌아가지 않으면 아이들은 미아가 되어버린다는데 불량배들과 시비가 붙고, 교통사고 목격자도 되고, 막상 희동이 엄마네 집주소는 모르고… 과연 친구들은 무사히 엄마를 만나고 집에 돌아갈 수 있을까요?", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2981/v4/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:54.800000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3126, "name": "아기공룡 둘리 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.394464", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-04-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3453, "title": "NEW 아기공룡 둘리", "subject": "도우너의 생일", "description": "오늘따라 울적해보이는 도우너, 무슨일인가 했더니 도우너의 생일이지 않겠어요? 의리의 둘리와 또치는 도우너를 위해 생일 잔치를 열어주기로 했어요. 도우너의 태어난 해 만큼 빵을 만드는데… 선물을 준비할 생각 조차 없는 길동 아저씨는 호시탐탐 그 빵을 노리는 거예요. 이 염치없는 길동 아저씨를 어떻게 혼내주면 좋을까요?", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2982/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:09.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3127, "name": "아기공룡 둘리 14 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.459688", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3454, "title": "NEW 아기공룡 둘리", "subject": "새해아침", "description": "새해아침, 길동아저씨는 둘리와 친구들을 사랑으로 감싸안아보기로 결심합니다. 역시 대인배! 하지만 아저씨가 사랑으로 감쌀수록 친구들의 장난은 더욱심해집니다. 보다못한 아저씨는 친구들에게 그날 그날을 반성하는 일기를 쓰게 하는데요… 과연 둘리와 친구들은 아저씨의 이런 마음을 알아줄까요?", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2983/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3128, "name": "아기공룡 둘리 15 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.503670", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-04-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3455, "title": "NEW 아기공룡 둘리", "subject": "심부름소동", "description": "말썽으로 하루를 시작하는 둘리와 친구들 덕분에 정자 아줌마는 폭발 직전! 차라리 둘리는 눈에 안보이는게 도움이 되겠어요. 때마침 길동 아저씨의 수첩을 아저씨 회사에 갖다드리라는 임무를 맡게 되는데요. 길동 아저씨 회사롤 가는 심부름 길은 둘리와 친구들에게는 험난 하기만 합니다. 과연 둘리와 친구들은 길동 아저씨 회사에 무사히 찾아 갈 수 있을까요?", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2984/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:24.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3129, "name": "아기공룡 둘리 16 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.560465", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-04-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3456, "title": "NEW 아기공룡 둘리", "subject": "충치소동", "description": "사탕을 좋아하는 희동이는 이가 너무너무 아파요.  충치때문에 앙앙 우는 희동일 보고 길동씬 둘리에게 희동이를 데리고 치과에 갔다오라고 해요. 억지로 치과에 끌려간 희동이는 '쌍문동 공포의 젖꼭지'라는 별명에 걸맞게 치과를 뒤엎어 놓는 데… 둘리는 희동이의 이빨을 치료하고 올수있을까요", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2985/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:16.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3130, "name": "아기공룡 둘리 17 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.603113", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-04-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3457, "title": "NEW 아기공룡 둘리", "subject": "마술연필", "description": "새해 계획으로 둘리와 친구들 집에서 내보내겠다고 결심한 길동 아저씨. 둘리와 친구들은 아저씨 약만 살살 올리다가 뒷산에서 우연히 연필을 줍는데요. 이 연필은 그리면 그린대로 현실이 되어 나타나는 마술연필이지 않겠어요! 마술연필만 믿고 집을 나가버리는 둘리는 친구들 앞에 과연 어떤사건이 펼쳐질까요?", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2986/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:20.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3131, "name": "아기공룡 둘리 18 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.649720", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-05-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3458, "title": "NEW 아기공룡 둘리", "subject": "노이로제", "description": "말썽쟁이 둘리와 친구들 덕분에 아저씨는 정신과 치료를 받게되었어요. 꾸준한 운동과 긍정적인 사고방식으로 아저씨는 차츰 안정이 되어가는데 반대로 둘리와 친구들은 아저씨의 전혀 다른 모습에 공포? 를 느끼기 시작해요. 과연 둘리와 친구들은 색다른 공포에서 벗어날수 있을까요?", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2987/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:06.800000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3132, "name": "아기공룡 둘리 19 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:19:00.685176", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "SBS", "broadcast_date": "2009-05-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3459, "title": "NEW 아기공룡 둘리", "subject": "디스크악마", "description": "둘리와 친구들은 길동씨와 음악 소리 때문에 티격티격 싸우고 있어요. 그와중에 희동이가 주워온 레코드판을 길동씨는 호기심에 켜봅니다. 레코드판에서는 잡음소리만 지익지익 나더니, 갑자기 기분나쁜 웃음소리와 함께 망토를 걸친 악마가 나오는게 아니겠어요!!! 악마는 길동씨는 디스크속에 가두고 둘리와 친구들을 유혹해서 악마가 온 세상을 지배하는 왕국을 건설하여고 합니다!!! 과연 둘리와 친구들이 악마를 물리치고 길동씨를 구할수있을까요?", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2988/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:36.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 3133, "name": "아기공룡 둘리 20 소장", "list_price": 600, "period": "0 day", "pr