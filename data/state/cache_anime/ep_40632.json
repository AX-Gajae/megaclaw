cription": "104기 훈련병단에게 이번에 부여된 훈련은 두 조로 나뉘어 편도 약 40킬로의 황무지를 왕복하는 것이었다. 숲의 샛길에서 2조의 다즈가 자신의 입체기동장치를 도둑맞았다는 보고가 올라온다. 근처에 주민이 거주하고 있다는 정보도 없었기에 라이너 일행은 절도단의 존재를 감지하기 시작했는데......", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/01/54462/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 68505, "name": "진격의 거인 OAD 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 68504, "name": "진격의 거인 OAD 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-01-03T23:30:00.144482", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-01-03", "rating_components": []}, "access_type": null, "is_available": false}]}