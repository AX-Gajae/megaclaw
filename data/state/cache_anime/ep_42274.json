ftel.net/assets/2024/07/84645/v30/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108403, "name": "근육맨: 완벽초인시조 편 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 108402, "name": "근육맨: 완벽초인시조 편 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-07-29T10:00:09.319265", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-07-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75462, "title": "근육맨: 완벽초인시조 편", "subject": "강습! 악마 초인군!!", "description": "정의 초인과 완벽 무량대수군의 대항전은 제2회전 이후, 전 세계에 흩어져 있는 6개의 링에서 동시에 개최된다. 각 대회장에는 전선에 복귀할 가능성이 큰 정의 초인 주력조의 연고지가 각각 선택됐지만... 완벽 초인이 기다리는 그 결전장에 뛰어든 것은 놀랍게도 전격 참전으로 난입한 악마 초인들이었다?! 우선은 울프맨을 대신해 링에 올라간 스테카세킹이 냉혹하고 무자비한 터보맨과 격돌한다!", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/84780/v30/9424e955/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108592, "name": "근육맨: 완벽초인시조 편 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 108591, "name": "근육맨: 완벽초인시조 편 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-08-05T10:00:10.038200", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-08-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75463, "title": "근육맨: 완벽초인시조 편",