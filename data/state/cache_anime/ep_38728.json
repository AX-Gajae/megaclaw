rue, "access_info_list": [], "running_time": "0:13:24.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18306, "name": "출동 케이캅 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21769, "title": "출동 케이캅", "subject": "흔들리는 공포", "description": "도시에 지진이 발생하자 아이들은 지진대피훈련을 받는다. 키마이라는 지진의 공포를 이용해 지진해머를 만들어 도시 곳곳에 더욱 큰 지진이 일어나게 한다. 출동한 케이캅은 가마토와 지진해머를 파괴하는데 성공한다. 한편, 스텔라는 사람들과 친해지기 위해 ‘귀요미 프로젝트’에 돌입한다. ", "episode_num": "14", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17701/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.333000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18307, "name": "출동 케이캅 14 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21770, "title": "출동 케이캅", "subject": "쓰레기와의 전쟁", "description": "음식물쓰레기가 커다란 사회문제로 발생한다. 스텔라는 채소를 재배한다는 말을 듣고, 자신이 좋아하는 라면을 심는다. 한편, 키마이라는 파리괴물을 만들어 사람들을 공격한다. 빠른 파리괴물의 움직임에 고전하는 케이캅. 하지만, 레드가 무기합체에 성공하면서 파리괴물을 체포하는데 성공한다. ", "episode_num": "15", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17702/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18308, "name": "출동 케이캅 15 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21771, "title": "출동 케이캅", "subject": "비열한 전사, 싸이퍼", "description": "타이탄이 사라진 이후, 크로노스는 싸이퍼를 지구에 급파한다. 싸이퍼는 수단과 방법을 가리지 않는 비열한 악당으로, 사람의 모습으로 변신하는 능력까지 갖추고 있다. 싸이퍼의 계략에 변신이 풀리며 위기에 처하는 케이캅. 이때, 스텔라가 나타나 소환기를 전달하면서 간신히 위기에서 벗어난다. ", "episode_num": "16", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17703/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:24.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18309, "name": "출동 케이캅 16 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21772, "title": "출동 케이캅", "subject": "스마트폰의 저주", "description": "스마트폰 사용이 많아지면서 점점 스마트폰에 중독되는 사람들이 늘어난다. 키마이라는 스마트폰에 중독된 사람들에게 이상한 전파를 발사해 인간 좀비로 만들어버린다. 인간 좀비가 사람들을 공격하는 가운데, 케이캅은 인간 좀비들을 직접 공격할 수 없어 난감해한다. 결국, 케이캅은 스마트폰의 약점인 액정을 공격해 문제를 해결한다.", "episode_num": "17", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17704/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18310, "name": "출동 케이캅 17 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21773, "title": "출동 케이캅", "subject": "몬스터가 된 아이", "description": "왕표와 일당들은 학교에서 왕따인 민수의 장난감(블루 피큐어)을 장난으로 부숴버린다. 싸이퍼는 왕따시키는 나쁜 마음을 이용해 민수를 아이괴물로 만들어버린다. 그동안의 설움과 분노를 폭발시키는 아이괴물. 케이캅이 공격하려하자, 동건이 케이캅의 앞을 막아선다. 동건의 희생으로 다시 아이로 돌아오는 민수. 민수는 동건이라는 든든한 친구가 생긴다. ", "episode_num": "18", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17705/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.900000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18311, "name": "출동 케이캅 18 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21774, "title": "출동 케이캅", "subject": "대결! 블루 대 레드 1", "description": "대수가 동건이네 학교 일일교사를 하는 날. 대수와 한방은 아이들의 ‘블루와 레드 중 누가 더 세냐?’는 물음으로 인해 승부욕이 불타오른다. 키마이라는 사람들의 지나친 승부욕을 이용해 최면제를 개발해 레드에게 흡수시킨다. 이성을 잃은 레드는 블루를 공격하기 시작하고, 블루는 원치 않는 싸움에 휘말리게 된다.   ", "episode_num": "19", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17706/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.600000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18312, "name": "출동 케이캅 19 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21775, "title": "출동 케이캅", "subject": "대결! 블루 대 레드 2", "description": "키마이라의 본부로 끌려가 블랙에너지까지 흡수한 레드는 사람들을 공격하기 시작한다. 출동한 블루는 레드에게 해독제를 복용시키고, 최면에서 풀려난 레드는 키마이라 본부에 홀로 잠복하겠다고 한다. 스텔라는 레드의 작전을 허용하고, 블루와 함께 레드를 추적한다. 적의 기지에 잠입한 레드는 블랙에너지 탱크를 파괴하는데 성공한다.", "episode_num": "20", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17707/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18313, "name": "출동 케이캅 20 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}