th": "https://thumbnail.laftel.net/assets/2018/12/17696/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18302, "name": "출동 케이캅 9 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21765, "title": "출동 케이캅", "subject": "위기의 케이캅!", "description": "동건의 오해가 깊어지면서 대수는 동건이를 더 이상 실망시키지 않기 위해 소환기를 스텔라에게 돌려주고, 스스로의 힘으로 동건이를 지키겠다고 선언한다. 한편, 키마이라는 부실공사로 인해 씽크홀이 생기자, 두더지괴물을 만들어 도심 곳곳에 싱크홀을 만들어낸다. 결국 마음을 돌린 대수는 블루로 변신해 두더지괴물을 체포한다.", "episode_num": "10", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17697/v4/Thumbnail.0000032.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:23.666000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 18303, "name": "출동 케이캅 10 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-05-23T10:30:00", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 21766, "title": "출동 케이캅", "subject": "가장 싫어하는 것!", "description": "동건이와 스텔라는 휴일을 이용해 유기견 보호센터로 봉사활동을 간다. 대수는 한방의 지나친 승부욕을 없애기 위해 유기견(방울이)을 한방에게 맡긴다. 한편, 인간이 가장 싫어하는 것을 이용해 똥폭탄을 만든 키마이라. 긴급 출동한 케이캅이 카마토를 공격해 똥폭탄 발사기를 없앤다.", "episode_num": "11", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17698/v4/Thumbnai