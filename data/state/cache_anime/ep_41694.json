mbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74636/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97302, "name": "빅쿠리맨 7 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-18T02:30:07.355039", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-01-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67277, "title": "빅쿠리맨", "subject": "가짜의 난", "description": "최근에 빅쿠리맨 캐릭터들을 사용한 비공식 상품이 퍼지면서 문제가 되고 있다. 야마토와 친구들은 조광조에게 부탁을 받고, 가짜 상품 회수를 하기 시작한다. 가짜 상품에 미약하게 있는 이력을 찾아, 순조롭게 회수를 해나가던 중 우연히 야마토의 친구인 타카양이 가짜 씰로 인해 위기에 처하는 걸 보게 되는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74639/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97300, "name": "빅쿠리맨 8 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-25T02:30:07.645699", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-01-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67278, "title": "빅쿠리맨", "subject": "과거에 우리는", "description": "야마토와 친구들은 칸에게 병문안을 갔다가 가짜 상품과 교환해 얻은 씰을 맡게 된다. 하지만 마리스가 씰을 포기할 리 없기에 계속해서 씰을 지키기 위해 경계하지만, 그들의 갑작스러운 공격에 씰을 빼앗기고 만다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75530/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97765, "name": "빅쿠리맨 9 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-01T02:30:06.815349", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-01-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67279, "title": "빅쿠리맨", "subject": "당신에게 도움이 되고 싶어서", "description": "어릴 적 씰의 '소리'가 들린 마리스. 피터는 순수하게 그에게 도움이 되고 싶다고 생각하지만, 마리스는 데빌 스토어에서 모습을 감춘다. 한편, 과거의 '성마화합'에 관해 들은 야마토는, 악마와 천사의 싸움은 끝나야 했는데, 여전히 싸우고 있는 것에 의문을 갖는다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75531/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97764, "name": "빅쿠리맨 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-08T02:30:06.933730", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67280, "title": "빅쿠리맨", "subject": "빅쿠리맨이 끝나는 날", "description": "피터의 몸으로 빌려 부활한 슈퍼 데빌은, 블랙 계율로 사람들을 지배하기 시작한다. 변형을 눈치챈 약신자들은 피닉스를 찾아다니지만, 보이지 않는다. 알리바바도 악마의 힘을 깨닫고 마리스를 찾아간다. 그때 마리스 아지트에 나타난 것은…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75532/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list"