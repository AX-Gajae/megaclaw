ion_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24958, "title": "BAKUMATSU [2023년 판권 만료작]", "subject": "금각사의 변! 이조, 죽다?", "description": "증기 기관차를 탈취해 무겐사이의 무기와 탄약을 확보한 사카모토. 하지만 금각사에서 무겐사이와 마주하고 이야기하고 있는 것 또한 사카모토였다. 사카모토는 무겐사이와 거래를 하고 싶다고 말하는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20270/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": "2023-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-11-24T23:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24959, "title": "BAKUMATSU [2023년 판권 만료작]", "subject": "격돌, 마지막 무사!", "description": "신선조가 요시노부를 포기하고 무겐사이를 따르기로 결정했을 때, 야마자키 스스무는 그 결정에 반대하며 신선조를 나갔었다. 이 일을 떠올리며 어느 고민을 하던 콘도는 무겐사이의 명령으로 오키타, 사이토와 함께 세이메이를 찾아 나서는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20271/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": "2023-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-12-01T23:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24960, "title": "BAKUMATSU [2023년 판권 만료작]", "subject": "세이메이 탈환! 감옥섬 탈출", "description": "드디어 세이메이를 발견한 콘도, 오키타, 사이토. 관 속