 true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110858, "name": "(자막) 신의 탑 2기 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 110857, "name": "(자막) 신의 탑 2기 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-14T00:00:12.717568", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-10-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77549, "title": "(자막) 신의 탑 2기", "subject": "스물다섯번째 밤", "description": "아낙과 란의 격투에 끼어들게 된 비올레. 두 사람을 아르키메데스로 전송시키자, 십이수의 팀도 FUG의 호텔에 도착한다. 그리웠던 동료들에게 자신의 정체가 스물다섯번째 밤이라는 사실을 숨겨야만 한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87300/v30/bacb4a1ffd2b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111080, "name": "(자막) 신의 탑 2기 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111079, "name": "(자막) 신의 탑 2기 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-21T00:00:08.096129", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-10-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77550, "title": "(자막) 신의 탑 2기", "subject": "Funky!", "description": "탑승권을 획득한 일행은 아르키메데스에서 잠시 휴식을 취한다. 그 사이 쿤은 라크와 재회하고, 밤을 FUG에서 빼내 오겠다고 다짐한다. 각자의 마음이 교차하고, 마침내 공방전이 개막된다.", "episode_num": "17", "episode_ord