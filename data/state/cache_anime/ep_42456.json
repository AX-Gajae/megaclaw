ets/2024/12/89647/v30/65ee53fd2827/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114068, "name": "비탄의 망령은 은퇴하고 싶다 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 114067, "name": "비탄의 망령은 은퇴하고 싶다 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-12-17T03:00:09.569369", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-12-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80087, "title": "비탄의 망령은 은퇴하고 싶다", "subject": "뭐가 됐든 낙찰받고 싶다", "description": "드디어 시작된 옥션. 크라이는 눈여겨본 보구 단 하나를 낙찰받기 위해 거액의 빚을 졌지만, 단상에 오르는 갖가지 보구들에 눈길을 빼앗겨 마음이 흔들리고 말았다. 크라이의 이성과 참을성이 한계에 달했을 무렵, 경매장에 출품된 것은 시트리가 원했던 아카샤 골렘이었다. 시트리의 마음을 헤아린 크라이는 본래 노렸던 보구를 포기하고, 골렘을 낙찰받기 위해 가진 모든 것을 투자해 크나큰 승부에 나섰다. 갖가지 생각이 교착하는 옥션. 과연 그 결말은?", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/90009/v30/33c1015fd4f5/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114252, "name": "비탄의 망령은 은퇴하고 싶다 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 114251, "name": "비탄의 망령은 은퇴하고 싶다 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-12-24T03:00:07.392799", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-12-23", "rating_components": []}, "access_type": null, "is_availab