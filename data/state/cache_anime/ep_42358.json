able": false}, {"id": 76492, "title": "(자막) 원피스 15기", "subject": "밀짚모자 일당, 충격! / 그들에게 전해진 나쁜 소식", "description": "샤본디 제도에서 쿠마에 의해 뿔뿔이 헤어진 루피의 동료들은 각각 자신이 떨어진 섬에서 고군분투 하던 중, 정상전쟁의 결과를 듣게 된다. 루피가 눈앞에서 자신의 형을 잃었다는 걸 알게 된 동료들은 모두 같은 마음으로 안타까워하는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85631/v30/8ee6226d9110/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109305, "name": "(자막) 원피스 15기 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-30T00:00:12.845660", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 76493, "title": "(자막) 원피스 15기", "subject": "명왕 레일리와의 재회 / 루피, 결단의 때", "description": "루피가 숨어있는 여인섬에 레일리가 나타난다. 바솔로뮤 쿠마가 날렸던 방향을 가르쳐줬고, 임펠다운 잠입으로 미뤄보아 행콕이 숨겨줬으리란 샤키의 예상이 적중했던 것. 동료들을 만나고 싶다며 샤본디에 가겠다는 루피에게 레일리는 한 가지 제안을 한다. 한편 우솝은 신문을 읽고 보인 열도를 탈출하려 하지만 번번이 실패하고 괴로워하는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85632/v30/50570b274e47/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109306, "name": "(자막) 원피스 15기 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-30T00:00:12.845660", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-29