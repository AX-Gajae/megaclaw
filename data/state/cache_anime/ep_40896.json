ating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-06-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55013, "title": "은하철도 999 part 3", "subject": "생명을 먹는 성녀 전편", "description": "일 년 내내 비가 내리는 별, '비의 연못'에 내린 테츠로와 메텔은 홍수에 휩쓸려 여관 2층으로 대피한다. \r\n그때 아크라는 여성이 배를 타고 나타나 돈을 내면 구해주겠다고 하지만, 테츠로는 그 제안을 거절한다.\r\n결국 급류에 휩쓸려 메텔과 헤어지게 된 테츠로는 가까스로 작은 섬에 도착하고, 이상한 등대 건물 안으로 들어간다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58141/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:41.333000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73600, "name": "은하철도 999 part 3 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-06-21T19:00:00.188957", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-06-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55489, "title": "은하철도 999 part 3", "subject": "생명을 먹는 성녀 후편", "description": "테츠로는 아크가 메텔한테서 꺼낸 생명의 불을 빼앗아 도망치는 과정에서\r\n아크가 인간으로 돌아가기 위해 쿠플레임 여왕 밑에서 일한다는 사실을 알게 된다.\r\n하지만 결국 테츠로는 붙잡혀 생명의 불을 빼앗길 위기에 처하고, \r\n여왕은 메텔의 생명의 불을 마시려고 한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58392/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:41.733000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74464, "name": "은하철도 999 part 3 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime":