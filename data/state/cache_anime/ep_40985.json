": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-03T01:00:10.127238", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55635, "title": "은하철도 999 part 4", "subject": "영원한 꿈을 좇는 별", "description": "999는 꿈을 좇는 별에 도착한다. \r\n그런데 이곳은 과학만능주의를 철저히 따르는 행성으로 직업의 자유가 없으며 정부에서 정해 준 직업에 충실하지 않은 자는 즉시 처형된다.\r\n아론은 관제관이라는 자신의 업무를 억지로 하고 있지만, 마음 속으로는 아직 만화가의 꿈을 버리지 못하고 있다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/59329/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75149, "name": "은하철도 999 part 4 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-03T01:00:10.127238", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55872, "title": "은하철도 999 part 4", "subject": "세인트 퀸의 반란 별", "description": "세인트 퀸의 반란 별은 꿀벌족과 말벌족, 나나니벌족 등의 벌족이 공존하는데, \r\n두 명의 여왕을 허용하지 않는 오랜 습성 때문에 가장 큰 세력인 꿀벌족과 말벌족이 늘 팽팽한 대립 관계에 있다.\r\n이 별에 도착한 테츠로와 메텔은 두 벌족의 어리석은 싸움을 후손에게 남기고자 기록 영화를 만드는 담을 만난다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/59582/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75147, "name": "은하철도 999 part 4 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-09T19:00:08.415231", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55873, "title": "은하철도 999 part 4", "subject": "안드로메다 천일야화 전편", "description": "999는 행성 알리바바에서 갑작스러운 공격을 받고 정차 역에서 멀리 떨어진 사막 한가운데 불시착한다.\r\n마을을 찾으러 나간 테츠로와 메텔은 도적을 만나 가진 걸 전부 털리고 도적의 거처로 끌려간다.\r\n그곳에서 도적의 두목인 알리바바가 두 사람에게 한 가지 제안을 하는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/59583/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:41.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75145, "name": "은하철도 999 part 4 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-09T19:00:08.415231", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55874, "title": "은하철도 999 part 4", "subject": "안드로메다 천일야화 후편", "description": "식인 새 로크에게 쫓기다 위기를 벗어난 테츠로는 999로 돌아가지만, 메텔은 본가 알리바바라는 여자에게 납치된 뒤였다.\r\n그런데 본가 알리바바 역시 가짜 알라바바에게 메텔을 빼앗기고 사막에 쓰러진다. \r\n메텔을 찾으러 나섰다가 본가 알리바바를 발견한 테츠로는 그녀와 함께 메텔을 찾기 위해 가짜 알리바바의 거처로 향한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/59584/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75143, "name": "은하철도 999 part 4 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-09T19:00:08.415231", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55875, "title": "은하철도 999 part 4", "subject": "젊은 전사의 전설", "description": "무기력한 기계 인간이 살고 있는 전설 행성. \r\n이 별의 호텔에서 잠을 자던 테츠로는 안개 속에서 나타난 소년과 소녀에게 납치된다. \r\n그들의 아지트에 감금된 테츠로는 함께 기계 인간과 싸워 달라는 말을 듣는다. \r\n테츠로는 인간을 벌레 취급하는 기계 인간의 극악무도함에 공감하면서도 엄마와 약속을 지키기 위해 제안을 거절한다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/59585/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75142, "name": "은하철도 999 part 4 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-09T19:00:08.415231", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56062, "title": "은하철도 999 part 4", "subject": "유령역 13호", "description": "무료함을 달래기 위해 열차 안을 무중력 상태로 만들어 공중 수영을 즐기던 테츠로와 차장은 갑자기 중력 장치가 켜지면서 바닥으로 떨어진다. \r\n범인을 찾지 못한 채 999 열차는 노선도에 없는 13호 역에 도착한다. \r\n메텔은 열차에서 내려 역 한가운데서 사라지고, 열차에 남은 테츠로는 검은 실루엣의 소녀를 만난다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59753/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75537, "name": "은하철도 999 part 4 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-16T09:00:08.281438", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56063, "title": "은하철도 999 part 4", "subject": "킬리만자로의 조종사", "description": "복엽기를 탄 양국의 조종사들이 끊임없이 싸우는 별, 킬리만자로의 기사. \r\n테츠로는 이곳에서 군을 지휘하는 귀족 출신의 기사도 정신에 환멸을 느껴 전투를 피하는 평민 출신의 조종사, 이자카를 알게 된다. \r\n그러나 이자카가 동생처럼 아끼던 키쿠오가 적군에게 죽음을 당하고, 분노한 이자카는 휴전 조약을 깨고 적군으로 향한다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59754/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.366000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75536, "name": "은하철도 999 part 4 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-16T09:00:08.281438", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56064, "title": "은하철도 999 part 4", "subject": "마카로니 그라탱의 붕괴", "description": "늘 지루함을 느끼던 기계 인간 메인과 서브는 과학 문명이 극도로 발달한 행성 마카로니 그라탱을 탈출하기로 결심한다. \r\n메인과 서브는 자신들을 철저히 감독하는 마더 컴퓨터 주니어의 감시를 속이기 위해 테츠로와 메텔을 붙잡아 두고, 두 사람 대신 999에 올라탄다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59755/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.566000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75535, "name": "은하철도 999 part 4 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-16T09:00:08.281438", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56065, "title": "은하철도 999 part 4", "subject": "메텔의 여행 전편", "description": "999호는 지연된 운행 시간을 단축하기 위해 워프를 발동한다. \r\n그런데 워프 공간에 또 다른 999호가 나타나면서 두 대의 999호가 충돌하고 만다. \r\n게다가 또 다른 999호에는 똑같은 메텔과 똑같은 차장이 타고 있는데, 메텔과 함께 여행하는 건 테츠로가 아닌 레드릴이란 소년이었다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59756/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75534, "name": "은하철도 999 part 4 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-08-16T09:00:08.281438", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56066, "title": "은하철도 999 part 4", "subject": "메텔의 여행 후편", "description": "테츠로와 레드릴은 행성 팬텀에서 두 명의 메텔이 쓰려져 있는 걸 발견한다. \r\n그런데 그 순간 미지의 생명체가 나타나 무기를 버리고 옷을 벗으라며 위협한다.\r\n그들은 테츠로 일행이 살아 있는 인간인지 기계 인간인지 확인한 뒤 열차로 돌려보내 준다.\r\n그런데 999로 돌아오자마자, 두 명의 차장이 인질로 잡히는 사건이 벌어진다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59846/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:41.833000"