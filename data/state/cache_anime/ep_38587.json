_products": [], "published_datetime": "2018-07-26T14:04:50.461582", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 20900, "title": "풀 메탈 패닉! IV : Invisible Victory [2024년 판권 만료작]", "subject": "메이크 마이 데이", "description": "치도리를 데리고 탈출을 시도하는 레너드. 치도리는 소스케가 왔다는 것을 눈치 채고 레너드에게 묻자 그는 소스케에게 가려면 자신을 총으로 쏘고 도망치라고 한다. 결국 치도리는 쏘지 못하지만 그녀를 끌고 가려는 레너드와 실랑이를 벌이다 실수로 그에게 쏘고 만다. 한편 소스케는 자신의 AS였던 알과 다시 만나는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/17015/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:14.066000", "progressbar": null, "item_expire_datetime": "2024-05-08T21:47:24", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-07-27T15:13:16.228362", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}