{"count": 50, "next": "https://api.laftel.net/api/episodes/v2/list/?item_id=46565&limit=20&offset=20&size=1&sort=oldest", "previous": null, "results": [{"id": 96550, "title": "파워레인저 고버스터즈", "subject": "고버스터즈, 집결하라!", "description": "메타 로이드인 쇼벨 로이드가 나타나 블루와 옐로우 버스터가 출동한다. 하지만 아공간에서 메가 조드인 쇼벨 조드가 전송되어 오는데.. 쇼벨 조드는 에네트론을 빼앗기 위해 에네트론 탱크로 향한다. 블루와 옐로우만으로는 역부족인 상황. 이때 레드 버스터인 재키가 나타난다.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108050/v51/f326fda69158/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:36.107000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138520, "name": "파워레인저 고버스터즈 1 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:36.362518", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2013-07-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96551, "title": "파워레인저 고버스터즈", "subject": "13년 전의 약속", "description": "재키만 특별대우를 받는 것 같아 불만인 라비. 라비는 재키에 왜 갑자기 팀에 들어왔냐고 따지고, 재키는 약속을 지키기 위해서라고 한다. 버너 로이드의 출현. 버스터즈들은 힘을 합쳐 싸우고, 라비는 재키가 13년 전의 약속을 기억하고 있었다는 사실을 알고 그를 다시 본다.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108051/v51/3fff643ede64/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:51.076000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138521, "name": "파워레인저 고버스터즈 2 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:36.601134", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2013-07-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96552, "title": "파워레인저 고버스터즈", "subject": "GT-02애니멀, 출격!", "description": "니들 로이드를 삭제하기 위해 병원에 간 버스터즈. 라비는 재키가 자꾸 어린 애 취급을 해서 화가 난다. 그래서 라비는 재키에게 자긴 이제 13년 전에 울기만 했던 아이가 아니라고, 류와 함께 셋이서 약속을 지키고 싶다고 한다. 그 말에 놀란 재키. 둘은 힘을 합쳐 니들 로이드를 물리친다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108052/v51/615e919e37fc/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:51.076000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138522, "name": "파워레인저 고버스터즈 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:36.825224", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2013-07-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96553, "title": "파워레인저 고버스터즈", "subject": "특명과 결의", "description": "아공간에 생존자가 없을 것이라는 케인의 말에 놀란 고버스터즈. 라비는 재키가 충격을 받았을까봐 걱정을 한다. 하지만 전송된 사람들이 살아있을 것이라고 굳게 믿는 재키. 류와 라비도 재키의 말을 믿고 힘을 내서 메타 로이드에 맞서 싸운다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108053/v51/4bf6a4e4e3da/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:52.077000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138523, "name": "파워레인저 고버스터즈 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:37.051561", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2013-07-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96554, "title": "파워레인저 고버스터즈", "subject": "위험한 열 폭주!", "description": "타이어 로이드에 맞서 싸우던 류가 열 폭주를 하고 만다. 라비는 그런 류를 말리려고 하지만 류는 라비에게도 폭력적으로 대하는데.. 평소와는 다른 류의 모습에 충격을 받은 라비. 하지만 자신에게 그런 모습을 안 보이기 위해 참아왔던 류의 진심을 깨닫고 라비도 그동안 류에게 의지만 했던 자신을 반성한다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108056/v51/1b6b1854122a/Thumbnail.0000052.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:52.144000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138524, "name": "파워레인저 고버스터즈 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:37.274459", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2013-07-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96555, "title": "파워레인저 고버스터즈", "subject": "합체, 고버스터 킹!", "description": "고버스터 킹으로 합체를 시도하는 재키. 하지만 타이밍이 안 맞아 번번이 실패한다. 그러던 중 엔터가 스프레이 로이드와 함께 제7격납고에 침입하고 메가 조드를 기동시킨다. 격납고에 갇힌 고버스터즈. 이때 류는 마지막 격벽이 닫히는 순간, 재키를 내보내서 자신들을 구해달라고 한다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108057/v51/2e670922a684/Thumbnail.0000051.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:37.062000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138525, "name": "파워레인저 고버스터즈 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:37.504698", "rating": {"rating": 7, "rating_type"