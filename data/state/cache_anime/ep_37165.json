ting": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-04-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8886, "title": "제로에서 시작하는 마법의 서", "subject": "결투", "description": "제로 일행은 상업의 중심지인 포미컴에 도착하지만 수인이라는 이유로 숙소가 잘 잡히지 않는다. 그러던 차에 노예 소녀들을 데리고 다니는 개의 모습을 한 수인과 만나게 되고 숙소 정보를 듣게 된다. 그날 밤, 다시 만나게 된 개 모습의 수인은, 노예들은 마녀이고 자신이 숨겨주고 있는 것이라 말하지만 용병은 소녀들이 마녀가 아니란 것을 눈치채는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7049/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6254, "name": "제로에서 시작하는 마법의 서 3 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24705, "name": "제로에서 시작하는 마법의 서 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:02.330471", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-04-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8887, "title": "제로에서 시작하는 마법의 서", "subject": "라테트로 가는 길", "description": "포미컴에서 잠깐의 휴식을 즐기고 제로의 마술사단의 은둔처가 있는 라테트를 향해 출발한 제로 일행. 라테트까지 가는 길은 고향의 움막밖에 모르고 살았던 제로에게 있어선 특별한 경험이 되었다. 이윽고 도달한 라테트의 입구에서 일행은 충격적인 장면을 목격하게 되는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7050/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6255, "name": "제로에서 시작하는 마법의 서 4 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24706, "name": "제로에서 시작하는 마법의 서 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:02.304076", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8888, "title": "제로에서 시작하는 마법의 서", "subject": "제로의 마술사단", "description": "라테트에 도착한 제로 일행은 눈 앞엔 무참한 광경이 펼쳐져 있었다. 마술사라고 추정되는 사람을 포함한 마을 사람들의 시체가 여기저기에 흩어져있는 기이한 광경을 확인한 제로는 이것은 마녀의 습격이라며 단언하는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7051/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6256, "name": "제로에서 시작하는 마법의 서 5 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24707, "name": "제로에서 시작하는 마법의 서 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:02.275733", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8889, "title": "제로에서 시작하는 마법의 서", "subject": "13번", "description": "강제소환에 의해 제로 일행이 불려내진 곳은 왕도 플라스타에 있는 왕성 안이었다. 제로의 서를 찾고있는 13번은 책을 탈환해 마녀를 질서를 되찾기 위해 국가마술사가 되었다고 말한다. 게다가 반발하는 알바스를 교묘한 말로 몰아넣고선 협력하지 않으면 화형 시키겠다고 말한다. 한편, 동료에게 배신당한 과거를 가진 용병은 알바스를 도우려 하지 않는 제로를 보고 의심과 불안함이 커지게 되는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7052/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0: