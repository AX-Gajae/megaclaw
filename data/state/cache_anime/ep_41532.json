ting_components": []}, "access_type": null, "is_available": false}, {"id": 65718, "title": "헬크", "subject": "반역자", "description": "궁지에 몰린 헬크를 구해준 건 자아를 되찾은 크레스였다. 하지만 다시 왕의 언술이 크레스를 공격한다. 형을 지키기 위해 크레스가 선택한 결말에 헬크는 슬픔과 분노로 폭주한다. 치열한 싸움 속에서 의식을 잃은 헬크. 웬 동굴에서 정신을 차린 헬크는 자신과 동료들이 처한 상황을 듣고 깜짝 놀란다. 그리고 헬크는 어떤 결심을 하는데...", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73396/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89536, "name": "헬크 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 89535, "name": "헬크 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-02T01:00:09.105701", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-11-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66074, "title": "헬크", "subject": "웃는 얼굴", "description": "달려가는 헬크의 앞을 가로막는 현상금 사냥꾼과 병사들. 많은 병사들을 전부 쓰러뜨리고 왕도로 향하는 헬크. 왕도에서 본 것은 사형장에 끌려나 온 알리시아의 처참한 모습이었다. 사람들의 추악한 모습에 헬크는 분노했지만, 알리시아는 상처를 입었으면서도 그를 걱정한다. 이윽고 두 사람의 재회를 축하하듯 눈이 내리기 시작하는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73508/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89965, "name": "헬크 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 89964, "name": "헬크 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_date