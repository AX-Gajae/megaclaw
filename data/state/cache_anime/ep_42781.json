ing_components": []}, "access_type": null, "is_available": false}, {"id": 81767, "title": "이얍! 스페이스 정글 시즌 1", "subject": "새 외", "description": "카오 일행과 마주한 거대 새... 눈앞에서 물고기 한 마리를 꿀꺽해버린다. 위험을 느낀 카오. 돌도 한줌에 날려버리는 레이저 총을 들어 새를 향해 쏴보지만 전혀 효과가 없다. 새, 카오를 물고 저 멀리 날아가 버린다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91430/v30/201c54a5f441/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116350, "name": "이얍! 스페이스 정글 시즌 1 3 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:16.748268", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2014-09-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81768, "title": "이얍! 스페이스 정글 시즌 1", "subject": "집짓기 외", "description": "어두워진 하늘 사이로 빗방울이 떨어지자 참치 캔 아래로 혼자 비를 피하는 카오. 모와 오키 더 큰 우유갑을 찾아 비를 피한다. 이에 질세라 우유팩 보다 더 높은 집을 짓는 카오. 그리고 시작된 집짓기 경쟁!", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91431/v30/646aa6bb0a20/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116351, "name": "이얍! 스페이스 정글 시즌 1 4 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:16.865822", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2014-09-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81769, "title": "이얍! 스페이스 정글 시즌 1", "subject": "올라가기 외", "description": "집안으로 들어갈 창문을 발견한 카오 일행. 운동신경이 좋은 루가 손쉽게 창문 곁에 올라가 나머지 멤버들을 위해 카오가 던진 줄을 받아들고 고정시킨다. 하나 둘씩 벽을 타고 올라가는 3마리. 오키 모 무사히 올라가는 듯 했지만 모의 실수로 4마리 모두 창문 아래로 떨어질 상황에 처하게 되는데...", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91432/v30/fd2b0ebf2155/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116352, "name": "이얍! 스페이스 정글 시즌 1 5 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:16.985082", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2014-10-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81770, "title": "이얍! 스페이스 정글 시즌 1", "subject": "고무줄 외", "description": "테이블 위 소품들을 이것저것 건드려보며 놀고 있는 카오일행. 고무줄을 발견한 모. 그런 모에게 다가가는 카오, 모가 잡고 있는 고무줄의 반대편을 잡아 길게 늘여 본다. 무심코 줄을 놓친 모. 반동으로 카오 얼굴을 세게 맞게 되고 매우 괴로워한다. 오기가 난 카오 한 번 더 고무줄을 길게 늘여보는데 이번에도 얼굴을 맞게 되는 카오... 모가 맞을 때까지 계속 시도해 보지만...", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91433/v30/dd52d5904c85/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116353, "name": "이얍! 스페이스 정글 시즌 1 6 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:17.101034", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2014-10-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81771, "title": "이얍! 스페이스 정글 시즌 1", "subject": "거미 외", "description": "낮잠을 자고 있는 오키, 카오, 모. 갑자기 거미 한 마리가 카오의 팔목에 붙어 떨어지지 않아 당황하는 카오. 그러나 곧 마치 스파이더맨처럼 거미줄을 이용하기 시작, 나머지 멤버들을 거미줄로 움직이지 못하게 한 뒤 자신 혼자 맛있는 사과를 먹으려는데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91434/v30/e8fbe85b356d/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116354, "name": "이얍! 스페이스 정글 시즌 1 7 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:17.218933", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2014-10-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81772, "title": "이얍! 스페이스 정글 시즌 1", "subject": "꼭두각시 외", "description": "음식을 들고 가는 오키 앞에 나타난 해골 인형! 춤을 추며 오키에게 다가가자 오키 역시 해골과 함께 춤을 춘다. 그러다 갑자기 춤추기를 멈추는 해골... 그리고 오키의 과자를 슬쩍 처다 보고 오키, 자신의 과자를 해골에게 나눠준다. 다시 시작되는 춤사위. 그 모습을 수상하게 생각한 루, 해골에 연결된 줄을 끌어 카오와 모가 해골을 조정하고 있던 사실을 밝히지만 오히려 그런 루를 책망하는 오키... 사실 모든 상황을 이미 눈치 채고 있었는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91435/v30/9927d2f319ed/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:51.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 116355, "name": "이얍! 스페이스 정글 시즌 1 8 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2025-03-21T00:00:17.335621", "rati