gressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1120, "name": "겁쟁이 페달 GRANDE ROAD (2기) 12 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T17:03:37.975194", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 1507, "title": "겁쟁이 페달 2기 GRANDE ROAD", "subject": "ROAD.13 질주 야마나카 호수", "description": "이즈미다의 가속으로 소호쿠와 차이를 벌려 독주하는 하코네 학교. 킨조들은 그 차이가 결정적인 거리가 되기 전에 1학년과 교대하고 팀을 끌기 시작한다. 그런 3학년의 실력 앞에 그저 지켜볼 수 밖에 없는 자신들의 무력함을 느끼는 이마이즈미와 나루코. 하지만 사카미치는 그런 선배들의 등을 바라보며 무언가 감지하기 위해 노력한다. ", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/1733/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.366000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1121, "name": "겁쟁이 페달 GRANDE ROAD (2기) 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T17:03:38.020744", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 1508, "title": "겁쟁이 페달 2기 GRANDE ROAD", "subject": "ROAD.14 최후의 작전", "description": "3학년의 추격으로 인해 한 번은 하코네 학교와 나란히 선 소호쿠지만, 신카이의 가속으로 다시 뒤쳐지게 된다. 하지만 타도코로가 최후의 전력 리드로 팀을 운반하고, 결국 하코네 학교를 붙잡는다. 그리고 코스는 라스트 스테이지인 산악코스에 들어간다. 골을 향해 움직이기 시작하는 그 순간, 2번째의 레이스에서 무릎을 다친 킨조에게 이변이…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/1734/v1/Thumbnail.0000057.jpg", "has_preview": true