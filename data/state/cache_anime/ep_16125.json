, "published_datetime": "2026-04-11T00:00:13.654748", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2025-12-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92858, "title": "(더빙) 달빛천사", "subject": "풀문 데뷔!", "description": "마침내 풀문의 첫 라이브 공연 일정이 잡히지만, 우연히, 오디션에서 뽑힌 게 실력이 아니라 얼굴 때문이라는 말을 듣게 된 루나는, 자신을 잃고 불안해한다. \n타토는 그런 루나에게, 처음 루나의 노래를 들었을 때의 느낌을 솔직히 말해주고 그 말에 용기를 얻은 루나는 당당히 무대에 서 성공적으로 공연을 마친다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105533/v30/f52aa6061846/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:47.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131862, "name": "(더빙) 달빛천사 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-11T00:00:14.090762", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2025-12-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92859, "title": "(더빙) 달빛천사", "subject": "풀문 노래 어때?", "description": "풀문의 데뷔 앨범이 대히트라는 매니저의 말에 루나는 들뜬 마음으로 학교로 향하지만 아무도 풀문을 알아주지 않자 실망한다. \n친구들이 알아주길 원한다면 먼저 다가가서 얘기해보라는 타토의 말에도 루나는 차마 용기를 내지 못하지만, 루나로 변신한 멜로니의 너스레로 친구들과 자연스럽게 어울릴 수 있게 된다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105534/v30/26dabd056b83/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:47.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131863, "name": "(더빙) 달빛천사 8 대여", "list_pric