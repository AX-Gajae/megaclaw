e": "0:20:47.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131876, "name": "(더빙) 달빛천사 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-11T00:00:16.466128", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2025-12-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92870, "title": "(더빙) 달빛천사", "subject": "들리지 않는 노래", "description": "풀문이 은퇴한다는 소문이 파다한 가운데 매니저와 프리스 선생은 사라진 루나를 찾아다닌다. \n한편, 사람들 눈을 피해 바닷가에 가있던 루나는 타토의 노래를 듣고, 다시 노래하기로 결심하고 프리스 선생과 매니저에게 자신의 비밀을 털어놓는다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105522/v30/7ffbfa707fe7/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:47.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131877, "name": "(더빙) 달빛천사 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-11T00:00:16.678783", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2025-12-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92871, "title": "(더빙) 달빛천사", "subject": "외톨이가 된 멜로니", "description": "멜로니에게 화가 난 타토는 멜로니 얘기조차 꺼내지 못하게 하고 멜로니는 그런 타토가 무서워 집에 들어오지 못한 채 학교 체육관에서 지낸다. \n둘을 화해시킬 방법을 찾던 루나는 불꽃놀이를 생각해내고 멜로니와 타토는 루나의 불꽃놀이를 도와주며 화해한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105524/v30/b0ac3d1ac41c/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:47