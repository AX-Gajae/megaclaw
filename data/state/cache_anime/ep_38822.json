ion_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22966, "title": "ISLAND [2021년 판권 만료작]", "subject": "더는 후회하고 싶지 않으니까", "description": "희망이 보이지 않는 도시에서 세츠나는 사라와 카렌을 도우며 애쓰지만 계속된 비운에 좌절한다. 그러던 와중에 린네는 발명을 완성하고, 세츠나는 인류의 존망이 걸린 과거를 바꾸기 위해 타임머신에 오른다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18554/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.100000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-09-10T13:46:47.686496", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22967, "title": "ISLAND [2021년 판권 만료작]", "subject": "다시 만났지만 당신은", "description": "해변가에서 눈을 뜬 세츠나는 자신이 그 여름과 똑같은 곳에 있다는 것을 알게 된다. 그리고, 이후의 일들도 모두 그때와 똑같이 흘러간다. 세츠나는 단 하나의 사건의 결말을 바꾸기 위해 그 순간을 향해 나아간다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18555/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:47.166000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-09-17T13:42:40.203246", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22968, "title": "ISLAND [2021년 판권 만료작]", "subject": "손을 맞잡고 내일로", "description": "쿠온이 자신이 아는 린네일 거라고 직감한 세츠나는 오하라 노리마