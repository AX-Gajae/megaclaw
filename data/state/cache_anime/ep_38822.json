s_available": false}, {"id": 22959, "title": "ISLAND [2021년 판권 만료작]", "subject": "꿈을 자아내는 올바른 방법", "description": "세츠나와 카렌, 사라는 린네를 밖으로 나오게 하기 위해 갖가지 방법을 동원하고, 모두의 응원 속에 밖으로 나온 린네는 자신이 문매병이 아님을 확인한다. 그러나, 수상한 폐가를 발견한 이들이 문을 열려고 하자 린네는 발작을 일으키며 쓰러지고 마는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18546/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:27.100000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-20T14:32:32.425843", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22960, "title": "ISLAND [2021년 판권 만료작]", "subject": "이 세계는 비밀투성이", "description": "카렌의 가짜 결혼식을 엉망으로 만들어버린 세츠나는, 그녀와 함께 도망치듯 본토로 나온다. 그리고 향한 곳은 카렌의 엄마가 있는 곳. 오빠에게서 전해 받은 엄마의 주소를 들고 찾아간 곳에서 카렌은 그만 눈물을 흘리고 마는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18548/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.100000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-20T14:32:32.425843", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22961, "title": "ISLAND [2021년 판권 만료작]", "subject": "그러니까 당신을 믿어", "description": "자신에겐 시간이 없다며 조급해하던 사라는, 시간을 건너왔다는 세츠나를 자신의 운명의 남자라 믿는다. 하지만, 가란도 가문의 검은 진실을 알게 된 린네가 이를 세츠나에게 전하는 걸 우연히 듣고 그대로 뛰쳐나가 버리고 마는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18550/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:24.766000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-27T10:33:11.831642", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22962, "title": "ISLAND [2021년 판권 만료작]", "subject": "거기 당신이 있으면 돼", "description": "카렌과 사라의 일이 일단락되자, 린네는 세츠나에게 이번엔 자신의 세츠나가 돼 달라고 말한다. 그리고 시작된 두 사람의 행복한 나날들. 린네는 확실히 과거와 작별하고, 앞으로 나아가기로 결심한다. ", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18549/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:24.100000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-08-27T10:33:11.831642", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22963, "title": "ISLAND [2021년 판권 만료작]", "subject": "영원히 사랑하고 싶은데", "description": "세츠나와 린네는 과거를 잊고 앞으로 나아가기로 약속하지만, 여전히 씻기지 않는 아픈 기억이 린네를 괴롭힌다. 폭풍이 오면 진실의 문이 열릴 거라 믿는 린네는, 홀로 거센 파도가 이는 밤바다로 향하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18551/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.166000", "progressbar": null, "item_expire_datetime": "2021-07-31T23:3