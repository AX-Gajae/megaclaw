와와 함께 비스코는 철인의 용광로에 떨어졌다. 폭주하는 용광로와 붕괴하기 시작하는 돔에서 미로 일행은 간발의 차이로 탈출했지만, 비스코를 잃은 슬픔에 잠길 틈도 없이 또 다른 시련이 연이어 닥쳐왔다. 비스코가 없는 지금, 미로는 남아있는 자신이 무엇을 할 수 있는가를 스스로에게 물었는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/56037/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70904, "name": "녹을 먹는 비스코 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70903, "name": "녹을 먹는 비스코 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-03-15T23:00:00.073148", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-03-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53290, "title": "녹을 먹는 비스코", "subject": "내가 비스코다!", "description": "부활한 철인은 모든 것을 차례로 파괴하면서 나아갔다. 이대로라면 일본은 다시 한번 녹으로 뒤덮일지도 모르는 상황. 비스코의 영혼을 이어받은 미로는 과감하게 철인과 맞섰다. 그렇게 자비와 파우, 급히 달려온 티롤과도 협력해서 폭주하는 철인을 몰아붙이고 있었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/56148/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 71051, "name": "녹을 먹는 비스코 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 71050, "name": "녹을 먹는 비스코 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-03-22T23:00:00.079015", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스"