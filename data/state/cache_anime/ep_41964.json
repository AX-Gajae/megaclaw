motion": null}, {"id": 100815, "name": "터닝메카드 리마스터 12 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-26T00:00:09.182184", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-03-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69177, "title": "터닝메카드 리마스터", "subject": "형제의 배틀", "description": "반다인과 싸워 타나토스를 빼앗으려고 에반을 학교에 데려온 찬은 수업이 귀에 들어오지 않는다. 한편 이대로는 버림받을 것이라는 생각에 초조한 도깨비단은 찬의 학교에 숨어들어가 메카니멀들을 풀어 찬을 찾게 한다. 그러나 그때 학교에서 피난 훈련이 시작되면서 학생들이 대피 연습을 위해 복도로 쏟아져나온다. 어수선한 속에서 학생들이 메카니멀을 발견하며 큰 소란이 일어나는데…!", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/79530/v15/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:43.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 101288, "name": "터닝메카드 리마스터 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 101287, "name": "터닝메카드 리마스터 13 소장", "list_price": 1000, "period": "0 day", "promotion": null}], "published_datetime": "2024-04-02T00:00:08.951392", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-03-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69178, "title": "터닝메카드 리마스터", "subject": "백수의 왕과 숲의 왕자", "description": "메카니멀 레이더를 따라 동물원에 온 리안. 도깨비단은 반다인의 프린스콩을 몰래 가지고 나와 리안의 뒤를 밟다가 리안의 레이더를 빼앗는다. 도망가던 도깨비단이 맹수 우리에 들어가면서 사자의 탈출 소동이 일어나지만 동물원에 살고 있던 메카니멀 파이온이 사자를 교묘히 유인해 포획에 성공한다. 타이밍 좋게 나타난 리안이 파이온을 테이밍하자 도깨비단은 떼를 쓰며 리안에게 결투를 신청한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/79555/v15/Thumbnail.0000028.jpg", "has_preview": true, "access_