 true, "products": [], "episode_products": [{"id": 74943, "name": "이세계 미궁에서 하렘을 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 74942, "name": "이세계 미궁에서 하렘을 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-07-28T03:30:08.295901", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-07-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55884, "title": "이세계 미궁에서 하렘을", "subject": "결정", "description": "록산느와 미궁에 들어가 다시 한번 이 세계에 대해 배우게 되는 미치오. 지금까지 자신의 마음대로 행동했던 것들이 쓸데없었고 손실이 많았던 행동임을 깨닫게 된다. 록산느에게 배운 지식과 게임의 이론, 재설정 기술을 사용하여 미치오는 미궁 안에서 효율적으로 돈을 벌 수 있는 방법을 생각해낸다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59724/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75180, "name": "이세계 미궁에서 하렘을 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75179, "name": "이세계 미궁에서 하렘을 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-04T03:30:09.146924", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-08-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55993, "title": "이세계 미궁에서 하렘을", "subject": "시련", "description": "미치오와 록산느는 1층 보스와의 대결에서 승리한다. 보스의 드롭 아이템인 리프를 주운 록산느가 약초 채취사 직업을 획득한 것을 보고 미궁 안에서의 새로운 스킬 향상 방법을 생각해 내는 미치오. 게임의 지식도 더하여 효율적으로 미궁 공략을 진행한다. 그대로 다음 2층에 이른 두 사람에게는 새로운 적이 기다리고 있었다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/01/64439/v15/Thumbnail.0000057.j