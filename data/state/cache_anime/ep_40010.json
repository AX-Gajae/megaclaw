]}, "access_type": null, "is_available": false}, {"id": 44286, "title": "신이 된 날 [2025년 판권 만료작]", "subject": "네가 '선택'한 날", "description": "위장 신분이 발각되어 시설에서 쫓겨나게 된 요타. 시바로부터 히나가 다른 시설로 옮겨진다는 말을 듣고, 시바에게 부탁해서 마지막으로 히나와 보낼 수 있는 시간을 얻게 된다. '함께 지낸 그 여름날'의 추억을 이야기하면서 요타는 '함께 살고 싶어?'라고 히나에게 묻는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/12/44291/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12.466000", "progressbar": null, "item_expire_datetime": "2025-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-12-28T00:00:01.858325", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2020-12-27", "rating_components": []}, "access_type": null, "is_available": false}]}