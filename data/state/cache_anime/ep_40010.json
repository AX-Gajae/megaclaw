30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-11-22T23:30:00.047017", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2020-11-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 43691, "title": "신이 된 날 [2025년 판권 만료작]", "subject": "바다를 보러 간 날", "description": "영화 촬영은 순조롭게 진행되었고 여름 방학도 이제 얼마 남지 않았다. 히나가 말하는 '세계의 종말'이 가까워져 오면서 요타는 히나가 갑자기 없어져 버릴까 불안해한다. 요타는 작정하고 히나의 부모님을 찾아가 히나에 대해서 묻기로 하는데......", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/11/43435/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12.466000", "progressbar": null, "item_expire_datetime": "2025-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-11-29T23:30:00.071369", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2020-11-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 43866, "title": "신이 된 날 [2025년 판권 만료작]", "subject": "신을 죽인 날", "description": "코로기 박사의 목적을 알아낸 히로토였지만 연구 결과까지는 알아낼 수 없었다. 평범한 고등학생인 요타가 라면집을 재건하고 마작 대회에서 우승한 것등 부자연스러운 행동을 반복한 것에 위화감을 느낀 히로토는 그 사건들에 히나가 관여했을지도 모른다고 의심하기 시작하고 드디어 '어떤 비밀'에 도달하는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/12/43569/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12.466000", "progressbar": null, "item_expire_datetime": "2025-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2020-1