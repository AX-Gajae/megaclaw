el.net/assets/2018/12/7018/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:54.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6140, "name": "왕실교사 하이네 8 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24746, "name": "왕실교사 하이네 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:04.339493", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8844, "title": "왕실교사 하이네", "subject": "과거의 대가", "description": "1년 전, 군학교에 다녔던 카이는 브루노를 지키기 위해 폭력 사건을 일으키고 정학을 당했다. 그 사건에 대해서 허위로 쓴 가십기사가 나와버렸고, 브루노는 분함을 느낀다. 그리고 카이는 사건의 당사자, 학생R에게 기사를 정정해줄 것을 요청하러 가게 되는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7019/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:54.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6141, "name": "왕실교사 하이네 9 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24747, "name": "왕실교사 하이네 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:03.991402", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8845, "title": "왕실교사 하이네", "subject": "내가 모르는 선생님", "description": "처음엔 문제투성이였던 왕자들도 자신들의 결점을 극복해 성장하고 있다. 하지만 그런 왕자들도 모르는 하이네의 과거를 로젠베르크 백작이 알아낸 모양이었다. 왕자들은 