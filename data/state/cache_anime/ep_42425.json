pire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110337, "name": "(자막) 아기와 나 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-10-03T10:00:11.661765", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-10-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77266, "title": "(자막) 아기와 나", "subject": "남자 고토!! 눈물의 첫사랑", "description": "고토가 5학년 3반 학급 위원 야리미조 메구미에게 사랑에 빠졌다. 용기를 내어 데이트에 초대하려고 고토는 타쿠야에게 전해 달라고 부탁한다. 다음 날 아침, 교실에서 고토를 만난 타쿠야는 실연했음에도 평소와 다름없는 고토를 보고 안도한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86588/v30/eab3c2044722/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:03", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110338, "name": "(자막) 아기와 나 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-10-03T10:00:11.661765", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-10-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77267, "title": "(자막) 아기와 나", "subject": "배가 꼬륵꼬륵 사건", "description": "곧 세 살이 되는 미노루의 식사 방법이 너무 더럽다. 어느 날 백화점 식당에서 한 엄마가 교육이 잘못됐다고 수근거리는 것을 듣고, 엄격한 교육을 시작했다. 하지만 미노루는 제대로 먹을 수 없어서 마침내 짜증을 낸다. 타쿠야는 그런 미노루의 모습을 보고 마음이 아프다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86589/v30/ca182b90a869/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:03", "progressbar": null, "item_expire_datetime": nu