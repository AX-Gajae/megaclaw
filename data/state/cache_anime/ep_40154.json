ucts": [{"id": 58823, "name": "아이★츄 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 58822, "name": "아이★츄 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-02-11T23:30:00.051491", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-02-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45343, "title": "아이★츄", "subject": "jugement ~웃는 얼굴을 위하여~", "description": "CD 3000장 완판이라는 할당량 달성 기간의 마지막 날이 찾아왔다. 각각의 팀들이 할당량 달성을 위해 마지막까지 힘쓰는 가운데, 파이어 피닉스는 아직도 달성까지 한참 남은 상황. 퇴학이 될지 어떨지가 걸린 공연을 앞두고, 세이야 일행의 앞에 엄마를 잃어버린 미아 소녀가 나타났는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/02/45162/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 58930, "name": "아이★츄 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 58929, "name": "아이★츄 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-02-18T23:00:00.136315", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-02-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45457, "title": "아이★츄", "subject": "vacance ~유대감~", "description": "아이츄는 쿠마 교장 선생님으로부터 여름휴가를 받아, 전세를 낸 프라이빗 비치에서 각자 바캉스를 만끽하고 있었다. 그런데 무츠키는 그다지 들뜬 것처럼 보이지 않았다. 그러던 중 일행이 하나 둘 행방불명되는 사건이 발생하고, 남은 아이츄들은 숲 깊숙한 곳에 있는 저택 안을 수색하게 되는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/02/45290/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 59207, "name": "아이★츄 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 59206, "name": "아이★츄 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-02-25T23:00:00.134258", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-02-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45586, "title": "아이★츄", "subject": "monochrome ~잃어버린 색~", "description": "카리스마 아이츄 천상천하가 돌연 귀국! 그렇게 그들은 세이야 일행 앞에 나타나 사운드 카니발 선발회에 자신들도 참여하게 되었다고 말했다. 천상천하 리더인 츠바키를 동경해 아이츄가 된 세이야가 심하게 들뜬 가운데, CD 완판을 축하하는 자리에서 벗어나 세이야는 그동안 츠바키에게 하고 싶었던 말을 전하지만, 그로부터 예상외의 말을 듣게 되는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/03/45403/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 59395, "name": "아이★츄 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 59394, "name": "아이★츄 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-03-04T23:00:00.132002", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-03-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45716, "title": "아이★츄", "subject": "phoenix ~재생~", "description": "어떤 아이돌이 될 것인가에 대한 목표를 잃어버린 세이야는 방황하고 있었다. 츠바키에게 들은 말의 의미를 혼자서 생각해봐도 답은 나오지 않았다. 한편, 사운드 카니발 선발회에 대비해 각자 연습에 열중하던 아이츄들도 세이야의 상태가 이상하다는 걸 하나둘 눈치채기 시작했는데.", "episode_num": "10", "episode_ord