ate": "2025-07-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83789, "title": "불꽃 소방대 3장 part 1", "subject": "과거의 광기", "description": "기절한 사이에 '대재해 집행관'인 페어리에게 붙잡힌 신라. 그때, 쇼우가 나타나서 형을 구하기 위해 \r\n페어리에게 덤벼들었다. 고전했지만 애로우의 힘을 빌려 페어리를 일도양단하는 데 성공한 쇼우.\r\n하지만......?!", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95663/v30/bb2c62a457cd/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:45.366000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-16T00:00:08.394692", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-07-15", "rating_components": []}, "access_type": null, "is_available": false}]}