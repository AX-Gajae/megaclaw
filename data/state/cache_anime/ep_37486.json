ing": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 4564, "title": "나루토 질풍전 7기 [2022년 판권 만료작]", "subject": "닌자의 춤을 추는 자들", "description": "나루토는 구미의 차크라를 닌자들에게 전달하여 전력 강화를 꾀한다. 구미의 차크라를 받아 힘이 증폭된 닌자들은 다시금 반격의 기회를 맞이하는데… 그때 나뭇잎 마을에는 오로치마루가 잠입하여 무언가 일을 꾸미고 있었다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3737/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:09.066000", "progressbar": null, "item_expire_datetime": "2022-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-01T15:27:28.378901", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 4565, "title": "나루토 질풍전 7기 [2022년 판권 만료작]", "subject": "모든 것을 아는 자들", "description": "사스케는 오로치마루가 환생시킨 역대 호카게들에게 우치하 일족의 진실에 대해서 캐묻는다.\n2대에게는 우치하 차별정책을 시작한 이유를, 초대 하시라마에게는 닌자와 마을의 시작에 대해서.\n그것을 듣고 나름의 답을 얻은 후에 복수를 접을지 계속할지를 결정하겠다면서…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3738/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:08.900000", "progressbar": null, "item_expire_datetime": "2022-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-01T15:27:28.432347", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 4566, "title": "나루토 질풍전 7기 [2022년 판권 만료작]", "subject": "하시라마와 마다라", "description": "피로 피를 씻는 처절한 싸움이 계속되던 전국시대.\n열 살이 채 되지 않은 어린애들마저 전장에서 목숨을 잃어갔다. 하지만 그 야만의 시대, 아직 소년이었던 하시라마와 마다라의 첫만남은 극히 평범했다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3739/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:56.133000", "progressbar": null, "item_expire_datetime": "2022-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-01T15:27:28.467928", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 4567, "title": "나루토 질풍전 7기 [2022년 판권 만료작]", "subject": "전국시대", "description": "서로가 숙적이자 형제를 죽인 일족이라는 것을 알게 된  하시라마와 마다라. 적이 된 둘은 서로의 일족의 장이 되어 대대로 계속된 전 쟁의 최전선에 선다. 하지만 마음 한구석에서는 옛 우정과 꿈을 버리지 않고  있었는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3740/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:09.066000", "progressbar": null, "item_expire_datetime": "2022-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-01T15:27:28.509868", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}