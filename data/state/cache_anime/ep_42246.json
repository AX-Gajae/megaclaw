isode_products": [{"id": 106251, "name": "꼬마신선 타오 - 영어 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74762, "title": "꼬마신선 타오 - 영어", "subject": "The Flying Cloud", "description": "새롭게 등장한 선생님, 손손! 전직 손오공이라고는 하지만 영 어설프기 그지없다. 하지만 근두운을 다루는 솜씨를 보고 깜짝놀란 아이들. 저마다 근두운에 올라타기 위해 애를 쓰지만, 거의 실패하고 만다. 이때 타오는 근두운을 타는 도구가 아닌 친구처럼 대하고, 마침내 멋지게 근두운 올라타기에 성공한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82918/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:54.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106250, "name": "꼬마신선 타오 - 영어 11 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74763, "title": "꼬마신선 타오 - 영어", "subject": "The Cloud Race", "description": "신선으로써 기본적으로 잘 다뤄야하는 근두운. 손손은 타오팀과 슈잉팀으로 나뉘어져 벌어지는 근두운 레이스를 열고, 2:2 박빙의 순간에 마지막 주자로 타오와 슈잉이 나서게 된다. 서로 만만치않은 실력을 자랑하는 가운데, 슈잉을 돕기위해 팽스들은 또다시 뒷공작을 시작하는데.. 과연 뜻대로 될까?", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82919/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:54.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106249, "name": "꼬마신선 타오 - 영어 12 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74764, "title": "꼬마신선 타오 - 영어", "subject": "Cloud Tree And Rain", "description": "지상세계의 일을 보여주는 신비의 거울. 거울 속에서 가뭄에 고생하는 할아버지의 모습을 본 타오는 걱정이 돼서 견딜 수가 없는데.. 그러다가 비를 내려준다는 구름나무 이야기를 듣고 갖은 고생끝에 구름나무가 있는 곳에 올라간 타오. 하지만 지나치게 불러낸 비구름은 홍수를 불러일으키고.. 죄책감에 시달리는 타오를 격려하며 교장선생님은 특별 선물을 내린다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82920/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:54.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106248, "name": "꼬마신선 타오 - 영어 13 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74765, "title": "꼬마신선 타오 - 영어", "subject": "Professor Bao's Reading Homework", "description": "졸기만하고 당췌 수업에 집중을 못하는 아이들에게 바오선생님이 독서 숙제를 내려준다. 울며 겨자먹기로 독서실에 내려간 아이들. 각각 흥미에 맞게 타오는 소환책, 무무는 무술책, 샤오밍은 의술책을 골라보다가 책 속에서 만난 신비의 선인들에게 특별한 수업을 받게 된다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82921/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:54.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106247, "name": "꼬마신선 타오 - 영어 14 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74766, "title": "꼬마신선 타오 - 영어", "subject": "Tao In Spain", "description": "타오와 친구들은 그리피 선생님의 방에 갔다가 게임의 요정 지니를 만나게 된다. 걱정하는 샤오밍의 말을 듣지않고 지니의 꼬임에 빠진 아이들은 장기말에 손을 대고, 그대로 게임세계로 빨려들어가 스페인의 작은 마을에 떨어지게 된다. 그리고 그곳에서 겁많은 투우지망생 페르난도를 만나게 된다. 타오와 친구들은 착한 페르난도를 위해 특별 투우훈련을 준비하고..", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82940/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:56.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106229, "name": "꼬마신선 타오 - 영어 15 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74767, "title": "꼬마신선 타오 - 영어", "subject": "Tao And The Cloud Pearl", "description": "친구들을 찾아 그리피 방에 들어온 뚱펭 역시 지니의 꼬임에 넘어가 장기말을 던지고, 스페인에 있던 친구들과 함께 북극으로 떨어진다. 위기에 처한 아기곰을 구해준 아이들은 북극의 얼음을 녹게만드는 커다란 하늘구멍에 대한 이야기를 듣게 된다. 그리고 타오는 하늘구멍을 없애고 북극을 구하기로 결심한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82941/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:55.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106228, "name": "꼬마신선 타오 - 영어 16 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74768, "title": "꼬마신선 타오 - 영어", "subject": "The Dormitory Ghost", "description": "어느 날, 타오가 밤중에 귀신과 맞닥트리는 사건이 발생한다.\n  슈잉은 이것이 기숙사 전설로 내려오는 만두귀신이라고 확신하고, 아이들은 다같이 귀신의 정체를 밝히기로 한다. 그리고 어두컴컴한 밤, 두려움에 떠는 아이들 앞에 다시 나타난 만두귀신!의 정체는 놀랍게도?!! 대체 기숙사에선 밤마다 무슨 일이 일어나고 있는 것일까?", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82901/v15/Thumbnail.0000033.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:54.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106267, "name": "꼬마신선 타오 - 영어 17 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-06-19T02:30:08.850070", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "대교어린이TV", "broadcast_date": "2022-09-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 74769, "title": "꼬마신선 타오 - 영어", "subject": "The Legendary Ming Ming", "description": "아이들과 축구를 하다가 우연히 커다란 알을 발견하게 된 타오.\n  몰래 기숙사로 가져오지만 하룻밤 새에 알이 깨어나고, 그 속에서 나온 정체불명의 동물은 식당을 엉망으로 만든다. 결국 교장선생님 앞에 데려간 동물의 정체는 다름아닌 신선의 애완동물. 오직 타오만을 따르는 것을 보고 교장선생님은 타오에게 기르는 것을 허락한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/82942/v15/