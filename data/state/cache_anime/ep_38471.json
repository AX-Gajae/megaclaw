ed_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19883, "title": "젤리고 1", "subject": "마지막 잎새/흔들린 우정", "description": "진정한 우정이란 과연 무엇이란 말인가, 친구를 위해 그림을 그리는 고고는 급기야 득도의 경지에 오르게 되는데..../젤리를 먹지 못해 앓아 누운 로로와 그를 안타깝게 바라보는 고고. 아픈 로로를 보니 젤리머신이 원망스럽기만 하다. 젤리머신에 원망의 망치 한방을 날린 고고. 그러자 고고에게 젤리 한알을 내어주는 머신.과연 고고와 로로의 가혹한 우정은 어디까지 치달을 것인가…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74785/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:41.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97599, "name": "젤리고 1 9 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19884, "title": "젤리고 1", "subject": "내 친구 윌슨/측은지심", "description": "누구도 너를 대신 할 수 없어. 서로를 원하고 서로를 시기하는 이 슬픈 무인도 같은 젤리 가게. 과연 집나간 고고는 돌아올 것인가?/꿈에서도 젤리를 애타게 원하는 로로에게, 환상의 젤리 소나기가 쏟아져 내린다. 이게 어떻게 된 일이지? 하늘에서 젤리가 떨어져요. 마구마구 떨어져요.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74786/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:41.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97598, "name": "젤리고 1 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19885, "title": "젤리고 1", "subject": "주술/UFO (미확인 비행 물체)", "description": "로로는 주술로 젤리머신을 제어하려고 한다. 갖은 방식의 주술이 사용되고 점점 젤리머신이 반응하기시작하는데....과연 주술사 로로는 젤리를 먹을 수 있을까?/어느날 갑자기 나타난 UFO가 젤리 가게안을 뒤지기 시작한다. 마치 젤리머신을 데리러 온 것 같다. 안돼! 고고와 로로는 UFO로 부터 젤리머신을 지키기 위해 고군분투 한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74814/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:40.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97574, "name": "젤리고 1 11 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19886, "title": "젤리고 1", "subject": "젤리와 콩나무/뚫어뻥", "description": "제크의 콩나무처럼 부쩍부쩍 자라나는 젤리나무. 조만간 무성한 잎을 틔우고 젤리들이 열릴 것 같다. 희망을 가득안고 열과성을 다해서 새싹을 키우는 고고와 로로./뚫어뻥은 막힌 변기에서만 쓰는 물건일까? 고고와 로로에게는 그 어떤 물건도 젤리를 빼내기 위한 도구가 된다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74815/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:39.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97573, "name": "젤리고 1 12 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19887, "title": "젤리고 1", "subject": "보물지도 1/보물지도 2", "description": "지도에 적힌 대로 땅굴을 파면 젤리머신 바닥에 닿을 수 있다.고고와 로로가 벌이는 프리즌 브레이크!!!/땅 속에 여러 개의 젤리머신이 숨겨져 있다는 사실을 알게 된 고고와 로로. 지도에 표시 되어 있는 곳을열심히 파 보자!", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74787/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:38.366000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97597, "name": "젤리고 1 13 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19888, "title": "젤리고 1", "subject": "위험한 선풍기/마술피리", "description": "더위에 지친 고고와 로로는 천장에 붙은 선풍기를 작동시키는 스위치를 발견 했다. 야호! 이제 시원해지겠지?/요상한 피리가 나타났다. 로로가 피리를 불면, 피리소리에 따라 밧줄을 마음대로 움직일 수 있다. 저 마술피리와 밧줄을 이용해서 젤리머신 안의 젤리들을 꺼내보자!", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74775/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97604, "name": "젤리고 1 14 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19889, "title": "젤리고 1", "subject": "불면증/최면", "description": "오늘도 불면증에 시달리는 로로는, 젤리 양 이라도 세어서 잠을 청해 본다. 젤리 한 마리. 젤리 두 마리…젤리 세엣…./최면으로 공중부양을 하려는 두 녀석. 유체 이탈 이라도 해서 젤리 머신을 통과. 젤리를 먹고 싶다. 젤리머신은 영혼이 된 고고와 로로에게 젤리를 내어 줄까?", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74816/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:36.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97572, "name": "젤리고 1 15 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19890, "title": "젤리고 1", "subject": "신기루/매일매일 기다려", "description": "정상적인 방법으로는 안 되겠다. 젤리머신을 아예 엎어 버리자. 고고와 로로는 온 힘을 다해 거대한 젤리머신을 넘어뜨리려 한다./한 알의 젤리를 먹기 위해 머신 앞에서 기나 긴 시간을 보내는 고고와 로로.우주의 이치를 통달한 싯다르타가, 하늘의 진리를 깨달은 예수가 이들만큼 긴 세월을 보냈을까? 인내는쓰고, 결과는 과연?", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74817/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:40.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97571, "name": "젤리고 1 16 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2017-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19891, "title": "젤리고 1", "subject": "얼굴 낙서/얼음 속 젤리", "description": "고고와 로로의 얼굴 낙서 전쟁이 시작 됐다. 누구든 먼저 잠이 들었다가는 큰 낭패. 서로의 얼굴을 도화지처럼 여기는 고고와 로로 중 승자는 누구??/고고와 로로 앞에 나타난 커다란 얼음 덩어리. 그리고 그 안에 든 먹음직스러운 젤리.얼음 속 젤리를 어떻게 빼 내지?", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74788/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:40.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97596, "name": "젤리고 1 17 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19892, "title": "젤리고 1", "subject": "감기/젤리의 비밀", "description": "감기에 걸린 로로를 멀리하는 고고. 혹여 자신에게도 감기가 전염 될지몰라, 로로가 근처에 오는 것도못 마땅하다. 너무하다, 너무해! 그런 고고가 서운한 로로의 복수는?/젤리의 정체는 무엇일까? 모든 것이 끝난 이 세상에 신비롭게 남아 있는 젤리의 진짜 의미를 확인하는시간.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74789/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:40.566000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97595, "name": "젤리고 1 18 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19893, "title": "젤리고 1", "subject": "사라진 동전/수술", "description": "사기꾼 고고와 순진한 로로가 동전 숨기고 찾기 대결을 한다. 과연 고고가 숨긴 동전은 어디로 갔을까?/수술 장갑을 끼고 수술용 가위를 움직이며 고고와 로로는 무언가에 집중하고 있다. 그들은 사력을 다해정밀하고 심도 있는 작업을 진행 한다. 녀셕들의 수술은 성공할 수 있을까?", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74818/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:38.900000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97570, "name": "젤리고 1 19 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 19894, "title": "젤리고 1", "subject": "불이 필요해/당신이 잠든 사이", "description": "어떤 방법으로도 젤리를 내어주지 않는 젤리머신에 너무나 화가 난 고고. 다이너마이트로 머신에게 복수를 꿈꾼다. 그러려면 다이너마이트 심지에 불을 붙여야 하는데, 왜 이렇게 불 붙이는게 힘들어?/잠든 고고의 배 아래에 젤리 한 알이 끼였다. 로로는 잠든 고고 몰래 젤리를 빼내기 위해 온갖 방법을시도한다. 하필이면 고고 배 아래에 끼어 있다니...젤리와 사투를 벌이는 로로는 젤리를 독차지할 수 있을까???", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74776/v15/Thumbnail.0000008.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:37.633000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97603, "name": "젤리고 1 20 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-