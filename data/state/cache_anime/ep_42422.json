el.net/assets/2024/11/88242/v30/dc92eb68b448/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 112027, "name": "외톨이의 이세계 공략 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 112026, "name": "외톨이의 이세계 공략 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-15T02:00:08.975982", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-11-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77569, "title": "외톨이의 이세계 공략", "subject": "외톨이와 미궁황", "description": "미궁의 최하층에서 하루카가 만난 것은 히든 보스인 '미궁황'이었다. 미궁황의 강력한 힘 앞에 한계를 맞이한 하루카였지만, 어째선지 미궁황은 하루카를 죽이려 하지 않았다. 그리고 하루카는 어떤 한 가지 이변을 눈치챘다. 한편, 하루카를 찾아 최하층으로 서둘러 향하던 반장과 같은 반 아이들의 앞을 강대한 적이 막아서는데--.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/88648/v30/ec1a90fcc6c5/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 112420, "name": "외톨이의 이세계 공략 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 112419, "name": "외톨이의 이세계 공략 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-22T02:00:06.854531", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-11-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77570, "title": "외톨이의 이세계 공략", "subject": "스탬피드", "description": "하루