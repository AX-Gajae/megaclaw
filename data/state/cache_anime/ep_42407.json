eview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109522, "name": "3월의 라이온 1기 - 판권 부활 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-10-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77174, "title": "3월의 라이온 1기", "subject": "가는 해 외", "description": "크리스마스부터 심한 감기에 걸려 줄곧 앓아누워 있다가 섣달 그믐을 맞이한 레이. 아카리, 히나타, 모모는 레이를 찾아왔다가 그 모습을 보고 즉시 강제로 병원과 카와모토 가로 끌고간다. 레이는 죽도 먹고, 극진한 간호를 받으며 많이 회복하고 의붓아버지 코다와 카와모토 가에 걱정을 끼친 것 같아 반성한다. 그리고 따뜻한 카와모토 가에서 새로운 해를 맞이하는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85332/v30/d0c7b943b340/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109523, "name": "3월의 라이온 1기 - 판권 부활 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-10-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77175, "title": "3월의 라이온 1기", "subject": "강 건너편에 있는 것", "description": "새해 휴일이 지나고 몸 상태도 회복한 레이는 카와모토 가에서 집으로 돌아온다. 떠들썩했던 카와모토 가의 연말연시 분위기에서 벗어나 혼자 시간을 보내자니 더욱 외로움에 쓸쓸하지만 기분을 전환하고 사자왕전 토너먼트에 집중하려 한다. 드디어 맞이한 토너먼트 1회전. 레이의 대국 상대는 츠지이 타케시! '여러 가지 의미'로 강한 공격력을 가진 츠지이를 상대로 레이는 분투한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85333/v30/d544389da497/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109524, "name": "3월의 라이온 1기 - 판권 부활 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-10-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77176, "title": "3월의 라이온 1기", "subject": "검은 강2 외", "description": "토너먼트에서 고토와 맞붙게 된 스미스는 대책을 준비해 대국장으로 향한다. 고토의 대국 형태는 앉은비차와 동굴곰. 반면 스미스는 풍차가 특기이다. 스미스는 고토에게 자신의 특기인 전법으로 부딪치려 하는데… 그리고 마찬가지로 사자왕전 토너먼트에서 레이는 시마다 카이 8단와 대국하는 날을 맞이한다. 레이에게 있어 무슨 일이 있어도 져서는 안 되는 싸움이 시작된다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85334/v30/f8fb6effc8f8/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109525, "name": "3월의 라이온 1기 - 판권 부활 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77177, "title": "3월의 라이온 1기", "subject": "눈부신 어둠 외", "description": "시마다의 실력을 잘못 판단해 돌이킬 수 없을 정도로 나쁜 국면에 이르렀음을 깨닫게 된 레이. 부끄러움과 혼란으로 심하게 동요하지만 시마다에게 끌려가듯 어떻게든 마지막까지 두어 나간다. 대국 후 레이는 너무나 부끄러운 나머지 장기회관에서 달려나간다. 그 뒷모습을 지켜보던 시마다는 자신의 사제인 니카이도가 한 말을 떠올리며 레이를 연구회에 불러 볼까 생각하는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85335/v30/21cfc41a3448/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109526, "name": "3월의 라이온 1기 - 판권 부활 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77178, "title": "3월의 라이온 1기", "subject": "달빛 외", "description": "사자왕전 토너먼트 결승전, 고토와 시마다의 3회 시합 중 첫 번째 대국의 막이 오른다. 스스로를 신뢰하는 사람들 사이의 싸움에 압도당하는 레이. 대국을 끝낸 고토는 장기회관 앞에서 기다리는 쿄코에게 차가운 태도를 보인다. 그 모습을 보며 레이는 자신이 코다의 집에서 나온 순간을 떠올린다. 그리고 미카즈키 당에서는 아카리와 히나가 그런 레이를 걱정하고 있었는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85336/v30/aa406167b714/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109527, "name": "3월의 라이온 1기 - 판권 부활 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77179, "title": "3월의 라이온 1기", "subject": "밤을 달리다 외", "description": "결석을 대체할 화학 실험 보고서를 쓰기 위해 레이는 선생님께 이끌려 '방과 후 과학 연구부'에 방문한다. 그곳에 있던 것은 노구치와 부원들. 동년배들과 활기차게 대화하는 레이의 모습을 보고 기뻐하는 선생님. 실험을 마친 레이는 사자왕전 토너먼트 결승전, 고토와 시마다의 최종국을 보러 간다. 승부의 행방은. 그리고 대국을 마친 시마다에게 레이가 건넨 말은...?", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85337/v30/72423c4a1705/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109528, "name": "3월의 라이온 1기 - 판권 부활 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77180, "title": "3월의 라이온 1기", "subject": "은빛 실 외", "description": "사자왕전, 시마다와 소야 명인의 대국 전야제에 참가한 레이와 니카이도. 언젠가 반드시 타이틀전에 나가겠다고 단언하는 니카이도의 각오를 보면서 레이는 동요한다. 회장 정원에 나온 레이는 바로 근처에 서 있는 사람을 알아차린다. 전혀 기척을 내지 않고 서 있는 그 사람이야말로 최연소 명인에 등극해 사상 처음으로 7대 타이틀을 전부 제패한 소야 토지였다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85338/v30/92dd0e5522fa/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109529, "name": "3월의 라이온 1기 - 판권 부활 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77181, "title": "3월의 라이온 1기", "subject": "격류 외", "description": "사자왕전 제3국을 앞둔 시마다. 자택에서 진행하는 연구회에서 주제로 다룬 국면에 대해 서로 다른 전법을 논하며 충돌하는 니카이도와 시게타. 한편 레이는 그 국면을 보고 '기분 나쁘다'고 표현한다. 시마다는 레이에게 다음 날 다시 와 주기를 요청하고 그와 대국하며 A급 기사의 대국에 압도되지만 자신이 할 수 있는 것을 필사적으로 건네려 한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85339/v30/957d283580f5/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109530, "name": "3월의 라이온 1기 - 판권 부활 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-11-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77182, "title": "3월의 라이온 1기", "subject": "밤을 지나다 외", "description": "눈이 많이 내리는 야마가타의 한 마을에서 자란 시마다. 동네 노인들에게 장기를 배웠고, 중학생이 되자 월 2회 장려회를 다니기 위해 아르바이트에 매진했다. 이기지 못하던 시기에도 위통과 싸우며 장기를 계속해온 그. 동갑내기 소야가 장려회를 빠져나가 순위전을 뛰어오르는 것을 보며 좁혀지지 않는 차이를 느끼면서도 노력하는 것을 그만둘 수는 없었다. 레이는 그런 시마다와 함께 사자왕전 제4국의 장, 교토로 향한다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85340/v30/2fea6b67563d/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109531, "name": "3월의 라이온 1기 - 판권 부활 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T21:00:11.136183", "rating": {"rating": 15, "rating_type": "방송통신심