ification_number": "", "broadcast_channel_name": "재능방송", "broadcast_date": "2024-09-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78764, "title": "엉덩이 탐정 시즌 5", "subject": "뿡뿡! 의뢰인은 괴도U (하)", "description": "괴도U에게서 망토를 찾아달라는 의뢰를 받고 모락모락오천호텔을 찾은 엉덩이탐정. 망토를 목격한 직원을 찾기 위해 오랜 세월 운영하지 않은 지하의 동굴 온천으로 향한다. 엉덩이탐정은 과연 망토를 찾을 수 있을 것인가! 그리고 괴도U는 나타날 것인가!", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87332/v30/e8b03174201c/Thumbnail.0000048.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:03.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111477, "name": "엉덩이 탐정 시즌 5 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-10-28T21:00:05.858801", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능방송", "broadcast_date": "2024-09-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78765, "title": "엉덩이 탐정 시즌 5", "subject": "뿡뿡! 아가씨의 하트를 도둑맞다!?", "description": "민트가 사랑에 빠졌다? 김노랑 가문의 집사인 양집사에게서 아가씨의 하트를 되찾아달라는 의뢰를 받은 엉덩이탐정. 민트의 마음을 이용해 값비싼 선물만을 요구하는 소년의 정체를 파헤친다. 엉덩이탐정과 브라운은 민트의 하트를 되찾을 수 있을 것인가?", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87333/v30/5316aa6a7db4/Thumbnail.0000048.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:03.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111478, "name": "엉덩이 탐정 시즌 5 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-10-28T21:00:05.858801", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classifi