, "episode_products": [{"id": 88813, "name": "말단 병사에서 군주까지 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07242", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65085, "title": "말단 병사에서 군주까지", "subject": null, "description": "크리스는 린드에게 경계병이 습격당한 이야기를 듣고 서둘러 랄프 십인대로 확인하러 간다. 하얀 악마의 초기증상을 확인한 크리스는 이전에 채집한 더티메이트를 이용해 치료제를 만든다. 환자의 증세가 안 좋아지자 랄프는 크리스 막사로 병사를 부축해온다. 같이 부축해온 병사가 하얀 악마라고 말하자 이 말을 듣게된 디고는 과민반응을 보이며 환자를 불태우려한다. 가까스로 디고를 붙잡아 소란을 잠재웠지만. 이 소란을 들은 캐너럭이 막사로 들어오게 되는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/episodes/dc3dc71c-8a2e-45ec-bd8e-16e06c4aa8b2.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:58.800000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88812, "name": "말단 병사에서 군주까지 14 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07242", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65086, "title": "말단 병사에서 군주까지", "subject": null, "description": "자신이 트레지디 출신이라는 디고의 말에 힘이 실려 캐너럭은 병사를 불태우려 한다. 크리스는 캐너럭이 다시 기사가 될 수 있는 공적을 만들어주겠다며 설득한다. 기절한 뒤 정신을 차린 디고는 막사 밖으로 뛰쳐나가 완치된 병사들을보게된다. 임시 치료소를 설립하고 타부대의 증상자까지 모두 치료하게 된다. 크리스는 적들이 이기회를 틈타 기습해 올꺼라고 캐너럭에게 말한다.. 7보병대는 기습에 대비하여 함정을파고 고기를태워 적들을 속이게 되는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/episodes/c97f8a47-2943-443d-9c3c-71721548eb86.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:55.666000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88811, "name": "말단 병사에서 군주까지 15 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07242", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65087, "title": "말단 병사에서 군주까지", "subject": null, "description": "포위한 적들과 전투하는 7보병대. 생각보다 강한 적들 때문에 고전 하게된다. 지원군이 올때까지 시간을 끌어야 하는 상황에 적 기사의 등장으로 아군의 비명소리가 이어진다. 적 병사들은 캐너럭이 적 기사쪽으로 가지못하게 시간을 끌고있고 크리스가 적 기사와 붙게된다. 전력차로 겨우 방어만하는 크리스. 린드가 화살을 날려보지만 적 기사는 린드를향해 달려들고 린드가 위험해진다. 린드에게 달려가는 적 기사에게 디고가 달려들어 다리에 상처를 입힌다. 크리스와 디고 2대1로 적기사와 싸우게 되는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/episodes/268202ec-5226-4baa-a069-f07fab0d641d.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:52.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88810, "name": "말단 병사에서 군주까지 16 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07336", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65088, "title": "말단 병사에서 군주까지", "subject": null, "description": "크리스는 창을 디고는 방패를들고 울브스의 기사와 맞서게 된다. 일부러 허술하게 보여 디고로 공격이 집중되게 한 크리스는 빈틈을 노려 울브스의 기사를 공격하지만 치명상을 입히지 못하고 팔이 부러지게된다. 이때 경험치가 가득차 있었던 아티펙트가 초기화되어 팔의 회복과함체 크리스의 신체능력이 향상된다. 크리스는 달라진 움직임으로 적장을 해치우고 승리하게 된다. 상부의 명령으로 진지를 정리하고 본대로 집결하게된 7보병대 마차에서 내린 크리스와 함께 캐너럭은 서드오더인 비하인 루드비히 앞에 서게 되는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/episodes/ab97a2b5-da12-4ae0-992b-c5bf65f1778d.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:06.666000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88809, "name": "말단 병사에서 군주까지 17 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07336", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65089, "title": "말단 병사에서 군주까지", "subject": null, "description": "비하인 루드비히를 설득해 팔문의 유격부대를 이끌어내, 그들을 처리하기로 하고, 계획을 실행한다.\r\n지난 전투에서 몸이 달라진 것을 확신하는 크리스.  지난생에서는 불가능했던 ‘재능’을 얻을 수 있을거라 기대한다.\r\n크리스는 휠켄에게 따로 부대편성을 부탁했고, 전쟁에서 확실한 활약으로 존재를 알리기로 결심.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/episodes/03302848-e7d1-4bf8-ad51-6f2d4c328c85.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:02.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88808, "name": "말단 병사에서 군주까지 18 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07336", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65090, "title": "말단 병사에서 군주까지", "subject": null, "description": "팔문의 군대와 전투를 치르는 세르카도 군. \r\n전투가 시작할 때 뒤로 빠져있던 크리스와 부대원은 유격부대를 후방에서 하나씩 처리해 거의 몰살시키고게 된다. \r\n팔문의 병사들이 퇴각할때, 지휘관들이 사망해 우왕좌왕하는 세르카도측의 병사들을 본 크리스.\r\n앞으로 나서서 그들을 통솔하기 시작한다", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/episodes/20a72795-c6e6-4223-b70a-af3edeaafcdc.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:49.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88807, "name": "말단 병사에서 군주까지 19 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07336", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}, {"id": 65091, "title": "말단 병사에서 군주까지", "subject": null, "description": "자신의 몸이 달라진 것을 느끼는 크리스. 적들을 처리해나간다. 다른 부대원들도 속속 합류하여, 결국 평야지역에서 팔문 부대를 모조리 몰아낸다. \r\n무공훈장 수여식에 반 루드비히 백작이 직접 수여식에 나타나 크리스에게 훈장을 달아준다. \r\n더 원하는 것이 있는지 묻는 백작에게, 크리스는 수습기사가 되게 해달라고 말한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/episodes/f37b305f-4598-4f8d-94d8-d87d82cc8e20.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:16.266000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 88806, "name": "말단 병사에서 군주까지 20 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-07T16:00:12.178946", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07336", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성"]}, "access_type": null, "is_available": false}]}