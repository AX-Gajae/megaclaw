um": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69202/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 84628, "name": "푸른 오케스트라 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 84627, "name": "푸른 오케스트라 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-09T00:30:09.192659", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-06-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62338, "title": "푸른 오케스트라", "subject": "초심자와 경험자", "description": "정기연주회 오디션까지 일주일이 남아서 부원들은 각자 열심히 연습에 매진하고 있었다. 잔뜩 긴장해 초조함과 불안에 사로잡힌 리츠코는 연주가 생각처럼 되지 않았다. 고등학교에서 악기를 시작한 사람과 어린 시절부터 계속 해온 사람. 리츠코와 같은 세컨드 바이올린에 속된 바이올린 경험자인 타치바나는 초심자임에도 오디션에 도전하려는 리츠코를 보고 신경이 곤두서 있었다. 이윽고 연습 방식을 두고 타치바나와 리츠코는 충돌하게 되었는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69420/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 84831, "name": "푸른 오케스트라 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 84830, "name": "푸른 오케스트라 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-16T00:30:08.117516", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62476, "title": "푸른 오케스트라", "subject": "결전 전야", "description": "오디션 3일 전. 부원 모두가 연습에 몰두하는 가운데 아오노와 사에키는 수학 보충 수업을 받고 있었다. 두 사람 다 쪽지시험에서 낙제점을 받았기 때문이었다. 빨리 동아리 활동에 참여하고 싶다는 생각으로 두 사람은 과제를 풀었다. 서둘러 달려온 음악실에서는 합주 연습이 이미 진행되고 있었다. 아유카와 선생님은 오디션에서의 연주 결과에 따라 학년과 상관없이 자리를 배치하려고 생각 중인 듯했다. 콘서트마스터인 하라다도 1, 2학년을 경쟁시키려고 생각하고 있었다. 그리고 다가오는 결전의 날.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69759/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85046, "name": "푸른 오케스트라 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85045, "name": "푸른 오케스트라 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-23T00:30:07.596656", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62611, "title": "푸른 오케스트라", "subject": "오디션", "description": "정기연주회에서 메인 곡이 될 드보르자크 '교향곡 제9번 [신세계로부터]' 연주 멤버를 결정하는 오디션이 시작됐다. 복도로 새어 나오는 바이올린 소리에 오케부 부원들의 긴장은 높아져간다. 사에키와 아오노 둘 중 누가 더 좋은 자리를 따낼 것인가? 아오노는 주목받고 있었다. 라이벌에게 이기고 싶다. 그리고 아유카와 선생님이 자신을 인정하게 만들고 싶다. 아오노의 순서가 찾아온다. 연주자에게서 등을 돌리고 앉은 3학년 심사위원들. 하지만 소리가 울리기 시작한 그 순간, 모두가 연주자가 누구인지 알게 되었는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69898/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85331, "name": "푸른 오케스트라 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85330, "name": "푸른 오케스트라 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-30T00:30:08.187459", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-06-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62907, "title": "푸른 오케스트라", "subject": "자신의 음색", "description": "오디션 결과, 아오노는 사에키보다 앞쪽의 자리를 따냈다. 하지만 아유카와 선생님으로부터 기술은 높지만 자신만의 음색이 보이지 않는다는 말을 듣는다. 그리고 어린 시절 예선 탈락한 콩쿠르에서 시시한 연주라고 아버지가 말했던 기억을 떠올린다. 초조함에 방황하는 가운데 어떻게든 바이올린을 켜고 싶었다. 하지만 기말고사를 앞두고 동아리 활동은 정지 기간에 들어갔다. 시험 성적이 나쁜 부원은 연주회에 나갈 수 없다. 아오노는 시험공부를 시작했는데.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/69982/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85596, "name": "푸른 오케스트라 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85595, "name": "푸른 오케스트라 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-07T00:30:08.581549", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62976, "title": "푸른 오케스트라", "subject": "다가서다", "description": "여름방학에 들어가면서 합주 연습이 본격적으로 시작됐다. 아오노는 다 같이 음을 맞추는 것의 어려움을 통감하게 된다. 개인의 음정과 리듬은 맞는데 합주를 하면 맞춰지지 않았다. 하지만 그때 콘서트마스터인 하라다가 활과 몸짓으로 신호를 보내기 시작했다. 완만하게 천천히 그리고 밝고 즐겁게──. 모두의 호흡이 서서히 맞춰지고, 연주가 하나가 되어갔다. 오케스트라 전원, 그리고 모든 악기의 소리와 마주하는 하라다의 수완에 아오노는 감명을 받는데.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70080/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85674, "name": "푸른 오케스트라 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85673, "name": "푸른 오케스트라 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-14T00:30:08.068449", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63350, "title": "푸른 오케스트라", "subject": "진심", "description": "장래 콘서트마스터 후보로서 기대를 받는 아오노와 사에키는 현악기 톱 연습을 견학하게 되었다. 각 파트의 톱 연주자가 모여 콘서트마스터를 중심으로 악곡의 이미지를 공유하고 표현을 구체적으로 결정해가는 자리였다. 그곳에는 양보가 전혀 없었다. 격렬한 의견의 충돌에 두 사람은 압도당했다. 하지만 일단 합주가 시작되자 평온한 시간이 흐르기 시작했다. 아오노는 선배들이 악기를 통해서 진심이 담긴 대화를 나누고 있다고 느꼈는데.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70291/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86072, "name": "푸른 오케스트라 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86071, "name": "푸른 오케스트라 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-21T00:30:07.991141", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63556, "title": "푸른 오케스트라", "subject": "걱정", "description": "정기연주회를 대비한 합주 연습이 뜨거운 가운데 아오노의 모습이 보이지 않았다. 아유카와 선생님의 말에 따르면 아오노의 어머니가 쓰러져 입원하게 됐다고 한다. 걱정으로 집중하지 못한 채 연습이 진행됐다. 아오노의 어머니를 잘 아는 리츠코는 특히 큰 충격을 받았다. 몇 번이고 아오노에게 연락해 보았지만 받지 않았다. 가만히 있을 수 없어서 아오노의 집에 찾아가기로 결심한 리츠코에게 사에키, 하루, 야마다도 합류한다. 아오노는 갑작스러운 친구들의 방문에 놀랐지만 조금씩 자신에 대해서 이야기하기 시작했는데.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70514/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86334, "name": "푸른 오케스트라 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86333, "name": "푸른 오케스트라 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-28T00:30:08.048513", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63760, "title": "푸른 오케스트라", "subject": "또 하나의 진심", "description": "너한테 말하고 싶은 게 있어' 혼자서 아오노의 집으로 돌아온 사에키. 심각해 보이는 표정으로 무언가를 말하려고 했지만 좀처럼 말을 꺼내지 못했다. 그러다 문득 눈에 들어온 방음실. 아오노가 아버지인 류지와 함께 어린 시절부터 바이올린 연습을 했던 방이었다. 장식된 트로피와 콩쿠르 기념사진. 아오노의 과거를 보며 사에키는 이야기하기 시작했다. 음악가인 어머니의 고향 독일에서 자란 사에키. 일본으로 돌아온 목적은 아오노를 만나기 위해서였는데.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70661/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:11.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86644, "name": "푸른 오케스트라 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86643, "name": "푸른 오케스트