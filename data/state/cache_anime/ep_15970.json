ion": null}, {"id": 119280, "name": "누라리횬의 손자 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-24T00:00:12.185457", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2025-06-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83932, "title": "누라리횬의 손자", "subject": "마경이 오면서 과실을 먹어 치운다", "description": "규키 일이 마무리되고 평온을 찾은 리쿠오. 한편, 카나는 악몽을 꾸고 있었다. 심지어 날이 가면 갈수록 악몽을 꾸는 빈도수가 점점 늘어났고, 생일날 아침에는 더더욱 심해져서 잠을 설칠 정도였다. 그렇게 피곤한 몸을 이끌고 등교한 카나는 꿈속에서 누군가와 만나기로 약속했다는 것을 떠올리지만, 그 상대가 누구인지는 떠오르지 않았는데...", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94362/v30/6fae4be9188f/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119283, "name": "누라리횬의 손자 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119282, "name": "누라리횬의 손자 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-24T00:00:12.441096", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2025-06-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83933, "title": "누라리횬의 손자", "subject": "선진의 바람, 서쪽에서", "description": "바케네코 4번가에서 어떤 사건이 벌어지고, 일의 진상을 조사하던 누라조 대 간부 히히가 누군가에게 습격당해 사망하는 사건이 발생한다. 누라조의 모든 인원들이 범인을 찾던 도중, 누라리횬은 유라와 만나게 된다. 유라는 리쿠오의 할아버지가 누라리횬이라는 것도 모른 채, 자신이 우키요에 마을에 온 목적을 말하고 마는데...", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94363/v30/e229a5403e65/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time":