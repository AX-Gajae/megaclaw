 다가오고 있었는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86081/v30/d8101a4b89a5/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109444, "name": "전국요호: 천마혼돈 편 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 109443, "name": "전국요호: 천마혼돈 편 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-09-05T02:00:13.615827", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-09-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75760, "title": "전국요호: 천마혼돈 편", "subject": "센야와 진운", "description": "아버지인 진운의 봉인 해제를 부탁한 센야에게 산신은 시련을 제시한다. 그것은 가까운 산에 나타난 쥐 어둠을 퇴치하는 것이었다. 곧바로 산으로 향한 센야 일행이었지만 갑자기 이상한 향기가 감돌았다. 그것은 어둠이 설치한 최면향을 쓴 환술이었다. 함정에 빠진 센야와 츠키코는 축제를 즐기는 어린아이의 모습이 되었고, 타마도 넷이서 여행을 하던 시절의 추억을 보고 지난날의 진카의 모습에 마음을 빼앗기기 시작했는데...", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86240/v30/a1653be9eb95/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109957, "name": "전국요호: 천마혼돈 편 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 109956, "name": "전국요호: 천마혼돈 편 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-09-12T02:00:11.451727", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-09-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75761, "title": "전국요호: 천마혼돈 편", "subject": "센야의 8년", "description": "센야는 단괴중을 나오도록 진운을 설득했지만 진운은 이에 응하지 않았고 두 사람은 주먹으로 승부를 가리기로 했다. 격렬한 싸움을 벌이던 와중에 갑자기 무의 백성이 나타나 진운과 센야는 유계로 빨려 들어갔다. 유계에서 우세한 무의 백성은 진운과 융합된 용, 나다레를 해방시켰고 나다레와 그 자리에서 도주하려 했다. 하지만 그때 분노한 산신과 태산이 나타났다. 지신 둘이 아군이 된 센야 일행에게 승기는 있을 것인가...?", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86374/v30/8fb45ba3272a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110063, "name": "전국요호: 천마혼돈 편 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 110062, "name": "전국요호: 천마혼돈 편 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-09-19T02:00:14.204746", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-09-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75762, "title": "전국요호: 천마혼돈 편", "subject": "전국요호: 천마혼돈 편 -Part1-", "description": "전국요호 천마혼돈 편의 후반이 시작되기 전에 전반의 내용을 한눈에 살펴보자 나우!", "episode_num": "10.5", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/09/86626/v30/a30b1c474669/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110192, "name": "전국요호: 천마혼돈 편 10.5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 110191, "name": "전국요호: 천마혼돈 편 10.5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-09-26T02:00:13.587679", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-09-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75763, "title": "전국요호: 천마혼돈 편", "subject": "천마혼돈을 둘러싸고", "description": "산신에게 붙잡혀있던 야젠으로부터 진카를 인간으로 되돌릴 방법을 듣게 된 센야. 진카의 결계를 부술 열쇠, 그것은 이동 가능하고 토지신에 필적하는 능력을 가진 자. 한편, 무의 백성은 센야와의 싸움에는 기지가 될 이동 요새가 필요하다고 생각했다. 양쪽의 목적에 부합하는 것 그것은 구름 어둠 만상왕의 힘... 일단 마을로 돌아간 센야 일행이었지만 센야는 무의 백성이 일으킨 사건의 원인이 자신이라고 생각해서 혼자서 마을을 떠났다. 그때, 타마는 한발 먼저 단독 행동에 나서 만상왕을 수색하다가 무서운 사실을 알게 되었는데.", "episode_num": "11", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87083/v30/71dbf3690d47/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110496, "name": "전국요호: 천마혼돈 편 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 110495, "name": "전국요호: 천마혼돈 편 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-10T02:00:13.031808", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-10-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78674, "title": "전국요호: 천마혼돈 편", "subject": "결전의 땅", "description": "만상왕이라는 이동 요새를 손에 넣은 무의 백성은 각지의 어둠들을 세뇌해서 어둠의 군단을 조직한다. 무의 백성은 성성이들도 군단으로 흡수하기 위해 만상왕을 보냈지만 그 앞을 도렌과 무도가 막아선다. 하지만 만상왕에게 뛰어든 무도는 예기치 않게 같은 용족인 나다레와 조우하고, 나다레에게 패배하고 말았다. 다행히 무사히 도망친 도렌과 무도는 타고의 안내를 받아 용의 기척을 쫓아온 센야와 재회하게 된다. 한편 무의 백성은 더욱 군단을 증강하려고 어둠 무리를 찾아 바위 어둠들의 마을로 향했는데.", "episode_num": "12", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87272/v30/952899c9b8f2/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111049, "name": "전국요호: 천마혼돈 편 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111048, "name": "전국요호: 천마혼돈 편 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-17T02:00:08.581038", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-10-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78737, "title": "전국요호: 천마혼돈 편", "subject": "조우(재회)", "description": "무의 백성이 센야와 결전을 치를 땅으로 고른 곳은 8년 전에 격전이 벌어졌던 단괴중 총봉산이었다. 단괴중 승정 인가는 센야, 무도, 도렌 셋의 투기는 어둠의 대군에 필적하는 힘이 있다고 느꼈고, 거기서 총본산 탈환의 희망을 발견했다. 각자 악연이 있었기 때문에 '가장 먼저 만난 사람이 진운과 싸운다'라는 약속을 하고 총본산으로 돌격하는 센야 일행. 무의 백성에게 조종당하는 어둠 병사들을 물리치고 세 사람은 총본산을 뚫고 나아갔다. 만상왕을 쫓고 있었던 타마도 여기에 가세하지만 그곳에 나타난 것은 타마가 가장 싸우고 싶지 않은 상대였는데...", "episode_num": "13", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87403/v30/f5d89447def6/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111374, "name": "전국요호: 천마혼돈 편 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111373, "name": "전국요호: 천마혼돈 편 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-24T02:00:06.922821", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-10-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78778, "title": "전국요호: 천마혼돈 편", "subject": "개안", "description": "무의 백성의 지시를 따르지 않은 진운(나다레)은 토렌과의 대결을 원했다. 두 사람은 격렬한 투기를 발산했고 그것은 전투를 지켜보던 타마 일행을 압도했다. 한편, 무의 백성은 도렌과 진운의 전투에도 아랑곳 않고 센야에게 어둠 군단을 보냈다. 수많은 어둠들의 공격에 서서히 밀리는 센야. 그런데 센야의 육체는 소모되었지만 영기는 끊임없이 솟아나 흘러넘치고 있었다. 조종당하는 모든 어둠들을 구하고 싶다... 그 진리에 다다랐을 때, 센야는 새로운 경지에 오르게 되었는데.", "episode_num": "14", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87553/v30/266da0096f18/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111531, "name": "전국요호: 천마혼돈 편 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111530, "name": "전국요호: 천마혼돈 편 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-31T02:00:07.528910", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-10-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78779, "title": "전국요호: 천마혼돈 편", "subject": "만상왕, 강림", "description": "무의 백성에게 조종당해서 타마를 공격하는 샤쿠간. 그때 달려온 것은 신스케였다. 타마와 신스케는 샤쿠간을 구속하려 했지만 고전을 면치 못했다. 틈을 봐서 유계 간섭을 사용한 신스케가 샤쿠간의 의식 속에서 본 것은 그녀가 샤쿠야쿠였던 시절의 끔찍한 기억이었다. 마을 사람들로부터 빨간 머리라며 심하게 박해받던 샤쿠야쿠의 앞에 나타난 것은 백마를 탄 수수께끼의 사무라이였는데.", "episode_num": "15", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/87792/v30/370f75aa8d6d/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111771, "name": "전국요호: 천마혼돈 편 15 대여", "list_price": 700