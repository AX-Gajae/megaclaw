st": [], "running_time": "0:23:37.600000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7519, "name": "소드 아트 온라인 2기 14 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22208, "name": "소드 아트 온라인 2기 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.478151", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10803, "title": "소드 아트 온라인 2기", "subject": "총집편", "description": "어머니를 지키기 위해 어린 나이에 총으로 사람을 죽여야 했던 시노는 계속 혼자 트라우마와 싸우고 있었다. 그런데 신카와의 소개로 건 게일 온라인을 알게 되고, 그곳에서 스나이퍼로 활약하면서 시노는 자신이 강해질 수 있다고 믿게 되었는데.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8924/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7520, "name": "소드 아트 온라인 2기 15 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22209, "name": "소드 아트 온라인 2기 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.412583", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10804, "title": "소드 아트 온라인 2기", "subject": "호수의 여왕", "description": "한 해가 저물어가는 12월 말 어느 날, 키리토는 ALO에서 엑스칼리버가 발견되었다는 소식을 접한다. 하지만 사실 그 엑스칼리버는 몇 달 전에 이미 키리토와 리파가 점찍어 둔 상태였는데... 다른 플레이어들이 선수칠까 걱정된 키리토는 멤버들을 불러서 엑스칼리버가 숨겨져 있는 던전을 공략하기로 한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8925/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7521, "name": "소드 아트 온라인 2기 16 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22210, "name": "소드 아트 온라인 2기 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.380791", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10805, "title": "소드 아트 온라인 2기", "subject": "거인의 왕", "description": "키리토 일행은 천신만고 끝에 라스트 보스 스림이 있는 4층 앞까지 다다른다. 그런데 4층 도착 직전, 얼음감옥에 갇힌 NPC를 구해주게 되는데... 그 NPC 프레이야에게서는 왠지 수상한 느낌이 들었다.\n", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8926/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7522, "name": "소드 아트 온라인 2기 17 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22211, "name": "소드 아트 온라인 2기 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.351108", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10806, "title": "소드 아트 온라인 2기", "subject": "엑스캘리버", "description": "키리토의 파티는 라스트 보스 스림 앞에서 고전에 고전을 거듭했다. 이를 보다 못한 프레이야는 일족의 보물만이 유일한 희망이라고 말하는데... 보물 더미에서 가까스로 찾아낸 프레이야의 일족의 보물은 황금빛 망치였다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8928/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7523, "name": "소드 아트 온라인 2기 18 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22212, "name": "소드 아트 온라인 2기 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.303443", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10807, "title": "소드 아트 온라인 2기", "subject": "숲속의 집", "description": "신 아인크라드에서 되찾은 키리토와 아스나의 통나무집은 멤버들의 새로운 휴식처가 되었다. 거기에서 평온한 한때를 보내던 멤버들은 문득 소문 이야기를 꺼내는데... 그건 키리토마저도 이기지 못한 절검으로 불리는 강자에 대한 이야기였다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8927/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7524, "name": "소드 아트 온라인 2기 19 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22213, "name": "소드 아트 온라인 2기 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.255584", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 10808, "title": "소드 아트 온라인 2기", "subject": "절검", "description": "아스나는 전학을 추진하는 엄마와 크게 다투고 자신의 무력함에 눈물짓는다. 그리고 다음날, 절검과 대전하기 위해 멤버들과 함께 24층으로 향하는데... 절검의 이미지는 아스나의 상상과는 완전히 딴판이었다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/8929/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7525, "name": "소드 아트 온라인 2기 20 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 22214, "name": "소드 아트 온라인 2기 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:26.235619", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}