assification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2004-08-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89772, "title": "신세기 에반게리온", "subject": "네 번째 적격자", "description": "에바 4호기와 네르프 제2지부가 소멸된 일로 미국 정부는 에바에 관한 일체의 권한을 일본의 네르프 본부로 넘긴다. 그 때문에 미국에서 건조 중이던 에바 3호기는 일본 마츠시로에서 기동 실험을 하게 되고, 3호기에 탈 네 번째 파일럿, 포스칠드런을 뽑기로 하는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/102162/v30/f4ed762958c6/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:26.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127858, "name": "신세기 에반게리온 17 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-31T00:00:16.238122", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2004-08-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89773, "title": "신세기 에반게리온", "subject": "생명의 선택을", "description": "에바 3호기의 기동 시험 중 사도에게 침식당하는 일이 발생한다. 겐도는 3호기를 사도로 간주하고 신지에게 파기를 명한다. 하지만 자신과 같은 나이의 아이가 타고 있다는 생각에 신지는 싸우기를 주저한다. 그러자 겐도는 신지의 의사와는 상관없이 더미플러그를 써서 초호기로 3호기를 부숴버리는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/102150/v30/111b94ac032b/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:25.700000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127859, "name": "신세기 에반게리온 18 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-31T00:00:16.434193", "rating": {"rating": 15, "rating_type": "방송통신심의위원