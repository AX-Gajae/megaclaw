bnail.laftel.net/assets/2019/01/22816/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:17.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32686, "name": "페어리 테일 6기 15 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27287, "title": "(더빙) 페어리 테일 6기", "subject": "복마전", "description": "황도12궁의 열쇠를 건네주기 위해 루시를 찾아온 유키노. 나츠는 세이버 투스가 동료인 유키노를 버렸다는 사실에 분노하여 세이버 투스로 쳐들어가지만 때마침 나타난 미네르바에 의해 저지당한다. 그리고 시작되는 3일차 경기 복마전. A팀에서 출전한 엘자가 충격적인 선언을 하는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22817/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:57", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32781, "name": "페어리 테일 6기 16 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27288, "title": "(더빙) 페어리 테일 6기", "subject": "100대1", "description": "여덟 명의 참가자가 돌아가며 총 100마리의 몬스터를 쓰러트리는 게임 복마전. 욕심부리지 않는 것이 포인트지만, 1번 제비를 뽑은 엘자는 망설임 없이 100마리를 상대하겠다 선언한다. 요정여왕 티타니아의 무모하면서도 장렬한 싸움에 모두가 할 말을 잃는다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22796/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:57", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32690, "name": "페어리 테일 6기 17 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27289, "title": "(더빙) 페어리 테일 6기", "subject": "렉서스 vs. 알렉세이", "description": "복마전에서의 엘자의 활약으로 3일차 중간순위 4위로 훌쩍 뛰어오른 페어리 테일 A팀! 드디어 그들의 반격이 시작된다. 그리고 이어지는 배틀 파트에서는 렉서스가 레이븐 테일의 알렉세이와 대결하게 되는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22797/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:57.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32779, "name": "페어리 테일 6기 18 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27290, "title": "(더빙) 페어리 테일 6기", "subject": "웬디 vs. 쉐리아", "description": "아버지 이완의 계략으로 레이븐 테일의 다섯 명 전원과 싸우게 된 렉서스. 이완은 루멘 이스투아르가 있는 곳을 말하라며 몰아붙이지만 결국 렉서스에게 호되게 당하고 만다. 이어지는 제4시합은 웬디 대 쉐리아. 놀랍게도 쉐리아는 웬디와 같은 천공마법을 쓰는 멸신마도사였다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22798/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:57.066000", "progressbar": null, "item_expir