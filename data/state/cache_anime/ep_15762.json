l_path": "https://thumbnail.laftel.net/assets/2019/02/24569/v1/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 36832, "name": "드래곤볼 Z 2기 17 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-03-29T21:30:00.036332", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 30000, "title": "드래곤볼 Z 2기", "subject": "면허 취득? 오공의 새로운 시련", "description": "쇼핑에서 돌아오는 산길에서 멧돼지에게 습격당한 치치는 즐거운듯이 에어카를 날리는 부부의 모습에 화를 낸다. 오공과 피콜로에게 면허를 따라고 명령한다. 교습소에서도 경쟁하는 두 사람은 어느 비오는 날의 도로 위 교습중에 유치원 버스가 산사태에 휩쓸리는 모습을 목격하는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/02/24572/v1/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 36835, "name": "드래곤볼 Z 2기 18 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-03-29T21:30:00.036332", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 30001, "title": "드래곤볼 Z 2기", "subject": "기척이 없는 살인귀, 누가 인조인간이냐!?", "description": "수행을 마치고 약속장소에 집결한 전사들. 하지만 트랭크스의 예고대로 10시간이 지나도 적의 기척은 느낄수가 없다. 그 때, 선두 전달용이던 막무가내의 스카이카가 돌연 폭발하며 나타난 인조인간들이 길에 내린다. 전사들은 기가 느껴지지 않는 적을 찾는 것에 당황해하지만, 곧 야무치가 인조인간을 발견하는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbna