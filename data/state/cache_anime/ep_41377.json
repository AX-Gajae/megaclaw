broadcast_date": "2023-05-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 72884, "title": "데드 마운트 데스 플레이 part 1", "subject": "The Magician -마술사-", "description": "포르카는 그의 정체를 꿰뚫어 본 시노야마 로잔에게 자초지종을 설명한다. 한편, 이와노메와 아라세는 괴인 솔리테어에게 이야기를 들으러 구치소로 찾아간다. 하지만 솔리테어는 신주쿠에 나타났던 해골에 흥미를 보이며 이야기 도중에 갑자기 사라진다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80980/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 103263, "name": "데드 마운트 데스 플레이 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-05-03T00:00:10.291202", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-05-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 72885, "title": "데드 마운트 데스 플레이 part 1", "subject": "The Assassin -암살자-", "description": "로잔의 지시로 신주쿠에서 포르카 일행과 같이 살게 된 시노야마 사요와 수행원 레이 샤오유. 샤오유는 포르카가 가짜라는 걸 알고 못마땅하게 여기며 정체를 밝혀내기로 다짐한다. 한편, 이와노메와 아라세는 방화 사건을 조사하기 위해 시노야마 저택을 찾아간다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80981/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 103262, "name": "데드 마운트 데스 플레이 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-05-03T00:00:10.291202", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadca