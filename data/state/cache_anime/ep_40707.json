od": "0 day", "promotion": null}], "published_datetime": "2022-01-19T00:00:00.102357", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-01-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52116, "title": "플래티넘 엔드 part 2", "subject": "확산의 힘", "description": "목숨과 맞바꾼 무카이도의 행동으로 메트로 폴리맨이었던 카나데와의 기나긴 싸움에 드디어 종지부를 찍었다. 하지만 미라이는 눈치채고 있었다. 카나데가 누군가가 쏜 빨간 화살에 맞았다는 사실을......대체 누가 카나데를 조종하고 있던 것일까? 경찰에서도 신 후보들의 정체를 밝히기 위해 본격적으로 움직이기 시작했고 사태는 다음 국면으로 진행되고 있었다. 그리고 다시 새로운 신 후보가 행동을 시작하는데.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/01/54985/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:21.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 69342, "name": "플래티넘 엔드 part 2 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 69341, "name": "플래티넘 엔드 part 2 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-01-26T00:00:00.091851", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-01-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52277, "title": "플래티넘 엔드 part 2", "subject": "최고의 암살자", "description": "신 후보 초등학생 스스무가 '신 선택'에 대한 정보를 TV 중계로 대대적으로 밝히고 말았다. 이를 계기로 전 세계의 사람들이 신 후보를 찾기 시작했다. 긴장하는 미라이와 사키. 두 사람은 이제 전 세계로부터 쫓기는 몸, 무슨 일이 있어도 정체가 밝혀져선 안 된다...... 하지만 어느 날 학교를 마치고 집으로 가던 중. 호시라는 경찰청의 형사가 미라이에게 접촉해 오는데.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55179/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:20.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 69852, "name": "플래티넘 엔드 part 2 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 69851, "name": "플래티넘 엔드 part 2 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-02T00:33:14.964149", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52705, "title": "플래티넘 엔드 part 2", "subject": "그 외 5인", "description": "경찰인 호시와 유미키의 협력을 얻어 미라이와 사키는 다른 신 후보들을 찾기 시작한다. 주변의 인간이 연달아 사망한 중학생인 나카우미 형제, 그들 중 하나가 신 후보일 것이라고 추측한 미라이 일행은 나카우미 형제의 집으로 향한다. 그곳에서 그들이 목격한 의외의 광경......동생 나카우미 슈지를 설득해 보려는 미라이였지만, 나카우미의 마음은 굳건했고 쉽게 마음을 열지 않았다. 행복이란 무엇인가?라는 물음과 미라이는 다시 한번 마주하는데.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55300/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:20.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70147, "name": "플래티넘 엔드 part 2 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70146, "name": "플래티넘 엔드 part 2 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-09T00:00:00.044062", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52807, "title": "플래티넘 엔드 part 2", "subject": "최후의 만찬", "description": "미라이, 사키, 스스무, 나카우미...... 지금까지 의사를 확인한 신 후보는 4명. 남은 것은 두 명. 그중 한 명인 테마리 유리는 경찰에 잡혀 연금된 상태였