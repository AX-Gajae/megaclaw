, "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62479, "title": "나의 백합은 일입니다!", "subject": "여름을 맞은 리베 여학교에 오신 걸 환영합니다!", "description": "블루메 선거도 끝나고 리베 여학교에 여름이 찾아왔다. 마이는 영업을 확대하기 위해 직원들의 교복도 하복으로 바꾸고 학생들의 추천 차도 부활시키기로 했다. 귀여움에 포인트를 둔 하복은 대부분의 직원들에게 잘 어울렸지만 가슴이 큰 야노가 입자 문제가 생겼다. 야노 본인은 하복을 마음에 들어 했지만 남들이 보기엔 부담스러울 만큼 야해 보이는 게 문제였는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69747/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85050, "name": "나의 백합은 일입니다! 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85049, "name": "나의 백합은 일입니다! 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-23T02:00:08.347468", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-22", "rating_components": []}, "access_type": null, "is_available": false}]}