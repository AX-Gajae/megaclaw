ating_components": []}, "access_type": null, "is_available": false}, {"id": 18574, "title": "이니셜 D Fourth Stage", "subject": "폭풍의 85 터보", "description": "그 힘겨운 일전이 끝난지 한나절이 채 지나지도 않은 새벽.\n타쿠미는 아키나 내리막에서 처음 보는 차에 보기 좋게 추월당하고 만다.\n한편 허탈함과 패배감 속에서 찾아온 타쿠미에게 이츠키는 터보 85를 선보이는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15496/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16224, "name": "이니셜 D Fourth Stage 7 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:23.837508", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18575, "title": "이니셜 D Fourth Stage", "subject": "운명의 FD 배틀", "description": "사이타마 원정의 시작을 알리는 사다미네 고개 배틀.\n상대방 힐클라임 대표는 검은 FD를 타는 여자 라이더, 이와세 쿄코였다.\n그런데 쿄코는 이전에 케이스케와 한 번 마주친 적이 있는 사이였고, 케이스케에게 한눈에 반해 있었다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15497/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16225, "name": "이니셜 D Fourth Stage 8 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:24.553443", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18576, "title": "이니셜 D Fourth Stage", "subject": "쿄코의 고백", "description": "쿄코는 케이스케를 만나기 위해 아카기로 찾아온다.\n하지만 케이스케는 그런 쿄코를 매몰차게 거절하는데…\n한편 사이타마 라이더들은 프로젝트 D에 대항하기 위하여 필승카드를 준비하는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15498/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16226, "name": "이니셜 D Fourth Stage 9 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:25.433406", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18577, "title": "이니셜 D Fourth Stage", "subject": "사이타마 구역 최종병기", "description": "분타에게서 86을 완전히 물려받은 타쿠미는 86에 한층 더 애찾을 갖기로 한다.\n한편 프로젝트 D와 사이타마 북서 연합팀과의 배틀 날에는 많은 비가 내리고 있었는데...\n동료들에 대한 의리와 케이스케에 대한 연심에서 갈등하던 쿄코는 케이스케를 응원하기 위해 고개를 찾는다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15499/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16227, "name": "이니셜 D Fourth Stage 10 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:26.273377", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18578, "title": "이니셜 D Fourth Stage", "subject": "빗속의 다운힐 배틀", "description": "경차 카푸치노를 상대로 아키나의 86은 고전을 면치 못한다.\n직선주로에서 따라잡지만 코너에서 뒤지는 상황은 타쿠미에게는 처음 있는 일이었고, 이는 초조함으로 이어졌다.\n어떻게든 필사적으로 카푸치노를 쫓아가는 타쿠미, 하지만 초조함은 상대방이 더욱 심했는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15500/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16228, "name": "이니셜 D Fourth Stage 11 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:27.317362", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18579, "title": "이니셜 D Fourth Stage", "subject": "갈등의 직선주로", "description": "급경사 섹션이 끝나고 경사가 완만한 후반부에 진입한 내리막 배틀 1차전.\n그리고 예기치 않게 내린 비는 타쿠미에게 오히려 유리한 요소로 작용한다.\n카푸치노를 바짝 쫓는 86, 하지만 막바지 직선주로에서 타쿠미는 이렇게 이기는 게 정당한 것인지 갈등하는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15501/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16229, "name": "이니셜 D Fourth Stage 12 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:28.433185", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18580, "title": "이니셜 D Fourth Stage", "subject": "동기부여", "description": "카푸치노를 운전한 사카모토는 타쿠미의 주행이 프로 답다는 이야기를 한다.\n주행 때의 의욕이 엄청나고, 강력한 동기부여가 있는 듯하다는 이야기와 함께…\n한편 힐클라임은 케이스케의 FD와 와타루의 레빈이 장기전을 펼치고 있었다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15503/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16230, "name": "이니셜 D Fourth Stage 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-24T17:27:48.210363", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18581, "title": "이니셜 D Fourth Stage", "subject": "슬픈 론리 드라이버", "description": "아키나 다운힐에서 타쿠미의 86을 제쳤던 임프레자가 다시 타쿠미 눈앞에 나타난다.\n타쿠미는 그 드라이버가 분타였다는 사실을 알자 경악하고, 임프레자를 몰면서 다시 한 번 경악한다.\n한편 이츠키는 다시 만난 카즈미와 좋은 분위기 속에서 데이트를 하는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15502/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16231, "name": "이니셜 D Fourth Stage 14 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:30.729354", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18582, "title": "이니셜 D Fourth Stage", "subject": "4WD 콤플렉스", "description": "임프레자를 몰아보면서 86을 어떻게 몰아야 하는지 알 수가 없게 된 타쿠미.\n와타루는 다음번 상대도 4WD니까 거기에서 무언가 실마리를 찾아 보라고 조언한다.\n그런데 다음번 상대들은 란에보를 모는 굉장히 불쾌한 녀석들이었다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15505/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16232, "name": "이니셜 D Fourth Stage 15 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:31.921254", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18583, "title": "이니셜 D Fourth Stage", "subject": "분노의 힐클라임", "description": "누군가가 도로에 뿌려 둔 오일 때문에 FD가 망가져 버린 케이스케는 낙담하고 만다.\n자기 때문에 D의 전적에 어이없는 1패가 추가된다는 자괴감에 눈물 흘리는 케이스케.\n그런데 그때, 저 멀리에서 로터리 사운드가 들려오면서 검은색 차가 나타나는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15504/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16233, "name": "이니셜 D Fourth Stage 16 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:33.257407", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18584, "title": "이니셜 D Fourth Stage", "subject": "사이타마 구역 최종결전", "description": "쿄코의 차로 힐클라임을 가볍게 잡아낸 케이스케에 이은 타쿠미의 다운힐.\n저쪽 팀에서는 어깨들을 불러모으며 협박하지만 타쿠미는 거기 굴하지 않고 자기 실력을 발휘한다.\n그리고 배틀이 끝난 후, 프로젝트 D 멤버들을 지키기 위해서 맨 앞에 선 케이스케가 본 것은…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15506/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16234, "name": "이니셜 D Fourth Stage 17 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:34.649554", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18585, "title": "이니셜 D Fourth Stage", "subject": "라스트 드라이브", "description": "차를 빌려준 보답을 하기 위해서 케이스케는 쿄코와 데이트를 하기로 한다.\n하지만 그 마지막에 기다리고 있던 것은 예정된 이별.\n프로젝트 D의 에이스로서 D를 완성시킬 때까지 다른 것은 아무것도 관심에 두지 않겠다고 케이스케는 다시 한 번 결심을 굳히고…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15507/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16235, "name": "이니셜 D Fourth Stage 18 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:36.069316", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18586, "title": "이니셜 D Fourth Stage", "subject": "갓 풋과 갓 암", "description": "다음 원정지인 이바라키에는 여태껏 만난 적 없는 강적들이 있다고 한다.\n신의 손, 갓 암으로 불리는 죠시마 토시야와 신의 발, 갓 풋으로 불리는 호시노 코조는 퍼플의 양대 기둥이자 중년 라이더.\n신으로 불리는 사나이들과 싸우기 위하여 프로젝트 D는 만반의 준비를 갖추어 원정길에 오른다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15508/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16236, "name": "이니셜 D Fourth Stage 19 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:37.729356", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18587, "title": "이니셜 D Fourth Stage", "subject": "초절정 GT-R!", "description": "신의 발로 불리는 호시노 코조의 R34의 주행은 가히 신의 경지였다.\n오르막과 내리막이 결합된 복합 스테이지, 케이스케의 FD는 오르막에서 뒤쳐졌다가 내리막에서 따라잡는 전개를 이어가는데…\n이러한 전개는 케이스케가 앞에서 출발할 경우, 내리막에서 상대를 따돌릴 수 있는 유리한 조건이었다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15509/v4/Thumbnail.0000065.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:27:22.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16237, "name": "이니셜 D Fourth Stage 20 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-30T21:54:39.349429", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-02-19", "rating_components": []}, "access_type": null, "is_available": false}]}