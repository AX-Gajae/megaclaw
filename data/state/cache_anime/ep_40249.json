 "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 60838, "name": "괴롭히지 말아요, 나가토로 양 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 60837, "name": "괴롭히지 말아요, 나가토로 양 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-05-05T00:30:00.135621", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-05-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 46416, "title": "괴롭히지 말아요, 나가토로 양", "subject": "선배의 복슬복슬/선배, 잘 먹었음요!!", "description": "길어진 머리를 커트해 주겠다고 말하는 나가토로. 조마조마해 하며 부탁하는 선배였지만 마침 나가토로의 전화가 울리면서 사태는 뜻밖의 방향으로......내일부터 여름 방학. 유명한 빙수 가게에 줄을 선 나가토로와 선배. 폭염 속에서 땀범벅이 된 나가토로를 본 선배는 예상 밖의 행동을 하는데......!", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/05/47292/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 60993, "name": "괴롭히지 말아요, 나가토로 양 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 60992, "name": "괴롭히지 말아요, 나가토로 양 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-05-12T00:30:00.109169", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-05-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 46555, "title": "괴롭히지 말아요, 나가토로 양", "subject": "선배, 완전 쉬워요~♥/선배! 바다, 같이 가요!!", "description": "눈을 떠보니 그곳은 판타지 세계. 세계의 구세주로서 선택받은 선배는 우연히 만난 네코토로와 함께 마왕의 성을 목표로 나아가는데......여름 방학. 방에서 뒹굴뒹굴하던 선배에게 나가토로에게서 같이 바다에 가자는 메시지가 도착한다. 마지못해 도착한 그곳에는 나가토로 프렌즈가 기다리고 있었는데......!", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/05/47514/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 61188, "name": "괴롭히지 말아요, 나가토로 양 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 61187, "name": "괴롭히지 말아요, 나가토로 양 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-05-19T00:30:00.107361", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-05-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 46607, "title": "괴롭히지 말아요, 나가토로 양", "subject": "선배, 축제 안 갈래요?/데이트 같네요, 선배♥", "description": "오늘은 여름 축제. 나가토로에게서 축제에 가자는 연락이 오기를 기대하는 선배였지만 연락은 오지 않았다. 우연한 만남을 기대하며 여름 축제 장소로 나간 선배였지만 그곳에 나타난 것은......함께 불꽃놀이를 보러 간 나가토로와 선배. 숨겨진 장소에서 불꽃놀이를 감상하는 두 사람. 서서히 이상한 분위기가 되고, 나가토로의 괴롭힘에 반격하지 않은 선배가 나가토로에게 키스를......!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/05/47618/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 61280, "name": "괴롭히지 말아요, 나가토로 양 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 61279, "name": "괴롭히지 말아요, 나가토로 양 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-05-26T00:30:00.095352", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "bro