제 한 번 더 점수를 빼앗기면, 케이의 아버지는 목숨을 잃게 된다.", "episode_num": "22", "episode_order": 22, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/04/92587/v30/94fec124c011/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117431, "name": "동패 Part 2 22 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117430, "name": "동패 Part 2 22 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-04-29T00:00:11.412190", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00392", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 82889, "title": "동패 Part 2", "subject": "절망의 관", "description": "케이는 하토리에게도 목숨을 걸 것을 요구하고, 하토리는 이를 받아들이며 새로운 조건을 내건다. 케이의 점수가 천 점씩 줄어들 때마다 인주 한 명의 목숨을 희생시키고, 마이너스가 될 경우 케이 역시 목숨을 걸어야 한다는 것이다.", "episode_num": "23", "episode_order": 23, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/04/92588/v30/8f348ffdf4fc/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117433, "name": "동패 Part 2 23 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117432, "name": "동패 Part 2 23 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-04-29T00:00:11.642443", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00392", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 82890, "title": "동패 Part 2", "subject": "최후의 승자", "description": "결국 목숨을 던진 케이지만, 3분 이내에 처치하면 살아날 가능성이 남아 있다. 케이를 대신해 마작을 두게 된 유우는 상황을 빨리 끝내려 하지만, 어느새 3분이 지나고 만다. 한편 타카츠는 조직의 존속을 위해 케이를 버리기로 결심한다.", "episode_num": "24", "episode_order": 24, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/04/92589/v30/57c7b7bb1177/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117435, "name": "동패 Part 2 24 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117434, "name": "동패 Part 2 24 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-04-29T00:00:11.877294", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00392", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 82891, "title": "동패 Part 2", "subject": "인주", "description": "상식을 벗어난 대결의 최종 승자는 유우였다. 죽음 앞에 몰린 하토리는 케이의 생명을 구해주는 대가로, 자신에게 해를 끼치지 않겠다는 약속을 요구하여 목숨을 건진다. 안도한 하토리는 그제야 자신이 쓴 트릭을 하나씩 털어놓기 시작한다.", "episode_num": "25", "episode_order": 25, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/04/92590/v30/cecb2552be04/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117437, "name": "동패 Part 2 25 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117436, "name": "동패 Part 2 25 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-04-29T00:00:12.109173", "rating": {"rating": 19, "rating_type": "영