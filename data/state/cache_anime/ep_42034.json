ng_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-06-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 70260, "title": "쾌걸 근육맨 2세 part 2", "subject": "최악의 공격, 슈팅 애로우!", "description": "근육만두 대 본콜드의 대결이 시작되고, 미트의 조언으로 근육만두는 서서히 시합을 이끌어 간다. 이를 본 본콜드는 민치를 인질로 삼아 미트에게 조언을 하지 말라고 요구한다. 어쩔 수 없이 입을 다무는 미트를 본 민치는 자신은 상관하지 말고 만두에게 조언을 하라고 하는데…", "episode_num": "39", "episode_order": 39, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78011/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:20.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 100620, "name": "쾌걸 근육맨 2세 part 2 39 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-03-14T00:00:08.820348", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-06-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 70261, "title": "쾌걸 근육맨 2세 part 2", "subject": "결과는?! 기적의 힘 챌린지", "description": "본콜드의 공격에 위기에 빠진 근육만두. 미트의 조언이 절실하지만 미트는 아버지를 잃은 충격에 링을 벗어난다. 이에 테리키드와 체크메이트는 힘을 합쳐 조언을 해주고 만두는 두 사람 덕분에 위기를 벗어나 역전의 기회를 얻는다. 한편 미트 앞에 나타난 해골맨은 미트에게 본인의 임무를 다하라고 하는데…", "episode_num": "40", "episode_order": 40, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78012/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:20.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 100619, "name": "쾌걸 근육맨 2세 part 2 40 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-03-14T00:00:08.820348",