ll, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5165, "name": "혈계전선 4 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27532, "name": "혈계전선 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T21:31:21.825654", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6446, "title": "혈계전선", "subject": "진격의 혈퇴", "description": "도로 위의 다른 차량을 집어 삼키며 질주하는 몬스터 트럭. 그 트럭에는 로리타 패션을 한 ‘편집왕’ 아리귤라가 타고 있다. 아리귤라는 전 애인이자, 누계 징역 1000년이 넘는 복역수 ‘브로디&해머’를 손에 넣기 위해 폭주한다. 우연히 트럭에 올라 타게 된 레오는 끝없는 연애 얘기로 아리귤라에게 말 고문을 당한다. 한편, 아리귤라의 폭주를 막기 위해 라이브라는 ‘브로디&해머’를 석방하기로 한다. ", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5448/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5166, "name": "혈계전선 5 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27533, "name": "혈계전선 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T21:31:21.985890", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6447, "title": "혈계전선", "subject": "Don’t forget to Don’t forget me", "description": "햄버거 가게를 나서던 레오는 햄버거를 사랑해 마지않는 먹보, 네지를 만난다. 버섯 같은 몸을 가진 네지는 한계 이상의 스트레스를 받으면 자신을 포함한 주변 모두의 기억을 잃게 만드는 포자를 만들어낸다. 레오는 종종 함께 햄버거를 즐기며 네지와 친해지지만, 포자의 능력을 알아챈 깡패 두 명에게 네지와 함께 납치되고 만다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5449/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:33.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5167, "name": "혈계전선 6 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27534, "name": "혈계전선 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T21:31:22.426875", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6448, "title": "혈계전선", "subject": "권객의 에덴", "description": "화이트의 쌍둥이 오빠 ‘블랙’과 만난 레오는 여동생을 둔 오빠라는 입장에서 공감대를 형성하며 친해진다. 한편, 재프로부터 비명 섞인 전화를 받은 레오는 크라우스와 함께 ‘에덴’으로 향한다. 그곳은 매일 밤 남자들이 모여 맨손으로 싸우며 시합을 벌이는 지하 격투기장. 빚에 쫓기던 재프가 크라우스를 시합에 끌어들이기 위해 부른 것으로, 영문을 모르는 크라우스는 갑자기 스포트라이트를 받으며 링에 오르게 된다.  ", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5450/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:32.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5168, "name": "혈계전선 7 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27535, "name": "혈계전선 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T21:31:22.868651", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6449, "title": "혈계전선", "subject": "Z의 가장 긴 하루(전편)", "description": "블랙과 함께 박물관을 방문한 레오. 그곳에서 3년 전, 뉴