ating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-07-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63722, "title": "교향시편 유레카 세븐", "subject": "상반된 생각", "description": "월광호를 고치기 위해서 발굴 터에 숨어 지내기로 한 월광 스테이트 멤버들.\r\n수리에 필요한 자재와 음식 등을 구할 겸 동굴 탐험에 나선다.\r\n하지만 오래전에 폐허가 된 동굴에서 손에 넣을 것은 별로 없었다.\r\n렌턴은 일행과 떨어져서 동굴 안을 탐색하다가 전기가 들어오면서 많은 음식과 아늑한 공간이 있는 곳을 발견한다.\r\n음식을 먹고 잠이 든 렌턴은 주변이 시끄러워져서 깬다.\r\n그곳에는 유레카가 있었고, 렌턴은 요즘 사이가 좋지 못한 유레카에게 사과한다..\r\n그러는 중에 코랄리안 속에서 본 것과 같은 꿈이라는 것을 깨닫지만, 갑자기 나타난 디엔드에 당황한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70178/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:27.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86595, "name": "교향시편 유레카 세븐 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86594, "name": "교향시편 유레카 세븐 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-03T00:00:08.345019", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-07-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63723, "title": "교향시편 유레카 세븐", "subject": "하늘 동굴", "description": "월광호를 수리하기 위해서 꼭 필요한 리프렉션 필름을 구하기 위해 나선다.\r\n켄고의 지인인 리프렉션 필름을 만드는 장인을 찾아 가지만, 그는 이미 죽고 아들만 남아 있었다.\r\n술에 절어서 지내는 아들 닐을 설득하여 리프렉션 필름을 만들 재료를 찾아 나선다.\r\n리프렉션 필름의 재료는 스카이 피쉬, 그 스카이 피쉬를 잡기 위해 술판을 벌인다.\r\n즐거운 사람 옆에 모인다는 스카이 피쉬를 잡아, 드디어 리프렉션 필름을 만든다.\r\n한편 듀이는 부대를 재결성하게 되면서 세컨드 서머 오브 러브를 계획한다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70180/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list"