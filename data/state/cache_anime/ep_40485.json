0 day", "promotion": null}], "published_datetime": "2021-10-03T19:00:00.060966", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2021-10-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49556, "title": "(더빙) 토리코 1기 part 2", "subject": "마지막 한 방울! 센츄리 수프는 누구에게?", "description": "유우가 늦어지자 미식회의 지배인 알파로가 아이스 헬로 마중을 나온다. 거기서 알파로는 단숨에 두 마리의 괴물을 해치운다. 한편, 텟페이는 구르메 쇼 윈도우를 쥐어짜고 마지막으로 한 방울의 수프가 떨어진다. 토리코 일행은 서로 이야기 끝에 마츠가 수프를 먹기로 한다. 그리고 알파로가 다가오는 걸 느낀 토리코 일행은 서둘러 빙산에서 빠져나가기로 하는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/10/51788/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65868, "name": "(더빙) 토리코 1기 part 2 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 65867, "name": "(더빙) 토리코 1기 part 2 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-10-09T19:00:00.032470", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2021-10-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49557, "title": "(더빙) 토리코 1기 part 2", "subject": "굿 바이, 아이스 헬! 세츠노의 숨겨진 힘", "description": "아이스 헬에서 마주친 알파로 일행과 세츠노. 세츠노의 숨겨진 힘을 경험한 알파로 일행은 두 말 않고 물러선다. 한편, 토리코 일행은 무사히 동굴의 출구를 찾아내 탈출에 성공하지만, 바다에 있어야 할 배가 사라지고 없다. 마츠와 텟페이의 대화를 도청한 커넬이 배를 돌려 가버린 것이었다. 돌아갈 방법이 없어 당황하는 그들 앞에 코코와 세츠노가 나타나고, 일행은 무사히 아이스 헬을 빠져나간다. 세츠노의 음식을 맛있게 먹은 토리코 일행은 부상자들의 치료를 위해 치유의 나라 라이프로 가는데...", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/10/51789/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:05.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65866, "name": "(더빙) 토리코 1기 part 2 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 65865, "name": "(더빙) 토리코 1기 part 2 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-10-09T19:00:00.032470", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2021-10-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49558, "title": "(더빙) 토리코 1기 part 2", "subject": "호쾌한 치료! 재생가 요삭 등장!", "description": "라이프를 둘러보며 다양한 시설을 이용해보던 토리코 일행은 미용을 위해 라이프에 와있던 써니와 우연히 마주친다. 그리고 식당에서 텟페이의 사부 요삭을 만나 그의 재생소가 있는 마더우드까지 따라간다. 그의 재생소는 온갖 희귀한 식재료들이 재생되고 있는 곳이었다. 요삭이 토리코의 동료들을 차례차례로 치료해주자 타키마르는 자신을 살려준 아이마르의 병을 고치기 위해 만병통치약을 달라며 무릎을 꿇고 애원한다. 이에 감동한 요삭은 만병통치약을 거저 주겠다고 하는데...", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/10/51897/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 66050, "name": "(더빙) 토리코 1기 part 2 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 66049, "name": "(더빙) 토리코 1기 part 2 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-10-16T22:30:00.058912", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2021-10-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49559, "title": "(더빙) 토리코 1기 part 2", "subject": "토리코의 완치가 먼저냐, 마츠의 수프가 먼저냐!", "description": "토리코는 요삭이 준비한 재생의 씨앗을 이용해 왼팔을 고치는데 힘쓴다. 요삭은 토리코의 놀라운 회복력에 감탄하면서 엄청난 식량을 제공하고 약 벌을 이용해 치료를 계속해 나간다. 한편, 센츄리 수프를 만들다 벽에 부딪친 마츠는 세츠노를 찾아가 충고를 듣는다. 그리고 마침내 마지막 한 가지 재료를 빼고 수프는 거의 완성 단계에 이르게 되는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/10/51898/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:05.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 66048, "name": "(더빙) 토리코 1기 part 2 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 66047, "name": "(더빙) 토리코 1기 part 2 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-10-16T22:30:00.058912", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2021-10-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49560, "title": "(더빙) 토리코 1기 part 2", "subject": "행복의 세계로! 먹어보자, 센츄리 수프!", "description": "마침내 센츄리 수프가 완성된다. 그리고 마츠는 토리코를 비롯해 센츄리 수프를 찾아 모험을 함께한 동료들에게 자신이 완성한 센츄리 수프를 대접한다. 한편 타키마르가 구해온 약을 거부하던 아이마르는 토리코가 전하는 말을 듣고 좀 더 살아보기로 결심한다. 그 이야기는 바로 몇 년 안에 제우스가 나타난다는 것이었다. 미식회도 제우스를 노리고 구르메 세계로 들어갈 수 있는 자를 늘리려하는데...", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/10/52123/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:05.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 66229, "name": "(더빙) 토리코 1기 part 2 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 66228, "name": "(더빙) 토리코 1기 part 2 15 소장", "list_price