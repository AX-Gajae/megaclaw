33000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70960, "name": "살애 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70959, "name": "살애 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-03-18T01:00:00.100756", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-03-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53314, "title": "살애", "subject": "WORST", "description": "17년 전, 현재의 량하는 과거의 량하의 방에서 신세를 지게 된다. 그로부터 5일 후, 현재의 량하는 아침이 되면 떠나겠다고 한다. 다음 날, 과거의 량하는 역에서 안내하기로 했던 노블의 전화를 받는다. 노블은 빨리 아이를 찾아달라고 부탁하다가 누군가의 총에 맞고 쓰러지는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/56172/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 71086, "name": "살애 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 71085, "name": "살애 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-03-25T01:00:00.092050", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-03-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53480, "title": "살애", "subject": "MY NAME", "description": "17년 전, 샤토는 자신을 구해주려던 진짜 량하를 총으로 쏘고 만다. 량하는 샤토를 데리고 필사적으로 도망치지만, 결국 죽는다. 그들과 함께 있었던 소년이자 현재의 량하는 의식을 잃었다가 깨어나고, 경찰에게 진짜 송량하는 존재하지 않았던 것으로 해두라는 충고를 듣는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.l