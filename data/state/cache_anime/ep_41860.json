s_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98432, "name": "원치 않는 불사의 모험가 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98431, "name": "원치 않는 불사의 모험가 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-01-29T22:30:07.913902", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-01-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68719, "title": "원치 않는 불사의 모험가", "subject": "불사의 모험가", "description": "구울에서 시귀로 존재 진화한 렌트. 겉모습도 제법 인간처럼 변해서 스스로 모험가 길드에 가 의뢰를 받고, 실적을 쌓아 나가기로 결심했다. 하지만 렌트는 만년 동급 모험가이면서 길드 내 공헌도도 높고, 원래 얼굴을 알고 있는 사람도 많았다. 로렌느의 조언을 듣고 렌트는 다른 사람으로 길드에 등록했고, 철급 모험가로서 다시 한번 시작하게 되었는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76411/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98531, "name": "원치 않는 불사의 모험가 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98530, "name": "원치 않는 불사의 모험가 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-05T22:30:08.253508", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68871, "title": "원치 않는 불사의 모험가", "subject": "동급 시험", "description": "신입 모험가 렌트 비비에로서 렌트는 까다로운 의뢰를 달성했다. 길드 직원인 셰일라로부터 실력을 인정받아 동급으로 승격하는 시험을 보는 걸 허락받은 렌트는, 곧바로 승격 시험에 참가해 필기시험을 가볍게 통과했다. 다음에 있는 실기 시험에서, 렌트는 자신과 같은 수험자인 라이즈, 로라와 함께 파티를 짜고 신월의 미궁으로 향했다. 하지만 미궁에 들어가기 전부터 이미 시험은 시작되었는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76639/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98834, "name": "원치 않는 불사의 모험가 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98833, "name": "원치 않는 불사의 모험가 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-13T00:00:08.132755", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69244, "title": "원치 않는 불사의 모험가", "subject": "마법 계약", "description": "렌트 일행이 도전한 실기 시험은 수험자들의 싸우는 능력만이 아닌, 모험가로서의 적성을 시험하는 것이었다. 라이즈와 로라는 헤매면서도 렌트의 도움을 받으면서 이를 극복해 나갔다. 그리고 그런 수험자들의 모습을 길드의 직원들은 빠짐없이 관찰하고 있었다. 일련의 보고를 들은 셰일라는, 렌트 비비에의 정체가 렌트 파이너라는 걸 확신했는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76832/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99210, "name": "원치 않는 불사의 모험가 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99209, "name": "원치 않는 불사의 모험가 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-19T22:30:07.589916", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69394, "title": "원치 않는 불사의 모험가", "subject": "새로운 무기와 힘", "description": "대장간의 클로프에게 새로운 검을 주문한 렌트. 검은 훌륭하게 만들어졌지만, 존재 진화와 더불어 마력과 기력, 성력도 강해진 탓에 더 튼튼한 검이 필요해졌다. 미스릴급을 목표로 하는 관계로 좋은 장비가 꼭 필요했고, 이를 위해서는 돈이 있어야 했다. 착실히 돈을 벌기 위해 길드로 향하던 렌트는 성가신 문제를 떠안고 있는 마을 사람과 조우했는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/77351/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99473, "name": "원치 않는 불사의 모험가 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99472, "name": "원치 않는 불사의 모험가 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-26T22:30:06.819478", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69946, "title": "원치 않는 불사의 모험가", "subject": "용혈화", "description": "렌트는 길드에서 값싼 의뢰를 발견했다. 그 보수는 단 동화 한 닢. 길드에서 전통적으로 소개하는, 곤란한 사람들을 돕기 위한 특별한 의뢰였던 것이다. 그 의뢰주는 알리제라고 하는 소녀였는데, 듣자 하니 그녀는 그녀가 신세를 지고 있는 고아원 원장인 릴리안을 도와주었으면 하는 모양이었다. 의뢰를 받아들인 렌트는 릴리안의 병을 치료하는 데 필요한 용혈화를 채집하기 위해 위험한 타라스크의 늪으로 향했는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/77718/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99801, "name": "원치 않는 불사의 모험가 9 대여", "list_price