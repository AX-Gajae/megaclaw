{"count": 12, "next": null, "previous": null, "results": [{"id": 78623, "title": "정령환상기 2", "subject": "이런 세계에서 만난 너는", "description": "결혼식장에서 세리아를 구출한 직후, 6개의 빛의 기둥을 목격한 리오. 그때 아이시아의 요청으로 향한 곳에서 리오의 전생 하루토의 첫사랑인 미하루와 운명의 재회를 한다. 모두가 바위집으로 피신한 그날 밤, 리오는 슈트랄 지방에 전해오는 '육현신의 전설'에 대해 이야기한다.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/88383/v30/8ead2835b60b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110862, "name": "정령환상기 2 1 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 110861, "name": "정령환상기 2 1 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-15T02:00:07.020933", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-10-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78624, "title": "정령환상기 2", "subject": "이세계 쇼핑", "description": "세리아와 미하루 일행의 생필품을 사기 위해 교역 도시인 아망드에 온 리오 일행. 미하루는 처음 온 이세계에 당황하면서도 세리아와 함께 마음껏 쇼핑을 즐긴다. 한편 플로라 왕녀가 있는 벨트람 왕국에는 사카타 히로아키가 용사로서 소환되었다.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87266/v30/9d11e41d8761/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111313, "name": "정령환상기 2 2 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111312, "name": "정령환상기 2 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-22T02:00:08.495685", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-10-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78625, "title": "정령환상기 2", "subject": "습격당한 우리 집", "description": "세리아와 미하루 일행을 부탁하기 위해 정령의 주민의 마을로 돌아온 리오. 장로들에게 미하루 일행에 대해 상담하던 리오는 자신에게 전생의 기억이 있음을 고백한다. 한편 리제롯테는 가르아크 왕국에 용사로 소환된 스메라기 사츠키를 만난다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87415/v30/1464b4d25300/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111466, "name": "정령환상기 2 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111465, "name": "정령환상기 2 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-10-29T02:00:08.200603", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-10-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78626, "title": "정령환상기 2", "subject": "어서 오세요", "description": "정령의 주민의 마을에 온 세리아와 미하루 일행의 환영회가 열린다. 라티파는 자신에게도 일본인이었던 전생의 기억이 있다는 걸 밝힌다. 그로부터 수일 후, 리오는 세리아의 편지를 부모님께 전하기 위해 고향인 로다니아에 갈 것을 제안한다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/10/87546/v30/764c9cc8e40a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111657, "name": "정령환상기 2 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111656, "name": "정령환상기 2 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-05T02:00:41.152623", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-11-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78627, "title": "정령환상기 2", "subject": "용사와 영웅", "description": "리제롯테 일행은 와이번을 피해 가까운 도시로 이동한다. 그곳에는 유그노 공작의 마도선도 피난한 상황. 육로를 이용하려는 리제롯테에게 사카타가 따라가겠다고 나서고, 아망드로 동행하게 된다. 그때 무수의 마물들이 나타나 마차를 습격한다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/87737/v30/abf97873be3f/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111862, "name": "정령환상기 2 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 111861, "name": "정령환상기 2 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-12T02:00:08.276735", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-11-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78628, "title": "정령환상기 2", "subject": "기억의 쐐기", "description": "리제롯테 일행을 구한 리오는 벨트람 왕국의 학원에서 옛 친구였던 플로라와 로아나가 있는 것을 알고는 하루토라고 자칭해 정체를 숨긴다. 한편 정령의 마을에서는 아키가 어린 시절 오빠 하루토와의 슬픈 이별의 기억을 떠올린다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/87791/v30/3f23d3273ab2/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 112327, "name": "정령환상기 2 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 112326, "name": "정령환상기 2 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-19T02:00:07.913029", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-11-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78629, "title": "정령환상기 2", "subject": "침입자들", "description": "아망드에 도착한 리오는 리제롯테가 마련한 숙소에서 세리아, 아이시아와 함께 머무른다. 그날 밤, 레스토랑에서 식사 중인 리오 일행의 방에 학원 시절 동창이었던 알폰스와 스튜어드가 나타난다. 알폰스는 리오 일행을 방에서 쫓아내려고 한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/88379/v30/fb96d8c2da30/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 113119, "name": "정령환상기 2 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 113118, "name": "정령환상기 2 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-26T02:00:09.000111", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-11-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78630, "title": "정령환상기 2", "subject": "소리 없이 다가오는 마수", "description": "숲을 조사하던 기사 일행은 갑자기 나타난 루시우스에게 순식간에 제압당한다. 이윽고 의식을 되찾은 알폰스는 끔찍한 마물 레버넌트로 변하는 기사들을 목격한다. 한편 플로라는 하루토라고 자칭하는 이를 생각하며 학원 시절의 리오를 떠올린다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/11/88955/v30/637f9af78e5e/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 113409, "name": "정령환상기 2 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 113408, "name": "정령환상기 2 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-12-03T02:00:08.409639", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-12-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78631, "title": "정령환상기 2", "subject": "아망드 방위전", "description": "갑자기 무수한 마물의 습격을 받는 아망드. 리제롯테는 시녀들을 곳곳에 배치해 피해를 막으려고 분주하고, 리오도 동문의 수비에 가세해 마물을 쓰러트린다. 한편 루시우스는 레버넌트로 변모한 알폰스의 안내로 리제롯테의 저택에 잠입한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/89263/v30/7502b53e925d/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 113757, "name": "정령환상기 2 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 113756, "name": "정령환상기 2 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-12-10T02:00:07.625484", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-12-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78632, "title": "정령환상기 2", "subject": "운명의 숙적", "description": "레버넌트 무리가 사카타와 플로라 일행이 있는 방을 습격한다. 알폰스의 일격에 사카타는 쓰러지지만, 다시 눈을 뜨고 신장 야마타노오로치의 힘을 해방한다. 한편 홀로 복도로 달아난 플로라는 루시우스에게 붙잡혀 저택 밖으로 끌려 나간다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.n