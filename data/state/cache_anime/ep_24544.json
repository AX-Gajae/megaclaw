75/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": "2019-05-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-04-17T18:31:49.220625", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 725, "title": "세인트 세이야 황금혼 [2019년 판권 만료작]", "subject": "돌입! 유그드라실의 일곱 방", "description": "결계를 파괴하고 유그드라실로 진입한 골드 세인트들은 유그드라실을 지탱하는 일곱 상징이 있는 방으로 흩어진다.\n이때 아이오리아는 리피아에게 위험하니 그만 돌아가라고 하지만 리피아는 말을 듣지 않고...\n각각의 방에는 새로운 오딘 사파이어를 통해 이전보다 비교가 되지 않는 힘을 갖게 된 갓 워리어들이 기다리고 있었다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/1276/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": "2019-05-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-04-17T18:31:49.276881", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 726, "title": "세인트 세이야 황금혼 [2019년 판권 만료작]", "subject": "격진! 갓 클로스 VS 갓 클로스", "description": "거인의 방에서의 타우러스와 헤라클레스의 싸움은 일방적으로 무시하는 타우러스와 이에 격분한 헤라클레스의 공격이 반복되었다.\n그리고 얼음의 방에서는 또다시 카뮈가 갓 워리어들 대신 골드 세인트를 맞아 싸우는데…\n얼음의 방에 도착한 슈라는 인정사정 없이 카뮈에게 돌진한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/1277/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": "201