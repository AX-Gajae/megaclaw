cation_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 28539, "title": "드래곤볼 슈퍼", "subject": "계왕성의 결전! 오공 VS 파괴신 비루스!", "description": "마침내 계왕성에 도착한 비루스. 계왕은 손오공과 비루스가 마주치는 것을 막기 위해 안간힘을 쓰지만, 곧 비루스에게 간파당하고 만다. 비루스는 손오공과 인사를 나누며 슈퍼 사이어인 갓에 대해 묻지만 모른다는 대답이 돌아오자 지구로 가려고 한다. 그런데 그때 손오공이 비루스에게 시합을 제안하고, 가볍게 손오공을 제압한 비루스는 지구로 향한다. 한편 계왕은 베지터에게 비루스가 지구로 향한 사실을 알리는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/02/24557/v4/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 34661, "name": "드래곤볼 슈퍼 5 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2019-02-25T21:00:00.170792", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 28540, "title": "드래곤볼 슈퍼", "subject": "파괴신을 화나게 하지 마라! 두근두근 생일파티", "description": "지구에 도착해서 베지터 앞에 모습을 드러낸 비루스. 과거 비루스의 엄청난 힘을 목격했던 베지터는 지구의 파괴를 막고자 비루스의 심기를 거스르지 않기 위해 최선을 다한다. 그런 베지터의 노력에 힘입어 비루스는 기분 좋게 파티를 즐기지만, 음식을 둘러싼 부우와의 갈등으로 인해 결국 비루스의 분노는 폭발하고 마는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/02/24558/v4/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 34662, "name": "드래곤볼 슈퍼 6 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2019-02-25T21:00:00.170792", "rating": {"rating":