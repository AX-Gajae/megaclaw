: {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67990, "title": "(더빙) 귀환자의 마법은 특별해야 합니다", "subject": "본선", "description": "랭킹전 예선을 순조롭게 돌파한 데지르, 로맨티카, 프람. 베타 클라스의 약진은 신무에 실릴 정도로 화제가 된다. 평민 최초로 알파 클라스 승급 이야기까지 거론되는 세 사람의 활약을 불쾌하게 생각하던 퍼그맨 교수는 노발대발했다. 알파 클라스 학생들에게 데지르 파티를 반드시 탈락시키라고 명령한다. 게다가, 헤브리온 학원에서 가장 격식 높은 파티인 '푸른 달'의 마검사 아제스트 킹스크라운은 입학시험에서 패배한 데지르를 향한 투지를 조용히 불태우고 있었는데──", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76612/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98756, "name": "(더빙) 귀환자의 마법은 특별해야 합니다 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98755, "name": "(더빙) 귀환자의 마법은 특별해야 합니다 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-08T22:30:08.534718", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67991, "title": "(더빙) 귀환자의 마법은 특별해야 합니다", "subject": "마수", "description": "드디어, 랭킹전 본선의 막이 올랐다! 본선 무대는 학원이 준비한 그림자 세계── 그곳에서는 과거에 일어난 역사적 사건이 재현되고 있었다. 사건을 해결하면 클리어할 수 있지만 데지르 일행은 최대 목표인 '상위 9명 안에 남아 싱글 랭커가 되는 것'을 달성하기 위해 다른 학생들에게 도전한다. 다양한 의도가 뒤섞인 가운데 데지르, 로맨티카, 프람은 각자의 강점을 살리면서 알파 클라스에게 도전하며 '싱글 랭커'를 목표하는데!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76724/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expi