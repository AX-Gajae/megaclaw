", "promotion": null}, {"id": 89283, "name": "성녀의 마력은 만능입니다 Season 2 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-25T00:30:08.064496", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-10-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 65629, "title": "성녀의 마력은 만능입니다 Season 2", "subject": "목적", "description": "연구소에서 만난 이후 유학생인 텐유는 매일같이 세이를 찾아서 돌아다닌다. 속이는 것도 한계라고 판단한 요한은 성녀인 것을 밝히지 않고 세이와 만나게 한다. 자기도 모르게 신이 나서 텐유와 식물에 대한 열띤 토론을 하던 세이는 텐유의 목적이 신경 쓰였는데......", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/10/73266/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89448, "name": "성녀의 마력은 만능입니다 Season 2 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 89447, "name": "성녀의 마력은 만능입니다 Season 2 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-01T00:30:09.905736", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-10-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66038, "title": "성녀의 마력은 만능입니다 Season 2", "subject": "텐유", "description": "난병으로 고통받는 어머니가 있는 텐유는 세이란이 받았던 포션을 단서 삼아 뛰어난 실력의 약사를 찾고 있었다. 하지만, 어떤 상급 포션도 진행 중인 병에 효과가 있을 거라고는 기대하기 어려웠다. 사정을 알게 된 세이는 만능약 만들기에 도전하게 되었는데......", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73489/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire