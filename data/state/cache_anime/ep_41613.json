il_path": "https://thumbnail.laftel.net/assets/2026/06/109979/v51/1eb5685af445/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.029000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96266, "name": "주술회전 2기 : 시부야 사변 43 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-01T02:00:10.040031", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67257, "title": "주술회전 2기 : 시부야 사변", "subject": "이비 -3-", "description": "눈앞의 참상에 멍하니 멈춰선 이타도리. 이타도리의 마음은 이미 한계를 넘어섰다. 한편, 마음속으로 그리던 이상적인 전개에 ‘저주’로서 흥분한 마히토는 이타도리에게 다시 타격을 가한다. 마침내 마히토는 최후의 일격을 가하려고 하지만, 바로 그때…", "episode_num": "44", "episode_order": 44, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/109980/v51/48a137af1452/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.029000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96665, "name": "주술회전 2기 : 시부야 사변 44 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-08T02:00:09.346837", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67340, "title": "주술회전 2기 : 시부야 사변", "subject": "변신", "description": "궁지에 몰렸던 이타도리는 토도의 격려를 받고 일어선다. 격렬한 공방 중에 이타도리, 마히토에 이어 토도도 흑섬을 날리고, 세 사람은 제각기 120%의 잠재 능력을 끌어내기에 이른다. 기어를 올린 마히토는 '다중혼' '발체'로 전방위 공격을 가한다. 이타도리, 토도, 마히토는 마침내, 서로를 향한 최후의 저주를 시작하는데…", "episode_num":