": [{"id": 85696, "name": "바람의 검심 -메이지 검객 낭만기- 2 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85695, "name": "바람의 검심 -메이지 검객 낭만기- 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-15T22:30:07.503945", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63358, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "활심류·재시동", "description": "켄신을 보고 소매치기에서 손을 씻기로 결심한 야히코. 관동 슈에이구미에게 하던 상납을 거절하고 저항했지만 구타당하며 절체절명의 위기에 처한다. 그때 켄신이 난입해 그 자리를 정리했다. 자신의 힘으로 해결하지 못한 것을 분하게 여기며 강해지기를 바라는 야히코. 그 모습을 본 켄신은 야히코를 카미야 도장으로 데리고 가는데.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70371/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86093, "name": "바람의 검심 -메이지 검객 낭만기- 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86092, "name": "바람의 검심 -메이지 검객 낭만기- 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-22T22:30:07.577928", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63564, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "싸움꾼·사가라 사노스케", "description": "켄신, 카오루, 야히코가 방문한 소고기 전골 가게 '빨간 소'에서 켄신은 술에 취한 자유민권 운동가들이 언쟁을 벌이다가 던진 술병에 머리를 맞는다. 그리고 가게에 있었던 남자인 사가라 사노스케가 보다 못해 일어나 딱밤 한 대로 민권 운동가를 날려버렸다. 사노스케는 켄신의 실력을 간파하고 흥미를 보였다. '나랑 한번 붙어볼래?'", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70543/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86365, "name": "바람의 검심 -메이지 검객 낭만기- 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86364, "name": "바람의 검심 -메이지 검객 낭만기- 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-29T22:30:06.729566", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63771, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "그리고 동료가 또 한 사람", "description": "참마도를 가볍게 휘두르는 사노스케와 대결하는 켄신. 일격으로는 끄떡도 하지 않는 엄청난 맷집을 자랑하는 사노스케에게 켄신은 연격을 퍼붓는다. 지면에 쓰러진 사노스케. 승부는 이미 결정된 것처럼 보였다. 하지만 사노스케는 의식이 몽롱한 가운데 승리에 집착하게 된 계기가 되었던 10년 전 적보대에서의 과거를 떠올렸는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70679/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86669, "name": "바람의 검심 -메이지 검객 낭만기- 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86668, "name": "바람의 검심 -메이지 검객 낭만기- 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-05T22:30:07.873772", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63983, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "검은 삿갓", "description": "켄신에게 경찰서장이 의뢰를 갖고 찾아온다. 의뢰 내용은 전 유신지사들을 노리는 살인귀 '검은 삿갓'을 쓰러뜨려 달라는 것이었다. 켄신과 사노스케는 참간장을 통해 살해 예고를 받은 타니 쥬산로를 호위하기로 한다. 오전 한 시 예고된 시각에 나타난 검은 삿갓. 그의 정체는 막부 말기부터 암살 임무로 이름을 떨친 부랑자 칼잡이・우도 진에였는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70887/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86883, "name": "바람의 검심 -메이지 검객 낭만기- 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86882, "name": "바람의 검심 -메이지 검객 낭만기- 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-12T22:30:08.578017", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64023, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "두 명의 칼잡이", "description": "칼잡이 발도재였던 시절의 켄신의 강함을 알고 있던 진에는 카오루를 인질로 잡아서 켄신의 분노를 부추긴다. 처절한 싸움을 벌이는 두 사람. 하지만 아직 켄신이 예전의 힘을 발휘하고 있지 않다고 생각한 진에는 카오루에게 니카이도 평법 '심중일방'을 걸어 호흡을 정지시킨다. 카오루가 질식사 하기까지 앞으로 3분── 켄신의 분노는 정점에 도달했는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/71166/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87025, "name": "바람의 검심 -메이지 검객 낭만기- 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87024, "name": "바람의 검심 -메이지 검객 낭만기- 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-19T22:30:07.770704", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64110, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "도주 가인", "description": "사노스케의 친구가 아편 과다 흡입으로 목숨을 잃는다. 하지만 아편은 금지된 마약인 이상 구입하려고 해도 높은 가격에 거래되어 일반인은 쉽게 손에 넣을 수 없는 물건이었다. 이를 의아해하던 켄신과 사노스케의 앞에 수수께끼의 여성 타카니 메구미가 나타난다. 메구미를 붙잡으려고 하는 타케다 칸류의 사병을 격퇴하는 켄신 일행. 하지만 메구미는 아편을 소지하고 있었는데......", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/71410/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87174, "name": "바람의 검심 -메이지 검객 낭만기- 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87173, "name": "바람의 검심 -메이지 검객 낭만기- 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-26T22:30:06.490921", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64316, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "어정번중의 습격", "description": "메구미를 숨겨주던 카미야 도장을 어정번중의 일원인 불뚝이가 습격한다. 입에서 불을 토하는 필살 '화염 날숨'으로 켄신과 사노스케를 공격했다. 강력한 중간 간부 격의 은밀이 등장해 켄신 일행의 패배를 예상한 메구미는 그 자리에서 도망치려고 한다. 그런 메구미를 만류하는 카오루. 카오루는 메구미에게 '당신을 위해 싸우고 있어'라고 말하며, 켄신의 강함을 믿는다고 이야기했는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/09/71730/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87585, "name": "바람의 검심 -메이지 검객 낭만기- 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87584, "name": "바람의 검심 -메이지 검객 낭만기- 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-09-02T22:30:07.881282", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-09-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64457, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "움직이는 이유", "description": "어정번중의 추격자는 일주일 동안 나타나지 않았고, 메구미도 카미야 도장의 사람들과 친해지기 시작했다. 하지만 사노스케는 친구를 죽게 만든 아편을 만든 게 메구미였다는 사실을 알고 납득하지 못해 화가 나 있었다. 그러던 어느 날, 메구미가 갑자기 사라졌다. 자신의 의지로 떠난다는 내용이 두고 간 편지에 적혀 있었지만 부자연스럽다고 생각한 켄신은 메구미를 노리던 타케다 칸류의 저택으로 향하는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/09/71965/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87805, "name": "바람의 검심 -메이지 검객 낭만기- 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87804, "name": "바람의 검심 -메이지 검객 낭만기- 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-09-09T22:30:07.522866", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-09-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64613, "title": "바람의 검심 -메이지 검객 낭만기-", "subject": "장렬한 한냐·만신창이 시키죠", "description": "칸류의 저택에서 메구미를 되찾기 위해 분투하는 켄신, 사노스케, 야히코. 그들의 앞을 막아선 것은 어정번중 밀정 담당 한냐. 권법가로서의 실력과 '신완의 술법'으로 켄신을 농락했지만 싸움 속에서 술법의 비밀을 간파한 켄신은 술법을 공략하는 데 성공했다. 승부가 