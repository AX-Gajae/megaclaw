ailable": false}, {"id": 85612, "title": "비밀의 아이프리", "subject": "정열의 그랑프리 코디", "description": "스타 아이프리 <루비 라즐리>가 제1회 아이프리 그랑프리 수상 코디인 '로즈 그랑프리'를 입고 무대에 오른다고 발표한다.\r\n그 소식에 설레는 소라와 초아. 하지만 멤버 태리는 어딘가 불안한 기색을 감추지 못하는데...\r\n라이브 당일, 세빈이와 태리가 무대로 오르지 못해 공연이 중단되는 돌발 상황이 벌어지고, 그때, 나타난 로즈 그랑프리 코디가 두 사람에게 \"지금의 두 사람은 나를 입을 수 없어.\"라고 말하고 사라진다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99418/v30/eb5b7fe3d8f6/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124802, "name": "비밀의 아이프리 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124801, "name": "비밀의 아이프리 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-01T00:00:09.263319", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능방송", "broadcast_date": "2025-10-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85613, "title": "비밀의 아이프리", "subject": "전해져라! 비밀의 라이브", "description": "루비 라즐리의 라이브를 본 뒤 자신감을 잃은 소라는 열흘 넘게 아이프리버스에 나타나지 않는다.\r\n그러던 중 소라는 꿈속에서 초아와 리리아가 자신이 아닌 다른 소라와 함께 멀어지는 악몽을 꾸게 되고, 결국 소라는 웃음마저 잃어버리게 된다.\r\n이 사실을 알게 된 초아는 소울이와 노아에게 상담하게 되고, 소라를 걱정하는 초아에게 소울이는 소라의 과거를 들려주게 되는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99771/v30/3157cb5c64d3/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125092, "name": "비밀의 아이프리 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125091, "