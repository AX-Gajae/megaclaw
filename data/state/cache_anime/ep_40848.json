classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53851, "title": "은하철도 999 part 2", "subject": "구형 주택단지의 대추장 후편", "description": "대추장의 저택에서 테츠로가 본 것은 대추장이 쥐고 있는 비밀 때문에 그의 말을 고분고분하게 따르는 메텔의 모습이었다.  \r\n한편 테츠고로는 과거에 납치됐던 연인이 죽었다는 사실을 알고 분노에 떨며 대추장의 성에 폭탄을 설치한다.\r\n폭발까지 남은 시간은 5분. 그 안에 테츠로는 메텔을 구해야만 한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56551/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 71863, "name": "은하철도 999 part 2 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-19T00:00:00.703038", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53852, "title": "은하철도 999 part 2", "subject": "피메일의 추억", "description": "차장은 옛 연인 마빌러스의 고향인 '추억의 얼굴'로 향하던 중 그녀와 비슷한 목소리를 가진 피메일이란 승객에게 헌신적으로 잘해 준다.\r\n하지만 피메일은 그런 차장을 농락하듯 999 열차의 궤도를 방해하고 메텔에게 손찌검까지 한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56806/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72101, "name": "은하철도 999 part 2 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-26T00:00:00.111273", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53853, "title": "은하철도 999 part 2", "subject": "폭풍 언덕의 키라", "description": "테츠로와 메텔은 끊임없이 폭풍이 휘몰아치는 '폭풍 언덕'에 내린다. \r\n그리고 호텔에 도착해 잠든 사이 테츠로의 패스를 도둑맞고 만다.\r\n범인을 쫓던 테츠로는 키라라는 소년을 잡지만, 소년은 결백을 주장한다. \r\n패스가 없어 열차를 못 타게 된 테츠로. 그때 소년이 나타나 어떤 제안을 하는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56807/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:43.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72100, "name": "은하철도 999 part 2 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-26T00:00:00.111273", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53985, "title": "은하철도 999 part 2", "subject": "발키리의 공간 기행 전편", "description": "고목의 산에 내린 테츠로는 기타를 치며 노래로 돈을 버는 프라이더라는 청년을 만난다.\r\n언젠가 우주에 이름을 떨치겠다는 꿈을 가진 그는, 연인인 앨리스가 힘들게 번 돈으로 은하철도의 표를 구해 999 열차에 몸을 싣는다. \r\n테츠로는 그런 프라이더에게 분노하지만, 자신도 프라이더와 다를 바 없다는 걸 깨닫는다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56808/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:41.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72099, "name": "은하철도 999 part 2 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-26T00:00:00.111273", "