_type": null, "is_available": false}, {"id": 53847, "title": "은하철도 999 part 2", "subject": "야옹 군의 생명 저택", "description": "테츠로와 메텔은 많은 동물이 모여 사는 '야옹 군의 생명 저택'이란 별에 도착한다. 테츠로는 함께 내린 한 여성이 새끼 고양이를 안고 눈물을 흘리는 모습을 보고 의아해한다. 호텔에 도착해 주스를 사러 나온 테츠로는 복도에서 거대한 고양이와 뱀과 마주치고 깜짝 놀란다.\r\n게다가 밤새 동물 울음소리에 잠을 이루지 못하고 메텔마저 사라진다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56313/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 71860, "name": "은하철도 999 part 2 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-15T10:30:00.063915", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53848, "title": "은하철도 999 part 2", "subject": "비겁한 장로의 제국", "description": "비겁한 장로 별에 도착하기 직전, 999의 차량이 하나하나 분리되더니 테츠로와 메텔이 탄 차량만 별의 인력에 의해 끌려간다. \r\n이것은 세상 그 누구도 믿지 못하는 졸렬한 대통령 데르무카데의 소행이었다.\r\n그의 목적은 젊어지기 위해 어린아이인 테츠로의 몸을 빼앗으려는 것이다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56548/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:42.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 71866, "name": "은하철도 999 part 2 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-19T00:00:00.703038", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "202