s_type": null, "is_available": false}, {"id": 86807, "title": "그랑블루 시즌 1", "subject": "첫 버디", "description": "시험을 커닝으로 극복한? 이오리와 코헤이. 소개팅에서 험한 꼴을 당했지만, 오늘은 'PaB'의 귀중한 신입부원 아이나의 환영회다. 새로운 곳에서 청춘 캠퍼스 라이프를 기대했던 아이나지만, 여기엔 평범한 사람이 없다는 걸 깨닫는다. 하지만 다이빙에 대해서만큼은 모두 진지했다. 수신호 등의 기초를 배우며, 2인 1조로 잠수하는 ‘버디 레크리에이션’이 시작된다. 한편, 오해가 계속된 채 치사와 한 팀이 된 이오리는…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98545/v30/8defe6037340/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 123637, "name": "그랑블루 시즌 1 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 123636, "name": "그랑블루 시즌 1 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-10-02T00:00:12.323082", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2025-VF02217", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["선정성", "약물"]}, "access_type": null, "is_available": false}, {"id": 86808, "title": "그랑블루 시즌 1", "subject": "복식 시합", "description": "잡지에 실린 미야코섬 특집을 보며, 아름다운 바다에서 스쿠버 다이빙을 하고 싶어 하는 이오리 일행. 그런데 토키타와 코토부키의 제안으로 어쩌다 테니스 복식 시합에 나가게 된다! 다이빙엔 2인 1조로 움직이는 ‘버디 시스템’이란 게 있어서, 목숨을 맡길 상대에 대한 신뢰를 키우는 것이 중요하다… 라는 건 명분이고, 이즈 봄 축제의 복수로 승부를 내자고 한 테니스 동아리 ‘팅커벨’에게 상금을 빼앗기 위한 싸움이다. PaB는 과연 승리할 수 있을까...!?", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98642/v30/2d2d6147fb98/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 123639, "name": "그랑블루 시즌 1 7 대여", "list_pri