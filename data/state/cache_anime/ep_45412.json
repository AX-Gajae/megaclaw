ating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92438, "title": "닥터스톤 4기 part 3", "subject": "우주는 숫자라는 언어로 쓰여 있다", "description": "제노가 만든 제트 엔진을 사용해서, 공동 제작 첫 번째 미사일을 완성한 센쿠. 유목으로 막혀 있던 수에즈 운하를 과학의 힘으로 돌파한다. 초고속 지름길로 수학의 나라 인도에 상륙한 과학 왕국 멤버는 로켓 개발에 필수인 수학 능력을 얻기 위해, 류스이가 신뢰하는 천재 수학자 SAI를 찾는다. 하지만 깨어난  SAI는 류스이를 보자마자 도망가는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105923/v30/ef42c56d832b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132327, "name": "닥터스톤 4기 part 3 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-17T00:30:10.540000", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92439, "title": "닥터스톤 4기 part 3", "subject": "컴퓨터 시대의 시작", "description": "SAI의 천재 프로그래머로서의 능력을 본 센쿠는, 스톤 월드에 컴퓨터를 만들겠다고 선언! 한편 타이주 일행을 통해 콘 시티의 유즈리하 일행도 석화에서 부활! 센쿠 일행과 유즈리하 팀이 똘똘 뭉쳐서 과학 크라프트 최대 난관인 컴퓨터 만들기에 도전한다. 그리고 센쿠 일행과 다음 도시를 만들기 위해 출항을 준비하던 류스이는 SAI에게 함께 갈 것을 권하지만…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/106434/v51/c3f43548215c/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.046000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132736, "name": "닥터스톤 4기 part 3 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-24T00:30:10.172462", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92440, "title": "닥터스톤 4기 part 3", "subject": "로켓의 진상", "description": "류스이의 마음을 깨닫고 뉴 페르세우스호에 타기로 한 SAI. 과학 왕국 멤버 총동원으로 컴퓨터 만들기를 진행하던 중, 상금을 건 '신세계 수학 올림피아드'가 개최된다. 참가자는 센쿠와 SAI, 콘 시티에선 뜻밖에도 마그마가 참전. 수학에 약한 마그마가 컴퓨터를 사용해 승부에 도전한다. 바로 그때 크롬 일행은 센쿠에게 로켓에 관한 충격적인 이야기를 듣게 되는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/106932/v30/bd0a3d5d0e4a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 133619, "name": "닥터스톤 4기 part 3 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-05-01T00:30:08.948024", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92441, "title": "닥터스톤 4기 part 3", "subject": "STONE TO SPACE", "description": "센쿠에게 달로 가는 로켓이 편도 티켓이란 말을 듣고 충격에 빠진 크롬 일행. 센쿠의 비장한 결의를 납득하지 못하는 크롬과 스이카는 SAI의 제자가 되기를 청하고 수학을 배우며 은밀히 왕복 로켓의 길을 모색한다. 그리고 센쿠 일행은 최종 목적지인 인도네시아에 상륙. 곧바로 고무 도시를 세운 센쿠는 과학 왕국으로 돌아가기 전 일본의 소울 푸드를 선물하려고 하는데...", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107091/v30/acee498a2046/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": fal