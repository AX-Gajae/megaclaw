tion_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-07-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8667, "title": "심심한 칠드런", "subject": "지근거리 연애", "description": "호흡이 척척 맞는 커플, 우치무라 치아키와 이이지마 카나는 사귄 지 곧 1년을 맞게 된다. 항상 함께였던 두 사람이지만, 카나는 어째서인지 치아키와의 거리를 한발자국 더 줄일 수 없다는 고민을 갖고 있었다. 고민한 끝에 카나는 그 사실을 치아키에게 털어놓지만 돌아온 대답은 예상하지 못한 것이었는데.\n", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/6842/v1/Thumbnail.0000030.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:34.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6081, "name": "심심한 칠드런 3 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 20961, "name": "심심한 칠드런 3 소장", "list_price": 750, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:14.530080", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-07-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8668, "title": "심심한 칠드런", "subject": "러브 코미디", "description": "학생회장인 아카기 마사후미에게 약점을 잡혀 키스를 했던 카지 료코는 건물 뒤쪽으로 아카기를 불러낸다. 왜 그런 짓을 했는지 아카기의 마음을 확인하고 싶기 때문이었는데 그런 카지의 마음은 모르고 장난치는 것만 같은 아카기의 태도에 카지는 짜증을 낸다. 하지만 아카기는 사실 카지를 예전부터 지켜봤었는데.\n\n", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/6843/v1/Thumbnail.0000030.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:34.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6082, "name": "심심한 칠드런 4 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 20962, "name": "심심한 칠드런 