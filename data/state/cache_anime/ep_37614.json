l, "is_available": false}, {"id": 8598, "title": "바티칸 기적 조사관 [2022년 판권 만료작]", "subject": "모습을 드러낸 과거의 망령", "description": "기적을 조사하던 중, 성당에서 한 소년이 살해된 채 발견되었다. 히라가는 혈액분석을 통해 소년이 햇빛도 들지 않는 열악한 환경에서 살았다는 것을 알아낸다. 한편, 마을 아이들이 부른 민요에 대해 조사하던 로베르토는 32년 전에도 미해결 살인사건이 일어났다는 것을 알게 되는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/6776/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.566000", "progressbar": null, "item_expire_datetime": "2022-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:15:17.873052", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8599, "title": "바티칸 기적 조사관 [2022년 판권 만료작]", "subject": "어둠의 황금, 나 주님과 함께", "description": "앗뜨거 집을 발견해 안으로 들어간 히라가 일행. 솔로몬의 세 가지 충고를 이용해 차츰차츰 앞으로 나아가던 그들의 앞에 나타난 가르도우네의 중요인물의 정체는 살해당한 줄로만 알았던 바로 그 사람이었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/6777/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.566000", "progressbar": null, "item_expire_datetime": "2022-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-18T21:57:53.521161", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8600, "title": "바티칸 기적 조사관 [2022년 판권 만료작]", "subject": "신포니아", "description": "태가 악화되어 위급한 상태에 빠진 히라가의 동생 료타. 료타에게는 죽음을 안내하는 자들이 보인다는 남들에겐 말 못할 비밀을 안고 있었는데.", "episode_num": "12", "episo