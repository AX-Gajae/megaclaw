ree": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-09T00:30:00.026963", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31038, "title": "로비하치 [2022년 판권 만료작]", "subject": "아닌 밤중에 장어", "description": "장어가 특산품인 갤럭시 가도 29번 플래닛, 하마마투에 도착한 로비와 하치. 지구에선 더 이상 장어가 안 잡히는 탓에, 하치는 로비와 달리 실제 장어를 먹어본 적이 없었다. 게다가 마침 하마마투에서는 대장어 축제가 열리고 있었는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27302/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-16T00:30:00.023540", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31355, "title": "로비하치 [2022년 판권 만료작]", "subject": "한 치 앞은 꿈의 나라", "description": "꿈과 모험, 그리고 사랑과 희망과 깨끗하고 바르고 재미있는 별, 36번 플래닛 앗카삿카에 도착한 로비와 하치. 앗카삿카는 행성 전체가 놀이공원이었다. 게다가 꿈과 모험, 그리고 사랑과 희망과 깨끗하고 바르고 재미있는 별인 만큼 불평이나 욕, 부정적인 말을 했다간 어마어마한 일들이 펼쳐지는 곳이었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27395/v1/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:35.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-23T00:30:00.731508", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channe