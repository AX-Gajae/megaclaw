pg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.400000", "progressbar": null, "item_expire_datetime": "2024-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2022-01-10T22:00:00.087029", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51809, "title": "평온세대의 위타천들 [2024년 판권 만료작]", "subject": "마", "description": "버즈와 메리아노는 무인도에서 망명 생활을 하고 있었지만, 둘 사이에서 태어난 아기를 제어할 수 없게 되어 조블 제국으로 돌아왔다. 한편 위타천인 하야토와 포라 그리고 길은 매일같이 수행에 열중하고 있었다. 그런 가운데 미쿠는 로봇을 통해서 오바미와 연락을 주고받는 데에 성공했는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/01/54602/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.400000", "progressbar": null, "item_expire_datetime": "2024-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2022-01-10T22:00:00.087029", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-12-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51810, "title": "평온세대의 위타천들 [2024년 판권 만료작]", "subject": "비린내", "description": "프론티어는 거리에 모습을 드러낸 미쿠를 쫓았지만, 어이없게도 포획에 실패하고 말았다. 그것을 단서로 미쿠는 위타천 측의 브레인에 해당되는 이스리이를 노리기로 결정했다. 그리고 미쿠와 오바미의 작전으로 인해 피사라와 코리의 세뇌가 풀리면서 이스리이와 포라가 붙잡히게 되었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/01/54604/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.400000", "progressbar": null, "item_expire_datetime": "2024-09-30T23:30:00", "in_