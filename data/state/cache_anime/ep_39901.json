oducts": [], "episode_products": [{"id": 52787, "name": "역경무뢰 카이지 시즌 2 Part 2 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 52786, "name": "역경무뢰 카이지 시즌 2 Part 2 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2020-07-09T00:00:00.149728", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2011-08-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40961, "title": "역경무뢰 카이지 시즌 2 part 2", "subject": "철벽의 문", "description": "제1관문 못의 숲은 돌파했지만, 제2관문 변덕쟁이 문지기에 가로막힌 카이지. 미동조차 하지 않는 문에 구슬을 계속 쏜다. 상황은 그야말로 절망적으로 보였다. 하지만 아무도 모르게 이미 제2관문 돌파를 위한 작전이 시작되고 있었다. 과연 제2관문 돌파를 위한 작전이란...?", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50543/v15/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:41.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 52785, "name": "역경무뢰 카이지 시즌 2 Part 2 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 52784, "name": "역경무뢰 카이지 시즌 2 Part 2 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2020-07-09T00:00:00.149728", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2011-08-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 40962, "title": "역경무뢰 카이지 시즌 2 part 2", "subject": "기적의 궤도", "description": "제2관문도 돌파하여 마성의 3단 원반에 도착한 카이지. 이치죠는 '늪' 최후의 관문이자 난공불락의 요새인 이 원반에 절대적인 자신감을 느끼고 있었다. 하지만 여기에서 상식을 뛰어넘은 카이지의 묘책이 빛을 발한다. 역전의 희망, 기적을 향한 길은 다시금 열릴 것인가?", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50544/v15/Thumbnail.000