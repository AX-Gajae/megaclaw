ue, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86630, "name": "제물공주와 짐승의 왕 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86629, "name": "제물공주와 짐승의 왕 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-03T22:30:06.903205", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63938, "title": "제물공주와 짐승의 왕", "subject": "추적과 신하의 공방", "description": "보르스트바스 방문을 앞두고 있었던 사리피 앞에 자신이 펜리르라고 하는 마족이 나타나, 사리피를 데리고 사라졌다. 그 소식을 롭스로부터 듣게 된 레온하트는 속으로는 안절부절못했지만, 사리피의 뜻을 존중하여 왕으로서 나라와 백성을 지키기 위해 왕궁에 머물게 되었다. 그것은 오즈마르고 각지에서 침략 행위가 벌어지고 있기 때문이었고, 이는 펜리르를 주축으로 하는 반왕정파 조직 '망국의 환랑군'의 소행이었는데.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70845/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86818, "name": "제물공주와 짐승의 왕 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86817, "name": "제물공주와 짐승의 왕 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-10T22:30:07.193872", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64014, "title": "제물공주와 짐승의 왕", "subject": "구출과 숙명의 대결", "description": "란트벨트는 키크, 베누와 함께 사리피를 구출하기 위해 움직였다. 란트벨트는 자신의 목숨과 맞바꿔서라도 사리피를 구하기 위해서 스스로 미끼가 되는 작전을 결행했지만, 사리피는 이를 용납지 않고 전부 함께 왕궁으로 돌아가겠다고 말했다. 하지만 란트벨트는 이미 만신창이인 상황이었고, 베누 또한 성수의 힘을 너무 쓴 상황이라 상황이 절망적인 건 그대로였는데. 과연 사리피 일행은 펜리르로부터 도망칠 수 있을 것인가.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/71070/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86975, "name": "제물공주와 짐승의 왕 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86974, "name": "제물공주와 짐승의 왕 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-17T22:30:07.524321", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64102, "title": "제물공주와 짐승의 왕", "subject": "마족과 인간의 가교", "description": "사리피가 위기였을 때 간발의 차이로 나타난 레온하트. 격전 끝에 레온하트가 펜리르를 상대로 승리하면서 오즈마르고 내부에도 평화가 돌아왔다. 반란 조직을 진압한 레온하트에 대한 민중들의 지지가 한층 더 굳건해진 가운데, 왕의 쾌유를 축하하며 시가를 행진하는 개선식이 열리게 되었다. 식전 전날, 펜리르와의 사건 때문에 반지가 부서져 버린 사리피를 레온하트는 어딘가로 데리고 갔는데.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/71350/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87152, "name": "제물공주와 짐승의 왕 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87151, "name": "제물공주와 짐승의 왕 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-24T22:30:08.292827", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64304, "title": "제물공주와 짐승의 왕", "subject": "친서와 금기의 마녀", "description": "제물 제도를 폐지하고, 요아나와 대등한 국교를 맺고 싶다고 바라는 레온하트. 하지만 상호 불가침 조약 때문에 국경을 넘어서 마족 사자를 보내는 것이 불가능하다는 문제가 있었다. 거기서 인간인 자신이라면 그 역할을 해낼 수 있을지 모른다면서 사리피가 나섰다. 레온하트를 비롯한 지인들이 걱정하긴 했지만, 베누와 함께 요아나의 왕도로 향한 사리피는 마스크비아나 왕국 퇴마 기사단 단장 대리인 오실롯과 만나게 되었는데.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/71660/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87349, "name": "제물공주와 짐승의 왕 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87348, "name": "제물공주와 짐승의 왕 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-31T22:30:07.658099", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-08-31", "rating_components": []}, "access_type": null, "is_available": false}]}