{"count": 26, "next": "https://api.laftel.net/api/episodes/v2/list/?item_id=24979&limit=20&offset=20&size=1&sort=oldest", "previous": null, "results": [{"id": 6093, "title": "요괴소년 호야 1기", "subject": "우시오와 토라의 만남의 연", "description": "중학생인 아오츠키 우시오는 부현원의 주지인 아버지와 둘이 살고 있다. 유서 깊은 부현원에는 요괴 퇴치 명인의 창이 보관되어 있다고 전해지지만, 우시오는 한 번도 본 적이 없다. 어느 날, 혼자 절을 지키던 우시오는 창고에서 의문의 지하실을 발견하고, 그 속에서 ‘야수의 창’에 박혀 있던 요괴와 맞닥뜨린다. 500년간 갇혀 있던 요괴는 우시오에게 야수의 창을 빼 줄 것을 요구하는데…", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5112/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 93009, "name": "요괴소년 호야 1 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 94122, "name": "요괴소년 호야 1 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:51.965880", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6094, "title": "요괴소년 호야 1기", "subject": "돌 먹는 요괴", "description": "기묘한 동거를 시작한 우시오와 토라. 다른 사람의 눈에는 보이지 않지만 우시오의 학교까지 동행한 토라는 사사건건 우시오와 부딪히면서도 학교 생활을 재미있어 한다. 한편, 도서위원인 아사코와 마유코는 사회 선생님으로부터 고도서와 고도구의 운반을 부탁 받고 불길한 느낌의 구교사로 향하는데…", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5114/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4633, "name": "요괴소년 호야 2 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27276, "name": "요괴소년 호야 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:51.996183", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6095, "title": "요괴소년 호야 1기", "subject": "그림 속 요괴", "description": "레이코, 마유코와 함께 미술전에 간 우시오는 자신이 가장 좋아하는 하뉴 화백의 그림을 보며 즐거워한다. 그 중, 우시오가 가장 좋아하는 작품 ‘레이코’를 본 토라는, 그 그림을 그린 사람이 다른 사람을 저주하며 죽었다는 걸 알아챈다. 한편, 학교에서 불량한 3학년 선배에게 얻어 맞던 우시오는 이를 말리던 여학생이 하뉴 화백의 외동딸인 레이코임을 알게 된다. ", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5113/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4634, "name": "요괴소년 호야 3 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27277, "name": "요괴소년 호야 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.032795", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6096, "title": "요괴소년 호야 1기", "subject": "토라, 번화가에 가다", "description": "도로 확장 공사를 위해 파헤쳐진 돌. 마을의 노인은 어떻게든 그 돌을 건드리지 말도록 부탁하지만 결국 돌은 꺼내지고, 잘린 머리 형태의 요괴 5마리가 튀어나온다. 요괴들은 공사 관계자들을 모두 죽여 버린 후, 복수를 위해 자신들을 봉인한 여자를 찾아 나선다. 한편, 요괴 출몰 현장으로 향한 우시오는 그곳에서 이노우에와 판박이인 메이지 시대의 위대한 영능력자, 히자키 미카도의 사진을 보게 된다. ", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5115/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4635, "name": "요괴소년 호야 4 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27278, "name": "요괴소년 호야 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.063210", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6097, "title": "요괴소년 호야 1기", "subject": "부주사, 효우", "description": "효우는 인간으로 변신해 악행을 일삼는 요괴들을 처치하는 부주사다. 그 중에서도 어린이를 해치는 요괴에 대해서는 봐주는 법이 없다. 그러던 어느 날, TV 영상에서 15년 전 자신의 아내와 딸을 죽인 요괴와 흡사한 모습을 발견하고 곧장 일본으로 향한다. 점괘에 나온 대로 서쪽으로 간 표는 한 공원에서 우시오와 조우하고, 그의 뒤에서 자신이 찾아 헤매던 요괴의 모습을 발견한다. ", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5116/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:37.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4636, "name": "요괴소년 호야 5 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27279, "name": "요괴소년 호야 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.100911", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6098, "title": "요괴소년 호야 1기", "subject": "아야카시의 바다", "description": "아사코의 할아버지가 운영하는 바닷가 매점에 놀러 간 우시오. 그곳에서 엄마를 잃고 난폭해진 소년, 타츠야를 만난다. 한편, 오랜만에 바다를 즐기던 토라에게 요괴 ‘우미자토’가 나타난다. 우미자토는 토라를 ‘나가토비마루 님’이라 부르며, 이 부근의 바다에 출몰하는 요괴 ‘아야카시’를 물리쳐 달라고 부탁한다. ", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5117/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4637, "name": "요괴소년 호야 6 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27280, "name": "요괴소년 호야 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.139617", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6099, "title": "요괴소년 호야 1기", "subject": "전승", "description": "우미자토로부터 엄마가 살아있다는 얘기를 들은 우시오. 아버지인 시구레에게 진위를 캐묻지만 적당히 둘러댈 뿐이다. 한편, 우시오의 앞에서는 보인 적 없는 법력승의 모습을 한 시구레는 어린 소녀에게 들러붙은 요괴를 퇴치하고, 그 길로 상위 승려들을 알현하러 간다. 그리고 ‘야수의 창’이 우시오에 의해 빠지게 된 상황을 보고하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5118/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4638, "name": "요괴소년 호야 7 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27281, "name": "요괴소년 호야 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.176579", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6100, "title": "요괴소년 호야 1기", "subject": "놈은 하늘에 있다", "description": "홋카이도에 가기 위해 공항에 간 우시오는 우연히 한 소녀와 남자의 대화를 듣게 된다. 얼마 전 발생한 비행기 추락 사고의 원인이 요괴 때문이라 말하는 남자와, 거짓말이라고 매도하는 소녀. 소녀는 추락한 비행기 기장의 딸이다. 토라는 이 요괴가 후스마라고 알려주는데, 우시오와 소녀가 탄 비행기 역시 후스마의 공격을 받아, 추락 위기에 놓인다. ", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5119/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4639, "name": "요괴소년 호야 8 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27282, "name": "요괴소년 호야 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.221033", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6101, "title": "요괴소년 호야 1기", "subject": "광풍", "description": "여행 중이던 우시오와 토라는 우연히 여년 묵은 요괴, 카마이타치를 만나고, 그들의 청으로 깊은 산속까지 따라가게 된다. 그곳에서 카마이타치의 첫째, 라이신은 야수의 창 사용자인 우시오에게 자신들의 형제인 쥬로를 죽여달라 부탁한다. 우시오는 단칼에 거절하지만, 쥬로가 살던 곳에서 쫓겨난 것에 대한 복수심으로 인간 살육을 예고하자, 그의 폭주를 막기로 한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5120/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4640, "name": "요괴소년 호야 9 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27283, "name": "요괴소년 호야 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.251423", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6102, "title": "요괴소년 호야 1기", "subject": "동자가 있는 집", "description": "멋대로 우시오를 처치하려 했던 법력승과 윗분들은 돌아온 큰스님, 니기라에게 큰 꾸지람을 듣는다. 한편, 카마이타치 남매가 알려준 온천에서 상처를 치유하던 우시오와 토라는, 머리칼이 눈처럼 하얀 소녀와 조우한다. 다음날 다시 거리에서 정신을 잃고 쓰러지는 소녀를 구하고 집까지 바래다 주던 우시오는, 소녀로부터 자신의 능력과 소녀의 엄마 이야기를 듣게 된다. ", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5121/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4641, "name": "요괴소년 호야 10 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27284, "name": "요괴소년 호야 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.282048", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6103, "title": "요괴소년 호야 1기", "subject": "일격의 거울", "description": "아사코와 마유코는 학교에 오지 않는 우시오를 걱정한다. 이런 사실을 모르는 우시오는, 함께 지내던 카마이타치 남매와 헤어져 다시 홋카이도로 향할 준비를 한다. 그러던 중 수면 위로 비치는 아사코의 얼굴을 보게 된다. 뭔가 안 좋은 일이 생긴 것을 직감한 우시오는, 카마이타치 남매의 안내로 거울에 대해 잘 아는 요괴를 찾아 간다. ", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5122/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4642, "name": "요괴소년 호야 11 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27285, "name": "요괴소년 호야 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.310558", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6104, "title": "요괴소년 호야 1기", "subject": "토오노 요괴 전도행 – 첫 번째", "description": "우시오와 토라는 카마이타치 남매와 헤어져 여행을 계속한다. 두 사람이 탄 버스가 토오노 역으로 향하던 중 갑자기 요괴의 습격을 받는다. 도망쳐도 계속해서 따라붙는 엄청난 수의 요괴들. 요괴들은 모두 “증오스런 그 여자의 아들을 죽여라’라고 외친다. 도망치던 우시오는 우연히 요괴 갓파를 만나고, 그로부터 요괴들이 우시오의 엄마를 증오하게 된 얘기를 듣게 된다. ", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5123/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4643, "name": "요괴소년 호야 12 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27286, "name": "요괴소년 호야 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.342091", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6105, "title": "요괴소년 호야 1기", "subject": "토오노 요괴 전도행 – 두 번째", "description": "홋카이도로 향하던 중 갑자기 요괴들의 습격을 받은 우시오와 토라. 소식을 전해 들은 카마이타치 남매는 동료인 요괴를 배신하고 우시오 편에 서기로 한다. 한편, 갓파의 조언대로 마을로 도망치던 우시오는 요괴들의 습격에 말려든 할아버지를 구출하고, 겨우겨우 마을에 도착해 할아버지에게 야수의 창과 관련한 지금까지의 얘기를 들려 주는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5124/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4644, "name": "요괴소년 호야 13 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27287, "name": "요괴소년 호야 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.372637", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6106, "title": "요괴소년 호야 1기", "subject": "비요 추적~전승자", "description": "드디어 홋카이도에 도착한 우시오와 토라는 숙소를 찾던 중, 백면인이 보낸 비요의 습격을 받는다. 그때, 야수의 창 전승자 중 한 명인 세키모리 히노와가 나타나 비요를 해치운다. 히노와는 수련을 쌓지 않은 우시오 때문에 비극이 초래된다며, 야수의 창을 넘겨줄 것을 요구한다. 어쩔 수 없이 창을 넘겨 주는 우시오. 그리고 야수의 창을 갖게 된 히노와와 비요의 싸움이 시작되는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5125/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4645, "name": "요괴소년 호야 14 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27288, "name": "요괴소년 호야 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-19T15:24:52.404106", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 6107, "title": "요괴소년 호야 1기", "subject": "추격의 교차~전승자", "description": "비요가 버스를 납치하는 바람에 우시오와 승객들은 위험에 처하지만, 토라와 나가레의 합동 작전으로 무사히 위기에서 벗어난다. 한편, 우시오와 나가레는 자신의 오빠의 행방을 찾는 모리츠나 준을 만난다. 우시오의 등장 이후 이상하게 변해 버렸다는 준의 오빠이자, 전승 후보자인 사토루. 이윽고 야수의 창과 그걸 조종하는 자를 파괴하겠다며, 사토루가 모습을 드러낸다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/5126/v4/