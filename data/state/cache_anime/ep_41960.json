시 발생한 불가사의한 사건, 그리고 담당의사로서 그녀를 상담했던 삼촌의 믿기 어려운 실제 체험이었다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76730/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:23.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99119, "name": "바빌론 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-02-17T00:00:08.578461", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69076, "title": "바빌론", "subject": "작전", "description": "지역의회 선거가 사흘 앞으로 다가오며 이츠키가 출연하는 공개 토론이 눈앞으로 다가온다. 세이자키와 수사팀은 필사적으로 수사에 임하지만 이츠키를 체포할 수 있는 증거는 찾지 못 한다. 그러던 중 세이자키는 쿠지인의 말을 듣고 한 작전을 생각해 내는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76732/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:23.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99118, "name": "바빌론 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-02-17T00:00:08.578461", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69077, "title": "바빌론", "subject": "최악", "description": "공개 토론에 등장한 소년의 정체에 세상은 경악한다. 비장의 카드를 거꾸로 빼앗긴 노마루에게 더 이상 방법이 없자 세이자키와 형사들은 예정대로 이츠키의 납치 작전을 개시한다. 문제없이 임무가 수행되어 가는 가운데 어떤 이변이 조용히 일어나기 시작하고 있었다.", "episode_num": "7", "episode_