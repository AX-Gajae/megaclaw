쳐들어간다. 그리고 에이타는 학년에서 제일 예쁜 미소녀, 야마다와 함께 양키 고등학교로 향하는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100019/v30/17f5d77a07ff/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125484, "name": "언더 닌자 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125483, "name": "언더 닌자 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T00:00:18.568187", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87527, "title": "언더 닌자", "subject": "나는 닌자의 역사에 남을 거다", "description": "광기에 사로잡힌 사루타가 휘두르는 검이 코단 고등학교에 피바람을 일으킨다. 눈에 보이지 않는 투명 인간이 무차별 연쇄 살인을 벌이자 공황 상태에 빠진 학생들.\n 한편 그때 양키 고등학교로 향한 쿠로와 히비 앞에 UN의 닌자가 나타난다. 그는 의외의 인물이었는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100021/v30/e915b56381f9/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125486, "name": "언더 닌자 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125485, "name": "언더 닌자 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T00:00:18.855774", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87528, "title": "언더 닌자", "subject": "소녀의 가슴은 아주 소중한 거야", "description": "쿠로와 히비 앞에 나타난 UN의 닌자, 그 정체는 야마다였다.\n 그리고 코단 고등학교에서 살인을 이어가는 사루타를 제압하기 위해 스즈키와 오니코베, 하치야가 움직이기 시작한다. 사루타가 착용한 UN의 최신 슈트 앞에 고전하는 NIN의 닌자들.\n 그리고 드디어 카토가 참전하는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100022/v30/92d0a583c6ad/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125488, "name": "언더 닌자 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125487, "name": "언더 닌자 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T00:00:19.149171", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87529, "title": "언더 닌자", "subject": "결국 쿠로가 검을 잡았다", "description": "야마다의 엄청난 실력에 압도당하는 히비. 그들의 싸움을 냉정하게 지켜보는 쿠로의 속셈은?\n 코단 고등학교에서는 사루타와의 전투로 발목을 잃은 스즈키가 전선에서 이탈한다. 노구치와 함께 관리인의 지시에 따라 도착한 비밀 통로에는 NIN과 UN의 피로 점철된 과거가 잠들어 있었다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100024/v30/7c31ec5f48c8/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125490, "name": "언더 닌자 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125489, "name": "언더 닌자 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T00:00:19.430285", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87530, "title": "언더 닌자", "subject": "평소처럼 '용조용조'하게 말이야", "description": "코단 고등학교에서 벌어지는 오니코베와 사루타의 장렬한 사투.\n NIN이 자랑하는 최종 병기, 둔의 발사를 요청하는 카토.\n 은밀히 진행됐던 UN의 작전, 그 진짜 목적은?\n 그리고 마침내 검을 잡은 쿠로. 목숨을 걸고 임한 야마다와의 대결, 그 결과는…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100025/v30/73c6d1fa0723/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:03.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125492, "name": "언더 닌자 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125491, "name": "언더 닌자 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T00:00:19.765242", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-29", "rating_components": []}, "access_type": null, "is_available": false}]}