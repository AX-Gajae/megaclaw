": false}, {"id": 77666, "title": "아마가미 씨네 인연 맺기", "subject": "패랭이꽃의 숨바꼭질 ~고민~", "description": "무려 몸이 뒤바뀌고 만 우류와 유나. 둘은 학교 친구들은 물론이고 야에와 아사히한테까지 비밀로 한 채 어떻게든 원래대로 돌아갈 방법을 찾으려 했다. 몸이 뒤바뀐 채 이루어지는 긴장감 넘치는 생활 속에서 우류는 유나의, 유나는 우류의 마음에 대해 알게 되었고, 마음의 거리가 점점 줄어들어 갔다. 문제를 해결하지는 못했지만 무사히 학교생활을 해내게 된 우류와 유나. 하지만 어쩌다 보니 유나의 친구인 밋 짱에게 몸이 뒤바뀐 걸 들킬 위기에 처했는데.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/91011/v30/631928a05805/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115609, "name": "아마가미 씨네 인연 맺기 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 115608, "name": "아마가미 씨네 인연 맺기 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-02-19T01:30:05.542929", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-02-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77667, "title": "아마가미 씨네 인연 맺기", "subject": "패랭이꽃의 숨바꼭질 ~이끌림~", "description": "유나의 숨겨진 마음은 그녀로부터 직접 듣겠다고 우류가 결심한 순간, 우류와 유나의 몸은 원래대로 돌아왔다. 그리고 우류의 부탁에 따라 유나는 용기를 내서 자신의 과거와 꿈에 대해 이야기하기 시작했다. 그 꿈은 우류가 보기에는 너무나도 유나와 어울리는 꿈으로 느껴졌으나, 유나 자신은 이에 자신감을 갖지 못하는 듯했다. 유나가 자신이 어리광을 부리면 누군가를 불행하게 만든다며 두려워한다는 사실을 깨달은 우류는, 그녀의 진짜 마음을 끄집어내야겠다고 생각했는데.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/91143/v30/42c234bb1b91/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 115765, "name":