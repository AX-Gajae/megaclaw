ets/2018/12/3191/v5/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1927, "name": "테니스의 왕자 141 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:35.386177", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3664, "title": "테니스의 왕자 part 6", "subject": "미국에서 온 소년", "description": "정체불명 외국 소년이 에치젠 료마를 찾는다며 세이슌 중학교에 들어 온다. 하지만 자리에 없다는 걸 알자 제일 강한 상대가 누구냐며 시합을 하자고 제안한다. 한편, 데즈카는 선발 멤버를 뽑기 위해 복식 대결을 하기로 한다. 하지만 복식조는 예상 밖에 멤버로 구성되는데…", "episode_num": "142", "episode_order": 142, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3192/v5/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1928, "name": "테니스의 왕자 142 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:35.439349", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3665, "title": "테니스의 왕자 part 6", "subject": "데즈카의 선택", "description": "관동 지역 선발팀을 뽑기 위한 합숙도 막바지에 접어들고 데즈카는 추천 선수를 정하기 위해 고민을 거듭한다. 한 편, 중등부 테니스 부에 흉흉한 소문이 돌기 시작하고, 그 소문은 이윽고 선발 후보팀의 귀에도 들어가게 된다. 소문의 주인공은 선발대회의 상대팀이며 노리는 것이 에치젠이라는 것이 밝혀지게 되는데…", "episode_num": "143", "episode_order": 143, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3193/v14/Thumbnail.0000053.jpg