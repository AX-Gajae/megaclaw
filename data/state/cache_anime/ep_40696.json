_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/01/55167/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 69610, "name": "하코즈메 ~파출소 여자의 역습~ 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 69609, "name": "하코즈메 ~파출소 여자의 역습~ 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-01-30T02:30:00.051827", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-01-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52542, "title": "하코즈메 ~파출소 여자의 역습~", "subject": "심야 순찰 / VS. 치한", "description": "나태한 근무 태도가 눈에 띄는 카와이에게 후지가 심야의 학교 순찰을 지시했다. 그곳에는 학교 털이범을 잡기 위해 잠복 중인 미나모토하고 야마다도 있었는데... 후일, 치한 취조를 하게 된 야마다는 피의자의 불손한 태도에 불쾌감을 느꼈다. 하지만 실력 부족으로 피의자의 진술을 끌어내지 못한 야마다는 후지와 미나모토에게 힘을 빌려줄 것을 요청했는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55254/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 69993, "name": "하코즈메 ~파출소 여자의 역습~ 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 69992, "name": "하코즈메 ~파출소 여자의 역습~ 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-06T02:30:00.032925", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52762, "title": "하코즈메 ~파출소 여자의 역습~", "subject": "미팅 광소곡 / 폭주 폴리스", "description": "사건이 발생했다는 무전을 받고 앞다투어 공용 차량으로 출동한 후지와 미나모토. 잘못해서 미나모토의 차에 타게 된 카와이는, 폭주하는 긴급 차량 안에서 과연 무엇을 보았을까. 다른 날에, 카와이와 후지가 한껏 차려입은 모습으로 선술집에 들어왔다. 그 목적은 바로 미팅. 일반인과 어울릴 수 있는 귀중한 찬스였지만, 옆방에서 눈에 익은 콤비의 모습이 보였는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55369/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70205, "name": "하코즈메 ~파출소 여자의 역습~ 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70204, "name": "하코즈메 ~파출소 여자의 역습~ 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-13T02:30:00.065748", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52829, "title": "하코즈메 ~파출소 여자의 역습~", "subject": "미행 선수권 / 홀리는 사람", "description": "카와이와 후지는 약물 판매책과 그 애인을 수사하는데 미행 역할로 발탁되었다. 그리고 카와이와 미나모토, 후지와 야마다는 각각 짝이 되어 미행을 하게 되었다. 남성 경험이 하나도 없는 카와이는 애인인 척을 하기 위해 손을 잡자고 하는 걸 거부했고, 후지는 미모가 너무 뛰어난 나머지 오히려 눈에 띄어버리고 마는 상황. 그러는 가운데 용의자는 러브호텔에 체크인했고 미행하던 조들도 이를 따라가게 되었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55530/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70320, "name": "하코즈메 ~파출소 여자의 역습~ 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70319, "name": "하코즈메 ~파출소 여자의 역습~ 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-20T02:30:00.059242", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 52912, "title": "하코즈메 ~파출소 여자의 역습~", "subject": "정의의 폭주 / 근육 바보", "description": "카와이의 선배인 시키네는 후배나 여경들 앞에서 거만한 태도를 보이는 탓에 주위에서 난감해하고 있었다. 임시로 시키네와 한 조가 된 카와이는 시민들 앞에서도 고압적인 시키네의 모습을 목격했는데, 그 태도 때문에 결국 문제가 발생하고 말았다. 다른 날에, 평소 격투기 기술이나 체력에는 그다지 자신이 없었던 카와이는 신고를 받고 치정 싸움 현장에 도착했다. 그곳에서 흥분 상태인 여성을 말로 설득하려고 했는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/02/55717/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 70485, "name": "하코즈메 ~파출소 여자의 역습~ 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 70484, "name": "하코즈메 ~파출소 여자의 역습~ 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-02-27T02:30:00.082236", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-02-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 53014, "title": "하코즈메 ~파출소 여자의 역습~", "subject": "체포술 / UFO", "description": "경찰 무술 훈련은 경찰관들에게 있어서 가장 중요한 업무 중 하나였다. 격무에 시달려 제대로 잠도 못 잔 카와이와 후지였지만, 너덜너덜한 몸을 채찍질해가며 마치 곰과 같은 강인한 육체를 가진 부서장의 훈련을 받게 되었다. 경찰관의 숙명은 걸려오는 신고에 대해 항상 진지하게 임하지 않으면 안 된다는 것. UFO 목격 정보에 하늘을 올려다보던 카와이와 후지 콤비는 목숨을 끊겠다는 신고에 휘둘리게 되었는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/03/55891/v15/Thumbnail.0000057.jpg", "has_previ