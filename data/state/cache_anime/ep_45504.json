 "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92646, "title": "괴도 세인트 테일", "subject": "신비한! 로자 왕녀의 거울", "description": "사람의 본모습을 보여 준다는 보물 '로자 왕녀의 거울'. 도둑맞은 전설의 거울이 경매에 나온다는 소식에 세인트 테일이 다시 한번 나선다. 그런데 경매장에서 거울을 가져가려는 순간 거울 속에 세인트 테일의 얼굴이 언뜻 비친다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105950/v30/130a7b807ed0/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:36.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132388, "name": "괴도 세인트 테일 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-18T00:00:13.332668", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92647, "title": "괴도 세인트 테일", "subject": "사랑과 눈물의 플랫폼", "description": "자전거로 일본 일주 여행을 하던 미국인 존은 마지막 마을에서 자전거를 도둑맞는다. 곧 미국으로 다시 돌아가야 하는데 훔쳐 간 사람이 어린아이라 신고할 수도 없어서 무척 곤란해한다. 그 사연을 들은 메이미는 미국으로 가기 전에 자전거를 찾아 주기로 한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105951/v30/cc0c2359d28d/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:36.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132389, "name": "괴도 세인트 테일 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-18T00:00:13.559906", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-17", "rating_co