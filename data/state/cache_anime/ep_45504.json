access_type": null, "is_available": false}, {"id": 92650, "title": "괴도 세인트 테일", "subject": "밸런타인데이의 하트 도둑!?", "description": "누구에게 초콜릿을 줄까로 떠들썩한 밸런타인데이 시즌. 이번에 세인트 테일이 찾아올 물건은 한 남학생을 향한 소녀의 마음이 담긴 노트다. 그런데 아스카의 실수로 노트가 '하트'라는 글자로 바뀌면서 일이 꼬이기 시작한다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/106430/v30/623096acd99e/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:36.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132814, "name": "괴도 세인트 테일 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-25T00:00:12.829508", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92651, "title": "괴도 세인트 테일", "subject": "건드리면 위험해! 초고압 전류의 함정", "description": "메이미는 아스카 주니어가 보고 싶어 하는 콘서트에 같이 가려 했지만 타카미야가 끼어들어서 말도 꺼내지 못한다. 게다가 세인트 테일로 변신해야 하는 날과 콘서트 날이 겹쳐 버린다. 예고장을 받은 아스카 주니어는 콘서트에 갈 것인가, 세인트 테일을 찾아올 것인가.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/106431/v30/176b14cc6c22/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:36.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132815, "name": "괴도 세인트 테일 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-25T00:00:13.191733", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-24", "rating_components": []}, "a