:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127374, "name": "나를 먹고 싶은, 괴물 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-19T00:00:15.400901", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-12-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88654, "title": "나를 먹고 싶은, 괴물", "subject": "차가운 아침", "description": "감기에 걸렸다는 이유로 학교를 결석한 히나코. 꾀병이라는 걸 눈치챈 미코는 히나코의 집으로 향한다. 시오리로부터 들은 옛날 이야기를 히나코에게 전해 주며 히나코가 살아 있어 줘서 기뻤다는 말을 하는 미코. 하지만 히나코는 가족과 함께 죽고 싶었다는 말을 내뱉고 만다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/101831/v30/b679b14392c2/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127543, "name": "나를 먹고 싶은, 괴물 11 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-26T00:00:11.319783", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-12-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88655, "title": "나를 먹고 싶은, 괴물", "subject": "소중한 사람", "description": "시오리는 히나코에게 십수 년 전에 만난 적이 있다는 사실과 자신의 진짜 소망을 이야기한다. 시오리는 그저 히나코가 살아 있기를 원했다. 살아 있게 하기 위해 히나코가 원하는 말을 들려 줬을 뿐이었다. 그 말을 들은 히나코는 시오리에게 이제 자신을 내버려두라고 소리친다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/102064/v30/5c0492e88617/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_t