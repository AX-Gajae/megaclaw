": []}, "access_type": null, "is_available": false}, {"id": 66952, "title": "(자막) 닥터스톤 3기 part 2", "subject": "멸망의 빛", "description": "요우는 애써 손에 넣은 석화 무기를 다시 빼앗기고 이바라는 오오아라시를 통해 석화 무기를 섬 중앙으로 옮기려고 한다. 한편 효가는 모즈와의 대결에서 밀리면서 섬에 있는 센쿠 일행에게 향하고 센쿠는 효가의 관창을 위해 윤활유를 만드는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74077/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 91033, "name": "(자막) 닥터스톤 3기 part 2 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-11-28T18:00:08.987966", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-11-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67156, "title": "(자막) 닥터스톤 3기 part 2", "subject": "최후의 승자", "description": "동료들의 희생으로 석화를 피한 센쿠는 라보카를 이용해 이바라를 공격하지만 준비성이 철저한 이바라에게 도리어 쫓기게 된다. 절벽으로 몰린 더는 피할 곳이 없는 센쿠에게 이바라가 석화 장치를 발동시키지만 그 순간 낯선 소리가 들려오는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74250/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96488, "name": "(자막) 닥터스톤 3기 part 2 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-05T19:30:08.043593", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67318, "title": "(자막) 닥터스톤 3기 part 2", "subject": "첫 번째 꿈", "description": "센쿠는 크롬을 시작으로 동료를 차례로 부활시키고 페르세우스호는 활기를 되찾는다. 과학팀은 통신 장치를 고쳐 루리에게 연락하지만 다른 전파로 인해 통신이 차단되고 섬뜩한 메시지가 흘러나온다. 와이맨의 공격 의지를 확인한 과학 왕국이 여러 의문을 품던 중 소유즈가 단서 하나를 떠올리는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74532/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96742, "name": "(자막) 닥터스톤 3기 part 2 20 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-12T19:00:08.173079", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67520, "title": "(자막) 닥터스톤 3기 part 2", "subject": "보물섬", "description": "수수께끼의 통신을 반복하는 와이맨이 달에 있다고 확신한 센쿠는 와이맨의 정체를 알아내기 위해 달에 가겠다고 선언한다. 과학 왕국은 부활액을 이용해 섬 주민들을 석화에서 부활시키고 출항을 앞둔 소유즈는 왠지 복잡한 마음이 든다. 한편 센쿠는 모두에게 보물섬을 동맹국으로 삼겠단 계획을 밝히는데…", "episode_num": "21", "episode_order": 21, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74883/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96893, "name": "(자막) 닥터스톤 3기 part 2 20 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-19T19:00:08.392786", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-18", "rating_components": []