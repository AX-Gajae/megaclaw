assets/2018/12/16996/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.100000", "progressbar": null, "item_expire_datetime": "2021-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-04-06T14:16:04.253814", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 20882, "title": "칼리굴라 [2021년 판권 만료작]", "subject": "앞으로 나아가는 것만이 전진이라 할 순 없다. 상황을 파악하는 것도 중요한 한 걸음이다.", "description": "악사들의 리더인 손은 뮤에게 노랫소리로 사람들을 이끌라고 한다. 이 세계가 현실이 아니라 뫼비우스란 것을 알아챈 아이들은 각자 다른 악사들과 대치한다. 아리아는 그 아이들에게 마음속에 있는 고통스럽고 괴로운 감정을 토해내라고 하는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/16995/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:44.033000", "progressbar": null, "item_expire_datetime": "2021-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-04-06T14:16:04.276399", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 20883, "title": "칼리굴라 [2021년 판권 만료작]", "subject": "절망적인 상황일수록 미소를 띨 필요가 있다", "description": " 뫼비우스에 대해 알아챈 사람끼리 모여 귀가부를 결성한 지도 한 달이 지났다. 어느 날, 귀가부는 다 함께 모여 전골 파티를 하기로 한다. 한편 계속 잠들어 있었던 뮤가 잠에서 깨어나자, 손은 악사들을 다시 불러모으기로 하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/16998/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.100000", "progressbar": null, "item_expire_datetime": "2021-03-31T23:30:00", "in