{"count": 12, "next": null, "previous": null, "results": [{"id": 62472, "title": "(자막) 기동전사 건담 수성의 마녀 part 2", "subject": "대지의 사자", "description": "플랜트 쿠에타 습격 사건으로부터 2주일. 평온한 일상이 유지되는 듯 보이는 학원. 하지만 사건에 대한 함구령이 내려지며 지구 기숙사 멤버들은 숨 막히는 나날을 보내고 있었는데. 오픈 캠퍼스를 하루 앞두고 준비가 진행되던 중 슬레타의 앞에 두 명의 편입생이 나타난다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69415/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06.866000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85029, "name": "(자막) 기동전사 건담 수성의 마녀 part 2 13 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-22T00:00:08.786209", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "WeeTV", "broadcast_date": "2023-06-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62690, "title": "(자막) 기동전사 건담 수성의 마녀 part 2", "subject": "그녀들의 바람", "description": "떠들썩한 오픈 캠퍼스, 그 속에서 슬레타는 소피와의 결투를 통해 가지고 싶은 것을 깨닫는다.\r\n한편, 일련의 사태에 책임을 느끼는 니카는...\r\n각자의 생각과 계략이 휘몰아치는 가운데 배틀로얄 방식의 결투 이벤트인 럼블링의 막이 오른다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69755/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:07", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85360, "name": "(자막) 기동전사 건담 수성의 마녀 part 2 14 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-30T10:00:08.429740", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "WeeTV", "broadcast_date": "2023-06-30