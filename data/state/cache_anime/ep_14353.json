000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89473, "name": "유니미니펫 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-11-01T16:00:10.263911", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-08-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 65669, "title": "유니미니펫", "subject": "동우의 위기", "description": "동우팀에 햄과 고양이 있음을 안 버그펫들은 어떻게든 동우팀을 떨어뜨려야 한다는 데 의견을 모으고 동우는 조직의 실체를 캐기 위해 위험한 잠입을 시도하다 들키고 만다. 동우는 함정방에 갇히고, 경기는 시작되지만 설상가상으로 공간이동 펜던트 수리중. 동우에 대한 걱정 때문에 사기가 크게 떨어진 유니미니펫팀은 실수를 연발, 패전직전이다. 그러나 동우는 때마침 도착한 매직으로 인해 탈출에 성공하고, 동우팀은 다시 힘을 모아 승리한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/10/72940/v15/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:53.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89472, "name": "유니미니펫 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-11-01T16:00:10.263911", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-08-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 65670, "title": "유니미니펫", "subject": "벼랑산 탐험", "description": "유니스톤을 찾아오겠다는 쪽지만 남기고 상현과 스피어와 함께 벼랑산으로 떠나는 동우. 천신만고 끝에 유니스톤을 찾아내고 버그펫 <로우뱃>도 잡는다. 공간이동을 하여 서둘러 경기장에 도착하지만 경기는 지기 일보 직전. 그러나 동우가 무사히 돌아 온 것에 안도한 유니미니펫팀은 더욱 힘을 내어 김현아의 플라워즈팀을 이기지만 이 팀에는 버그펫은 없다. 그러나 승리의 기쁨을 즐기는 사이 <로우뱃>이 도망을 치고만다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/202