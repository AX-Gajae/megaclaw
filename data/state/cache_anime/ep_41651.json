ning_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90969, "name": "MF고스트 7 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-02T00:00:08.923697", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66926, "title": "MF 고스트", "subject": "보이스 카운트", "description": "속도를 내며 주목 플래그까지 받았다가 환상의 콤비 남매를 만난 뒤, 플래그가 사라진다. 하지만, 바로 남매를 추월하고 시야가 좋지 않은 죽음의 구역 안개 속에서도 주저 없이 액셀을 밟는다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74018/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90968, "name": "MF고스트 8 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-09T00:00:07.831235", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66927, "title": "MF 고스트", "subject": "시속 300킬로미터 도그파이트", "description": "안개 속을 빠져나온 카나타는 다시 속도가 느려져 순위를 유지하기로 방향으로 계획을 수정하고 3위 그룹인 아이바는 실수로 오버런을 해 순위가 내려간다. 오가타는 완주 상금액을 보며 만감이 교차한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74019/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:44.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "