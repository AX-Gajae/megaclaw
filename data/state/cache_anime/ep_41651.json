{"count": 12, "next": null, "previous": null, "results": [{"id": 65511, "title": "MF 고스트", "subject": "영국에서 온 도전자", "description": "영국에서 일본에 온 카나타 리빙턴은 사이온지 렌의 집에 머물게 된다. 첫 만남에 렌의 가슴을 두근거리게 만든 카나타는 렌이 레이싱걸로 일하는 MFG 예선에 출전한다.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/10/72855/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:44.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89089, "name": "MF고스트 1 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-21T00:00:09.937860", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-10-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 65594, "title": "MF 고스트", "subject": "충격의 MFG 신세대", "description": "카나타의 MFG 출전을 모르고 있던 렌은 놀람과 동시에 걱정이 앞선다. 순위가 점점 올라가는 카나타를 보며 오가타와 아이바는 카나타의 질주를 응원하기로 생각을 바꾸었다.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/10/72856/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 89380, "name": "MF고스트 2 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-10-28T00:00:15.963386", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-10-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 65762, "title": "MF 고스트", "subject": "어묵 스트레이트", "description": "오가타가 질주하는 카나타의 모습을 보고 이중인