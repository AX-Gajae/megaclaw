ublished_datetime": "2025-01-04T00:00:11.404052", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80686, "title": "게게게의 키타로", "subject": "게 스님과 옛날 수수께끼", "description": "항구 마을에 밤마다 수상한 스님이 나타나서 수수께끼를 낸 다음에 정답을 못 맞히는 사람들을 동상으로 만드는 사건이 일어난다. 무명한필, 생쥐인간, 응애할아범, 만리장벽, 고양이소녀도 잇따라 동상으로 변한다. 결국 키타로까지 동상으로 변하고, 스님은 뒤늦게 나타난 모래할멈을 보고 놀라며 공주님이라고 부른다. 그 자리에서 도망친 모래할멈과 눈알아버지는 마나와 함께 깊은 산속에 사는 까마귀요괴에게 도움을 청하러 가는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/90100/v30/3dc9dd62732e/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114519, "name": "게게게의 키타로 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-01-04T00:00:11.588517", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80687, "title": "게게게의 키타로", "subject": "수달요괴의 거짓말", "description": "요즘 들어 키타로의 집 앞에 누군가 매일 채소를 두고 간다. 키타로와 눈알아버지는 누구의 짓인지 수상쩍게 여기는데, 사실 그건 고양이소녀가 다친 할아버지의 밭일을 도와주면서 수확한 채소였다. 그러던 어느 날, 고양이소녀는 키타로에게 줄 채소를 배고프다고 하는 소년에게 준다. 한편, 펜션에 놀러 온 마나는 엄마한테 근처의 늪에 교활한 요괴가 산다는 말을 듣는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/90101/v30/4340a203bdd3/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114520, "name": "게게게의 키타로 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-01-04T00:00:11.768976", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80688, "title": "게게게의 키타로", "subject": "요괴 부활하다!? 요괴 학교", "description": "아이들이 요괴 학교라는 곳에 간다는 말을 남긴 채 사라지는 사건이 잇달아 발생하자 키타로 일행은 즉시 요괴 학교로 향한다. 그곳에선 무명에 의해 부활한 요괴들이 아이들을 요괴로 만들기 위한 계략을 꾸미고 있었는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/90102/v30/e642fad6788a/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114521, "name": "게게게의 키타로 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-01-04T00:00:11.953416", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-09-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80689, "title": "게게게의 키타로", "subject": "요화의 기억", "description": "마나의 이모할머니 댁에 잔뜩 피어있는 요화를 보고 의아함을 느낀 키타로 일행은 요화에 대해 알아보기 위해 멀리 남쪽에 있는 섬으로 향한다. 키타로와 함께 섬에 도착한 마나는 그곳에서 그간 몰랐던 전쟁의 참상에 대해 알게 되는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/90103/v30/3bce91c71f6d/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114522, "na