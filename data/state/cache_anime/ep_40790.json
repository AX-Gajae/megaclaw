: false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72317, "name": "아하렌 양은 알 수가 없어 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72316, "name": "아하렌 양은 알 수가 없어 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-04-23T22:30:00.061776", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-04-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54259, "title": "아하렌 양은 알 수가 없어", "subject": "너무 찌지 않았어?", "description": "몇 년 전에 유행했던 몬스터 포획 육성 게임에 빠진 아하렌 양. 열심히 플레이하는 모습을 본 라이도는 '유행과 약간 거리감이 있지 않아?'라고 생각하면서도 아하렌 양과 같이 플레이하게 된다. 아하렌 양의 예상을 배신하는 '알 수 없는' 공격에 라이도는 투지를 불태우는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57330/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:38.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72522, "name": "아하렌 양은 알 수가 없어 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72521, "name": "아하렌 양은 알 수가 없어 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-04-30T22:30:00.067720", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-04-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54327, "title": "아하렌 양은 알 수가 없어", "subject": "너무 강하지 않아?", "description": "수영장을 자유롭게 사용해도 괜찮은 체육 특별 수업. 고글을 내린 수영복 차림의 라이도 군은 무엇을 할지 고민한다. '라이도 군'이라는 부름에 뒤돌아보니 그곳에는 스노클과 다이빙 슈트를 입은 아하렌이 있었다. 중장비인 아하렌 양과 라이도 군의 너무 자유로운 수영 시간이 시작되는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57378/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:38.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72702, "name": "아하렌 양은 알 수가 없어 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72701, "name": "아하렌 양은 알 수가 없어 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-07T22:30:00.110880", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54473, "title": "아하렌 양은 알 수가 없어", "subject": "예술 아냐?", "description": "도시락을 집에 두고 와 버린 아하렌 양. 매점에 도시락을 사러 가려고 했지만 그곳은 굶주린 망자들이 우글거리는 \"팬더모니엄'. 라이도는 그런 곳에 아하렌 양을 혼자서 보낼 수는 없어!라며 결심한다. 도시락을 사기 위해 아하렌 양과 라이도는 망자들이 들끓는 매점에 발을 내딛는데!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57613/v15/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:38.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72821, "name": "아하렌 양은 알 수가 없어 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72820, "name": "아하렌 양은 알 수가 없어 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-14T22:30:00.114608", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54656, "title": "아하렌 양은 알 수가 없어", "subject": "여름 축제 아냐?", "description": "토바루 선생님과 미야히라 선생님이 옥상에서 도시락을 먹고 있을 때 아하렌 양과 라이도가 옥상으로 올라왔다. 수업 중 교과서가 잘 보이도록 아하렌 양이 라이도의 무릎 위에 앉거나, 앞이 잘 보이도록 어깨에 타거나...'심히 유운적인' 두 사람의 등장에 토바루 선생님의 망상은 멈추질 않는데!", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57764/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73038, "name": "아하렌 양은 알 수가 없어 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73037, "name": "아하렌 양은 알 수가 없어 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-21T22:30:00.081695", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54810, "title": "아하렌 양은 알 수가 없어", "subject": "감기 아냐?", "description": "아침부터 조금 몸 상태가 좋지 않았던 라이도. 나른한 표정의 라이도를 본 아하렌 양의 가슴은 두근두근. 왜냐하면, 라이도의 얼굴이 '미소년 얼굴'이 돼 있었기 때문이다! 아하렌, 오시로, 이시카와, 사토, 그리고 토바루 선생님의 마음을 술렁이게 만드는 라이도의 '미소년 얼굴'의 행방은?!", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/58002/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73284, "name": "아하렌 양은 알 수가 없어 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73283, "name": "아하렌 양은 알 수가 없어 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-28T22:30:00.082670", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54891, "title": "아하렌 양은 알 수가 없어", "subject": "캠핑 아냐?", "description": "아하렌 양은 라이도, 오시로 양, 이시카와, 사토 양과 함께 산으로 캠핑을 가게 된다. 의욕이 넘치는 아하렌 양이었지만 식재료를 집에 두고 와 버렸다. 풀 죽은 아하렌 양을 본 라이도는 '뭔가 먹을 수 있는 걸 채취하러 가자'라고 제안하고, 다 같이 숲으로 들어가는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58085/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73419, "name": "아하렌 양은 알 수가 없어 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73418, "name": "아하렌 양은 알 수가 없어 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-06-04T22:30:00.054876", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-06-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54985, "title": "아하렌 양은 알 수가 없어", "subject": "눈 아냐?", "description": "눈이 내려 쌓이는 가운데 학교로 향하는 라이도. 그런 라이도의 앞에 거대한 눈사람이 나타났다. '눈 거대 생물'을 보고 도망치려던 라이도였지만 갑자기 눈사람에게서 '안녕'이라는 목소리가 들려왔다. 그 거대 눈사람의 복부에 뚫린 구멍에서 아하렌 양이 나타났는데...?!", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58219/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:23.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73569, "name": "아하렌 양은 알 수가 없어 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73568, "name": "아하렌 양은 알 수가 없어 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-06-11T22:30:00.117118", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-06-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55040, "title": "아하렌 양은 알 수가 없어", "subject": "결투 아냐?", "description": "캠핑 이후, 모습이 보이지 않는 오시로 양에게서 라이도 앞으로 '결투장'이 도착한다. 뭔가를 오해했을 거라고 생각한 라이도였지만 '라이도에게 지옥을'이라고 쓴 머리띠를 하고 화살을 겨누는 오시로 양이 결투 장소에 나타나면서 상황이 변한다. 오시로 양은 다 같이 캠핑을 갔던 그날 밤 아하렌 양이 '라이도 군에게 고백할래'라고 말한 것을 들었는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58408/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73714, "name": "아하렌 양은 알 수가 없어 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73713, "name": "아하렌 양은 알 수가 없어 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-06-18T22:30:00.075468", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-06-18", "rating_components": []}, "access_type": null, "is_available": false}]}