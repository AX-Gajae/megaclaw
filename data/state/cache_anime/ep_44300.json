ng_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92451, "title": "샹피뇽의 마녀", "subject": "저주받은 아이", "description": "루나는 강가에서 가슴에 칼이 꽂힌 채 의식을 잃은 청년을 발견한다. 청년에게서 칼을 뽑는 순간 거대한 저주 버섯이 나타나고, 루나는 필사적으로 저주 버섯을 정화하려 한다. 그런데 어느새 청년은 어린 소년의 모습으로 변해 있었다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/03/105239/v30/46ffd4c829a1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131723, "name": "샹피뇽의 마녀 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 131722, "name": "샹피뇽의 마녀 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-04-06T00:00:13.836524", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2026-04-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92452, "title": "샹피뇽의 마녀", "subject": "흑마녀 회의", "description": "루나는 한때 저주받은 아이였지만 그 운명을 이겨낸 유일한 존재다. 그리고 소년 역시 같은 운명을 짊어진 아이였다. 루나는 소년을 훌륭한 마법사로 키워 운명을 극복하겠다고 다짐한다. 흑마법사들은 소년을 루나에게 맡겨도 될지 고심한다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105386/v30/7432ac6091e4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131725, "name": "샹피뇽의 마녀 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 131724, "name": "샹피뇽의 마녀 4 소장", "list_price"