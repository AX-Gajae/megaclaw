0/15a65b8aeb38/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20050, "name": "이누야샤 2기 (더빙) 16 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-08-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24088, "title": "(더빙) 이누야샤 2기", "subject": "부러진 철쇄아!", "description": "카라와의 싸움에서 바람의 상처를 그대로 돌려 받은 이누야사. 커다란 상처를 입은 이누야사 앞에 금강이 나타난다. 이누야사는 사혼의 구슬을 나락에게 넘긴 금강을 원망하지만 금강은 나락을 지옥으로 몰기 위해 사혼의 구슬을 넘겨준 거라며 이누야샤에게 꼭 살아 있으라고 말한다. 하지만 바로 그 때, 나락의 세 번째 분신이 이누야사를 찾아오는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91847/v30/be57c82cd0a4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:50.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20051, "name": "이누야샤 2기 (더빙) 17 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-08-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24089, "title": "(더빙) 이누야샤 2기", "subject": "카이진보의 사악한 검!", "description": "신키에 의해서 부러진 이누야사의 철쇄아. 이누야사의 아버지가 남겨준 철쇄아는 이누야사를 수호하는 칼로 알려져 있었지만 사실은 이누야사가 가진 사악한 요괴의 힘을 막는 역할도 하고 있었다. 철쇄아를 고치기 위해 토토사이를 찾아가 수리를 부탁하는 이누야샤. 한편 셋쇼마루는 카이진보라는 대장장이를 찾아가 고신키의 이빨로 철쇄아에 버금가는 칼을 만들어 줄 것을 부탁한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91848/v30/c5a55ceecabd/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:50.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20052, "name": "이누야샤 2기 (더빙) 18 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-08-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24090, "title": "(더빙) 이누야샤 2기", "subject": "셋쇼마루! 투귀신을 휘두르다!", "description": "카이진보라는 대장장이와 맞서게 된 이누야사. 하지만 카이진보는 철쇄아의 검압을 견디지 못하고 사라져버린다. 그러나 투귀신은 철쇄아가 내려쳐도 끄떡이 없는데 과연 이 칼의 주인은 누구일까? 한편 카이진보를 찾아다니던 셋쇼마루는 카라의 도움으로 투귀신을 찾아내고 새로운 검을 손에 넣은 셋쇼마루는 이누야샤를 공격하는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91849/v30/8b6a35ebd033/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:50.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20053, "name": "이누야샤 2기 (더빙) 19 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-08-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24091, "title": "(더빙) 이누야샤 2기", "subject": "쥬로와 카로!", "description": "우연히 만나게 된 이누야사와 코우가. 무언가로부터 열심히 도망 중이던 코우가는 이누야사한테는 관심도 없는 듯 하다. 결국 휭 하니 사라져버린 코우가의 뒤에 남겨진 것은 이누야사와 쥬로. 쥬로는 나락의 4번째 분신으로