[{"id": 132383, "name": "우동나라의 황금색 털뭉치 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:18.190599", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93447, "title": "우동나라의 황금색 털뭉치", "subject": "리쓰린 공원", "description": "가가와로 내려오기로 결심하고 포코와 함께 가가와로 향하는 소타. 도착한 고향집에서 평온한 일상을 보내게 된다. 하지만 포코와 생활하기 위해서 일을 해야 한다. 당분간은 이전 회사 일을 하면서 프리랜서로 지내지만, 정착해서 할 일을 찾아야 한다. 그러는 중에 마나베에게 연락이 와서 마나베 대신 노조미와 포코를 데리고 가오가오 쇼를 보러 가게 된다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105818/v30/d659532a7f75/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132384, "name": "우동나라의 황금색 털뭉치 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:18.400464", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93448, "title": "우동나라의 황금색 털뭉치", "subject": "쇼도시마", "description": "소타는 포코를 데리고 다하마 사장에게 소개받은 쇼도시마의 팀 플래니트를 찾아간다. 마침, 사장이 자리를 비운 탓에 소타와 포코는 엔젤 로드를 구경하러 간다. 그곳에서 신나게 놀다가 깜빡 잠이 들어 버린 소타. 소타가 잠든 사이에 포코가 사라져 버린다. 잠에서 깬 소타는 정신없이 포코를 찾으러 다닌다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105819/v30/aa8982c18904/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132385, "name": "우동나라의 황금색 털뭉치 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:18.605853", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93449, "title": "우동나라의 황금색 털뭉치", "subject": "멸치 국물", "description": "소타와 포코가 돌아오자, 문 앞에 실연당한 히로시가 앉아 있다. 히로시는 실연당한 마음을 우동으로 위로받고 싶다면서 소타에게 우동을 만들어 달라고 한다. 어쩔 수 없이 우동을 만들기 시작하는 소타. 히로시와 포코가 옆에서 도우면서 만드는데 갑자기 포코가 너구리로 변신하기 시작했다. 급하게 감추려고 포코를 밖으로 내보낸다. 밖으로 나간 포코는 점점 더 너구리의 모습으로 변하고 사람으로 되돌아오지 못한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105823/v30/6a3b0ddacbed/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132391, "name": "우동나라의 황금색 털뭉치 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:18.805116", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93450, "title": "우동나라의 황금색 털뭉치", "subject": "저수지", "description": "어머니 기일을 앞두고 린코가 집에 찾아와서 대청소를 한다. 그리고 점심을 먹기 위해 린코가 음식을 만들었다. 하지만 소타와 나카지마는 요리를 못하는 린코가 불안하다. 린코는 갓으로 만든 켄친조림을 준비하는데, 아린 맛을 제대로 제거하지 않아 맛이 쓰고 아리다. 결국 참지 못하고 소타는 린코에게 화를 내 버린다. 그 말에 상처받은 린코는 집을 뛰쳐나가고 나카지마가 그 뒤를 쫓는다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105820/v30/dfb5543cb6f4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132392, "name": "우동나라의 황금색 털뭉치 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:19.005737", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93451, "title": "우동나라의 황금색 털뭉치", "subject": "다카마쓰 축제", "description": "소타는 마나부 씨와 함께 다카마쓰 축제 준비를 돕는다. 다카마쓰 축제 당일에 마나베 모녀와 나카지마, 린코와 함께 축제에 참가한다. 게다가 히로시와 다하마 씨도 축제를 보러 왔다. 즐겁게 축제를 즐기는 도중에 갑자기 포코의 꼬리가 드러나고 그곳에 있던 모두가 포코의 꼬리를 봐 버리고 만다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105821/v30/ac24226518a6/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:47.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132393, "name": "우동나라의 황금색 털뭉치 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-19T00:00:19.208694", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-02-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93452, "title": "우동나라의 황금색 털뭉치", "subject": "가케우동", "description": "축제 중에 꼬리가 드러나 포코가 도망쳐 버린다. 그런 포코를 쫓아가는 소타. 포코가 너구리가 아니라 사람이라고 믿고 싶었던 소타는 포코가 사람의 모습으로 자신에게 온 이유를 되묻게 된다. 도망가던 포코는 소타에게 옛날 일을 보여 준다. 그리고 사고의 기억이 없던 소타는 자기가 구해 준 너구리가 포코라는 것을 기억해 낸다, 그리고 서먹한 채 화해하지 못하고 아버지를 떠나보낸 소타에게 포코는 다시 아버지의 모습을 보여 준다.", "episode_num": "12", "episode_order": 1