ion": null}], "published_datetime": "2018-01-15T15:25:54.975132", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18321, "title": "플란다스의 개", "subject": "추억의 방울", "description": "파트라슈는 네로와 경주를 할 수 있을 정도로 건강해졌다. 아로아와 네로는 크게 기뻐하며 파트라슈와 함께 온종일 뛰어다니며 놀았다. 그리고 다음 날, 네로와 아로아는 배달 가시는 할아버지와 함께 앤트워프 마을로 간다. 그곳에서 조르주와 폴을 만나서 즐거운 시간을 보내는 네로. 하지만 파트라슈의 주인이었던 철물상도 같은 시각, 앤트워프에 있었는데... ", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15408/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:46.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15779, "name": "플란다스의 개 9 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:55.193968", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18322, "title": "플란다스의 개", "subject": " 아로아의 브로치", "description": "파트라슈가 마을에 가는 게 걱정된 할아버지는 네로에게 숲에 가서 나뭇가지를 주워 오라고 한다. 숲에 간다는 얘기를 들은 아로아는 네로를 따라나선다. 네로와 함께 간 파트라슈는 생전 처음으로 숲속을 뛰어다니며 자유를 만끽한다. 파트라슈와 함께 뛰어다니던 아로아는 숲속에서 브로치를 잃어버렸다는 걸 깨닫는다. 그 브로치는 아로아의 아빠가 사준 선물이었는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15409/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:46.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15780, "name": "플란다스의 개 10 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:55.287603", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18323, "title": "플란다스의 개", "subject": "아로아 엄마의 꽃밭", "description": "할아버지를 따라서 배달 온 네로는 조르주와 폴을 만난다. 두 사람은 네로네 마을에 놀러 가기로 하고 네로를 따라나선다. 네로는 조르주와 폴에게 마을을 안내해주고 있었는데, 갑자기 한스 아저씨가 나타나서 네로를 끌고 간다. 한스가 간 곳은 아로아 엄마의 꽃밭. 엉망으로 짓밟힌 꽃밭을 보며 한스는 파트라슈가 한 짓이라며 네로를 몰아세우는데...  ", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15410/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:46.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 16200, "name": "플란다스의 개 11 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-29T13:14:35.898391", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18324, "title": "플란다스의 개", "subject": "할아버지의 저금통", "description": "할아버지와 네로가 너무 좋은 파트라슈는 자기가 배달 수레를 끌겠다고 고집을 피운다. 네로와 할아버지는 어쩔 수 없이 파트라슈에게 수레를 끌게 하고 함께 앤트워프로 향한다. 할아버지와 헤어진 직후, 네로와 파트라슈는 철물상이 다가오는 걸 보고 황급히 골목으로 숨는다. 하지만 철물상은 골목 앞에 멈춰 서고 점점 네로가 숨어 있는 곳을 향해 걸어오는데... ", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15411/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:48.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episo