able": false}, {"id": 69396, "title": "(더빙) 나 혼자만 레벨업", "subject": "How to Get Stronger", "description": "10여 년 전 '게이트'라고 불리는 다른 차원과 이쪽 세계를 이어 주는 통로가 나타났다. 게이트 너머에는 마수가 존재했고 마수와 싸울 수 있는 능력에 각성한 자들을 사람들은 '헌터'라고 불렀다. 헌터는 체내에 있는 마력의 양에 따라 S급, A급, B급, C급, D급, E급으로 랭크가 나뉜다. 가장 약한 E급 중에서도 최약의 헌터로 각성했던 성진우가 어떤 일을 겪으며 강해질 수 있었는지 되돌아본다.", "episode_num": "7.5", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/77350/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99477, "name": "(더빙) 나 혼자만 레벨업 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99476, "name": "(더빙) 나 혼자만 레벨업 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-26T23:30:08.325985", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69944, "title": "(더빙) 나 혼자만 레벨업", "subject": "This Is Frustrating", "description": "병에 걸린 어머니를 위해 성진우에게 필요한 것은 아이템창에 표시된 '생명의 신수'. 하지만 그것을 제작하기 위해 필요한 아이템을 입수할 수 있는 퀘스트에 도전하는 것은 현재 성진우의 레벨로는 자살행위나 다름없었다. 그때, 헌터협회로부터 D급 던전 공략 소집 요청이 도착했다. 던전으로 향한 성진우였지만 그곳에서 만난 사람들은---?", "episode_num": "8", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/79061/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99805, "name": "(더빙) 나 혼자만 레벨업 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99804, "name": "(더빙) 나 혼자만 