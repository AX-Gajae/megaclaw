, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57460/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72605, "name": "파티피플 공명 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72604, "name": "파티피플 공명 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-06T02:00:00.098879", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-05-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54457, "title": "파티피플 공명", "subject": "천하태평계 Vol.1", "description": "서머 소니아의 출전권을 따내기 위해 ‘좋아요 10만 개 기획’에 참가하기로 한 에이코. 공명은 다른 팀들의 분석을 통해 에이코의 SNS에 게시물을 올리는 날짜를 마감 기한 사흘 전으로 정한다. 이 말을 들은 에이코와 KABE, 오너는 기겁을 하지만 에이코는 공명의 말을 따르기로 한다. 에이코는 공명의 지시대로 자신이 만든 노래를 레코딩 하기 위해 어느 스튜디오로 향하고 그곳에는 뜻밖의 인물이 있었는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57580/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72793, "name": "파티피플 공명 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72792, "name": "파티피플 공명 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-13T02:00:00.098980", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-05-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54638, "title": "파티피플 공명", "subject": "나를 찾다", "description": "에이코는 노래에 자기 색깔이 없다는 키도의 지적을 받고 자신을 찾기 위해 나나미와 버스킹을 하게 된다. 다른 가수의 노래도 자기 것으로 만드는 나나미를 보고 감탄하면서도 아무리 연습해도 잘되지 않아 고민에 빠진다. 노래 연습을 하고 있던 에이코를 찾아온 KABE. 두 사람은 처음으로 함께 노래와 랩을 하게 되지만 자신들의 부족함을 느끼며 풀이 죽는다. 그러자 에이코는 KABE에게 원점으로 돌아가보라는 조언을 하고 KABE는 바로 랩을 시작했던 곳으로 가보는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57741/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72960, "name": "파티피플 공명 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72959, "name": "파티피플 공명 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-20T02:00:00.067526", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-05-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54736, "title": "파티피플 공명", "subject": "백성을 위해서", "description": "키드에게 그동안 갈고닦은 노래를 선보이는 에이코. 키드는 예전보다 좋아졌다고 하지만 뭘 위해서 부르는지 모르면 안 된다고 충고한다. 또다시 풀이 죽은 에이코에게 나나미는 기분전환을 하러 가자고 하고 에이코는 공명이 준 전망대 티켓을 발견한다. 그렇게 나나미와 함께 전망대에 올라간 에이코는 그곳에서 나나미의 엄청난 고백을 듣게 되는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57953/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73122, "name": "파티피플 공명 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73121, "name": "파티피플 공명 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "publish