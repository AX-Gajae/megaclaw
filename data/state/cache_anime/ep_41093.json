득 마치 데이트 같다는 생각이 든다./크리스마스이브에 히나타의 집에 모여 크리스마스 파티를 하게 된 아오이와 친구들. 하지만 아르바이트하는 곳의 점장이 허리를 삐끗해 아오이는 급히 일을 돕기 위해 달려간다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/11/61878/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78114, "name": "야마노스스메 Next Summit 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-11-16T00:00:07.420729", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 57810, "title": "야마노스스메 Next Summit", "subject": "히카리의 데이트 대작전! / 다 함께 화이트 크리스마스!", "description": "아오이는 아르바이트하는 곳의 선배인 히카리의 제안으로 나구리 호수에 가게 된다. 그곳에서 카누 체험과 도시락을 먹으며 즐거운 시간을 보내는 두 사람. 아오이는 문득 마치 데이트 같다는 생각이 든다./크리스마스이브에 히나타의 집에 모여 크리스마스 파티를 하게 된 아오이와 친구들. 하지만 아르바이트하는 곳의 점장이 허리를 삐끗해 아오이는 급히 일을 돕기 위해 달려간다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/11/61972/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78288, "name": "야마노스스메 Next Summit 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-11-23T00:00:09.703965", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 57862, "title": "야마노스스메 Next Summit", "subject": "새해 해돋이 어디서 볼까? / 반 친구들과 등산!", "description": "섣달그믐날 텐란산에서 해돋이를 보기 위해 아오이의 집에 모인 히나타와 코코나. 하지만 텐란산은 붐빈다는 아빠의 말에 셋은 아빠의 차로 히와다산으로 향한다. / 아오이와 히나타는 같은 반인 카스미의 부탁으로 미오, 유리, 카스미와 함께 타카오산에 첫 참배를 하러 간다. 아오이는 첫 등산에 고전하는 카스미를 보며 1년 전 자신의 모습을 떠올린다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/11/62125/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78414, "name": "야마노스스메 Next Summit 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-11-30T00:00:09.356445", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 57896, "title": "야마노스스메 Next Summit", "subject": "파워 스폿에서 밸런타인데이? / 스노 슈즈로 도전!", "description": "밸런타인데이를 얼마 안 남기고 아오이는 호노카에게 다 함께 파워 스폿에 가자고 제안한다. 그리고 아오이, 히나타, 코코나, 호노카는 함께 파워 스폿을 돌며 즐거운 한때를 보낸다. / 동아리실 청소를 하던 중 스노 슈즈를 발견한 코하루는 아오이와 히나타에게 이걸 신고 눈 쌓인 산에 올라가자고 제안한다. 그리고 호노카도 함께 넷이 아카기산으로 출발. 하지만 생각보다 눈이 적어 실망한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/62347/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78573, "name": "야마노스스메 Next Summit 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-12-07T00:00:09.272424", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 57971, "title": "야마노스스메 Next Summit", "subject": "계류낚시는 인생? / 히나타 가족과 카마쿠라로!", "description": "최근에 낚시를 시작한 아오이 아빠와 나구리로 낚시를 간 아오이, 히나타, 코코나. 민박집 주인에게 낚시하는 법을 배우고 본격적으로 낚시를 시작하지만 좀처럼 잡히지 않는다. / 히나타 엄마의 기분전환을 위해 카마쿠라에 간 히나타 가족과 아오이. 카마쿠라 알프스에서 하이킹을 즐기며 도시락을 함께 먹고 즐거운 시간을 보낸다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/62661/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78931, "name": "야마노스스메 Next Summit 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-12-14T00:00:11.278682", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58277, "title": "야마노스스메 Next Summit", "subject": "새로운 계절", "description": "벚꽃이 피는 3월. 아오이는 2학년이 되면 히나타와 다른 반이 될까 봐 불안해한다. 그리고 1학년의 종업식 날, 반 친구들과 텐란산에서 기념 사진을 찍게 된 아오이는 산에 대해 잘 안다는 이유로 리더로 뽑힌다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/62966/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 79067, "name": "야마노스스메 Next Summit 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-12-21T00:00:07.616384", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58430, "title": "야마노스스메 Next Summit", "subject": "또 만났구나! 후지산", "description": "2학년이 된 아오이는 친구들과 쿠모토리산에서 훈련하고 새 등산 배낭을 장만하는 등 후지산 재도전을 차근차근 준비한다. 그리고 드디어 다가온 후지산 재도전의 날. 아오이는 흐린 날씨에 우울해지지만, 이번 만큼은 끝까지 오르겠다고 다짐한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/63373/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 79274, "name": "야마노스스메 Next Summit 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-12-28T00:00:09.554420", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58638, "title": "야마노스스메 Next Summit", "subject": "가자! 새로운 정상으로", "description": "날씨에 대한 불안을 안고 스바시리 코스로 올라가는 아오이와 친구들. 그리고 마침내 구름이 걷히고 후지산의 정상이 드러난다. 하지만 순조롭게 보이던 본 7부 능선 직전, 아오이는 작년과 같은 두통에 시달린다. 히나타는 좌절의 기억을 떠올린 아오이를 보며 어떤 결단을 내린다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/01/63528/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 79502, "name": "야마노스스메 Next Summit 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-01-04T00:00:12.102261", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}