, "period": "7 day", "promotion": null}, {"id": 72816, "name": "데아이몬 : 화과자 이야기 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-14T01:00:00.109183", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-05-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54662, "title": "데아이몬 : 화과자 이야기", "subject": "흩날리는 가을빛", "description": "료쿠쇼에 수습생이 들어왔다. 완벽주의자처럼 보이는 그녀는 좀처럼 곁을 주지 않지만, 료쿠쇼의 누군가를 항상 눈으로 쫓고 있다. 한편, 이리노 부자가 키타야마 초등학교에서 화과자 체험 교실을 열게 된다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57752/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73033, "name": "데아이몬 : 화과자 이야기 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73032, "name": "데아이몬 : 화과자 이야기 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-21T01:00:00.705682", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-05-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54816, "title": "데아이몬 : 화과자 이야기", "subject": "밤의 회고", "description": "핼러윈이 다가오면서 마을은 들뜬 분위기이다. 나고무도 핼러윈 때 분장하기 위하여 밴드 활동 때 쓰던 밤 탈을 찾는데, 보이지 않는다. 혼자 찾아 다니며 애쓰는 나고무를 보던 카노코도 밤 탈의 행방을 수소문한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57980/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:15", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing":