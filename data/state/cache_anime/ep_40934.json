ts": [{"id": 75166, "name": "이세계 약국 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75165, "name": "이세계 약국 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-03T22:30:09.879042", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55987, "title": "이세계 약국", "subject": "이세계 약국의 일상과 화장품", "description": "이세계 약국의 존재가 시민들에게 알려지면서 주목을 받게 되었지만, 여전히 손님은 별로 오지 않는 상황이 계속되었다. 로테가 실시한 시민 대상 설문 조사 결과를 보자, 귀족이 운영하는 가게에 오는 걸 평민이 주눅 들어 한다는 것을 알게 되었다. 어떻게 하면 손님을 늘릴 수 있을지 고민하던 차에 팔에 자상이 몇 개나 보이는 귀족 영애가 약국에 실려 왔는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59842/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75414, "name": "이세계 약국 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75413, "name": "이세계 약국 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-10T22:30:06.798847", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56113, "title": "이세계 약국", "subject": "남매와 바다", "description": "항구 마을인 마세일을 시찰하고 돌아오니 이세계 약국의 손님이 세 배 정도는 늘어있었다. 하지만 그 가운데는 흰옷 차림의 수상한 2인조도 섞여 있었다. 다음 날, 약국으로 사람이 안 탄 짐마차가 돌진하는 사건이 발생했고, 거기에다 들이닥치듯이 찾아온 환자 발생 소식에 팔마는 치료를 하기 위해 출발했다. 하지만 도착한 곳에서는 의외의 인물이 그를 기다리고 있었는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59940/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75623, "name": "이세계 약국 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75622, "name": "이세계 약국 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-17T22:30:07.951568", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56182, "title": "이세계 약국", "subject": "그림자 없는 소년과 이단 심문관", "description": "흰색 옷차림을 한 집단의 정체는, 이단자와 악령을 제거하는 이단 심문관들이었다. 팔마는 그들에게 악령으로 오해받아 신술로 공격받게 되었으나 상대방이 다치지 않는 선에서 대응했다. 그러다 전투 중에 이단 심문관들의 리더인 살로몬이 큰 부상을 입고 말았다. 자신을 공격한 상대이긴 하지만 팔마는 그를 치료하기로 결정했는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/60094/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75757, "name": "이세계 약국 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75756, "name": "이세계 약국 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-24T22:30:09.441046", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56343, "title": "이세계 약국", "subject": "인플루엔자와 약국의 새벽", "description": "평민들로 구성된 약사 길드에 소속된 약사 피에르는 늦은 밤에 딸에게 열이 나 어쩔 줄을 몰라 하고 있었다. 그때 우연히 만난 팔마에게 진료를 받게 되었다. 팔