_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/05/93218/v30/a56f14b9bb75/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:09.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118091, "name": "더 파이팅 리마스터 part 1 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118090, "name": "더 파이팅 리마스터 part 1 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-05-17T09:00:07.744802", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-05-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83354, "title": "더 파이팅 리마스터 part 1", "subject": "데뷔전", "description": "일보의 데뷔전 상대는 니시카와 체육관의 오다 유스케.\n한 체급 위인 주니어 라이트급에서 전향한 선수라는 사실에 일보는 긴장한다.\n하지만 소문대로 오다는 훈련을 싫어하는 선수였고,주변에서도 이미 기대를 접은 상태였다.\n과거 복싱에 진지하게 임했던 오다의 모습을 사랑했던 그의 연인인 레이코는 오다를 조롱하는 남들의 이야기를 오다에게 전하며, 오다의 투지에 불을 지핀다. \n그는 승리를 위해 본격적인 훈련에 돌입하고, 일보는 강렬하게 단련된 그의 몸을 보고 세간의 소문과 다르다는 것을 직감한다.\n그리고 마침내,일보의 데뷔전 날이 밝아온다!", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/05/93222/v30/540bc52f867e/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:10.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118093, "name": "더 파이팅 리마스터 part 1 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118092, "name": "더 파이팅 리마스터 part 1 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-05-17T09:00:08.263127", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "bro