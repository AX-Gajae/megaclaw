 찾아야 겠다고 생각하는데...", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/05/93410/v30/ce1b3d4dc8bf/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:09.833000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 118271, "name": "더 파이팅 리마스터 part 1 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 118270, "name": "더 파이팅 리마스터 part 1 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-05-24T09:00:08.502420", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-05-24", "rating_components": []}, "access_type": null, "is_available": false}]}