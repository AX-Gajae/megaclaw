ilable": false}, {"id": 87104, "title": "전생 악녀의 흑역사", "subject": "용의자 결정으로 사망 확정?", "description": "코노하와 함께 몰래 외출한 이아나는, 거리에서 코노하의 인기와 자신이 얼마나 미움받는 존재인지를 동시에 실감한다. 저택으로 돌아온 두 사람 앞에 한 남자가 나타나고, 이아나는 그에게서 엄청난 악의를 느낀다. 남자는 경찰 치안 부대 제2반 하이드렌지아대 소속 부대장인 샤노우. 그는 바로 코노하 살인 미수 혐의로 이아나를 체포했던 남자였다. 최근 일어나고 있는 미소녀 연속 실종 사건을 조사 중인 샤노우는, 이아나에게 의심의 눈길을 보내는데...", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100323/v30/ad75b4627da5/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125525, "name": "전생 악녀의 흑역사 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125524, "name": "전생 악녀의 흑역사 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-13T01:30:08.078711", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-11-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87105, "title": "전생 악녀의 흑역사", "subject": "뇌 내 영상은 전 연령", "description": "'이 아이는 노예가 아니니까'ㅡ 친구가 된 메노아의 의붓 언니에게 기세 좋게 쏘아붙인 이아나. 아마릴리스 부인의 파티에서 얼떨결에 소란을 일으킨 탓에, 이아나를 향한 샤노우의 의심은 점점 확신이 되어간다. 바로 그때, 저택에서 메노아가 실종되는 일이 벌어지고... 메노아의 귀걸이를 가지고 있던 이아나가 실종 사건의 혐의자로 몰리게 되는데...!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100555/v30/59a85e5d9825/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125796, "name": "전생 악녀의 흑역사 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"