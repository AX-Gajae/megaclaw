rice": 700, "period": "7 day", "promotion": null}, {"id": 90819, "name": "Paradox Live THE ANIMATION 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-24T00:30:07.899658", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67061, "title": "Paradox Live THE ANIMATION", "subject": "VIBES", "description": "Akanyatsura'와의 대결 전 긴장이 고조되는 'BAE' 이번에 이기면 결승으로 향하는 길이 보일 것이다. 그러던 중, 슬럼가 한구석에서 하준은 이오리를 만난다. 하준이 품고 있는 '어떤 사정'을 이오리는 간파하고 있는 듯했다. 하지만, 하준은 이오리의 충고를 흘려넘긴다. 그에게는 어떻게 해서든 승리하고 싶은 이유가 있었다. 그리고 무대의 막이 오르는데──", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74155/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 94831, "name": "Paradox Live THE ANIMATION 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 94830, "name": "Paradox Live THE ANIMATION 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-01T00:30:08.593467", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67254, "title": "Paradox Live THE ANIMATION", "subject": "BREAK", "description": "엑스트라 배틀 출전이 결정된 'BAE'. 휴식 겸 합숙의 일환으로 산속의 온천에 갔는데 우연히 그곳에서 'Akanyatsura' 일행과 만난다. 여관의 여주인으로부터 잡은 사람에게 행운을 가져다준다는 '어떤 생물\"의 전설을 들은 알렌과 사츠키는 그것을 겟 하기 위해 움직이기 시작했는데──", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74421/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96660, "name": "Paradox Live THE ANIMATION 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96659, "name": "Paradox Live THE ANIMATION 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-08T00:30:07.250049", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67337, "title": "Paradox Live THE ANIMATION", "subject": "LOST", "description": "몇 년 만에 아버지와 재회한 알렌. 알렌의 아버지는 'Paradox Live'에서의 알렌의 활약을 알고 있었다. 자신의 음악을 인정해 줬으면 좋겠다── 하지만, 알렌의 한 줄기 희망은 잔혹하게 부서져 버렸다. 엑스트라 배틀 당일. 'BAE'와 'cozmez'는 각자의 마음을 가슴에 품고, 무대에 오르려 하고 있었는데──", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74656/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96782, "name": "Paradox Live THE ANIMATION 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96781, "name": "Paradox Live THE ANIMATION 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-15T00:30:08.386923", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67568, "title": "Paradox Live THE ANIMATION", "subject": "MEMORIES", "