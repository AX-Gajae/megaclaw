:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24780, "title": "좀비 랜드 사가 [2026년 판권 만료작]", "subject": "GOGO 네버랜드 SAGA", "description": "사가 록 출연을 무사히 마친 프랑슈슈 멤버들은 잡지에 실린 자신들의 기사를 보며 기뻐한다. 인지도 높은 아이돌을 다음 목표로 설정한 프랑슈슈는 적극적으로 공연과 이벤트를 펼쳐 나간다. 그러던 어느 날, 거구의 한 남자가 체키회에 나타난다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20129/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": "2026-04-15T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-11-30T00:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24781, "title": "좀비 랜드 사가 [2026년 판권 만료작]", "subject": "한 번 죽은 이 목숨 무슨 인과 때문인지 되살아나 노래하고 춤추는 게 숙명이라면 친구를 향한 마음 가슴에 담아 관철해 나갈 뿐 내 SAGA", "description": "고령화로 주민의 대다수가 노인인 사가. 그런 현실에 맞춰, 할머니, 할아버지의 마음을 사로잡기 위해 프랑슈슈는 공원에서 열린 노인들의 카시마 춤 연습회에 참가한다. 그런데, 한 무리의 불량 여학생들이 공원은 자신들의 구역이라며 시비를 걸어 온다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20130/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.100000", "progressbar": null, "item_expire_datetime": "2026-04-15T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-12-07T09:57:34.897052", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "a