ing_components": []}, "access_type": null, "is_available": false}, {"id": 47057, "title": "남자 고교생의 일상", "subject": "남자 고교생과 자전거 외", "description": "자판기 앞에서 요즘 성행한다는 소매치기범의 이야기하던 요시타케와 모토하루. 호랑이도 제 말하면 온다고 하듯이, 요시타케의 지갑이 소매치기범에 의해서 도둑맞는다. 모토하루는 지나가던 사람에게 자전거를 빌려 범인을 뒤쫓기 시작하나, 얼마 가지 못해서 넘어진다. 요시타케는 그런 모토하루를 서포트하며 자전거를 밀어주는데...", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50592/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49.266000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 62318, "name": "남자 고교생의 일상 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 63331, "name": "남자 고교생의 일상 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-06-18T00:00:00.217902", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2012-03-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 47058, "title": "남자 고교생의 일상", "subject": "남자 고교생과 아버지 외", "description": "아버지를 향해 천천히 야구공을 던지는 히데노리. 아버지는 골프채를 야구 배트와 같이 힘껏 휘두르며 공을 쳐 낸다. 아버지와 같이 캐치볼을 하고 싶은 히데노리와 캐치볼만큼은 절대로 하고 싶지 않은 아버지 사이의 신경전이 펼쳐지는 가운데, 두 남자는 각자 마음속에 품었던 꿈과 자신의 미래에 대한 이야기를 시작한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50593/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 62843, "name": "남자 고교생의 일상 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 63330, "name": "남자 고교생의 일상 11 소장", "list_price": 1500, "period": "