free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46588, "name": "역경무뢰 카이지 part 1 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 46587, "name": "역경무뢰 카이지 part 1 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-12-17T00:00:00.121529", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "바둑TV", "broadcast_date": "2010-01-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36712, "title": "역경무뢰 카이지 part 1", "subject": "사자", "description": "호화 여객선 에스포와르에서 승부를 마친 지 4개월이 지났지만, 대출금 징수는커녕 독촉 전화도 없어 카이지는 불안해하고 있었다. 무사히 배에서 내리면서 원래 있던 빚 385만 엔은 없어졌지만, 배에서 새로운 빚 629만 엔이 생겼다. 월 10만 엔씩 갚아도 원금은 거의 줄지 않는 상황. 카이지는 배의 별실에 있었던 이시다를 구하기 위해 돈을 쓴 것을 후회하지만 때는 이미 늦었다. 그러던 중 카이지는 점장으로부터 10만 엔을 훔쳤다는 의심을 받는다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/12/33664/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:49.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46586, "name": "역경무뢰 카이지 part 1 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 46585, "name": "역경무뢰 카이지 part 1 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-12-17T00:00:00.121529", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "바둑TV", "broadcast_date": "2010-01-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36713, "title": "역경무뢰 카이지 part 1", "subject": "광연", "description": "스타사이드 호텔의 파티에 발을 들인 카이지는, 30명 정도의 젊은 참가자 중 이시다와 사하라를 발견한다. 그 외에도 에스포와르에 있었던 몇 명의 모습을 발견하고, 카이지는 마음을 다잡는다. 주최 측은 참가자를 12명씩 5조로 나누어, 1조부터 작은 엘리베이터에 태워 올려보낸다. 1조 10번의 번호를 받은 카이지.