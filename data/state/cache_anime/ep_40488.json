able": false}, {"id": 49476, "title": "(더빙) 포텐독 시즌 2", "subject": "잡았다! 개똥 테러범!", "description": "원석, 카이, 푸푸, 뿔테는 개똥테러범이 골드팽임을 포착하고, 골드팽의 개똥 생산 현장을 급습한다. 개똥테러작전을 지휘하던 골드팽의 '기네스'는 순식간에 상대를 얼려버리는 무시무시한 초능력으로  포동넷을 위협하고 푸푸와 뿔테는 기네스와 싸우던 중 자신들의 초능력을 발견하게 되는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/51053/v15/Thumbnail.0000020.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:42.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65088, "name": "(더빙) 포텐독 시즌 2 7 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2021-09-07T23:30:00.053050", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS1", "broadcast_date": "2021-08-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49477, "title": "(더빙) 포텐독 시즌 2", "subject": "개튜브 작전", "description": "골드팽은 부상을 입은 기네스를 데리고 달아난다. 기네스는 부상을 입은데다가 자신감도 떨어져 소심해지고 우울해진다.,개리우스는 마음의 눈으로 기네스의 자신감을 다시 강화시키고, 기네스에게 개튜브로 슈퍼쟈니를 홍보하는 임무를 맡긴다. 기네스의 예쁜 외모 덕분에 슈퍼쟈니 홍보 동영상은 인기가 폭발하고…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/51054/v15/Thumbnail.0000022.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:09:12.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65087, "name": "(더빙) 포텐독 시즌 2 8 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2021-09-07T23:30:00.053050", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS1", "broadcast_date": "2021-08-05", "rating_components": []}, "access_type": null, 