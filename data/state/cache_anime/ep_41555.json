_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126077, "name": "우리 회사의 작은 선배 이야기 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126076, "name": "우리 회사의 작은 선배 이야기 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-28T00:00:13.290554", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-07-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87487, "title": "우리 회사의 작은 선배 이야기", "subject": "딴 데로 샐까요?", "description": "거래처에서 미팅을 마치고 돌아오던 중, 리포터에게 커플로 오해받은 시오리와 타쿠마. 결국 연인 흉내를 내며 인터뷰에 응한 두 사람은 진땀을 뺀다. 한편, 크리스마스 날 회사 회식에 참석한 두 사람. 회식을 마치고 역으로 향하던 시오리는 타쿠마에게 딴 데로 새자고 제안하고 두 사람은 크리스마스로 물든 거리로 나선다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100967/v30/ba405a52800e/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:11.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126079, "name": "우리 회사의 작은 선배 이야기 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126078, "name": "우리 회사의 작은 선배 이야기 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-28T00:00:13.653827", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-08-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87488, "title": "우리 회사의 작은 선배 이야기", "subject": "본능을 거스를 수 없어!", "description": "자신의 코스프레 취미와 또 다른 취미까지 들켜버린 하야카와는 주임의 도움으로 원고 마감에 이어 판매 도움까지 받는다. 그리고 맞이한 1년의 마지막 날, 시오리는 후배인 타쿠마에게 전화를 걸어 감사 인사를 전하고 타쿠마는 새해 첫 참배를 같이 가자고 제안한다.", "episode_num": "6", "episode_order": 6, "th