, "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/103249/v30/4102673e09f5/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129102, "name": "SI-VIS: The Sound of Heroes 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-27T00:00:10.810259", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-01-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87054, "title": "SI-VIS: The Sound of Heroes", "subject": "마음은 전해져, 노래는 전해져", "description": "하르모니아 건물 전체가 미라주로 둘러싸인다. 건물 밖에 있었던 쿄야와 소지, 준은 안으로 들어가려고 시도해 보지만, 어느 문으로 들어가도 튕겨 나오기만 한다. 한편, 미로처럼 복잡해진 건물 안쪽을 헤매다가 서버 룸에 도착한 나기와 뮤. 두 사람 앞에 나타난 메데이아는 10년 전의 진실을 알려준다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/103651/v30/67e2c6c25fae/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129368, "name": "SI-VIS: The Sound of Heroes 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-02-03T00:00:22.629785", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-02-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87055, "title": "SI-VIS: The Sound of Heroes", "subject": "지구에 절망을, 그리고…", "description": "미라주의 안쪽과 바깥쪽에 떨어져 있던 시비스 멤버들은 노래를 통해 다시 한곳에 뭉치고, 하르모니아 건물은 무사히 미라주에서 벗어