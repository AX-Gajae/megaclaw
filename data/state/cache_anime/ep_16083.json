:36.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 136024, "name": "파라다이스 키스 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-05-29T00:00:14.608504", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KNET", "broadcast_date": "2026-04-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 94282, "title": "파라다이스 키스", "subject": "미래", "description": "졸업을 맞이한 멤버들은 각자의 미래를 향해 나아간다. 조지는 디자이너의 길을 꿈꾸며 파리로 떠나기로 한다. 함께 가자고 권하는 조지의 말에 유카리는 흔들리게 된다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107386/v30/8c45f2f9e715/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:44.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 136025, "name": "파라다이스 키스 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-05-29T00:00:14.806517", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KNET", "broadcast_date": "2026-04-29", "rating_components": []}, "access_type": null, "is_available": false}]}