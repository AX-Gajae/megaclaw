lished_datetime": "2021-05-28T19:00:00.184955", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2020-VK05207", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "선정성", "폭력성", "대사", "공포", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 46723, "title": "기괴하고 요상한 귀신딱지", "subject": "물귀신을 찾아라1", "description": "꼭두와 에구구의 도움으로 악귀의 정체가 물귀신임을 알아낸 짝구와 우동. 하지만, 갑작스레 쏟아지는 비 때문에 물귀신의 위치를 알 수 없게 돼버린다. 이대로 오늘 자정이 지나버리면 초아 역시 악귀가 돼버리는 최악의 상황. 꼭두와 우동은 어떻게 물귀신을 찾을지 고민하는 한편, 짝구가 생각한 기발한 아이디어가 이 문제를 해결한다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/05/47328/v15/Thumbnail.0000007.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:04.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 61345, "name": "기괴하고 요상한 귀신딱지 5 소장", "list_price": 300, "period": "0 day", "promotion": null}], "published_datetime": "2021-05-28T19:00:00.184955", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2020-VK05207", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "선정성", "폭력성", "대사", "공포", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 46724, "title": "기괴하고 요상한 귀신딱지", "subject": "물귀신을 찾아라2", "description": "숨바꼭질 귀신의 뒤를 쫓아 물귀신을 찾아 나선 짝구와 우동은 골목길에서 물귀신을 발견하지만, 비가 와서 평소보다 훨씬 힘이 강해진 물귀신은 쉽게 잡히지 않았다. 우동은 꼭두가 준 악귀의 힘을 약하게 만드는 쫀드기를 찾지만, 그건 이미 짝구가 먹어버린 상태. 과연 짝구와 우동은 쫀드기 없이 물귀신을 잡을 수 있을까?", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/05/47329/v15/Thumbnail.0000007.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:03:09.266000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], 