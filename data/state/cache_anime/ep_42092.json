": []}, "access_type": null, "is_available": false}, {"id": 72559, "title": "블루 아카이브", "subject": "나의 학생이니까", "description": "호시노를 찾기 위해 노력하는 선생님은 의문의 편지를 받고, 그 편지에 적힌 대로 간 곳에서 검은 양복을 만난다. 자신에게 협조하라는 검은 양복. 하지만 그의 요청을 단번에 거절한 선생님은 카이저 PMC 실험실에 갇힌 호시노를 구하고자 아이들과 함께 다른 학교에 협조 요청을 하러 다니는데….", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/83319/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106114, "name": "블루 아카이브 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-06-17T02:00:09.788760", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-06-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 72560, "title": "블루 아카이브", "subject": "다녀왔어", "description": "호시노를 구출하러 간 대책위원회 멤버들. 카이저 코퍼레이션의 강력한 대항에 아이들은 위기에 처한다. 그리고 그때 그들을 구하기 위해 나타난 선도부, 게헨나, 흥신소 멤버들. 그들의 지원에 힘입어 아이들은 호시노가 있는 곳을 찾아내지만….", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/06/83359/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 106706, "name": "블루 아카이브 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-06-24T02:00:10.528803", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-06-24", "rating_components": []}, "access_type": null, "is_available":