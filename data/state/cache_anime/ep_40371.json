isode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50844/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 64588, "name": "바니타스의 수기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 64587, "name": "바니타스의 수기 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-08-21T23:30:00.114988", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-08-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49248, "title": "바니타스의 수기 1기", "subject": "빨강을 사냥하는 자", "description": "롤랑의 공격에서 도망친 바니타스와 노에. 그리고 가까스로 롤랑에게 사정을 설명한다. 롤랑, 그리고 롤랑과 같은 샤세르인 마리아, 조르주와 함께 지하 미궁의 심층으로 향하는 일행. 지하 미궁 최심부에는 샤세르에서 추방당했던 연구자 닥터 모로가 있었는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/08/50976/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.566000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 64802, "name": "바니타스의 수기 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 64801, "name": "바니타스의 수기 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-08-28T23:30:00.077604", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-08-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49390, "title": "바니타스의 수기 1기", "subject": "No.69", "description": "닥터 모로의 연구실에서 격렬한 전투에 휘말리는 바니타스 일행. 납치된 저주받은 그림자 법사를 상대로 고전을 면치 못하지만 노에의 협력으로 바니타스는 그림자 법사의 진명을 되찾는다. 그 후 바니타스와 노에는 폭발로 무너지는 연구실에서 겨우 탈출에 성공하는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/09/51134/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 64983, "name": "바니타스의 수기 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 64982, "name": "바니타스의 수기 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-09-04T23:30:00.066013", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-09-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49532, "title": "바니타스의 수기 1기", "subject": "서약", "description": "바니타스에게 미움받기 위해서 일부러 사랑에 빠진 척 연기하기로 한 잔느. 파리의 거리에서 데이트하는 두 사람 그런 둘을 도미니크와 단테가 지켜본다. 한편, 루스벤 경이 찾아와 함께 카페에 간 노에였는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/09/51302/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65202, "name": "바니타스의 수기 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 65201, "name": "바니타스의 수기 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-09-11T23:30:00.032386", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-09-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49630, "title": "바니타스의 수기 1기", "subject": "출발점", "description": "잔느의 이야기로 루스벤 경의 불온한 움직임을 눈치채고 노에를 걱정하는 바니타스. 그런 와중에 18세기 사람들을 공포에 떨게 했던 '제보당의 괴수'가 다시 나타난다. 단테로부터 그 이야기를 들은 바니타스와 노에는 괴수가 저주받은 자와 관련 있을 가능성이 있다고 보고 제보당으로 향하는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/09/51493/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 65359, "name": "바니타스의 수기 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 65358, "name": "바니타스의 수기 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-09-18T23:30:00.065576", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-09-18", "rating_components": []}, "access_type": null, "is_available": false}]}