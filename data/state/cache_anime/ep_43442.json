oducts": [], "episode_products": [{"id": 125377, "name": "샤바케 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125376, "name": "샤바케 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-08T02:30:07.768366", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-11-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 86869, "title": "샤바케", "subject": "은애", "description": "이치타로의 행방불명으로 나가사키야가 발칵 뒤집혔다. 무언가 알고 있는 듯한 에이키치의 모습에 히기리 대장과 니키치는 집요하게 물었지만, 에이키치는 입을 굳게 다물고 있었다. 그때, 나가사키야 근처에서 약재상이 살해당했다는 소식이 들려오는데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100383/v30/c5b9b0c7ace0/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125629, "name": "샤바케 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125628, "name": "샤바케 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-15T02:30:09.055616", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-11-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 86870, "title": "샤바케", "subject": "돌파구", "description": "마츠노스케가 일하는 아즈마야 근처에서 고양이가 살해당하는 사건이 연이어 발생했다. 범인의 누명을 쓰고 아즈마야의 마님에게 추궁당하던 마츠노스케는, 기지를 발휘해 그를 감싸준 오미치 덕분에 누명을 벗는다. 아즈마야의 하나뿐인 딸인 오미치는 마츠노스케에게 연심을 품고 있는 것처럼 보였는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100616/v30/6e6681819232/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:2