pire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54148, "name": "(더빙) 블랙 클로버 2기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-10-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41817, "title": "(더빙) 블랙 클로버 2기", "subject": "약속의 세계", "description": "판젤과 마르스는 아스타와 파나와 싸우고 있는 곳으로 라드로스를 유인한다. 상대의 마법 공격을 흡수한 뒤 그걸 방출하는 힘을 가진 라드로스를 쓰러뜨리기 위해 판젤은 아스타의 반 마법을 이용하려고 한다. 아스타는 영문도 모른 채 판젤이 시키는 대로 파나의 힘을 튕겨내는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35062/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54147, "name": "(더빙) 블랙 클로버 2기 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-10-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41818, "title": "(더빙) 블랙 클로버 2기", "subject": "발전시키는 존재", "description": "파나는 마르스와 아스타의 도움으로 예전 기억을 되찾는다. 하지만 백야의 마안 서드 아이였을 때의 기억은 전혀 떠올리지 못한다. 다만 마석을 찾아야 한다는 강한 의지와 누군가의 강렬한 증오에 지배됐던 것만을 기억할 뿐이다. 그때 쓰러뜨린 줄만 알았던 라드로스가 부활해 강력한 공격을 퍼붓는다. 갑작스러운 공격에 동료들은 모두 쓰러지고 아스타 혼자 라드로스에 맞선다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35063/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54146, "name": "(더빙) 블랙 클로버 2기 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-10-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41819, "title": "(더빙) 블랙 클로버 2기", "subject": "아무것도 아니다", "description": "라드로스의 공격을 받고 의식을 잃은 아스타. 그것을 본 마녀왕은 반 마법의 검을 능숙하게 다룰 수 있는 아스타의 진정한 힘을 이끌어내서 정체를 확인하려고 한다. 한편, 아스타는 무의식 속에서 거대한 무언가를 만난다. 그것은 자신에게 의식을 맡기면 이기게 해 주겠다고 하지만, 아스타는 스스로의 힘으로 이기겠다며 거부한다. 그리고 갑자기 의식을 찾은 아스타는 지금껏 본 적 없는 어마어마한 힘을 발휘한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35064/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54145, "name": "(더빙) 블랙 클로버 2기 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-10-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41820, "title": "(더빙) 블랙 클로버 2기", "subject": "운명의 붉은 실", "description": "마녀왕의 진짜 목적은 아스타의 반 마법 검과 그 검을 다룰 줄 아는 아스타였다. 강력한 마법으로 아스타를 꼭두각시로 만든 마녀왕은 의식이 없는 아스타를 조종해 노엘을 죽이려 한다. 그 모습을 본 바네사는 마녀왕에게 애원하지만 마녀왕은 들은 척도 하지 않는다. 그때 아스타와 동료들을 구하고자 하는 간절한 마음이 바네사의 잠재된 힘을 각성시킨다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35065/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54144, "name": "(더빙) 블랙 클로버 2기 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-10-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41821, "title": "(더빙) 블랙 클로버 2기", "subject": "다녀왔습니다", "description": "마녀왕이 그렇게 기다렸던 바네사의 마법은 자신의 계획을 망치는 마법이 되어 마녀왕에게 돌아왔다. 잘못을 깨달은 마녀왕은 그 강력한 힘으로 훼손된 숲과 다친 아스타 일행 및 마녀들을 한순간에 회복시켜 준다. 아스타가 백야의 마안이 갖고자 하는 마석에 대해 묻자, 마녀왕은 마석과 아스타가 가진 검이 원래 고대 엘프 족의 소유물이었다는 것을 알려 준다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35066/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:02", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54143, "name": "(더빙) 블랙 클로버 2기 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41822, "title": "(더빙) 블랙 클로버 2기", "subject": "백야의 마안의 비밀", "description": "백야의 마안과 다이아몬드 왕국의 습격으로부터 마녀의 숲을 구한 아스타 일행이 무사히 돌아왔다. 금색의 여명단 유노, 클라우스, 미모사도 아스타의 팔이 나았다는 소식에 안도한다. 클라우스는 유노와 미모사에게 언제 또 공격해 올지 모르는 백야의 마안에 대해 심도 있게 이야기를 나누자고 제안한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35067/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54142, "name": "(더빙) 블랙 클로버 2기 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41823, "title": "(더빙) 블랙 클로버 2기", "subject": "즐거운 축제 더블데이트", "description": "클로버 왕국에서 1년 중 가장 큰 축제로 사랑받는 성과제가 열린다. 성과제에서는 각 마법기사단이 1년 동안 세운 공적을 별 개수로 환산해 1위를 정한다. 검은 폭우단 역시 들뜬 마음으로 성과제에 참가한다. 아스타는 해저 신전에서 우정을 쌓은 키아트와 카호노의 남매를 이 축제에 부른다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/01/35068/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:03.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 54141, "name": "(더빙) 블랙 클로버 2기 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2020-09-11T19:00:00.121983", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41824, "title": "(더빙) 블랙 클로버 2기", "subject": "사투! 야미 VS 잭", "description": "클로버 왕국에서 가장 인기 많은 축제, 성과제가 열린다. 서로를 라이벌로 여기며 만날 때마다 으르렁대는 야미와 취록의 당랑단 단장 잭 더 리퍼. 오늘 두 사람은 포장마차의 매상을 놓고 경쟁 중이다. 우연히 이 장소에 오게 된 아스타는 야미의 위협에 손님을 끌어 모아 보지만 지나가는 사람들은 눈길도 주지 않고 포장마차는 파리만 날린다.", "episode_n