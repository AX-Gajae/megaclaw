 "products": [], "episode_products": [{"id": 32766, "name": "페어리 테일 8기 10 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27335, "title": "(더빙) 페어리 테일 8기", "subject": "나츠 vs. 레오", "description": "오피우쿠스가 거대한 뱀으로 변신한 뒤, 아스트랄 스피리터스 자체가 오피우쿠스의 몸이었다는 사실이 밝혀진다. 레오는 그 안에서 리베럼을 다시 거행하려 하고 나츠와 웬디는 의식을 막기 위해 필사적으로 덤벼든다. 반드시 막으려는 나츠와 어둠의 불꽃으로 나츠를 제압하려는 레오. 팽팽했던 싸움은 레오가 나츠의 불꽃을 흡수하면서 균형이 깨지기 시작하는데...", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22857/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:56.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32732, "name": "페어리 테일 8기 11 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27336, "title": "(더빙) 페어리 테일 8기", "subject": "뱀주인자리 오피우쿠스", "description": "로키가 강제폐문 됐지만 리베럼은 끝나지 않고 오피우쿠스는 공격을 계속한다. 고전하던 루시와 유키노는 나츠의 도움으로 버르고와 리브라를 이기고 황도 12문은 결국 모두 강제 폐문 당한다. 하지만 그래도 리베럼은 끝나지 않고 오피우쿠스는 수상한 웃음을 짓는다. 나츠 일행은 오피우쿠스를 통해 리베럼에 숨겨진 진짜 진실을 알게 되는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22858/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:55.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32731, "name": "페어리 테일 8기 12 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27337, "title": "(더빙) 페어리 테일 8기", "subject": "별빛이 가득히 내려올 때", "description": "성령을 도우려 한 일이 오히려 그들을 위기에 빠트렸다는 걸 알고 나츠 일행은 큰 충격에 빠진다. 그리고 드디어 드러난 성령왕과 오피우쿠스의 계략. 모든 걸 알게 된 나츠 일행은 성령왕의 폭주를 돕는 ‘리베럼 베루스’를 막기 위해 최선을 다한다. 하지만 오피우쿠스의 힘은 너무 강력하고 리베럼 베루스는 점차 완성되어 가는데...", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22859/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:55.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32765, "name": "페어리 테일 8기 13 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27338, "title": "(더빙) 페어리 테일 8기", "subject": "성령수", "description": "드디어 나츠 일행은 오피우쿠스를 물리쳤지만 성령들은 돌아오지 않고 무시무시한 괴성과 함께 아스트랄 스피리터스가 붕괴한다. 나츠와 동료들은 성령들을 구하기 위해 이번엔 성령왕과 맞선다. 하지만 괴물처럼 변한 성령왕의 무서운 힘 앞에 나츠 일행은 속수무책으로 당하기만 한다. 성령왕은 무서운 힘을 발휘해 동료들까지 별자리로 만들어 버리는데...", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22860/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:54.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32704, "name": "페어리 테일 8기 14 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27339, "title": "(더빙) 페어리 테일 8기", "subject": "믿음", "description": "동료들까지 별자리로 변하자 성령수의 뱃속으로 뛰어든 나츠. 나츠는 그 안에서 수상한 빛에 휩싸여 사슬에 묶여 있는 성령왕을 발견한다. 성령왕은 점점 그 수상한 빛으로 끌려들어 가고 나츠는 그를 막기 위해 애쓰지만 쉽지가 않다. 한편 밖에선 엘자, 그레이, 가질, 루시가 성령수를 쓰러트리기 위해 고군분투하고 있는데...", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22861/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:02.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32713, "name": "페어리 테일 8기 15 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2015-06-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27340, "title": "(더빙) 페어리 테일 8기", "subject": "진심이 만들어 내는 것", "description": "알작과 비스카가 나츠에게 아스카를 맡기고 일을 떠났다. 웬디는 아스카를 위해 케이크를 만들기로 하고, 엘자는 케이크에 넣을 전설의 딸기를 따러 떠난다. 나츠, 루시, 해피는 아스카의 성화에 아스카와 함께 간단한 의뢰를 처리하고 그 돈으로 스노우 볼을 산다. 아스카는 부모님의 추억이 담긴 스노우 볼을 찾아서 기뻐하지만, 갑자기 나타난 도적들에게 스노우 볼을 빼앗기고 마는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22862/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:03.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32723, "name": "페어리 테일 8기 16 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2015-06-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27341, "title": "(더빙) 페어리 테일 8기", "subject": "413 DAYS", "description": "오늘은 쥬비아와 그레이가 만난 지 413일째 되는 날. 쥬비아는 오늘을 기념해 그레이에게 선물을 주기로 한다. 동료들한테 조언도 얻고, 실패도 해가며 결국 직접 짠 머플러를 선물로 준비한다. 하지만 오늘은 그레이의 스승 울의 기일이었고, 우울한 그레이는 쥬비아의 선물을 외면한다. 쥬비아는 그레이의 맘을 헤아리지 못한 자신을 탓하며 울먹이는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22863/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32688, "name": "페어리 테일 8기 17 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27342, "title": "(더빙) 페어리 테일 8기", "subject": "은백색 미궁", "description": "나츠, 루시, 해피는 ‘별꽃 아이스’를 찾아달라는 의뢰를 완수하기 위해, 별꽃 산으로 떠난다. 찾는 얼음은 보이지 않고 눈보라만 점점 더 심해지자 일단 동굴 안으로 피신한다. 생각보다 깊은 동굴 속에서 이상한 낌새를 챈 순간, 나츠 일행은 어딘가로 굴러 떨어진다. 가도 가도 끝이 없는 동굴 속, 3일 동안 한숨도 자지 못한 나츠 일행은 이상한 행동을 하기 시작하는데...", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22864/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:03.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32802, "name": "페어리 테일 8기 18 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27343, "title": "(더빙) 페어리 테일 8기", "subject": "변신!", "description": "루시는 성령들이 없을 때를 대비해서 미라젠에게 변신 마법을 배우기로 하지만, 도통 진도가 나가질 않는다. 와카바와 마카오 역시 변신 마법을 배우고 싶어서 몰래 루시의 뒤에서 따라해 보지만 별 효과가 없다. 하지만 잠시 후, 와카바와 마카오는 변신 마법의 부작용으로 악당으로 변신해서 마을을 파괴한다. 바로 그때, 정의의 히어로로 변신한 엘자가 나타나는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22865/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:03.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 32803, "name": "페어리 테일 8기 19 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2019-01-19T14:00:00.650912", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 27344, "title": "(더빙) 페어리 테일 8기", "subject": "케모케모가 왔다!", "description": "나츠는 의뢰를 처리하다 하늘에서 떨어진 알을 줍는다. 그리고 곧 알이 부활하는데 그 안에서 정체를 알 수 없는 귀여운 생물이 튀어나온다. 나츠는 ‘케모케모’라는 이름을 지어주고 키우는 법을 알아내기 위해 길드간 교환 유학생 제도에 참가한다. 가는 곳마다 케모케모에 관해 물어봤지만 아무도 아는 사람이 없다. 그렇게 돌아다니는 동안 나츠는 온갖 사고를 치게 되는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22866/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_