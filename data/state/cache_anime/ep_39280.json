annel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31399, "title": "소멸도시 [2022년 판권 만료작]", "subject": "선택", "description": "희망의 빛 양호 학원은 라쿠나 케미컬과 관련되어 있으며, 아이들은 인체 실험의 재료였다. 그에 대한 증거를 잡은 타쿠야는 동료들과 함께 라쿠나 케미컬에 맞서기로 결심한다. 하지만 정면 승부로는 승산이 없었기에 언론을 이용해 비밀을 폭로하는 방법을 선택하는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27537/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-29T00:30:00.679616", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31528, "title": "소멸도시 [2022년 판권 만료작]", "subject": "운명", "description": "유키가 태어나기 전, 유키의 아버지 다이치의 젊은 시절 이야기. 다이치는 타이요, 츠키와 함께 평행 세계에서 온 사람이었다. 조직을 이용해 인체 실험을 반복하는 타이요와 츠키, 그리고 평행 세계와 이곳을 연결하는 포털 장치를 완성하기 위해 연구에 매진하는 다이치. 하지만 어느 날부터 미후유라는 여성이 연구밖에 모르던 다이치의 마음에 조금씩 자리를 잡아갔는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27730/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-05T00:30:00.596110", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31618, "title": "소멸도시 [2022년 판권 만료작]", "subject": "결단", "description": "직접 소우마를 땅에 묻는 유키와 그런 유키를 바라보는 타쿠야. 그리고 로스트로 향할 그 두 사람의 몸이 걱정된 에이지와 키쿄는 둘에게 로스트가 인간에게 미치는 영향에 대한 진실을 밝히는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27856/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-12T15:30:00.684496", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31716, "title": "소멸도시 [2022년 판권 만료작]", "subject": "신뢰", "description": "서로의 결의를 확인한 타쿠야와 유키는 드디어 로스트로 향한다. 파동성 물질의 영향을 받아도 두 사람이 기억을 계속 유지할 수 있도록 긱과 모두는 외부에서 지원할 수 있는 방법을 찾는다. 한편, 타이요 역시 다이치가 로스트 내부에 있다고 확신하며 결판을 내기 위해 로스트에 가기로 하는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/28103/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-19T00:30:00.735728", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31759, "title": "소멸도시 [2022년 판권 만료작]", "subject": "미래", "description": "서로를 인식하며 겨우 의지를 유지하고 있는 타쿠야와 유키. 가장 깊은 곳에서 로스트의 확장을 막고 있던 다이치와 그와 대치하는 타이요. 다이치가 유키에게 보낸 메시지에 담긴 진짜 의미는 무엇일까. 로스트에 휘말린 수많은 사람들과 현재를 살아가고 있는 모든 이들을 위해 유키는 결단을 내리는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnai