 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/07/49784/v15/Thumbnail.0000031.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:14", "progressbar": null, "item_expire_datetime": "2024-01-16T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2021-08-23T20:00:00.049889", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49164, "title": "크리켓팡 [2024년 판권 만료작]", "subject": "도전! 신기록", "description": "무엇이든 잘하는 것이 있다면 캐쉬의 신기록 노트에 기록이 된다. \r\n기록을 세우기 위해 서로 선의의 경쟁을 하는데, 리키가 반칙을해서 올리버가 크게 삐지고 만다.\r\n과연 리키는 올리버의 마음을 풀어줄수 있을까?", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/07/50114/v15/Thumbnail.0000031.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:14.300000", "progressbar": null, "item_expire_datetime": "2024-01-16T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2021-08-23T20:00:00.049889", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 49165, "title": "크리켓팡 [2024년 판권 만료작]", "subject": "우리 모두 깡총", "description": "다같이 단체줄넘기를 하면서 재미있게  놀고 있는데,  키가 큰 올리버는 어쩔 수 없이 계속 줄만 빙빙 돌려 심심해 한다.\r\n그러자 키차이가 많이 나도 같이 신나게 줄 넘기를 할 수 있는 방법에 대해 고민한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/07/50115/v15/Thumbnail.0000031.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:13:14.300000", "progressbar": null, "item_expire_datetime": "2024-01-16T23:30:00", "in_app_download": true, "is