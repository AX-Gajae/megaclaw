nail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:44.966000", "progressbar": null, "item_expire_datetime": "2024-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-11-11T00:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24742, "title": "벨제붑 아가씨의 뜻대로 [2024년 판권 만료작]", "subject": "9cm만큼... / 각하의 비밀", "description": "벨제붑은 뮤린과 일하러 가던 도중에 힐이 부러지고 만다. 그래서 벨제붑의 의상 담당인 아드라멜레크가 고쳐주기로 하고 그녀는 당분간 슬리퍼를 신고 있기로 한다. 그 모습을 본 뮤린이 낮은 신발을 신어도 괜찮다고 하자 벨제붑은 싫다고 한다. 그녀가 높은 힐을 고집하는 이유는 따로 있었는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20099/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.966000", "progressbar": null, "item_expire_datetime": "2024-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-11-18T00:30:00", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24743, "title": "벨제붑 아가씨의 뜻대로 [2024년 판권 만료작]", "subject": "판데모 욕탕은 좋은 곳이니 한번 오세요 / 좀 더 알고 싶은데…", "description": "벨제붑은 직원들이 운동부족이라는 말을 듣고 헬스장을 만들기로 한다. 그런데 며칠 후 헬스장이 있어야 할 자리에 욕탕이 생겨서 사람들은 어리둥절해 한다. 그건 다름 아닌 판데모니움의 재무대신인 아스타로트가 벌인 일이었다. 벨제붑은 이미 만들어 버린 건 어쩔 수 없다며 다 같이 욕탕에 들어가자고 한다. 그러자 아스타로트의 눈이 반짝이기 시작하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/20102/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.033000", "progressbar": null, "i