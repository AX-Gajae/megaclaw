": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5460, "name": "로그 호라이즌 2기 4 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:32:23.695055", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2014-10-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3500, "title": "로그 호라이즌 2기", "subject": "크리스마스 이브 ", "description": "아키바 거리에 나타난 그 남자는 위병의 강력한 장비를 가지고 모험가들을 차례로 죽여 갔다. 이 범인의 정체는 도시의 경호를 책임져야 할 대지인인 쿠니에 일족의 남자, 네루레스이었다. 대지인의 공주로서 있을 수 없는 사태에 충격을 받는 레이네시아. 그리고 고민하는 그녀에게 다가서는 아카츠키는 혼자 크리스마스이브의 거리에 뛰어 나간다. 그 시기 니시카제 여단의 정찰대가 드디어 네루레스와 만나게 된다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3028/v1/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:35", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 5461, "name": "로그 호라이즌 2기 5 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-24T23:32:23.726297", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2014-11-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3501, "title": "로그 호라이즌 2기", "subject": "새벽의 미아", "description": "크리스마스이브의 밤, 폭주한 위병인 네루레스의 흉인에 쓰러지는 아카츠키. 그리고 정신 차린 아카츠키 눈에 들어온 것은 현실 세계의 시부야 역 앞에서 붐비는 사람들이었다. 무엇인가로부터 도망가듯이 거리를 떠도는 아카츠키는 다음 순간, 빛에 휩싸여 조용한 모래사장으로 전이한다. 아득히 멀리 지구를 바라보는 달의 해변. 거기에 시로에가 있었다. 북쪽으로 여행을 떠났던 시로에도 같은 밤, 어디에선가 목숨을 잃었던 것이다. ", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3029/v1/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:35", 