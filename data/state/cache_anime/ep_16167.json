iewing": true, "products": [], "episode_products": [{"id": 76293, "name": "신의 괴도 잔느 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76292, "name": "신의 괴도 잔느 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-09-07T19:00:08.531819", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "9colors", "broadcast_date": "2022-05-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56421, "title": "신의 괴도 잔느", "subject": "첫 키스는 달빛에 빛나다!", "description": "어느 날 아침, 마론의 집 초인종이 울린다. 문을 여니 미야코가 인형을 보여주고 유치원에서 인형극을 할 테니 마론에게도 도와달라고 한다. 인형극은 바로 빨간 모자 이야기. 하지만 미야코가 적은 대본은 왠지 백설공주처럼 끝이 나는 이상한 스토리이다. 그리고 모모쿠리 유치원에서의 공연 중, 토라져 있던 유치원생 켄이치가 자리에서 뛰쳐나와 인형을 빼앗아 망가트리고 만다. 원래는 착한 아이인데 일주일 정도 전부터 이상하다는 선생님이 말을 하고, 원장은 가정에서 무슨 일이라도 있지 않을까 걱정하던 참이라고 했다. 켄이치가 신경 쓰인 마론은 켄이치의 엄마가 악마에 씐 것을 확인하고 켄이치와 엄마를 되돌려주겠다는 약속을 하는데, 과연 약속을 지킬 수 있을까?", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/104351/v30/535e17e9f780/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:58.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 76291, "name": "신의 괴도 잔느 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76290, "name": "신의 괴도 잔느 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-09-07T19:00:08.531819", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "9colors", "broadcast_date": "2022-05-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56422, "title": "신의 괴도 잔느", "subject": "급 접근! 사랑의 허리케인 상륙", "description": "신밧드에게 키스를 당한 마론. 마왕의 앞잡이인 신밧드가 마론에게 괴도를 그만두게 하고 싶다는 건 경쟁자를 없애기 위한 술책이 틀림