5/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72593, "name": "마법사의 여명기 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72592, "name": "마법사의 여명기 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-05T01:00:00.670556", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54449, "title": "마법사의 여명기", "subject": "적합한지는 스스로 정한다", "description": "붙잡힌 홀트를 구출하기 위해 동굴 안으로 돌입한 세빌과 로스. 그곳에서 두 사람을 기다리고 있던 건, 세빌의 기억 속에 희미하게 남아 있던 암흑 진창의 마녀였다. 그녀는 세빌에게 너는 특별한 존재라면서 무서울 정도로 집착을 보였고, 마을을 습격한 것도 그를 위해서였다고 말했다. 자신 때문에 소중한 동료들이 상처 입은 걸 알게 되어 분노하는 세빌. 로스와 함께 그 마녀에게 맞섰으나, 그 장소에서 특별 실습에 관련해 숨겨진 진실이 밝혀졌는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57560/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72769, "name": "마법사의 여명기 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72768, "name": "마법사의 여명기 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-12T01:00:00.131925", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54568, "title": "마법사의 여명기", "subject": "무지의 지", "description": "실습 장소에서의 시험에 훌륭하게 합격한 세빌, 홀트 그리고 쿠도. 암흑 진창의 마녀인 제로의 지도 아래 새롭게 특별 실습이 시작되었다. 새로운 과제는 마법을 사용한 일로 마을에 공헌하는 것. 홀트는 심부름센터를 개업했고 쿠도는 진료소에서 일하는 가운데, 세빌은 마력을 공급해주는 일을 시작했지만 가게에 틀어박혀 거의 나오는 일이 없었다. 그러한 상황을 우려한 로스는 일부러 일거리를 맡겨 세빌을 밖으로 내보냈는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57727/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72942, "name": "마법사의 여명기 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72941, "name": "마법사의 여명기 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-19T01:00:00.101092", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54852, "title": "마법사의 여명기", "subject": "난 아무것도 구할 수 없어", "description": "마법을 동료에게 맞혀버린 홀트와 치료 중 마력 고갈로 쓰러져 버린 쿠도. 이에 풀이 죽은 둘은 더욱 성장하기 위해 제로에게 상담을 받으러 갔다. 하지만 어디까지나 마력 가게 사람으로서의 행동만 하던 세빌은, 제로에게 '마법사를 목표로 하는 것이 아니라면 네가 이 마을에서 배울 것은 아무것도 없다'라고 엄한 말을 듣고 말았다. 세빌이 자신이 나아갈 길에 대해 고민하는 가운데, 라이오스와 함께 간 숲에서 위험에 직면하게 되었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58043/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 73330, "name": "마법사의 여명기 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 73329, "name": "마법사의 여명기 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_dat