ccess_info_list": [], "running_time": "0:23:40.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.841119", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-10T10:09:23.545167", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11787, "title": "성각의 용기사 [2019년 판권 만료작]", "subject": "청의 브류나크", "description": "교회에 있던 사람들을 인질로 잡고 베로니카의 목을 내놓으라는 테러리스트, 단죄의 아브도차.\n그러나 베로니카는 그런 협박에 굴복하지 않겠다며 오히려 공격태세에 들어가는데...\n상의 끝에, 애쉬가 교섭인으로 아브도차에게 다가간다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9913/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.841119", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-10T10:09:23.709362", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11788, "title": "성각의 용기사 [2019년 판권 만료작]", "subject": "루카 사리넨", "description": "엘리트 코스라고 불리는 합숙에 이례적으로 선발된 애쉬는 레베카를 찾아가 이유를 묻는다.\n한편, 이번 합숙의 또 다른 선발 멤버이자 사상 최연소 드래고너인 루카 사리넨은 어떤 고민을 안고 있었는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9915/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:40.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.841119", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "publis