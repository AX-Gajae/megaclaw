on": null}], "published_datetime": "2026-04-21T00:00:28.447574", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2016-02-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93561, "title": "(더빙) 가면라이더 드라이브", "subject": "강소란이 안절부절못하는 이유는 무엇인가", "description": "여성들한테 사기를 쳐서 전 재산을 갈취한다는 것과, 로이뮤드일 것이라는 혐의를 받고 있는 안기훈. 물증을 잡기 위해 전진과 수현은 그가 개최하는 회원 전용 이벤트에 참가한다. 하지만 연회장 어디에서도 중가속 입자 반응은 나타나지 않고, 갑자기 들린 체이스의 목소리를 따라 수현은 회장 밖으로 나간다. 그곳에서 안기훈이 변한 보이스 로이뮤드와 맞닥뜨리고, 그의 정체와 범행 수법을 알아낸다. 최후의 일격을 가하려는 그때 하트 로이뮤드가 나타나 방해하고, 하는 수없이 전진은 아직 미완성인 시프트 카, 데드 히트를 사용한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105681/v30/99523b2b8210/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:59.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132636, "name": "(더빙) 가면라이더 드라이브 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-21T00:00:28.644664", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2016-02-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93562, "title": "(더빙) 가면라이더 드라이브", "subject": "데드 히트를 이겨내는 자는 누구인가", "description": "소란은 자신의 전 애인으로 행방불명된 지성을 찾아 제 발로 로이뮤드를 따라간다. 그곳에서 지성을 만나지만 그는 자신의 지식을 이용해서 로이뮤드와 손을 잡은 범죄자였다. 보이스 로이뮤드는 자신의 목소리로 홀린 피해자들을 방패삼아 드라이브와 마하를 상대한다. 그때 벨트 씨의 스승, 할리 핸드릭슨이 나타나 최종점검이 끝난 데드 히트를 마하에게 주고, 마하는 데드 히트를 써서 보이스 로이뮤드를 물리친다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105682/v30/4fa0ab00773c/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:59.100000",