ification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2024-04-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77149, "title": "다이노스터 공룡수호대 시즌 2", "subject": "긴급 미션! 아기 공룡 돌보기", "description": "트리나가 다이노스터에게 벡스의 계획을 알려준다. 그가 다이노어스의 퀀텀 코어보다 높은 파장으로 진동하는 지구의 퀀텀 코어를 찾는 중인데, 그의 손에 들어가면 아주 위험하단 것이다. 트리나는 벡스를 막기 위해, 어서 퀀텀 코어를 찾으려 하지만, 로라 박사는 트리나와 팀원들에게 다른 임무를 준다. 박사가 카페에 아기 공룡들을 위한 새 집을 만들 동안 산장에서 아기 공룡들을 돌봐달라는 것이다. 트리나는 주저하지만, 다이노스터는 트리나가 있어 다행이라 생각한다. 벡스가 보낸 밀렵꾼들이 분신술이 가능한 테크노 오르니토미무스와 함께 일행을 공격하기 때문이다. 아기 공룡들을 보호하려면 온갖 도움이 다 필요할 것이다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85712/v30/bf184262a402/Thumbnail.0000030.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:47.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109617, "name": "다이노스터 공룡수호대 시즌 2 12 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-09-09T00:00:13.260774", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "EBS", "broadcast_date": "2024-04-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 77150, "title": "다이노스터 공룡수호대 시즌 2", "subject": "산사우리오 공룡 대전!", "description": "델비는 서둘라 멤버들을 이끌고 지구의 잃어버린 퀀텀 코어를 찾으러 떠난다. 하지만 남자 아이들에게는 쉬어가는 시간이 필요하다! 루시오는 TV를 보고, 오즈는 제이민의 비디오 게임 실력을 보며 감탄하고 있다. 그때 TV에서 청소년 비디오 게임 대회 광고가 나오고, 멤버들은 대회 트로피가 퀀텀 코어와 똑같이 생긴 것을 보고 깜짝 놀란다! 아이들은 반드시 대회에서 이겨서 트로피를 가져와야 한다! 하지만 한 가지 걱정은 최고의 게이머가 너무 긴장한다는 것이다. 긴장을 너무 많이 하는 제이민이 대회에서 우승할 리가 없다! 그리고 빅 다이슨이 대회에서 우승하기 위해 반칙을 쓰고, 테크노 스텔라사우루스의 도움까지 받는다!", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85713/v30/44a073949ec3/Thumbnail.0000030.jpg", "has_preview": true, "access_info_list": [], 