ogressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98529, "name": "라그나 크림슨 part 2 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98528, "name": "라그나 크림슨 part 2 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-05T16:00:10.004410", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-02-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68864, "title": "라그나 크림슨 part 2", "subject": "전우", "description": "은장병단의 반격으로 궁지에 몰린 타라텍트라는 다시 나타난 라그나의 치명적인 일격 앞에 마지막 힘을 쥐어짜서 대항했다. 판단를 그르쳐 전우를 위기에 빠트렸다며 자책하는 오르토 졸라. 그 모습을 본 타라텍트라는 그와 함께 싸웠던 옛날 기억을 떠올리면서 눈앞의 전장에서 승리하기 위한 각오를 졸라에게 말한다. 전우의 마음을 받아들이고 자신의 사명을 자각한 졸라는 지휘관으로서 비정한 판단을 내리는데.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76637/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98830, "name": "라그나 크림슨 part 2 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98829, "name": "라그나 크림슨 part 2 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-12T18:00:07.856584", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-02-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69233, "title": "라그나 크림슨 part 2", "subject": "사투의 끝", "description": "볼테카무이에게 완전히 패배한 라그나였지만 다행히 전위 마법으로 목숨을 구했다. 절망한 가운데 카무이에게 목이 잘렸을 터인 스탈리아와 정신 세계에서 만난 라그나는 그녀가 완수하고 싶어 하는 일이 있다는 것을 알게 되고 그녀의 생존을 확신했다. 한편, 스탈리아를 잃고 무거운 분위기에 휩싸인 은장병단의 앞에 알테마티아와 같은 용모를 가진 성녀 카루라가 나타났는데.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76812/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99208, "name": "라그나 크림슨 part 2 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99207, "name": "라그나 크림슨 part 2 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-19T13:30:08.349738", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-02-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69323, "title": "라그나 크림슨 part 2", "subject": "싸우는 이유", "description": "크림슨이 수복한 지구의 안에서 상처를 치료하고 완쾌한 라그나. 이번에야말로 날개의 혈족을 없애고 스탈리아를 구하기 위해 크림슨에게 도움을 요청한다. 하지만 압도적인 힘을 가진 카무이와 알테마티아의 시간 조작 마법 앞에서 현재 상태로는 승산이 없다고 생각한 크림슨은 라그나의 요청을 거절한다. 대신에 자신의 계획을 따르도록 라그나에게 지시했지만, 스탈리아와 은장병단의 멤버들과의 관계 속에서 자신이 싸우는 이유를 발견한 라그나는, 크림슨의 지시를 거부했는데.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/77152/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99471, "name": "라그나 크림슨 part 2 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99470, "name": "라그나 크림슨 part 2 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-26T14:00:09.761490", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "