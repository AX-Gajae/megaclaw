": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5402, "title": "내가 인기 있어서 어쩌자는거야 [2019년 판권 만료작]", "subject": "내가 인기 있어서 어쩌자는 거야", "description": "4인방과 시마는 세리누마에게 고백하려는 무츠미를 방해하지만 곧 무츠미와 함께 자신들의 마음을 고백한다. 고민하던 세리누마는 데이트 후에 고백에 대한 답을 하기로 하고 한 명씩 데이트를 하지만 고민은 더욱 깊어간다. 대답을 기다리는 모두에게 세리누마는 자신의 특별한 사람에 대해 말하는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4448/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.100000", "progressbar": null, "item_expire_datetime": "2019-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-15T21:18:30.838527", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}