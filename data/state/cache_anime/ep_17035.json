ion_number": "", "broadcast_channel_name": "K.net", "broadcast_date": "2022-02-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55476, "title": "은아전설 위드", "subject": "준동하는 칼날", "description": "새로운 동료들을 찾아 기슈에 도착한 위드 일행은 갑자기 들개 사냥꾼들의 총탄 공격을 받게 된다. 그것은 빈고 지역에서 온 흉견 카마키리의 비열한 함정이었다. 절체절명의 궁지에 몰린 위드를 구해낸 것은 자기 목숨도 돌아보지 않고 구하려는 한 남자 바로 제롬이었다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58553/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:56.733000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74405, "name": "은아전설 위드 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 74404, "name": "은아전설 위드 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-07-13T22:00:00.147637", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "K.net", "broadcast_date": "2022-02-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55477, "title": "은아전설 위드", "subject": "절 천랑발도아", "description": "총탄에 맞아 절벽으로 떨어진 제롬을 찾아다니다가 어떤 계곡 온천에 다다른 위드 일행. 거기서 기다리고 있었던 것은 온천에서 상처를 치유하던 제롬과 코가의 닌자견 텟신이었다. 남 알프스에 다녀온 텟신으로부터 위드에게 전해진 것! 그것은 불변의 의지를 가지고 정의를 관철하려는 아버지의 뜨거운 말과 아버지의 필살기 ‘절 천랑발도아’였다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58554/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:56.566000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74403, "name": "은아전설 위드 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 74402, "name": "은아전설 위드 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-07-13T22:00:00.147637", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "K.net", "broadcast_date": "2022-02-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55478, "title": "은아전설 위드", "subject": "결별", "description": "온천에 몸을 담그며 심신이 치유된 오우 군은 텟신을 동료로 맞이하고, 남 알프스로 진군하기 시작했다. 호겐의 아지트 근처까지 다다른 그때, 위드 일행을 지켜보는 2개의 그림자. 그것은 위드와 쿄시로 암살에 실패했던 킬러 렉터와 썬더 형제였다. 또다시 위드 일행의 목을 베려고 노리는 킬러. 그들의 처우를 둘러싸고 오우 군의 유대에 균열이 가기 시작하는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/06/58555/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:56.600000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 74401, "name": "은아전설 위드 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 74400, "name": "은아전설 위드 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-07-13T22:00:00.147637", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "K.net", "broadcast_date": "2022-02-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 55479, "title": "은아전설 위드", "subject": "눈 위의 사투", "description": "멜로부터 결전의 장은 오우가 될 것이라고 전해들은 위드 일행. 그러나 오우에 도착한 위드 일행을 기다리고 있던 것은 겐바와 토베이가 이끄는 침략군이었다. 형제들의 원수를 갚겠다고 불타오르는 시구레와 무츠의 6형제 그리고 카마키리 군대까지 합세하여 쌍둥이 고개에서 결전이 시작된다!", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/07/58810/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:56.866000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_a