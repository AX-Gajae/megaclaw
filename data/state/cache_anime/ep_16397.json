ccess_type": null, "is_available": false}, {"id": 18471, "title": "이니셜 D Second Stage", "subject": "패배의 예감", "description": "쿄이치의 작전 지시를 무시하고 너무 일찍 86을 제쳐 버린 세이지의 란에보IV.\n타쿠미의 86은 차의 성능 차이를 절감하면서도 꾸역꾸역 란에보를 쫓아간다.\n그리고 레이스가 후반으로 접어들수록 앞서 있는 세이지는 왠지 모를 불만과 조바심을 느끼게 되는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15454/v4/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15823, "name": "이니셜 D Second Stage 3 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-16T16:15:21.295037", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18472, "title": "이니셜 D Second Stage", "subject": "불타오르지 않는 승리", "description": "결국 막판에 세이지의 란에보IV를 제치며 란에보 군단에게 군마 첫 패배를 선사한 타쿠미.\n하지만 타쿠미는 그 승리에 취할 여유가 없었다.\n지금 타쿠미의 신경은 학교 신발장에서 발견한 정체불명의 편지에 쏠려 있었기에…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15455/v4/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:52.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15824, "name": "이니셜 D Second Stage 4 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-16T16:15:21.424769", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18473, "title": "이니셜 D Second Stage", "subject": "파멸을 향한 카운트다운", "description": "여자친구라고 생각했던 나츠키의 외도에 분노한 타쿠미는 아카기로 스도 쿄이치를 찾아가 배틀을 건다.\n아키나보다 경사도 급하고 초행길인 아키나에서의 슈퍼 머신 란에보와의 대결.\n승리할 수 있는 요소가 단 하나도 없지만 분노로 가득찬 타쿠미에게는 그런 건 아무런 장애물도 되지 않았다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15456/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:15", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15825, "name": "이니셜 D Second Stage 5 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-16T16:15:21.563502", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18474, "title": "이니셜 D Second Stage", "subject": "굿바이, 86", "description": "란에보에게 추월당한 이후 놀라운 페이스를 보여주면서 악착같이 란에보를 쫓아가는 타쿠미와 86.\r하지만 그 주행은 낡은 86의 한계를 한참 뛰어넘는 가혹한 페이스였다.\r한편 분타는 드디어 그 날이 온 것 같다는 예감에 사로잡히는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15457/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:17", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15836, "name": "이니셜 D Second Stage 6 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-17T20:01:59.488632", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18475, "title": "이니셜 D Second Stage", "subject": "아카기 배틀, 백과 흑의 섬광!", "description": "아키나의 86이 패배하면서 군마의 마지막 보루가 된 타카하시 료스케와 FC.\r그 결전의 날이 밝았지만, 86을 잃은 타쿠미는 거기에 신경쓸 겨를조차도 없어 보였다.\r한편 1년 전의 패배를 설욕하기 위해 칼을 갈아온 스도 쿄이치는 기어이 아키나에서 타카하시 료스케의 FC를 제치고 만다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15458/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:17", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15838, "name": "이니셜 D Second Stage 7 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-18T10:16:30.823289", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18476, "title": "이니셜 D Second Stage", "subject": "그 차, 흉폭해지다", "description": "카운터 공격으로 완전히 리드를 빼앗긴 타카하시 료스케는 악착같이 란에보III를 쫓아가며 기회를 노린다.\r하지만 둘의 대결을 지켜보는 사람들은 하나같이 절망적이라는 결론에 도달하고 있었는데…\r그럼에도 타카하시 료스케는 단 하나, 스도의 란에보III의 약점을 간파하고 있었다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15459/v4/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:17", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15849, "name": "이니셜 D Second Stage 8 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2018-01-16T11:49:36.012441", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2018-01-19", "rating_components": []}, "access_type": null, "is_available": false}, {"