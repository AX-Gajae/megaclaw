": "https://thumbnail.laftel.net/assets/2025/08/97268/v30/f68dee8f4fb1/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 122072, "name": "안녕! 틴틴팅클 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-08-28T00:00:10.799659", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-08-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85281, "title": "안녕! 틴틴팅클", "subject": "목욕탕, 공중전화, 눈물의 초밥", "description": "[목욕탕] 친구와 처음 오는 목욕탕! 틴틴이와 같이 씻고 냉탕열탕 대결도 하고 마무리는 역시 식혜지!\r\n[공중전화] 틴틴이와 신나게 놀다보니 어느 덧 헤어질 시간… 조금 더 놀고싶은데? 엄마에게 연락하기 위해 임시방편으로 콜렉트콜을 이용해보기로 한다.\r\n[눈물의 초밥] 다음 날 점심에 초밥을 먹기로 한 미니와 베리. 신난 미니는 일찍 잠들지만 핸드폰 삼매경인 베리는 그만 늦잠을 자버리고 마는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/97638/v30/1e2bfd9e57b7/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 122359, "name": "안녕! 틴틴팅클 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-09-04T00:00:10.360542", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-09-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85282, "title": "안녕! 틴틴팅클", "subject": "가치, 놀림, 기름기", "description": "[가치] 1등만을 노리는 석기는 항상 성적 스트레스에 시달리고 있다. 쉬는 시간에 떠드는 것조차 용납하지 못하는데…\r\n[놀림] 먹는 걸 좋아하는 마로! 하지만 그런 마로를 뚱뚱하다며 놀리는 아이들.. 맛있는 걸 좋아하는 것 뿐인데 마로는 상처를 입고 만다.\r\n[기름기] 콩물이의 오래된 집에서는 따뜻한 물이 나오지 않아 콩물이가 씻을 수 있는 날이 많지 않다. 기름기 넘치는 머리를 지적한 친구에게 욱하고 만 콩물이는 따뜻한 물이 나오지 않는 집을 탓하며 우울해한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/97945/v30/bd27e644a3eb/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 122637, "name": "안녕! 틴틴팅클 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-09-11T00:00:10.152209", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-09-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85283, "title": "안녕! 틴틴팅클", "subject": "놀이터 흙, 다툼, 끝말잇기", "description": "[놀이터 흙] 땅을 파봐라! 500원이 나오나! 엄마의 잔소리에 바로 놀이터로 달려가 흙을 파는 팅클이. 과연 놀이터에서 500원을 찾아낼 수 있을까?\r\n[다툼] 여느 때 처럼 틴틴이에게 장난을 치는 팅클이. 하지만 장난이 과했을까? 틴틴이가 욱하는 마음에 팅클이에게 화를 내 버린다. 팅클이의 당황한 얼굴에 깜짝 놀란 틴틴이는 자리를 도망쳐버리는데…\r\n[끝말잇기] 심심한 베리가 미니에게 장난을 걸며 끝말잇기를 하자고 제시한다. 언니랑 노는 게 제일 즐거운 미니는 그런 베리의 술수에 빠지고 마는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98171/v30/1673710f80fb/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:21.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 122995, "name": "안녕! 틴틴팅클 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-09-18T00:00:11.266435", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-09-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85284, "title": "안녕! 틴틴팅클", "subject": "이뽑기, 색종이, 아침밥", "description": "[이 뽑기] 유치가 빠질려고 하는 팅클이. 저번에 아빠가 뽑아줬다가 너무 아팠던 안 좋은 기억이 있어 이번에는 혼자 빼보려고 도전을 한다.\r\n[색종이] 하트를 접어보는 시간! 마음처럼 잘 안접혀지는 색종이에 틴틴이는 우울해하지만 손재주가 좋은 콩물이가 틴틴이를 도와주게 되자 반아이들의 인기쟁이가 된다.\r\n[아침밥] 아침부터 밥을 해서 시끄러운 소리를 내시는 할머니. 소음에 결국 일어난 콩물이는 할머니가 맨밥에 물을 말아먹고 계신 걸 보게 된다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98548/v30/2f4fa593d868/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 123421, "name": "안녕! 틴틴팅클 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-09-25T00:00:10.243233", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-09-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85285, "title": "안녕! 틴틴팅클", "subject": "조퇴, 타임캡슐, 언니친구", "description": "[조퇴] 운동장에서 오래달리기를 하고 있는 아이들. 선천적으로 몸이 약한 틴틴이는 달리기를 하던 중 쓰러지고 만다.\r\n[타임캡슐] 틴틴이와 팅클이가 동네 놀이터에 타임캡슐을 숨기기로 한다. 틴틴이가 아주 소중한 것을 넣었다고 하자 팅클이는 엄청나게 궁금해지는데…\r\n[언니친구] 베리 언니가 처음으로 집에 데려온 친구! 얼마나 재밌게 노는 지 미니는 베리와 언니 친구 사이에 껴들고만 싶다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98700/v30/0375e3f37493/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:17.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 123592, "name": "안녕! 틴틴팅클 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-02T00:00:14.092236", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-10-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85286, "title": "안녕! 틴틴팅클", "subject": "다이어트, 생신선물, 모기", "description": "[다이어트] 소아비만인 아이들을 따로 부르자 충격을 받은 마로, 오늘부터 다이어트다! 하지만 세상엔 먹을 것들이 너무 많아~!\r\n[생신 선물] 오늘은 팅클이 엄마 코코의 생일 날! 엄마에게 멋진 선물을 하고 싶은 팅클이는 틴틴이와 함께 선물을 직접 제작한다.\r\n[모기] 더운 여름 날, 콩물이의 온 몸이 모기에게 물린 사태가 일어난다. 걱정이 된 할머니는 시내에 나가 콩물이를 위한 모기 퇴치 물건을 사주기로 결심한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99112/v30/d1f476948d2a/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:20.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124018, "name": "안녕! 틴틴팅클 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-16T00:00:10.545589", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-10-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85287, "title": "안녕! 틴틴팅클", "subject": "마트, 벌, 말싸움", "description": "[마트] 엄마와 마트에 온 팅클이. 양파를 사는 것을 잊은 엄마가 팅클이에게 카트를 맡겨둔 채 자리를 나선다. 안돼~ 곧 결제해야한다구~!\r\n[벌] 심심한 수업시간. 열어둔 창문에서 벌이 들어오고 교실은 아수라장이 된다.\r\n[말싸움] 언니에게 멋있는 모습을 보여주고 싶었던 미니는 베리의 귀찮음에 상처를 받는다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99113/v30/4e1a5fcaed82/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124019, "name": "안녕! 틴틴팅클 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-16T00:00:10.821252", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-10-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85288, "title": "안녕! 틴틴팅클", "subject": "토, 편식, 게임기", "description": "[토] 속이 안좋은 팅클이. 결국 아이들 앞에서 토를 하고 만다. 아이들의 웅성거림에 패닉이 오게 되는데…\r\n[편식] 콩! 세상에서 제일 싫은 콩! 하지만 콩을 안먹으면 지옥에서 다 먹게 된다고?! 그건 싫어~\r\n[게임기] 요즘 인기인 게임기를 들고 온 꾀돌이. 콩물이는 꼭 해보고 싶었지만 꾀돌이의 변덕에 체험을 하지 못하게 된다. 그 모습을 틴틴이가 보게 되는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99340/v30/11a01a91ee46/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:15.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124279, "name": "안녕! 틴틴팅클 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-23T00:00:10.777364", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-10-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85289, "title": "안녕! 틴틴팅클", "subject": "화장실 괴담, 캐릭터 만들기, 동생", "description": "[화장실 괴담] 너네 .. 그거 알아? 화장실에 오래 있으면 귀신이 널 찾아온다고!! 귀신을 믿지 않는 팅클이. 하지만 괜시리 오싹하다…\r\n[캐릭터 만들기] 노트에 RPG 게임을 만들어 노는 팅클이와 틴틴이. 근데 어라? 팅클이 캐릭터만 멋있는 것 같다.\r\n[동생] 오늘은 미니 없이 아이들과 놀고싶어… 베리는 미니를 두고 친구들을 선택하지만 이내 후회하고 만다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99590/v30/d3440a1e35c6/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:17.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124783, "name": "안녕! 틴틴팅클 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-30T00:00:10.289406", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-10-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85290, "title": "안녕! 틴틴팅클", "subject": "입원, 복도 인사, 아이스크림 케이크", "description": "[입원] 몸이 약한 틴틴이는 주기적으로 입원하게 된다. 병원은 심심해.. 하지만! 그런 틴틴이를 병문안 온 친구들이 있다.\r\n[복도 인사] 팅클이를 짝사랑하고 있는 멍물이. 아니! 팅클이가 나에게 인사하잖아~! 어쩌면 좋아! \r\n[아이스크림 케이크] 곧 다가오는 콩물이 생일! 아이스크림 케이크가 탐나지만 이내 가격을 보고 포기하고 만다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/99818/v30/d7cb21142258/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:16.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125065, "name": "안녕! 틴틴팅클 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-11-06T00:00:11.950748", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2025-11-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85291, "title": "안녕! 틴틴팅클", "subject": "버스, 교환일기, 베리의 하루", "description": "[버스] 콩물이의 집으로 놀러가는 날! 하지만 버스를 혼자 타는 건 처음인 틴틴이… 걱정이 천근만근이다.\r\n[교환일기] 요즘 인기인 교환일기 다이어리! 틴틴이는 팅클이와 교환일기를 하고 싶다.\r\n[베리의 하루] 미니가 없는 베리의 하루. 평소에는 귀찮았던 미니가 없자 베리는 매우 심심해 진다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100279/v30/30f9847959a4/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:19.966000", "pro