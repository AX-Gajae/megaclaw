l_path": "https://thumbnail.laftel.net/assets/2023/12/74683/v15/Thumbnail.0000046.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:19:12.600000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97048, "name": "RWBY vol.6 - 영어 11 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-23T16:00:09.179245", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-12-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67643, "title": "RWBY vol.6 - 영어", "subject": "분노의 폭발", "description": "코르도빈의 로봇을 상대하기 위해 약점을 찾는 루비와 팀은 결국 미사일 발사대를 망가트리는 데 성공하고, 양과 블레이크는 결국 아담을 해치운다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74684/v15/Thumbnail.0000041.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:17:18.800000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97047, "name": "RWBY vol.6 - 영어 12 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-23T16:00:09.179245", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-12-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67644, "title": "RWBY vol.6 - 영어", "subject": "우리의 길", "description": "아틀라스의 로봇을 해치우자마자 바다에서 나타난 그림이 아르거스로 향한다. 아르거스의 방어막까지 뚫리자 루비 팀은 아틀라스로 갈 수 있는 기회를 포기하고 그림에 맞선다. 루비는 칼라베라와 얘기했던 은안의 힘을 생각하며 그림을 상대하고, 결국 석화에 성공하지만 마지막에 등장한 코르도빈이 그림을 해치운다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74687/v1