ccess_type": null, "is_available": false}, {"id": 18993, "title": "요르문간드 1기 [2025년 판권 만료작]", "subject": "멸망의 언덕 2", "description": "발메와 요나가 빠진 상태로 암살자들을 마주치게 된 코코 일행. 허를 찔려 전에 없던 위험에 빠지게 된다. 한편 동반하던 요나도 제쳐두고 혈혈단신으로 적지에 뛰어든 발메는 적들을 쓰러뜨리는 듯 보였으나 적의 작전에 휘말려 저격 포인트에 몰리게 된다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15629/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:07.466000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-02-04T12:41:11.724927", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2012-07-27", "rating_components": []}, "access_type": null, "is_available": false}]}