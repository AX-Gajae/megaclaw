_path": "https://thumbnail.laftel.net/assets/2018/12/15622/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:12.033000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-02-04T12:41:10.845069", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2012-06-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18987, "title": "요르문간드 1기 [2025년 판권 만료작]", "subject": "아프리카 골든 버터플라이 phase.1", "description": "바닷길로 이동중이던 코코 일행은 도중에 해적에게 납치되면서도 남아프리카로 향한다. 한편 항구의 무역회사에서도 누군가 남아프리카로 향한다. 도착한 코코는 이곳에 온 목적인 닥터 마이애미를 만나러 간다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15623/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.400000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-02-04T12:41:10.969010", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2012-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18988, "title": "요르문간드 1기 [2025년 판권 만료작]", "subject": "아프리카 골든 버터플라이 phase.2", "description": "아마다 미나미 박사를 쫓아 눈 덮인 산지에 들어간 요나일행. 첸의 부하 카렌로우가 사용하는 전투방법에서, 과거의 전투에서 자신의 부대를 전멸시킨 자의 모습을 보게된 발메는 그 자의 정체를 알아내기 위해 싸움을 건다. 한편 거리에 남은 코코는 첸과의 회동에서 박사를 놓고 대치하게 된다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15624/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:08.733000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-02-04T12:41:11.097028", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2012-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18989, "title": "요르문간드 1기 [2025년 판권 만료작]", "subject": "몽드 그로소", "description": "무인항공기 도입을 꾀하던 B국에 판매를 시도하는 코코. 하지만 판매처에 있던 것은 전직 여배우인 무기 브로커 아마리아 토로호브스키였다. 그 이후 코코가 가는 곳마다 미리 손을 써 움직임을 막으려 한다. 사면 초가에 빠진 코코에게 역전의 방법이 있을까?", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15625/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.466000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-02-04T12:41:11.228988", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2012-06-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18990, "title": "요르문간드 1기 [2025년 판권 만료작]", "subject": "Dragon Shooter 1", "description": "상품을 공수하게 된 코코일행. 하지만 이번에는 상품 외에 NGO의 의사들도 함게 수송해야만 한다. 그들을 데리고 있다는 것을 숨기고 T공화국에 입국하여 거래를 하게 되지만, 민병 조직인 \"발칸 드래곤\"의 리더 발드래의 난입으로 순식간에 궁지에 몰리게 된다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15626/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06.300000", "progressbar": null, "item_expire_datetime": "2025-06-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_produc