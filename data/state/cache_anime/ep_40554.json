de_products": [{"id": 66813, "name": "Deep Insanity THE LOST CHILD 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 66812, "name": "Deep Insanity THE LOST CHILD 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-05T01:30:00.035482", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50476, "title": "Deep Insanity THE LOST CHILD", "subject": "Take 05", "description": "엘시 암살 명령을 받은 시구레는 마음의 안정을 찾지 못하고, 임무에서도 자신과 같은 후위인 코바토와의 연계도 제대로 해내지 못하게 되었다. 보다 못한 레슬리가 그에게 권한 것은 코바토와의 연계 강화 달을 진행하는 것이었지만, 시구레는 코바토의 '사정'을 목격해버리고 말았는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/52592/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 66984, "name": "Deep Insanity THE LOST CHILD 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 66983, "name": "Deep Insanity THE LOST CHILD 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-12T01:30:00.035493", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50614, "title": "Deep Insanity THE LOST CHILD", "subject": "Take 06", "description": "엘시 암살이 결행되는 것으로 결정되었다. 레슬리가 이끄는 대로 어사일럼 안을 나아가는 시구레가 어렵지 않게 목적지에 다다르는 것에 위화감을 느끼는 가운데, 드디어 그 순간이 찾아왔다. 시구레가 저격 임무를 맡은 가운데 암살 작전이 시작되었는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/52791/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67202, "name": "Deep Insanity THE LOST CHILD 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67201, "name": "Deep Insanity THE LOST CHILD 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-19T01:30:00.029711", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50736, "title": "Deep Insanity THE LOST CHILD", "subject": "Take 07", "description": "레슬리의 죽음. 그리고 그 사실을 완전히 받아들이지 못하고 있는 시구레 일행들. 앞으로의 일에 대해 근심하는 그들에 대해 베라는 무정하게도 엘시 암살 계획의 진행 및 임무 재개를 고했다. 그리고 레슬리를 대신해서 새롭게 현장의 지휘관이 된 사람이 있었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/53428/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67383, "name": "Deep Insanity THE LOST CHILD 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 67382, "name": "Deep Insanity THE LOST CHILD 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-11-26T01:30:00.049664", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2021-11-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 50862, "title": "Deep Insanity THE LOST CHILD", "subject": "Take 08", 