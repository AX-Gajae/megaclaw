{"count": 12, "next": null, "previous": null, "results": [{"id": 87531, "title": "카와고에 보이즈 싱", "subject": "On the Set", "description": "텐시, 에이, 시라토리는 카와고에 학교를 다니는 친구들이다. 그들 앞에 갑자기 나타난 정말 특이한 전 지휘자, 하루오. 세 친구들은 하루오에게 휘말려 보이스 콰이어부에 들어가게 된다. 그리고 갑자기 사람들 앞에서 노래를 부르게 되는데….", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100892/v30/5cecdb990edd/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126319, "name": "카와고에 보이즈 싱 1 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126318, "name": "카와고에 보이즈 싱 1 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:14.532444", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-10-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87532, "title": "카와고에 보이즈 싱", "subject": "눈부시게 빛나는 내일을 향해", "description": "보이스 콰이어부에 IT와 오토메가 들어와 부원들은 활기에 찬다. 하지만 늘 돋보이려고 하는 IT와 늘 자신을 억누르는 오토메는 물과 기름 같다. 그런 와중에 눈치 없는 하루오의 폭언이 날아가고 콰이어부는 한바탕 소란에 휩싸이는데!", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100893/v30/2ed34a89c4d9/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126321, "name": "카와고에 보이즈 싱 2 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126320, "name": "카와고에 보이즈 싱 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:14.847011", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-10-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87533, "title": "카와고에 보이즈 싱", "subject": "안달루시아를 꿈꾸며", "description": "단봇치는 하교 중 다른 학교의 불량배들의 공격을 받는다. 그 순간 페이스 페인팅을 한 아다치가 나타나 단봇치를 구해준다. 여자처럼 예쁜 자신의 얼굴에 거부감을 가지고 있는 아다치. 교장은 페이스 페인팅을 조건으로 콰이어부에 입부하라고 한다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100894/v30/2ec2ec1011d6/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126323, "name": "카와고에 보이즈 싱 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126322, "name": "카와고에 보이즈 싱 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:15.147069", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-11-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87534, "title": "카와고에 보이즈 싱", "subject": "키재기", "description": "아다치의 합류로 6명이 된 콰이어부. 쌍둥이 형제 휴우가 코우와 신은 유급당하지 않기 위해 콰이어부에 가입부하지만 틈만 나면 싸우기만 할 뿐 노래에는 관심이 없다. 그런데 하루오 선생이 그 아이들을 칭찬하면서 부원 사이에서 불만이 높아져 가는데….", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100895/v30/7d12956eff2f/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126325, "name": "카와고에 보이즈 싱 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126324, "name": "카와고에 보이즈 싱 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:15.494093", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-11-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87535, "title": "카와고에 보이즈 싱", "subject": "LA LA LA", "description": "콰이어부의 멤버는 8명으로 늘어났지만 합창대회에 나가기에는 부족하다. 그러던 중 뉴튜브에 올라온 동영상을 보고, 그 동영상에 나온 두 사람을 찾으러 다니는데….", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100896/v30/9518ceede4cb/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126327, "name": "카와고에 보이즈 싱 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126326, "name": "카와고에 보이즈 싱 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:15.790578", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-11-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87536, "title": "카와고에 보이즈 싱", "subject": "Summer Blessing", "description": "10명이 되어 보이스 콰이어 대회에 출전하기로 한 콰이어부. 출전 자유곡을 정하기 전, 작년 우승팀이 축제에서 공연한다는 소식에 다 같이 축제를 간다. 그곳에서 단봇치는 어릴적 친구인 쥬우를 만나는데….", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100897/v30/ebe7fff8af74/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126329, "name": "카와고에 보이즈 싱 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126328, "name": "카와고에 보이즈 싱 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:16.100732", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-11-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87537, "title": "카와고에 보이즈 싱", "subject": "솔방울", "description": "오토메의 콧노래 덕분에 자유곡의 멜로디는 탄생했지만, 편곡없이는 노래를 부를 수가 없다. 여름 합숙을 간 콰이어부는 그곳에서 하루오 선생님의 지인인 실력파 움악인인 우메 씨를 만난다. 아이들은 우메 씨에게 편곡을 부탁하지만 거절당하는데….", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100898/v30/7cc1a3cc9b25/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126331, "name": "카와고에 보이즈 싱 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126330, "name": "카와고에 보이즈 싱 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:16.401002", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-11-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87538, "title": "카와고에 보이즈 싱", "subject": "Gettaway", "description": "관동 대회에 나가기 위해 노래 연습을 하는 콰이어부. 더운 여름이지만 에어컨이 고장난 탓에 마을 회관으로 장소를 옮긴다. 하지만 하필 강도가 마을 회관 안으로 도망쳐 들어갔고 리카 선생님이 인질로 붙잡혀버리는데….", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100899/v30/00910abf3d96/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126333, "name": "카와고에 보이즈 싱 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126332, "name": "카와고에 보이즈 싱 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:16.706879", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87539, "title": "카와고에 보이즈 싱", "subject": "언젠가의 I am sorry", "description": "IT는 아버지가 어그로를 끄는 뉴튜버인 것이 발각되자 한동안 학교를 나가지 않는다. 오랜만에 등교한 IT를 아무렇지 않게 환영해주는 콰이어부 아이들. 하지만 어그로를 끈 영상때문에 사람들이 집까지 쳐들어오자 IT는 이사를 가게 되는데….", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100900/v30/d912066b7e07/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126335, "name": "카와고에 보이즈 싱 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126334, "name": "카와고에 보이즈 싱 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:17.002594", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87540, "title": "카와고에 보이즈 싱", "subject": "전원", "description": "IT가 빠지고 부원은 9명이 된다. 부족해진 코러스를 메우기 위해 콰이어부는 밤늦게까지 연습한다. 아이들 부모의 항의가 빗발치고 결국 학교까지 찾아오자 하루오는 어떤 행동을 하는데….", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100901/v30/8866ba3f25ff/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126337, "name": "카와고에 보이즈 싱 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126336, "name": "카와고에 보이즈 싱 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:17.310240", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87541, "title": "카와고에 보이즈 싱", "subject": "Unknown의 색채", "description": "콩쿨 대회 첫번째 날. 라이벌인 타치카와키타학교 등 실력이 쟁쟁한 학교들이 출전한다. 긴장감이 떠도는 와중에 무대에 서게 된 콰이어부. 과제곡을 부르지만 생각지도 못 한 일이 발생하는데….", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100902/v30/ee1c171aad56/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126339, "name": "카와고에 보이즈 싱 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126338, "name": "카와고에 보이즈 싱 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:17.611625", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2023-12-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87542, "title": "카와고에 보이즈 싱", "subject": "Now Or Never", "description": "보이즈 콰이어 관동 대회 2일차. 과제곡에서 실수를 한 단봇치는 도망치듯 대회장을 나간다. 어릴 적 친구였던 쥬우는 단봇치에게 다가가 자신의 심정을 이야기 하며 최선을 다해서 노래를 부르라고 한다. 하지만 도무지 용기가 나지 않던 단봇치에게 하루오는 선생은 어떤 제안을 하는데….", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100903/v30/12fc0f5bdaf0/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:47.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126341, "name": "카와고에 보이즈 싱 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 126340, "name": "카와고에 보이즈 싱 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-12-05T13:00:17.952315", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-01-17", "rating_components": []}, "access_type": null, "is_available": false}]}