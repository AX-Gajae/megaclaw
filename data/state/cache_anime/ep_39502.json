0 day", "promotion": null}], "published_datetime": "2019-11-03T23:30:00", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 35759, "title": "그랑블루 판타지 The Animation 2기", "subject": "안개로 뒤덮인 섬", "description": "알비온을 떠난 그랑 사이퍼가 도착한 곳은 들어가면 두 번 다시 나올 수 없다는 소문이 있는 짙은 안개로 뒤덮인 섬이었다. 정보 수집과 식량 조달을 위해 마을을 거닐다 창백한 안색의 좀비들과 만나 백 년 전에 나타났다는 유령선에 대해 듣게 된다. 좀비들의 집으로 초대받은 그랑 일행은 뜻밖의 인물들과 재회를 하게 된다. 흑기사와 행동을 같이 하는 용병 콤비인 드랑크와 슈투름, 그리고 루리아와 비슷한 힘을 지닌 오르키스. 드랑크는 이 섬에서 일어나고 있는 현상에 성정수가 관계되어 있다며 그랑 일행에게 협력할 것을 의뢰하는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/11/33128/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 45586, "name": "그랑블루 판타지 The Animation 2기 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 45585, "name": "그랑블루 판타지 The Animation 2기 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-11-17T23:30:00.077171", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 35944, "title": "그랑블루 판타지 The Animation 2기", "subject": "불사의 성정수", "description": "셀레스트에게 삼켜져 버린 루리아, 이오, 오르키스. 남겨진 그랑 일행은 마을에서 만난 유령 소녀 페리와 함께 루리아 일행을 구해낼 방법을 찾아다닌다. 한편 루리아 일행도 그저 앉아서 구조를 기다리지 않고 서로 협력하여 시행착오를 거듭하면서 출구를 찾고 있었다. 조금씩 마음을 나누게 된 루리아와 오르키스, 그리고 그것을 흐뭇하게 지켜보는 이오. 하지만 셀레스트의 몸속을 나아감과 동시에 서서히 상태가 이상해지는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/11/33280/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 45811, "name": "그랑블루 판타지 The Animation 2기 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 45810, "name": "그랑블루 판타지 The Animation 2기 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-11-24T23:30:00.097855", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-11-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36177, "title": "그랑블루 판타지 The Animation 2기", "subject": "가족에 대한 기억", "description": "셀레스트는 누군가에게 조종당하고 있었다. 그 의지에 따라 셀레스트가 마을을 습격하고 좀비들을 먹는다. 피해를 줄이기 위해 그랑 사이퍼를 조종해서 셀레스트를 막아서는 라캄. 그랑은 삼켜진 루리아 일행을 구하기 위해 그랑 사이퍼에서 셀레스트로 뛰어내려 셀레스트의 몸속으로 잠입한다. 그곳에서 기다리고 있던 거울에 비친 듯한 또 한 명의 자신이 휘두르는 검에 그랑은 고전을 면치 못하는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/11/33490/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 45967, "name": "그랑블루 판타지 The Animation 2기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 46064, "name": "그랑블루 판타지 The Animation 2기 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-12-01T23:30:00.042958", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-12-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36325, "title": "그랑블루 판타지 The Animation 2기", "subject": "약속의 도시", "description": "손상된 그랑 사이퍼를 수리하기 위해서 그랑 일행은 배를 만드는 성지라고 불리는 가론조섬으로 향한다. 가론조섬에서 그랑 일행은 배의 수리를 의뢰하지만 조선공들은 거액의 돈이 오감에도 불구하고 계약서를 쓰지 않는다. 의아하게 여기던 참에 가론조섬에는 구두 약속이라 해도 지키게 하는 신이 있다는 전설을 듣게 된다. 수리 비용을 마련하기 위해 셰로카르테로부터 의뢰를 받아서 수행하는 그랑 일행. 한편, 수리 작업을 지휘하기 위해 배에 남은 라캄의 앞에 한 명의 소년이 나타나는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/12/33792/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46187, "name": "그랑블루 판타지 The Animation 2기 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 46186, "name": "그랑블루 판타지 The Animation 2기 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-12-08T23:30:00.078019", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2019-12-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36560, "title": "그랑블루 판타지 The Animation 2기", "subject": "이룰 수 없는 꿈", "description": "갑자기 나타난 폼메른이 이끄는 에르스테 제국군에게 끌려가버린 그랑과 루리아. 마정의 영향으로 괴로워하는 노아도 제국의 주둔지에 있는 연구소에 붙잡혀 있었다. 남겨진 라캄 일행의 앞에 로제타가 나타나 그랑 일행의 구출에 힘을 빌려주겠다고 말한다. 잊고 있던 머나먼 기억을 떠올린 라캄은 한시라도 빨리 노아를 구출하기로 결심한다. 그리고, 연행된 그랑과 루리아는 에르스테 제국의 재상 프리시아와 대면하는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/12/33983/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46450, "name": "그랑블루 판타지 The Animation 2기 10 대여", "list_price": 700, 