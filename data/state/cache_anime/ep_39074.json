리고 눈을 떠 보니 과거가 아닌 현재로 돌아와있었다. 평화로운 마을을 보고 잘 해결된 것 같아 안심하지만 왜인지 학교에서 오리가미의 모습이 보이질 않는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/03/25675/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": "2024-01-07T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-03-19T00:30:00.603352", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 29837, "title": "데이트 어 라이브 Ⅲ [2024년 판권 만료작]", "subject": "별이 내리는 밤의 천사", "description": "쿠루미를 발견한 오리가미는 반전체 정령, 데빌로 각성해 쿠루미를 공격했다. 하지만 곧 제정신으로 돌아온 오리가미에게는 쿠루미를 공격한 기억이 없었다. 아무래도 오리가미의 자기 방어 본능이, 평화롭게 사는 오리가미와 정령을 사냥하는 정령인 데빌의 기억을 분리해놓은 모양이었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/03/25820/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": "2024-01-07T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-03-26T00:30:00.534787", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 30218, "title": "데이트 어 라이브 Ⅲ [2024년 판권 만료작]", "subject": "이츠카 시도를 공략하라", "description": "토비이치 오리가미의 영력을 봉인해, 세계는 평화를 되찾았다. 고등학교를 다니며 평범하게 보내는 일상이 이어지던 그 때, 의외의 인물이 영력을 내뿜으며 그 평화를 무너뜨리는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/04/25955/v1/Thumbnail.0000057.jpg", "has_pre