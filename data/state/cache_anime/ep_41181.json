ewing": true, "products": [], "episode_products": [{"id": 78318, "name": "느린 장마 6 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 78317, "name": "느린 장마 6 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2022-11-26T00:00:09.412580", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07627", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["대사", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 57825, "title": "느린 장마", "subject": null, "description": "산돌의 부상으로 빠듯 해진 웅신, 가을 그리고 산돌의 생활비. 웅신은 돈을 마련하려 나이를 속여가며 술집 알바를 구하지만, 위조사실을 들켜 월급도 못 받고 쫓겨난다. 가을은 그런 사장에게 따지러 갔다가 상해를 입히게 되는데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/75115/v15/Thumbnail.0000010.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:33.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78316, "name": "느린 장마 7 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 78315, "name": "느린 장마 7 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2022-11-26T00:00:09.412580", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07627", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["대사", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 57826, "title": "느린 장마", "subject": null, "description": "가을은 상황 설명을 요하는 판사의 질문에 입을 닫고 제대로 답을 하지 않는다. 그런 가을을 설득하고자 하는 오란. 가을은 그런 오란에게 마음을 열지만, 정작 오란은 마지막 법정에 나타지 않는다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/75116/v15/Thumbnail.0000011.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:40.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78314, "name": "느린 장마 8 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 78313, "name": "느린 장마 8 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2022-11-26T00:00:09.412580", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07627", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["대사", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 57827, "title": "느린 장마", "subject": null, "description": "귀여운 동생의 자리를 빼앗겼다며 질투하는 운에게 옛 친구들이랑 노는게 당연하지 않냐는 바람의 일침한다. 어벙벙 해진 운은 결국 계단에서 굴러 손목을 접지른다. 하필 올시즌 개막전이 있는 주에. 겨우 부상은 회복하지만 전처럼 따라주지 않는 몸과, 신인선수들이 활약을 하는 탓에 살면서 처음 슬럼프를 겪는다. 그런 상황에서 운은 바람과 가족들에게 청천벽력 같은 결정을 전한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/75117/v15/Thumbnail.0000011.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:04:46.233000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78312, "name": "느린 장마 9 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 78311, "name": "느린 장마 9 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2022-11-26T00:00:09.412580", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2022-VK07627", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["대사", "약물", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 57828, "title": "느린 장마", "subject": null, "description": "2년 후. 한 카페에서 가을, 바람, 오란이 만난다. 가을은 담배를 피러 나가고 바람은 조심스럽게 오란이 계속 편의점일을 하고 싶은건지 묻는다. 대답을 들을 수 있을까 싶은 찰나 가을이 돌아와서 상황이 흐지부지되고 결국 대답은 듣지 못한다. 가을, 바람과 헤어지고 눈이 오는 밤 길을 걷는데 저 멀리