time": "0:23:45.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20836, "name": "살육의 천사 12 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 20835, "name": "살육의 천사 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2018-09-22T02:55:35.362115", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2018-09-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22423, "title": "살육의 천사", "subject": "I'm not Your God.", "description": "잭이 레이첼의 방에서 돌아다니던 중, 갑자기 방에 있던 TV가 켜졌다. TV에서는 어느 한 살인사건에 대한 뉴스가 나오고 있었고, 살해된 부부의 사진과 현장에서 발견된 부부의 딸의 이름, 시체의 특징에 대한 내용이 연달아 비춰졌다. 그리고 뒤이어 틀어진 영상에는 대니의 카운셀링을 받는 레이첼의 모습이 있었는데.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18138/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 28398, "name": "살육의 천사 13 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 28400, "name": "살육의 천사 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2018-10-08T13:11:31.697638", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2018-10-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 22424, "title": "살육의 천사", "subject": "Swear you will be killed by me.", "description": "잭에게 총구를 겨눈 레이첼. 하지만 정작 총을 쏜 상대는 잭이 아닌 대니였다. 그리고 레이첼은 잭만은 자기가 죽이겠다며 다시 총을 겨누는데.", "episode_num": "14", "episode_order": 14, "thumbnail_p