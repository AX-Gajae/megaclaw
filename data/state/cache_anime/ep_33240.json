sets/2019/11/33495/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:37.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46340, "name": "프리파라 3기 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2019-12-11T19:00:00.115743", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "디즈니", "broadcast_date": "2018-05-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36431, "title": "프리파라 3기", "subject": "신의 주얼 변신 뽀용♡", "description": "신급 아이돌 그랑프리 우승 축하 선물로 영화를 찍도록 주선해주는 프린스. 모두는 파라데미 상 수상 감독이라는 얘기에 기대에 부풀지만 로봇언니가 감독이라는 사실에 실망하고 주인공으로 낙점된 시온은 귀여운 캐릭터에 경악하며 촬영을 거부한다. 하지만 보석 체인지로 캐릭터가 바뀐 멤버들. 그때 쥬루루가 위험에 빠지게 되는데...", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/11/33500/v4/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:54.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 46339, "name": "프리파라 3기 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2019-12-11T19:00:00.115743", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "디즈니", "broadcast_date": "2018-05-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 36432, "title": "프리파라 3기", "subject": "빵점 아이돌 시작했습니다 (ㅠ.ㅠ)", "description": "라라의 성적이 떨어지자 집으로 찾아 온 글로리아. 그 때 쥬루루가 갑자기 튀어나와 결국 쥬루루의 존재를 들키게 된다. 사정을 들은 글로리아는 시험 성적을 올리는 조건으로 당분간 자신이 쥬루루를 맡기로 한다. 다시 쥬루루를 데려오기 위해 열심히 공부한 라라는 수학에서 58점을 맞아 실망에 빠진다. 한편, 라라의 등신대를 보고 쫓아가던 쥬루루는 위험에 빠지게 되는데…", "episode_num": "14", "episode_order