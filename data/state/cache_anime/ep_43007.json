는 걸 밝혀냈다. 그 후 온천에서 진로에 대해 이야기하는 나기와 이마리, 세토를 보고 루리는 울적한 표정을 지었지만, 나기의 권유로 여관 옥상으로 향했다. '유성을 손에 넣어 보고 싶지는 않아?'라고 말하는 나기의 제안에 그들은 운석을 찾게 되었는데.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/98694/v30/a363176a27da/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 123554, "name": "루리의 보석 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 123553, "name": "루리의 보석 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-09-30T01:30:06.809213", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-09-29", "rating_components": []}, "access_type": null, "is_available": false}]}