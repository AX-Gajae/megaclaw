promotion": null}], "published_datetime": "2024-10-11T21:00:11.872246", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2023-11-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78447, "title": "(더빙) 명탐정 코난 11기 part 1", "subject": "시간 파수꾼의 칼날 (전편)", "description": "2년 전부터 생일 때마다 날아오는 협박장. 명한은 의뢰를 받고 연희의 생일파티에 간다. 단 1초라도 늦는 것을 용서하지 않는 연희의 성격에 모두가 놀라는데.. 드디어 생일 파티가 시작되고 불이 꺼지면서 생일 케이크가 들어온다. 그리고 연희는 자신이 태어난 시간인 오후 6시에 맞춰 불을 끄는데.. 하지만 6시를 알리는 종은 울리지 않고 대신 연희의 비명소리만 울려퍼진다. 누군가에게 살해를 당한 연희. 하지만 범인과 흉기는 흔적도 없이 사라지고 파티장에 있던 모든 사람들이 조사를 받기 시작한다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85786/v30/eb50d2c0fa19/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:44.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110796, "name": "(더빙) 명탐정 코난 11기 part 1 632 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-10-11T21:00:11.872246", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "투니버스", "broadcast_date": "2023-11-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 78448, "title": "(더빙) 명탐정 코난 11기 part 1", "subject": "시간 파수꾼의 칼날 (후편)", "description": "파티에 초대된 손님들을 다 조사해봤지만 흉기는 물론 용의자도 찾아내지 못하고.. 증언을 토대로 범인은 뚱뚱하고 재빠르며 드레스를 입은 여성일 거라고 유추한다. 이때 발코니를 살펴보던 코난이 범인의 트릭을 발견하고 명한을 재워 자신의 생각을 말하기 시작한다. 코난은 범행 당시의 상황을 재현하며 접는 우산을 갖고 있었던 변정호를 범인으로 지목한다. 정호는 코난의 추리에 자신의 범행을 인정하고, 어릴 때부터 친구였던 시계 기술자의 원한을 풀어주기 위해서 그랬다고 자백을 한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85788/v30/a0d5971c96ec/Thumbnail.0000059.jpg", "has_preview": true, "access_info