/2018/12/11745/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:36.100000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.019125", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-12T23:32:11.178885", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13624, "title": "초차원 게임 넵튠 : The Animaiton [2019년 판권 만료작]", "subject": "라스테이션의 비밀", "description": "4여신은 라스테이션 서버를 해킹하여 위성을 조종한 해킹범을 쫓게 된다.\n한편 동생들은 라스테이션 교회에 몰카를 설치한 범인을 추적하는데...\n몰카와 해킹은 동일범 소행이었는지 한곳에서 마주치게 된다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11746/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:37.100000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.019125", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-12T23:32:11.523394", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13625, "title": "초차원 게임 넵튠 : The Animaiton [2019년 판권 만료작]", "subject": "복수의 과실", "description": "또다시 음모를 꾸미는 마제콘느가 선정한 결전의 장소는 가지밭.\n가지라면 질색을 하는 넵튠은 아이와 컴파를 구하러 날아갔다가 변신이 풀려 고전하게 된다.\n거기에 가지 고문을 당하는 아이에프를 보던 프루루트가 기어이 폭발하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11747/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:37.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.019125", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-12T23:32:11.872419", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13626, "title": "초차원 게임 넵튠 : The Animaiton [2019년 판권 만료작]", "subject": "금단의 낙원", "description": "금단의 섬 R18 아일랜드에서 커다란 대포가 발견된다.\n여신들은 혹시나 모를 불상사를 막기 위해 조사차 섬으로 떠나는데...\n역시 그 이름답게 R18 아일랜드에서는 이런저런 성인용 이벤트가...!", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11748/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.019125", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-12T23:32:12.309398", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 13627, "title": "초차원 게임 넵튠 : The Animaiton [2019년 판권 만료작]", "subject": "에덴의 도전", "description": "피셰가 사라진 후로 얼핏 보기에는 부지런해진 넵튠. 하지만 그것은 마음속의 허전함을 메우기 위한 몸부림이었다. 이를 보다 못한 프루루트는 넵튠에게 솔직해지라면서 채찍질을 하고…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/11749/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:39.100000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:05.019125", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-12T23:32:12.638514", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name"