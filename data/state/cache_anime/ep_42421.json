: []}, "access_type": null, "is_available": false}, {"id": 84059, "title": "역사에 남을 악녀가 될 거야", "subject": "악녀와 과거", "description": "로아나 마을에서 윌이 꺼낸 이야기는 자신의 과거ㅡ 어린 날의 회한과 음모에 관한 이야기였다.\r\n이야기를 다 들은 앨리시아가 학교로 돌아가자, 다시금 수상한 움직임을 보이는 학생들이 있었다.\r\n그로 인해 앨리시아는 또다시 성가신 일에 휘말리는데...?!", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/96095/v30/f76db5cb5d67/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-22T04:00:10.831815", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 84060, "title": "역사에 남을 악녀가 될 거야", "subject": "악녀와 교내 카리스마", "description": "옆 나라인 라발 국에 흥미를 가지는 앨리시아.\r\n'역사에 남을 악녀'가 되기 위해서 게임의 시나리오 바깥으로 나가보고 싶다는 생각을 하지만, 그건 너무나 어려운 일이었다.\r\n한편 리즈는, 앨리시아와 듀크의 관계를 보며 불안을 느끼는데...", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/96248/v30/335da09cc46b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-29T04:00:11.594896", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 84061, "title": "역사에 남을 악녀가 될 거야", "subject": "악녀와 성녀", "description": "메르의 꾸준한 조사로, 드디어 성녀의 비밀이 드러난다.\r\n성녀 리즈의 비밀은 학교의 비정상적인 상황과 관계되어 있었는데...\r\n감시 역할로서 성녀를 올바른 길로 인도하기 위해, 악역 영애 앨리시아는 마침내 히로인 리즈와 정면 승부한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/96249/v30/93864a107a7c/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-29T04:00:11.949100", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 85445, "title": "역사에 남을 악녀가 될 거야", "subject": "악녀와 왕자", "description": "앨리시아에게 '넌 누구지?'라며 차갑게 말하는 듀크.\r\n누군가가 듀크에게 앨리시아와의 기억을 지워버리는 마법을 건 듯했는데...\r\n그 범인으로 지목된 사람은 다름 아닌 앨리시아였다. 왕궁으로 불려 간 앨리시아의 운명은ㅡ?", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/96250/v30/086069b1f644/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-29T04:00:12.289791", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-28", "rating_components": []}, "access_type": null, "is_available": false}]}