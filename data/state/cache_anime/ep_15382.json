457/v30/282d9c4becb9/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:59.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119379, "name": "기동아 부탁해(하나다 소년사) part 1 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119378, "name": "기동아 부탁해(하나다 소년사) part 1 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-27T00:00:12.220627", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00949", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "공포", "약물"]}, "access_type": null, "is_available": false}, {"id": 83982, "title": "기동아 부탁해(하나다 소년사) part 1", "subject": "13년만의 파트너", "description": "이치로의 누나인 토쿠토에게 좋아하는 사람이 생겼다?! 바로 전학생 요코미조! 집에 가져온 요코미조 사진을 보던 이치로는 이상함을 느끼는데... \"야 꼬맹이 넌 내 존재가 느껴져?\". 사진 속에 '귀신'은 자신을 '사귀'로 소개하며, 사람의 운명을 바꾼 죄로 요코미조에게 갇히게 되었다며 이치로에게 파트너 제안을 한다. \"뭐 13년 전으로 돌아가서 널 막으라고?!\" 이치로에도 주어진 임무! 잘 해낼 수 있을까?", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94459/v30/26368a01a111/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:59.300000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 119381, "name": "기동아 부탁해(하나다 소년사) part 1 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 119380, "name": "기동아 부탁해(하나다 소년사) part 1 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-06-27T00:00:12.555546", "rating": {"rating": 12, "rating_type": "영상물등급위원회", "classification_number": "2025-VF00949", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "공포", "약