/assets/2018/12/4477/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:14.200000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.044992", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-15T21:25:46.252821", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5433, "title": "다가시카시 1기 [2019년 판권 만료작]", "subject": "초히모Q와 구슬치기와 때때로 마켄구미…", "description": "코코노츠와 친구들은 호타루에게 연락을 받고 절에 가게 된다. 호타루는 가지고 놀아도 혼나지 않는 막과자에 관해 얘기하기 시작하고, 다같이 초히모Q와 구슬을 갖고 놀게 된다. 호타루는 사야가 모든 놀이에 재능이 있다는 걸 눈치채고 시카다 막과자에서 일해보면 어떻겠냐고 제안하는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4478/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:15.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.044992", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-15T21:25:46.287310", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5434, "title": "다가시카시 1기 [2019년 판권 만료작]", "subject": "여름 축제와 호타루와…", "description": "여름 축제 전날, 코코노츠는 요우와 함께 몬자야키 노점을 준비하러 신사에 갔다가 우연히 호타루를 만난다. 몬자야키와 막과자의 밀접한 관계를 설명하던 호타루는 축제가 열린다는 사실을 알고 매우 기뻐한다. 한편, 사야는 유카타를 예쁘게 차려입고 코코노츠 앞에 나타나는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4479/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13.200000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.044992", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-15T21:25:46.320934", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5435, "title": "다가시카시 1기 [2019년 판권 만료작]", "subject": "엄청 무서운 이야기 껌과 태풍과..", "description": "태풍이 몰려온 어느 날 밤, 토우는 모두에게 무서운 이야기를 들려준다. 사야는 비명을 지르며 무서워하는 반면에 호타루는 전혀 무서워하는 기색이 없다. 왜냐하면 이야기의 결말을 모두 알고 있기 때문이다. 실은 토우가 들려준 괴담은 ‘엄청 무서운 이야기 껌’에 들어 있는 이야기였는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4480/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:13.200000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.044992", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-15T21:25:46.382653", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5436, "title": "다가시카시 1기 [2019년 판권 만료작]", "subject": "와타파치와 응가초콜릿과…", "description": "구내염에 걸린 호타루는 평소와 달리 별로 기운이 없다. 호타루가 구내염이 생긴 원인에 대해 이상한 이유를 늘어놓자, 사야는 막과자를 많이 먹었기 때문이라고 말해준다. 하지만 호타루는 오히려 그럴 때일수록 입에서 톡톡 튀는 와타파치를 먹고 자극을 느끼는 게 좋다고 주장하는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4481/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:15.200000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.044992", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetim