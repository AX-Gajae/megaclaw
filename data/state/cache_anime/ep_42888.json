der": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/08/96356/v30/c310379fb4c8/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 121189, "name": "공녀 전하의 가정교사 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 121188, "name": "공녀 전하의 가정교사 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-08-03T02:30:06.784579", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-08-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 84089, "title": "공녀 전하의 가정교사", "subject": "꿈에 그리던 왕립 학교 후편", "description": "왕립 학교 입학식 도중, 앨런에게 왕궁에서 구원을 요청했다. 달려가 보니 기사들이 모두 쓰러져 있고 제럴드 왕자에게 검을 휘두르는 리디야가 있었다. 그로부터 며칠 후 앨런은 왕립 학교에 불려와 있었다. 교수의 배려로 학교의 임시 강사가 된 앨런은 선생님으로서 처음으로 왕립 학교의 교단에 서는데.", "episode_num": "6", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/08/96999/v30/8085979cec10/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 121362, "name": "공녀 전하의 가정교사 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 121361, "name": "공녀 전하의 가정교사 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-08-10T02:30:06.462161", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-08-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 84090, "title": "공녀 전하의 가정교사", "subject": "과외 수업은 온천에서", "description": "올그렌 공작 가문의 온천 시설로 여행을 온 티나, 엘리, 앨런, 리디야. 온천을 기대했던 일행이었지만 설비 고장으로 온천에 들어갈 수 업게 되어 낙담한다. 온도 관리에 사용되는 마석이 사라진 것이 원인이라고 한다. 그러던 중, 마찬가지로 여행을 온 스텔라,  펠리시아, 카렌과 우연히 만났다. 일행은 온천에 들어가기 위해 마석을 찾기로 했는데?!", "episode_num": "7", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/08/97160/v30/89336f58b291/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 121733, "name": "공녀 전하의 가정교사 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 121732, "name": "공녀 전하의 가정교사 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-08-17T02:30:06.261075", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-08-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 84091, "title": "공녀 전하의 가정교사", "subject": "거짓된 것", "description": "왕립 학교에서 수업 준비를 하던 앨런에게 전화가 걸려 온다. 제럴드 왕자와 그의 추종자들과 말싸움을 벌이던 리네가 왕자에게 결투를 신청했다고 한다. 서둘러 달려간 앨런이 목격한 것은 꺼림칙한 기운을 발산하는 단검을 손에 든 평소와 다른 모습의 제럴드 왕자였는데...", "episode_num": "8", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/09/97559/v30/414f488433a7/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 121980, "name": "공녀 전하의 가정교사 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 121979, "name": "공녀 전하의 가정교사 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-08-24T02:30:06.663226", "rati