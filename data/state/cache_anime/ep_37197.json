xpire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6305, "name": "그랑블루 판타지 The Animation 6 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24879, "name": "그랑블루 판타지 The Animation 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:09.568648", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8769, "title": "그랑블루 판타지 The Animation", "subject": "철의 거인", "description": "그랑 일행은 자카 대공의 마법 기운을 가진 마물에게 둘러싸여 절체절명의 위기에 놓인다. 하지만 마물이 이오의 목소리에 반응해 잠깐 멈춘 틈을 타 위기를 모면하게 되지만 출구가 막혀 퇴로를 잃고 만다. 누군가가 부르는 목소리가 들린다며 루리아의 안내를 따라 도착한 곳은 지하에 숨겨져 있던 비밀 공간. 그곳에는 자카 대공과 그가 만든 철의 거인, 콜로서스가 기다리고 있었는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/6944/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 6306, "name": "그랑블루 판타지 The Animation 7 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 24880, "name": "그랑블루 판타지 The Animation 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:15:09.549722", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2017-05-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 8770, "title": "그랑블루 판타지 The Animation", "subject": "두 사람의 거리", "description": "만물상이 보급품을 준비할 동안 남는 시간을 활용해 만물상의 유적 조사 의뢰를 맡게 된 그랑 일행. 그러나 그 유적은 함정이 가득한 유적이었고, 유적으로 들어가기도 전에 일행은 함정에 빠