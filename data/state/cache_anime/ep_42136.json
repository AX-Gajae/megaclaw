um": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80073/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102149, "name": "파워레인저 돈브라더즈 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71378, "title": "파워레인저 돈브라더즈", "subject": "빛과 날개", "description": "비밀을 지키며 도주 중이던 두견이 마침내 약속했던 1년이 지나자, 선미를 만날 거라는 기대에 부풀어 있다. 그런 가운데 갑자기 옥상에서 뛰어내리려는 해준을 본 두견은 그를 구해 준다. 실연의 아픔 때문에 자살을 시도했다는 해준의 얘길 들은 두견은 악마로 분장까지 하면서 해준의 연인이 다시 돌아갈 수 있도록 최선을 다해 돕는다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80074/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102148, "name": "파워레인저 돈브라더즈 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71379, "title": "파워레인저 돈브라더즈", "subject": "뜻밖의 일격", "description": "도원은 자신이 히어로가 아니라 일개 동행자인 데 대해 불만을 토로하며 홍도에게 자신도 홍도와 같은 히어로가 되고 싶다고 말한다. 그러자 홍도는 자신에게서 단 한 방만이라도 공격에 성공한다면 자신과 동등한 위치로 인정하겠다는 게임을 제안한다. 이때부터 호시탐탐 홍도의 빈틈을 노리