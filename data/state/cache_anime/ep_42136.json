 "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102155, "name": "파워레인저 돈브라더즈 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71372, "title": "파워레인저 돈브라더즈", "subject": "병에 걸린 개", "description": "음식점에서 일하던 두견은 자신을 체포하러 온 형사들을 피해 오토바이로 도망친다. 그런데 그때 무서운 속도로 마태구가 쫓아오더니 두견의 입속에 종이고양이를 집어 넣는다.\n 간신히 도망친 두견은 노장기를 찾아가지만 집 앞에서 쓰러지고 만다. 당황한 노장기는 두견을 일단 집에 눕혀 놓고 홍도를 찾아가는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80068/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102154, "name": "파워레인저 돈브라더즈 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71373, "title": "파워레인저 돈브라더즈", "subject": "달은 거짓말쟁이", "description": "거짓말을 할 줄 모르는 홍도는 백곰 택배에서 소장에게 동료의 잘못을 있는 그대로 말한 탓에 동료들에게 미운털이 박힌다. \n 한편 카페 두리둥실에는 새로 아르바이트생 예빛나가 들어온다. 아이돌 데뷔를 앞두고 있다는 빛나는 카페 손님들을 팬클럽으로 만들어 버리는데 그런 모습이 가비 눈에는 영 마음에 들지 않는다. 결국 가비는 홍도에게 자기 대신 카페에서 아르바이트를 해 달라는 부탁하는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80069/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102153, "name": "파워레인저 돈브라더즈 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71374, "title": "파워레인저 돈브라더즈", "subject": "굿바이 홍도", "description": "블랙 도기 이외에 정체를 모두 알게 된 돈 브라더즈는 네 명이 한자리에 모여 앞으로 어떻게 싸울지 논의하기로 한다. 그런데 거짓말을 못 하는 홍도와 나머지 세 사람 사이에 균열이 일어나고, 원승은 홍도가 동료들의 고마움을 알 때까지 싸움을 보이콧 하겠다고 선언한다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/04/80070/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 102152, "name": "파워레인저 돈브라더즈 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-04-19T00:00:10.171955", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-08-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 71375, "title": "파워레인저 돈브라더즈", "subject": "홍도의 빈자리", "description": "홍도가 가온의 칼을 맞은 뒤 흔적도 없이 사라진다. 천도진의 말에 따르면, 뇌인의 검에 베여 사라지는 건 죽음을 의미한다. 또한 도진은 타로가 사라졌을 때 타로를 대신할 사람이 나타날 거라는 말을 남긴다. \n 그 무렵, 마음의 소리를 듣은 백도원은 히어로로 사명을 완수해야 할 때가 왔다는 걸 깨닫고, 친지들에게 이별을 고한 뒤 마을을 떠난다.", "episode_num": "14", "episode_order": 14, "thumbnail_pa