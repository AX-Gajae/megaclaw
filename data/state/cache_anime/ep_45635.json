57.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-05-19T01:00:10.954936", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-05-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93642, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 흔들린다.", "description": "여느 때처럼 동아리방에 있던 문예부 3인방은 전 학생회장인 ‘모리 스즈미’와 전 학생회 부회장인 \r\n‘모치즈키 슌’에게 문예부가 폐부 위기에 처해 있다는 사실을 전해 듣는다. 폐부를 막기 위한 대책을 짜느라 \r\n고군분투하던 나오는 교내에 도플갱어가 있음을 고발하는 종이가 흩뿌려지는 광경을 보게 되는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/107951/v51/f1873e69057a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-05-26T01:00:11.395701", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-05-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93643, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 찾는다.", "description": "아키와 수족관 데이트를 한 다음 날, 나오는 반 친구인 사토로부터 도시락을 같이 먹자는 제안을 받아, \r\n처음으로 같은 반 동성 친구들 사이에서 점심을 먹게 된다. 그 후, 사토와 함께 도서실에 간 나오는 \r\n우연히 복잡한 표정으로 지나가는 리츠코를 보게 되는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/05/108370/v51/fee7883903c7/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-02T01:00:11.252710", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93644, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 뒤틀린다.", "description": "드디어 세이료제 2일 차가 되어, 학교에 가게 된 나오. 메이드 복을 입고 아키와 같이 귀신의 집 \r\n체험을 하는 등, 처음으로 문화제를 만끽한다. 어느새 시간은 흘러 연극 무대 준비를 하던 도중, \r\n나오는 스즈미의 숨겨진 과거를 알게 되는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108646/v51/0a52927f022a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-09T01:00:10.516699", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93645, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 잃는다.", "description": "막이 열리고, 리츠코가 쓴 ‘신 다케토리 이야기’의 무대가 시작된다. 극을 진행하며, \r\n나오는 이 이야기가 스즈미에게 어떤 의미인지 점차 깨닫게 된다. 결국 나오는 마지막 장면에서 \r\n대본과는 달리 진심이 담긴 질문을 스즈미에게 던지게 되는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/109107/v51/b84c09596dda/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-16T01:00:11.344320", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93646, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 나뒹군다.", "description": "스즈미의 죽음과 동시에 료가 사라진 것에 대한 슬픔에서 쉽사리 헤어 나오지 못하는 나오. 그 와중에 스나오는\r\n나오에게 앞으로는 자신이 학교에 다니겠다고 선언한다. 그렇게 집에 있게 된 나오에게 리츠코와 아키가 함께 \r\n온천에 가자며 찾아오는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/109514/v51/b2dad56f4d39/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-23T01:00:11.044192", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93647, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 여행을 떠난다.", "description": "각각 수학여행지인 교토와 료의 고향인 후지노미야로 향하는 스나오와 나오. 스나오는 교토에서 슈야, 사토, \r\n요시이와 함께 관광 명소를 돌아다니며 점차 친해진다. 한편, 후지노미야에 도착한 나오와 아키는 목장에서 \r\n다양한 체험을 하던 중, 우연히 어느 선배와 마주치게 되는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/110041/v51/12ce8be860b4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-06-30T01:00:09.719474", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-06-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93648, "title": "레플리카도, 사랑을 한다.", "subject": "레플리카는, 던진다.", "description": "수학여행을 즐기던 중, 잘 모르는 동급생에게 일방적으로 고백받게 된 스나오. 고백을 거절하며 \r\n들은 말에 상처받은 스나오는 가슴 속에 묻어두고 있던 생각을 사토에게 털어놓게 된다. 한편, 나오는 \r\n모치즈키와 아키에게, 수학여행답게 베개 싸움을 하자고 제안하며 여행 분위기를 만끽하는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/07/110297/v51/c1f0a3c7ff3b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.430000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-07-07T01:00:09.877479", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-07-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 93649, "title": "레플리카도, 사랑을 한다.", "subject": "그리고, 레플리카는.", "description": "감자 수확을 돕고, 아름다운 후지산을 보는 하루를 통해 변해가는 계절의 아름다움을 느끼며, 자신의 마음도 많이 변했음을 느끼는 나오. 그러던 중 나오와 아키는, 스나오와 슈야의 부름 때문에 뒷일을 모치즈키에게 맡기고 교토로 불려 가게 된다. 이렇게 처음으로 모이게 된 네 사람이었지만, 얼마 안 가서 뭔가 이상하다는 것을 알게 되는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/07/110426/v51/650b24ec016d/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:11.450000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-07-14T01:00:09.520541", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-07-13", "rating_components": []}, "access_type": null, "is_available": false}]}