ess_info_list": [], "running_time": "0:24:01.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117607, "name": "록은 숙녀의 소양이기에 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117606, "name": "록은 숙녀의 소양이기에 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-04-25T01:30:06.063727", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-04-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82060, "title": "록은 숙녀의 소양이기에", "subject": "두근거리네요♡ / 우린 내놓고 해, 너도 내놔보든가!!!", "description": "취주악단 '레드 패밀리아'의 대타 멤버로 동네 연주회에 참가하게 된 리리사와 오토하. 어딘가 아니꼬운 느낌의 프로 가수 이시타니 쥰이 노래를 하지 않는 취주악을 깔보자 두 사람은, 타도 이시타니라는 구호 아래 투지를 불태웠다. 멤버들을 끌어들이면서 리리사와 오토하는 관객들을 열광하게 만들었으나, 우연히 현장에 있었던 아리스에게 이를 목격당하고 말았는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/05/93104/v30/8b9b203fe65a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 117927, "name": "록은 숙녀의 소양이기에 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 117926, "name": "록은 숙녀의 소양이기에 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-05-02T01:30:06.082594", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-05-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 82061, "title": "록은 숙녀의 소양이기에", "subject": "멤버에 넣어주면 안 돼...? / 지금 당장, 그 녀석을 버려", "description": "연주회의 여운에 빠진 채 등교하