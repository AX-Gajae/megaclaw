ecdf3662/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:18.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129607, "name": "마법소녀 사이트 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 129606, "name": "마법소녀 사이트 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-02-07T00:00:16.412168", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2026-VF00530", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}, {"id": 91228, "title": "마법소녀 사이트", "subject": "우리는...", "description": "관리인의 정체는 인간 소녀인 것으로 보였다. 아야와 동료들을 지키기 위해 자신의 수명을 다 쓴\r\n츠유노 또한 새로운 관리인 후보로서 부활했다. 정식 관리인이 되기 위해서 아야를 죽이라고 명령받은\r\n츠유노. 과거의 기억을 잃은 츠유노는 초인적인 힘으로 아야를 습격해 왔다. 강하게 살아 줘. 츠유노의\r\n마지막 말을 가슴에 품은 아야의 싸움이 시작된다. 그 끝에서 아야가 찾아낸 것은 과연.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/103768/v30/0c6c5422fcbb/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:03.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129609, "name": "마법소녀 사이트 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 129608, "name": "마법소녀 사이트 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2026-02-07T00:00:16.872769", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2026-VF00530", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "모방위험"]}, "access_type": null, "is_available": false}]}