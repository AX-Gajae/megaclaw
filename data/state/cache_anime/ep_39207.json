, "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-01-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 28436, "title": "(더빙) 가면라이더 빌드", "subject": "정의의 경계선", "description": "장래오와 반용주는 용주의 여자친구 유미를 이용해 용주를 살해현장에 보낸 것도, 스매시 인체실험실에 데려가기 위해 교도소에서 용주를 기절시킨 것도 주기범이란 인물이란 사실을 알아낸다. 그런데 그의 이력서에 적힌 정보는 모두 가짜였다. 이때 강아린이 자신의 정보력을 이용해서 주기범의 연락처를 알아낸다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22668/v4/Thumbnail.0000051.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 34509, "name": "(더빙) 가면라이더 빌드 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2019-02-23T19:00:00.124288", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-01-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 28437, "title": "(더빙) 가면라이더 빌드", "subject": "증언은 원점으로", "description": "가슴에 코브라 문양이 새겨진 괴인에게 독을 맞고 정신을 잃은 장래오는 기억의 단편 속에서 판도라 박스의 패널이 인체실험실에 있었다는 걸 떠올린다. 판도라 박스가 파우스트란 악의 조직과 연관있다는 걸 깨달은 래오는 아린에게 스카이 월의 비극에 관한 정보를 수집해 달라고 부탁한다. 한편, 반용주는 자신의 무죄를 증명할 주기범의 가족을 보호하기 위해 서도에 도착한다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/01/22898/v4/Thumbnail.0000051.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 34496, "name": "(더빙) 가면라이더 빌드 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "