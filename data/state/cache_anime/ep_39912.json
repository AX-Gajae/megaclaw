progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96649, "name": "디지몬 어드벤처: 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-07T19:00:07.725869", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67194, "title": "디지몬 어드벤처:", "subject": "완전체 습격", "description": "해변 요새에서 성스러운 디지몬이 잡혀 있단 정보를 얻은 태일 일행은 그 장소에 대해 의논한다. 그때 우가몬이 나타나 긍지를 되찾겠다며 도전해 오고 태일과 그레이몬은 이를 받아들인다. 우가몬과 그레이몬의 싸움이 한창일 때 갑자기 메탈티라노몬이 나타나고 자신이 버려졌단 걸 깨달은 우가몬은 태일에게 성스러운 디지몬이 있는 곳을 알려주고 메탈티라노몬에게 달려든다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74273/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:16.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96648, "name": "디지몬 어드벤처: 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-07T19:00:07.725869", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67195, "title": "디지몬 어드벤처:", "subject": "강철의 초진화", "description": "메탈티라노몬의 엄청난 힘에 태일 일행은 몸을 피하고 우가몬이 알려준 길에 대한 의견으로 태일과 매튜는 마찰을 겪는다. 한솔은 우가몬이 준 정보가 맞다는 걸 알아내고 태일이 시간을 버는 사이 나머지 일행은 그 길을 따라가기로 한다. 하지만 메탈티라노몬을 막아내기가 쉽지 않고 결국 나머지 일행이 있는 곳까지 쫓아온다. 위기의 순간 그레이몬이 완전체인 메탈그레이몬으로 진화하고 메탈티라노몬을 무찌른다. 한편 독기로 가득한 늪을 피해가기 위해 태일 일행은 두 팀으로 나누어 가기로 하다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74274/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:16.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96647, "name": "디지몬 어드벤처: 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-07T19:00:07.725869", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67196, "title": "디지몬 어드벤처:", "subject": "사막에 선 늑대", "description": "태일, 한솔, 미나 팀은 수수께끼의 유적에 도착하고 매튜, 소라, 정석 팀은 사막을 건너가다가 공격을 받는다. 캬로몬들을 구해준 매튜 일행은 네몬 일행을 만나고 이들을 돕고 싶은 소라, 정석과 달리 매튜는 파피몬과 먼저 길을 나선다. 버드라몬과 원뿔몬은 전갈몬과 맞서 싸우지만 힘에 밀리고 위기의 순간 매튜와 가루몬이 나타난다. 전갈몬과의 싸움 중 가루몬은 완전체인 워가루몬으로 진화하고 전갈몬을 물리친다. 한편 미나와 팔몬은 유적 안에서 갑자기 지하로 떨어진다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74275/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:16.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96646, "name": "디지몬 어드벤처: 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-07T19:00:07.725869", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2022-04-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67197, "title": "디지몬 어드벤처:", "subject": "릴리몬 개화", "description": "지하로 떨어진 미나와 팔몬은 사운드버드몬의 조종을 받는 안드로몬의 공격을 받지만 가드로몬의 도움으로 위기를 넘긴다. 하지만 안드로몬은 엘리베이터를 타고 지상으로 올라가려던 이들을 쫓아오고 미나를 지키던 가드로몬은 안드로몬의 공격에 당하고 만다. 위기의 순간 그레이몬과 캅테리몬이 나타나지만 안