_components": []}, "access_type": null, "is_available": false}, {"id": 11679, "title": "젝스 이그니션 [2019년 판권 만료작]", "subject": "PHASE 8", "description": "나고야에 취재를 갔다가 행방불명이 된 엄마를 찾기 위해 쿠라시키 세라는 그곳으로 향한다. 그리고 공룡형 젝스, 티라노와 만나게 되는데... 한편, 고베 시내에 나타난 흑세계의 젝스 ‘오디움’을 없애고자 알렉산더가 말을 타고 달려나간다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9806/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.496310", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:12:48.256298", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11680, "title": "젝스 이그니션 [2019년 판권 만료작]", "subject": "PHASE 9", "description": "부모님의 기일에 나라현에 찾아간 카미유기 아야세는 복수를 결심하게 된 그날을 떠올린다.\n갑자기 나타난 천사형 젝스들에 의해 마을 사람들이 모두 유린당하던 그날을.\n한편, 리겔은 상부의 시지를 받고 홀로 귀환하게 되는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9807/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.496310", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:12:48.236543", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11681, "title": "젝스 이그니션 [2019년 판권 만료작]", "subject": "PHASE 10", "description": "아즈미가 겪고 있는 불치병의 진실을 알게 된 리겔은 상부의 지시에 불복하게 된다. 그리고 결국 청세계의 젝스에게 쫓기는 신세가 되고 마는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9808/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.496310", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:12:48.051185", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11682, "title": "젝스 이그니션 [2019년 판권 만료작]", "subject": "PHASE 11", "description": "알렉산더의 일격을 받고서도 존재가 사라지지 않은 오디움. 오디움은 다시 증오를 뿜어내면서 카미유기 아야세를 새로운 핵으로 쓰기 위해 자신의 몸 안으로 납치해버리는데. 미카도는 사용 가능한 모든 병력을 이용해 오디움을 처단하기로 결심한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9809/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.133000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:07.496310", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:12:47.999389", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11683, "title": "젝스 이그니션 [2019년 판권 만료작]", "subject": "PHASE 12", "description": "아야세가 오디움에 흡수되기 전에 손을 써야 하기 때문에 상황은 일각을 다투고 있었다.\n아스카는 피에리테, 지거 두 젝스에게 리소스를 공급하며 오디움 본체에 접근하는데...\n한편, 아야세는 오디움이 보여주는 부모님의 환상 때문에 정신을 차리지 못한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9810/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.133000", "progress