lable": false}, {"id": 23659, "title": "(더빙) 원피스 3기", "subject": "꿈의 도시, 레인 베이스 도착!", "description": "드디어 레인베이스에 도착한 밀짚모자 해적단. 목이 마른 루피와 우솝은 자청해서 물을 사러가지만 남아있는 친구들은 불안하기만 하다. 예상대로 루피와 우솝은 스모커대령과 해군들을 몰고 나타나고 혼비백산한 동료들은 크로커다일이 경영하는 레인 디너즈에서 집결하기로 정하고는 뿔뿔이 흩어진다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18968/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:35.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20280, "name": "원피스 3기 (더빙) 13 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:43:21.793840", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 23660, "title": "(더빙) 원피스 3기", "subject": "레인 디너즈로 돌진! 크로커다일의 함정", "description": "스모커 대령한테 쫓겨서 레인디너즈로 뛰어들어간 루피와 동료들은 크로커다일이 파놓은 함정에 빠져서 철창 속에 갇히고 만다. 철창에 갇힌 루피는 마치 바다에 빠진 것처럼 힘을 쓰지 못한다. 그 철창은 특수한 돌로 만들어진 것으로 악마의 열매 능력자들을 무력화시키는 기운을 내뿜고 있기 때문이다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18969/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:35.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20281, "name": "원피스 3기 (더빙) 14 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:43:21.793840", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 23661, "title": "(더빙) 원피스 3기", "subject": "유토피아 작전 발동! 반란의 시작", "description": "출정을 앞두고 왕궁 안에서 갑자기 사라진 코브라 국왕이 나노하나에 모습을 드러낸다. 코브라 국왕은 댄스 파우더를 써서 비를 빼앗은 사실을 국민들 앞에 고백하며 사죄를 하겠다고 한다. 그 순간 거대한 배가 항구를 덮치고 코브라와 국왕군은 도시에 불을 지른 채 어디론가 사라져 버린다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18970/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:36.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20282, "name": "원피스 3기 (더빙) 15 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:43:21.793840", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 23662, "title": "(더빙) 원피스 3기", "subject": "공포의 바나나 악어와 미스터 프린스", "description": "레인 디너즈의 지하 감옥에 갇혀버린 밀짚모자 해적단. 크로커다일은 감옥 열쇠를 일부러 악어 우리에 떨어트려 놓고는 비비에게 국민들과 친구들 중 하나만 선택하라고 강요한다. 그 때 울리는 전화벌레 소리. 전화를 건 사람은 바로크 주식회사에 얼굴이 알려지지 않은 상디다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/18971/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20283, "name": "원피스 3기 (더빙) 16 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:43:21.793840", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 23663, "title": "(더빙) 원피스 3기", "