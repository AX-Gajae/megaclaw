n_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18266, "title": "톰 소여의 모험", "subject": "톰, 한눈에 반하다", "description": "세인트루이스에서 돌아오는 메어리 누나를 마중하기 위해 나간 항구에서 톰은 한 소녀를 보고는 한 눈에 반해버린다. 그 후 그 소녀가 제프의 친척이라는 것을 알고는 실망하지만, 창문 밖을 보고 있는 소녀에게 열심히 자신을 알리는데....", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15353/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:37.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15634, "name": "톰 소여의 모험 3 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:38.707495", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18267, "title": "톰 소여의 모험", "subject": "샘 할아버지의 주술", "description": "베키와 친해졌다고 생각한 톰은 신이 나서 교회에 간다. 하지만 교회에서 만난 베키는 톰에게 쌀쌀맞게 굴면서 제프와는 친하게 지낸다. 이를 본 톰은 분한 마음에 울음을 터트리다 허크에게 들키고 만다. 하지만 허크는 모른 척 하며 샘 할아버지에게 놀러가자고 하는데....", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15354/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:40.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15635, "name": "톰 소여의 모험 4 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:38.797466", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18268, "title": "톰 소여의 모험", "subject": "사랑은 달콤쌉싸름한 것", "description": "또다시 돌아온 월요일 아침. 톰은 학교를 빼먹기 위해 꾀병을 부려보지만 이모에겐 안 통한다. 어쩔 수 없이 학교로 향하던 톰은 허크를 만나고 결국 또 지각을 하고 만다. 선생님 몰래 교실에 들어오다 걸린 톰은 회초리를 맞고 자리까지 옮기게 된다. 그런데 새로운 짝꿍이 다름 아닌 베키였는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15355/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:40.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15636, "name": "톰 소여의 모험 5 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:38.887296", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18269, "title": "톰 소여의 모험", "subject": "허크의 집 짓기", "description": "집을 짓기 시작한 허크. 하지만 도와준다던 톰은 코빼기도 보이지 않고 허크 혼자서 나무와 씨름을 한다. 그 무렵 톰은 베키네 집에서 즐거운 한때를 보내고 선물로 쿠키까지 받는다. 그날 저녁에 허크는 톰에게 찾아가 톱과 망치를 빌려달라고 하고 톰은 그제야 허크와 한 약속이 생각나는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15356/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:37.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15637, "name": "톰 소여의 모험 6 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:38.989208", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18270, "title": "톰 소여의 모험", "subject": "라이벌의 등장", "description": "아침에 물을 길어오던 톰은 길에서 어떤 남자 아이와 부딪힌다. 남자 아이는 실례했다며 사과했지만 톰은 그 애의 건방진 태도에 화가 나 달려든다. 하지만 그 순간 폴리 이모가 나타났고 톰은 어쩔 수 없이 싸움을 멈춘다. 씩씩대며 학교에 간 톰은 교실에서 아침에 싸운 남자 아이를 발견하는데…", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15357/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:38.166000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15638, "name": "톰 소여의 모험 7 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:39.081236", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18271, "title": "톰 소여의 모험", "subject": "꿈에 그리던 증기선", "description": "톰은 친구들과 함께 증기선을 구경하기로 한다. 하지만 약속한 시간에 친구들은 오지 않았고 우연히 만난 허크와 함께 증기선에 몰래 들어간다. 조타실을 구경하던 톰과 허크는 선원이 들어오는 바람에 나가지 못하게 된다. 그러다 결국 배가 출발하고 마는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15358/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:40.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15639, "name": "톰 소여의 모험 8 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-12T18:25:19.497665", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18272, "title": "톰 소여의 모험", "subject": "폴리 이모의 아이들", "description": "톰은 이모가 외출한 틈을 타 허크와 낚시를 하러 가기로 하지만 허크는 몸이 안 좋다며 다음에 가자고 한다. 톰은 허크에게 아플 때 먹는 피마자기름을 갖다 주지만 허트는 안 먹겠다고 한다. 그래서 톰은 시범을 보이기 위해 기름을 먹고 속이 안 좋아져 결국 집으로 돌아간다. 톰은 집에 가는 길에 의사인 미첼을 만나고 그에게 폴리 이모가 편찮으시단 말을 듣는데... ", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15359/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:39.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15640, "name": "톰 소여의 모험 9 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:39.287336", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18273, "title": "톰 소여의 모험", "subject": "마을의 골칫덩어리", "description": "톰과 허크는 강물에 떠내려가던 술주정뱅이 머프를 구해준다. 머프는 그에 대한 보답으로 마을에 해적의 보물이 묻혀 있을 거란 얘기를 해준다. 그 얘기를 들은 톰은 허크에게 보물을 찾으러 가자고 하지만 허크는 거짓말일 거라며 안 가겠다고 한다. 그러던 중 톰과 허크는 해적의 보물을 찾으러 가는 머프와 인디언 조의 모습을 발견하는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15360/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:39.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15641, "name": "톰 소여의 모험 10 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:39.776865", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-07-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18274, "title": "톰 소여의 모험", "subject": "해적의 보물", "description": "베키와 장난을 치고 있던 톰. 그 모습을 본 도빈스 선생님은 톰이 베키를 괴롭히는 줄 알고 톰을 야단친다. 도빈스 선생님이 회초리 벌을 주려던 찰나 시드가 나타나 오해를 풀어준다. 톰은 시드에게 고맙단 인사를 하고 나가려는데 시드가 따라나선다. 톰은 시드에게 중요한 일이 있으니 집에 가라고 하지만 시드는 집요하게 묻는다. 톰은 결국 해적의 보물 이야기를 하고 마는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15361/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:42.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15642, "name": "톰 소여의 모험 11 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:39.894075", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18275, "title": "톰 소여의 모험", "subject": "화가 난 베키", "description": "보물을 찾느라 잠을 못잔 톰은 하루 종일 꾸벅꾸벅 졸면서 다닌다. 그러다 결국 도빈스 선생님께 걸려 회초리를 맞고 그제야 정신을 차린다. 그날 오후, 베키의 집에 초대 받은 톰은 시저 때문에 마음 편히 놀 수가 없었다. 그래서 톰은 베키에게 강가로 산책을 가자고 한다. 그곳에서 톰은 해적의 보물 이야기를 하다가 베키와 약혼을 하게 되는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15362/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:38.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15643, "name": "톰 소여의 모험 12 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.001232", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18276, "title": "톰 소여의 모험", "subject": "해적이 될 거야", "description": "에이미와 약혼을 했다는 톰의 말에 화가난 베키는 톰과의 연락을 끊는다. 톰은 연락이 안되는 베키를 찾아 나서고, 아이들과 놀고 있던 베키에게 다가가지만 베키는 톰을 아는척도 하지 않는다. 베키와의 싸움 후 방황하던 톰은 벤을 만나고, 아빠와 싸우고 집을 나온 벤과 톰은 해적이 되기 위해 모험을 떠나는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15363/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:35.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15644, "name": "톰 소여의 모험 13 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.537352", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18277, "title": "톰 소여의 모험", "subject": "해적은 학교에 다니지 않아", "description": "해적이 되기 위해 집을 나온 톰과 벤과 허크는 섬에서 즐거운 한때를 보낸다. 그런데 갑자기 폭우가 내리고 그들이 타고 온 뗏목이 떠내려가자 벤은 몹시 불안해한다. 한편 톰과 벤의 학교에는 폴리 이모와 벤아빠가 찾아가 아이들에게 그들의 행방을 묻는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15364/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:39.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15645, "name": "톰 소여의 모험 14 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.632818", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18278, "title": "톰 소여의 모험", "subject": "모험에 모험을 거듭하다", "description": "도빈스 선생님이 반 아이들에게 톰과 벤이 물에 빠져 목숨을 잃은 것 같다는 소식을 전하자 아이들은 슬픔에 잠긴다. 그 무렵 톰과 벤 그리고 허크는 섬에서 신나게 놀다가 강에 빠진 시체를 찾는 배를 발견한다. 그러자 톰은 그 배는 자신들 찾는 배라며 마을로 가서 상황을 살펴보고 오겠다고 하는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15365/v15/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:42.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15646, "name": "톰 소여의 모험 15 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.731384", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18279, "title": "톰 소여의 모험", "subject": "톰 소여의 장례식", "description": "마을에선 톰과 벤 그리고 허크의 장례식을 치르기로 한다. 한편 벤은 집에 돌아가고 싶다며 울기 시작했고 허크도 마을이 그리워졌다며 돌아가겠다고 한다. 톰은 그런 두 사람을 섬에서 이틀만 더 머물다가 돌아가자며 설득한다. 그리고 드디어 세 사람은 자신들의 장례식장에 도착하는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15366/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:43.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15647, "name": "톰 소여의 모험 16 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.840325", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18280, "title": "톰 소여의 모험", "subject": "운수 나쁜 날", "description": "마을로 돌아온 톰과 벤은 다음 날 학교에 가자 친구들의 인기를 독차지한다. 하지만 도빈스 선생님은 두 사람을 용서할 수 없다며 회초리를 때린다. 한편 찰리와 놀고 있던 베키는 아이들에게 모험 얘기를 하는 톰이 계속 신경 쓰인다. 베키의 그런 모습에 질투가 난 찰리는 톰의 책에 일부러 잉크를 쏟는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15367/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:43.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15648, "name": "톰 소여의 모험 17 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:40.940899", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18281, "title": "톰 소여의 모험", "subject": "아픈 화해", "description": "톰과 화해하기로 마음먹은 베키는 찰리에게 톰의 책에 일부러 잉크를 쏟은 걸 얘기하겠다고 한다. 그러자 찰리는 톰에게 용서해달라고 하면서 일부러 그런 게 아니라며 거짓말을 한다. 톰은 거짓말인 줄도 모른 채 찰리를 용서해준 뒤 몰래 지켜보던 베키를 발견하고 따라간다. 교실로 들어온 베키는 선생님 서랍에 있던 책을 보다가 톰이 부르는 소리에 놀라 책장을 찢고 마는데... ", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15368/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:41.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15649, "name": "톰 소여의 모험 18 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:41.038446", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18282, "title": "톰 소여의 모험", "subject": "개구리 대결", "description": "톰은 찰리의 개구리와 시합을 하기 위해 학교에 개구리를 가지고 온다. 그런데 톰은 수업시간에 졸다가 상자를 떨어뜨리는 바람에 개구리를 놓치고 만다. 그래서 톰은 허크와 함께 제일 잘 뛰는 개구리를 잡아서 찰리에게 도전장을 내민다. 하지만 첫 시합은 무승부로 끝나고 점심시간에 다시 한번 대결하기로 한다. 그런데 찰리는 아무도 없는 교실에 몰래 들어가 톰의 개구리에 손을 대는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15369/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15650, "name": "톰 소여의 모험 19 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:41.342110", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2017-08-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 18283, "title": "톰 소여의 모험", "subject": "도빈스 선생님의 비밀", "description": "시냇가에서 매 맞은 엉덩이를 식히던 톰은 도빈스 선생님이 가발을 벗는 모습을 보게 된다. 톰은 학교 친구들에게 말해보지만 아이들은 좀처럼 믿지 않는다. 그러던 중 선생님은 자습시간에 졸았다는 이유로 반 아이들 모두를 회초리로 때린다. 여학생들이 맞는 모습을 보고 화가 난 톰은 선생님 머리가 가발이란 것도 밝힐 겸 복수하기로 하는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/15370/v4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:42", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 15651, "name": "톰 소여의 모험 20 대여", "list_price": 600, "period": "7 day", "promotion": null}], "published_datetime": "2018-01-15T15:25:41.445347", "rating": {"rating": 0, "rating_type":