isode_products": [{"id": 2229, "name": "포켓몬스터 XY 10 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-23T15:59:52.934004", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2014-03-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2455, "title": "포켓몬스터 XY 1기&2기", "subject": "대나무숲의 추적! 판짱과 부란다!!", "description": "여행을 하고 있는 지우와 친구들이 점심식사를 하려고 하는 도중, 그 모습을 보고 있던 두 마리의 판짱이라는 포켓몬이 나타나 지우와 친구들의 식사를 전부 먹어 치운다. 그러는 사이에, 로켓단이 나타나 지우와 친구들의 포켓몬을 한꺼번에 잡아 도망가 버리게 된다. 이번이야말로 훌륭하게 작전에 성공한 로켓단이었지만, 사소한 싸움을 하는 바람에 기구가 폭발하고, 피카츄와 포켓몬들은 모두 뿔뿔이 흩어지게 된다. 어떻게든 피카츄와 포켓몬들은 한곳에 모이게 되지만, 나옹은 기구에서 떨어지면서 부란다라는 포켓몬에게 충돌하여 부란다를 화나게 만드는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2341/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:39.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 2230, "name": "포켓몬스터 XY 11 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-23T15:59:52.977213", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2014-03-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2456, "title": "포켓몬스터 XY 1기&2기", "subject": "포켓몬 바이어를 잡아라! 분떠도리 위장작전!!", "description": "여행을 하고 있는 지우와 친구들은 여행도중, 포켓몬 바이어인 데이즈가 여경으로부터 도망가는 장면을 목격하게 된다. 포켓몬 바이어인 데이즈는, 주로 비비용을 팔아서 돈을 벌어들이는 악랄한 악당이다. 지우와 친구들은 데이즈를 쫓아가는 여경을 도우려고 그 뒤를 따라가게 되고, 그 도중에 데이즈가 떨어트린 포켓몬, 분이벌레를 발견하게 된다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2342/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:39.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 2231, "name": "포켓몬스터 XY 12 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-23T15:59:53.023713", "rating": {"rating": 0, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2457, "title": "포켓몬스터 XY 1기&2기", "subject": "님피아 VS 개구마르! 유치원 대소동!", "description": "지우는 여행을 하는 도중에 포켓몬 트레이너인, 프르미에와 포켓몬 시합을 하게 된다. 프르미에는 님피아로, 지우는 개구마르로 승부를 걸게 되는데. 프르미에는 “내가 이기면 사귀는 거다”라며 의미심장한 발언을 하고, 결과적으로 개구마르는 님피아의 헤롱헤롱 공격에 지게 된다. 지우는 약속대로 프르미에와 사귀기로 하고, 프르미에를 따라가게 되는데, 그곳은 프르미에가 일하는 유치원이었다. 프르미에는 다양한 포켓몬을 유치원에 데리고 와서 유치원 아이들에게 포켓몬과 만남의 기회를 마련하고자 하는 것이었다. 피카츄와 포켓몬들을 만난 유치원 아이들은 크게 기뻐했다. 하지만 그중에, 포켓몬에게 가까이 가려고 하지 않는 한 아이가 있는데 그 아이의 이름은 랜디. 랜디가 포켓몬을 무서워하는 이유는......?", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2343/v4/Thumbnail.0000049.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:20:38.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 2232, "name": "포켓몬스터 XY 13 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-23T15:59:53.070023", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "IPTV", "broadcast_date": "2014-03-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2458, "title": "포켓몬스터 XY 1기&2기", "subject": "음침한 저택의 기이한 사건! 냐스퍼는 보고 있다!", "description": "여행을 하고 있는 지우와 친구들은 비를 피하려고 한 저택 안으로 들어가게 된다. 그 무렵에, 로켓단도 비를 피하려고 같은 저택 안으로 들어가게 된다. 그 저택은 인기척은 없지만, 갑자기 불이 켜지거나 