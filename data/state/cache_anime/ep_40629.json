lassification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51029, "title": "(더빙) 괴도 키드 1412", "subject": "승부사 vs 마술사", "description": "인호의 당구장이 조직의 손에 넘어갈 위기에 처한 걸 알게 된 희도. 전설의 큐를 찾으러 조직의 보스가 운영하는 당구장에 간다. 거기서 과거에 인호를 이겨 전설의 큐를 뺏어간 당구 고수, 하승진의 게임을 보게 되는데.. 희도는 인호에게 전설의 큐를 찾아주기 위해 하승진과 당구 대결을 한다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/52819/v15/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:00.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67820, "name": "(더빙) 괴도 키드 1412 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2021-12-10T19:30:00.029303", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 51030, "title": "(더빙) 괴도 키드 1412", "subject": "명탐정은 백일하에", "description": "런던에서 온 유명한 고등학생 탐정 백준수. 준수는 키드를 잡기 위해 키드가 예고한 현장에 나타난다. 키드가 도망갈 곳을 모두 차단한 준수는 의기양양하지만 키드는 행글라이더로 도망을 치는데.. 그런데 다음날 준수는 희도의 반으로 전학을 오고, 청아와 라이브 공연을 보러 가기 위해 키드를 잡겠다고 약속한다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/11/52820/v15/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:01.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 67819, "name": "(더빙) 괴도 키드 1412 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2021-12-10T19:30:00.029303", "rating": {"rating": 15, "rating_type": null, "classification_