: {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67425, "title": "(자막) 언데드 언럭", "subject": "리우데자네이루", "description": "부정자 언리페어와 접촉하기 위해 리우데자네이루에 도착한 앤디와 후코. 두 사람은 변장을 위해 양복과 드레스로 빼입고 호화 여객선의 승객으로 잠입한다. 더없이 호화로운 여객선 내부. 그런데 그곳에서 열리는 건, 같은 인간인 부정자를 상품으로 사고파는 블랙 옥션이었다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74692/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96827, "name": "언데드 언럭 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-16T12:00:13.008810", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67580, "title": "(자막) 언데드 언럭", "subject": "액티베이트", "description": "후코와 앤디가 접촉하려고 한 부정자 언리페어는 일명 ‘부정자 사냥’이라고 불리는 무리 중 1명이었다. 그들의 목적은 경매품으로 잡혀 온 부정자 ‘치카라’를 포획하거나 죽이는 것. 치카라의 능력은 쓸모가 있지만 용기 없는 치카라는 쓸모없다고 생각한 언리페어는 치카라를 죽이고 그 능력을 다른 사람에게 옮기려 한다. 개틀링 건이 발사되고 죽음을 확신한 순간, 앤디가 온몸으로 총알을 막으며 치카라를 보호하고 있었다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/75006/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96994, "name": "언데드 언럭 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2023-12-23T12:00:08.361760", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-12-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68031, "title": "(자막) 언데드 언럭", "subject": "타치아나", "description": "다섯 살 생일을 맞이하던 날, 타치아나는 갑자기 모든 사물과의 접촉을 부정하는 언터처블 부정자가 된다. 의지와는 상관없이 발동하는 강제 발동형 능력은 타치아나에게서 가족과 집을 앗아갔고, 경매품으로 올라온 타치아나를 빌리가 구하면서 그녀는 유니온의 멤버가 된다. 그런 슬픈 과거를 지닌 타치아니에게 후코는 부정자가 된 후 처음 생긴 친구였다. 타치아나는 죽음의 위기에 놓인 후코를 구하기 위해 억제해 왔던 능력을 해방한다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75367/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97515, "name": "(자막) 언데드 언럭 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-01-06T12:00:09.263613", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-01-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68167, "title": "(자막) 언데드 언럭", "subject": "크림슨 불릿", "description": "타치아나가 엄청난 파괴 능력 때문에 공중으로 날아간 앤디와 립. 여기서 립을 놓치면 후코가 죽는다는 앤디의 말에 치카라는 마음을 다지며 싸움에 임한다. 후코와 치카라를 지키며 싸우는 앤디와 아티팩트를 이용해 공격을 밀어붙이는 립. 치열한 공방전이 펼쳐지는 가운데 싸움은 막바지에 다다른다!", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75547/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97784, "name": "(자막) 언데드 언럭 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-01-13T12:00:08.698269", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-01-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68288, "title": "(자막) 언데드 언럭", "subject": "언더", "description": "앤디는 치카라에게 유니온에 들어올지 말지 고민해 보라며 일주일이라는 시간을 준다. 그리고 일주일 뒤, 치카라의 학교를 찾아간 후코와 앤디 앞에 죽은 줄 알았던 립이 나타난다. 립은 후코와 앤디에게 선물이라며 아티팩트를 건네는데 그 안에는 이 세계를 멸망시킬 신의 그림자가 담겨 있다. 자신들을 언더라고 칭하는 립은 석 달 뒤 일어날 격변을 예고하고 사라진다. 한편, 후코와 앤디를 만나기 위해 나타난 치카라는 자신의 어두운 과거를 고백하는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/75808/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97917, "name": "(자막) 언데드 언럭 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-01-20T12:00:09.086273", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-01-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68595, "title": "(자막) 언데드 언럭", "subject": "레볼루션", "description": "새로운 퀘스트가 발표된 직후, 빌리는 유마를 토벌하는 데 수많은 사람들이 희생될 수 있는 핵무기 사용을 제안한다. 아무리 반복해도 쥬이스는 신을 죽일 수 없다고 말하는 빌리는 갑자기 원탁의 멤버에게 총을 쏜다. 갑작스러운 빌리의 행동에 혼란에 빠진 원탁의 멤버들. 그 순간, 원탁이 불길에 휩싸이더니 UMA 번이 나타난다. 그리고 번의 머리 위에는 자신들을 언더라고 칭하던 립과 라트라의 모습이 보인다. 그런데 립은 빌리를 향해 보스라고 부르는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/76034/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98372, "name": "(자막) 언데드 언럭 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-01-27T12:00:09.237987", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-01-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68714, "title": "(자막) 언데드 언럭", "subject": "아웃 스마트", "description": "언더의 리더라는 정체를 드러낸 빌리가 원탁과 아포칼립스를 빼앗으려 하자, 유니온은 그를 막기 위해 후코와 앤디를 지원하는 데 총력을 기울인다. 그리고 유니온의 노력과 후코의 불운으로 UMA 번을 저지하는 듯했다. 하지만 여러 가지 부정 능력을 쓰는 빌리는 결국 원탁을 빼앗아 지상으로 나가는 데 성공한다. 이때 빌리 앞에 타치아나가 나타나는데…", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76198/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98506, "name": "(자막) 언데드 언럭 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-02-03T12:00:09.484406", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-02-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 68866, "title": "(자막) 언데드 언럭", "subject": "크라이 포 더 문", "description": "빌리의 배반으로 유니온은 큰 타격을 입는다. 혼란에 빠진 원탁의 멤버를 소집한 쥬이스는 이 세계가 신에 의해 파괴와 재생을 수없이 반복해 왔다고 말한다. 또한 쥬이스 자신은 아크라는 아티팩트를 통해, 빅토르는 불사의 능력을 통해 지금까지 루프를 경험해 왔으며, 이치에서 벗어날 수 있는 방법은 스스로 죽거나 신을 죽이는 수밖에 없다고 말한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76530/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98778, "name": "(자막) 언데드 언럭 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-02-10T12:00:09.049860", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-02-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69235, "title": "(자막) 언데드 언럭", "subject": "언데드 + 언럭", "description": "후코의 삶에 있어서 버팀목이 되어 준 만화 ‘네게 전해지길’. 쥬이스는 그 만화가 이 세계의 예언서일지 모른다고 얘기하며, 앤디와 후코에게 그 만화를 그린 안노 운을 조사하라고 지시한다. 만화가와 직접 접촉하기 위한 수단으로 만화를 그려야 하는 후코는 머리를 싸매고 고민하지만, 앤디는 죽도록 가슴 뛰는 걸 떠올리면 된다고 후코를 격려한다. 이에 자신의 마음을 들여다보고 자신의 경험을 바탕으로 ‘언데드 + 언럭’이란 만화를 완성한 후코는 앤디와 함께 출판사로 향한다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76761/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99141, "name": "(자막) 언데드 언럭 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-02-17T12:00:11.853583", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-02-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69325, "title": "(자막) 언데드 언럭", "subject": "안노 운", "description": "안노 운을 만나기 위해 캐나다로 향하는 후코와 앤디는 안노 운이 자신들의 존재를 알고 있으며 유니온에 대해서도 파악하고 있음을 짐작한다. 약속 장소에 기척도 없이 나타난 안노 운은 후코와 앤디가 오텀과 싸우면서 본인들에 대해 알게 되고 더욱더 강해질 거라고 예언한다. 그런데 그 순간 누군가의 비명이 들린다. 소리가 나는 곳으로 달려간 후코와 앤디는 그곳에서 사람의 인생을 먹는 UMA, 오텀과 맞닥뜨린다.", "episode_num": "20", "episode_order": 20