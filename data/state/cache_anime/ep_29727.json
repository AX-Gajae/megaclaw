nail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99640, "name": "죠죠의 기묘한 모험 시즌 1 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99639, "name": "죠죠의 기묘한 모험 시즌 1 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-02T00:00:08.731262", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2018-MF01798", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성", "모방위험", "주제", "대사", "공포", "선정성", "약물"]}, "access_type": null, "is_available": false}, {"id": 69460, "title": "죠죠의 기묘한 모험 시즌 1: 팬텀 블러드/전투조류", "subject": "JOJO vs. 궁극 생물", "description": "마침내 멕시코의 지하 연구소에 도착한 죠셉. '기둥 속 사내 산타나'와 대면하고, 서로 전투태세에 돌입한다. 하지만 산타나의 몸은 죠셉의 파문 에너지를 튕겨내서 외부에서의 공격은 닿지 않는다. 그에 죠셉은 산타나의 몸속에서 직접 파문을 흘리려고 고육지책을 쓴다. 하지만 흡혈귀를 훨씬 뛰어넘는 능력을 가진 산타나에게 죠셉의 파문은 치명적인 영향을 주지 못하는데...", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76245/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99642, "name": "죠죠의 기묘한 모험 시즌 1 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99641, "name": "죠죠의 기묘한 모험 시즌 1 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-02T00:00:08.731262", "rating": {"rating": 19, "rating_type": "영상물등급위원회", "classification_number": "2018-MF01798", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성", "모방위험", "주제", "대사", "공포", "선정성", "약물"]}, "access_type": null, "is_availab