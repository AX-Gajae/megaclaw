mber": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-01-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88186, "title": "빈란드 사가 시즌 2", "subject": "뱀", "description": "농장을 지키는 용병들과 함께 술을 마시러 간 올마르. 모두가 자신을 비웃고 한심하게 생각한다면서 좌절하는 올마르에게 용병들은 인정받기 위한 방법을 알려준다. 그 방법은 다름 아닌 살인을 해보는 것. 한편, 지독한 악몽에 시달리다가 깨어난 토르핀은 왠지 모르게 가슴이 요동치는 걸 느낀다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99595/v30/3497963df476/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:44.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124895, "name": "빈란드 사가 시즌 2 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:08.921979", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88187, "title": "빈란드 사가 시즌 2", "subject": "깨달음", "description": "용병들에게 불려 가 죽임당할 위험에 처한 에이나르와 토르핀. 그런데 토르핀이 죽음을 전혀 두려워하지 않자, 화가 난 용병 ‘여우’는 토르핀의 몸을 조금씩 베어가며 상처를 낸다. 그러던 중 용병들의 두목 ‘뱀’이 그 자리에 나타난다. 갑작스러운 뱀의 공격에 토르핀은 자기도 모르게 받아친다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99596/v30/4aa4d383bc7c/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:44.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124896, "name": "빈란드 사가 시즌 2 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.204157", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88188, "title": "빈란드 사가 시즌 2", "subject": "피 묻은 길", "description": "크누트 왕자를 지키기 위해 스벤 왕의 목을 베어버렸던 아셰라드. 그 이후 크누트는 스벤 왕의 뒤를 이어서 덴마크 군의 총대장이 되어 잉글랜드 침공을 이어 나간다. 이전의 유약한 모습은 온데간데없이 냉혹하고 단호한 군주의 모습을 보이는 크누트에게 토르켈은 거침없는 충고를 던진다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99597/v30/a89c96a24e2a/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:49.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124897, "name": "빈란드 사가 시즌 2 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.363925", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88189, "title": "빈란드 사가 시즌 2", "subject": "말을 달라", "description": "숲의 나무들을 어느 정도 베어낸 에이나르와 토르핀은 본격적으로 밭을 만들려고 하지만, 사람 힘만으로 나무 그루터기들을 뽑는 건 매우 힘든 일이었다. 에이나르는 말이 필요하다고 판단하고, 고용인에게 말을 빌려달라고 부탁하지만 거절당한다. 그때 에이나르와 토르핀의 얘기를 들은 어느 노인이 이들에게 거래를 제안한다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99599/v30/041c12c78ae4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:49.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124898, "name": "빈란드 사가 시즌 2 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.519649", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-02-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88190, "title": "빈란드 사가 시즌 2", "subject": "철권 케틸", "description": "토르핀과 에이나르는 자신들이 만든 보리밭에 싹이 나자 기뻐하며 보람을 느낀다. 한편, 케틸의 농장에서 상습적으로 도둑질을 해가던 남매가 용병에게 붙잡힌다. 케틸의 첫째 아들 토르길은 남매에게 중벌을 내려야 한다고 주장하지만, 케틸은 남매의 딱한 사정을 듣고 난처해한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99600/v30/748d396b62ed/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:47.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124899, "name": "빈란드 사가 시즌 2 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.676563", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-03-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88191, "title": "빈란드 사가 시즌 2", "subject": "텅 빈 남자", "description": "밤마다 계속해서 지독한 악몽에 시달리는 토르핀. 아버지의 원수 아셰라드의 죽음으로 인해 원망할 상대를 잃은 토르핀은 앞으로 어떻게 살아가야 할지 몰라 방황하고 있었다. 한편, 농장의 고용인들은 토르핀과 에이나르가 심은 보리가 어느덧 많이 자란 것을 보고 못마땅해한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99601/v30/0df55c74d4d4/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:47.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124900, "name": "빈란드 사가 시즌 2 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.834780", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-03-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88192, "title": "빈란드 사가 시즌 2", "subject": "맹세", "description": "순간적으로 화를 참지 못하고 고용인에게 주먹을 날려버린 토르핀. 고용인들의 반격에 쓰러진 토르핀은 꿈속에서 어딘가 깊은 곳으로 떨어진다. 그곳에서는 수없이 많은 전사들이 끔찍한 모습으로 싸우고 있었다. 당혹스러운 눈으로 그들을 바라보는 토르핀 앞에 아셰라드가 나타난다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99602/v30/4c35dff02547/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:46.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124901, "name": "빈란드 사가 시즌 2 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:09.992789", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-03-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88193, "title": "빈란드 사가 시즌 2", "subject": "저주의 목", "description": "토르핀과 에이나르는 드디어 숲의 마지막 한 그루까지 모두 베어낸다. 자유 신분으로 돌아갈 날이 얼마 남지 않자, 토르핀은 그동안 막연하게 생각해왔던 꿈을 에이나르에게 말한다. 한편 스벤의 장남 하랄 왕이 병으로 쓰러지자, 크누트는 병문안을 위해 덴마크 옐링으로 향한다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99603/v30/cc1c8a9a9de3/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:46.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124902, "name": "빈란드 사가 시즌 2 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.165677", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-03-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88194, "title": "빈란드 사가 시즌 2", "subject": "왕과 검", "description": "하랄의 병문안을 위해 옐링에 온 케틸은 하랄이 이미 세상을 떠났다는 소식을 듣고 허탈감에 주저앉는다. 어쩔 수 없이 케틸은 다음 덴마크 왕이 될 크누트를 만나서 좋은 관계를 맺어두기로 한다. 그리고 그 시각, 올마르는 마을에서 한 젊은이와 시비가 붙어 싸우고 있었다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99604/v30/6c2b9c01c031/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:44.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124903, "name": "빈란드 사가 시즌 2 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.320649", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-03-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88195, "title": "빈란드 사가 시즌 2", "subject": "잃어버린 사랑을 위해", "description": "크누트 앞에서 종사단에 들어가게 해달라고 소리쳤다가 형편없는 검 실력만 보여주고 망신당한 올마르. 종사장의 지시를 받은 전사들은 올마르에게 종사단 불합격 소식을 전해주며 올마르를 놀린다. 도를 넘어선 심한 모욕에 올마르는 화를 참지 못하고 전사들에게 결투를 신청한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99605/v30/7d1caaaaba1a/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:44.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124904, "name": "빈란드 사가 시즌 2 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.478221", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88196, "title": "빈란드 사가 시즌 2", "subject": "암운", "description": "케틸의 농장 주변에서 한 노예가 주인 일가를 죽이고 탈주하는 사건이 일어난다. 한편, 농장에서는 자유가 코앞으로 다가온 토르핀과 에이나르가 앞으로의 삶에 대해 고민하고 있었다. 자유의 몸이 될 수 없는 아르네이즈를 걱정하는 에이나르. 그러던 중, 스벨켈이 밭에서 쓰러진 채로 발견된다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99606/v30/80d5c4b92a4a/Thumbnail.0000062.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:51.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124905, "name": "빈란드 사가 시즌 2 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.632964", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88197, "title": "빈란드 사가 시즌 2", "subject": "자유", "description": "케틸의 농장에서 헤어졌던 아내와 재회한 가르다르. 그러나 기쁨도 잠시, 뱀과 그 부하들에게 둘러싸인다. 에이나르는 아르네이즈가 자유가 되길 바라며 뱀과 맞서 싸우려고 하지만, 자신에게는 힘이 부족하다는 걸 알고 갈등한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99607/v30/a8a942dac12f/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:48.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124906, "name": "빈란드 사가 시즌 2 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.783694", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88198, "title": "빈란드 사가 시즌 2", "subject": "폭풍", "description": "가르다르가 걱정되어 밤중에 홀로 집을 나선 아르네이즈는 뱀의 부하에게 부탁하여 가르다르를 만난다. 초라한 몰골로 묶여 있는 가르다르는 아르네이즈에게 밧줄을 풀어달라고 요청한다. 그리고 감시병이 방심하고 가까이 다가온 순간, 가르다르가 그에게 달려든다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99608/v30/df79b076d5ff/Thumbnail.0000061.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:47.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124907, "name": "빈란드 사가 시즌 2 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:10.933197", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 88199, "title": "빈란드 사가 시즌 2", "subject": "대의", "description": "밤중에 뱀의 부하들을 죽이고 도망친 가르다르. 뱀은 가르다르가 아직 근처에 있을 거라 판단하고 아르네이즈를 미끼로 써서 붙잡으려고 한다. 한편, 아르네이즈에게 지난밤 이야기를 들은 에이나르와 토르핀은 망설임 끝에 그녀가 가르다르와 도망칠 수 있도록 돕기로 한다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99609/v30/a61bcf89bdd1/Thumbnail.0000062.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:50.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124908, "name": "빈란드 사가 시즌 2 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-10-31T22:00:11.086494", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number":