https://thumbnail.laftel.net/assets/2023/11/73777/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90183, "name": "코드 기아스 : 반역의 를르슈 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 90182, "name": "코드 기아스 : 반역의 를르슈 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-20T10:00:09.519207", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66219, "title": "코드 기아스 반역의 를르슈", "subject": "홍련 춤추다", "description": "일본 해방전선의 본거지가 있다고 여겨지는 나리타 산맥에 코넬리아가 이끄는 브리타니아군이 기습해 왔다. 그 정보를 입수한 를르슈는 흑의 기사단을 이끌고 나리타 산맥으로 향한다. 코넬리아의 공격에 괴멸해가는 일본 해방전선의 부대. 중과부적으로 승산이 없다고 두려워하는 흑의 기사단의 멤버들을 고무시키며 를르슈는 이번 전쟁에서 기적을 일으키겠다고 선언하고 코넬리아를 향해 첫 일본제 나이트메어 홍련 2식을 출격 시키는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73776/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90181, "name": "코드 기아스 : 반역의 를르슈 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 90180, "name": "코드 기아스 : 반역의 를르슈 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-20T10:00:09.519207", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66932, "title": "코드 기아스 반역의 를르슈", "subject": "나리타 공방전", "description": "나리타 산맥에서 코넬리아의 부대를 고립시키는 데 성공한 흑의 기사단. 를르슈는 드디어 코넬리아의 품에 파고들어 투항할 것을 명령한다. 하지만, 목숨을 걸고 싸울 각오를 보이는 코넬리아. 스자쿠가 조종하는 랜슬롯의 맹공에 전황은 뒤집혀서 흑의 기사단은 철수할 수밖에 없게 된다. 제로를 뒤쫓는 스자쿠였지만 C.C.의 미지의 능력 때문에 움직일 수 없게 돼 버린다. C.C.의 힘에 머리속을 침식당하는 스자쿠. 악몽같은 이미지 속에서 죽은 아버지와 대면하게 되었는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74049/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90980, "name": "코드 기아스 : 반역의 를르슈 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 90979, "name": "코드 기아스 : 반역의 를르슈 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-27T10:00:08.815835", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66933, "title": "코드 기아스 반역의 를르슈", "subject": "교토에서 온 사자", "description": "용기를 내 를르슈에게 데이트 신청을 한 셜리. 하지만 를르슈는 흑의 기사단 멤버들과 함께 '교토'의 대표와 대면하기 위해 후지 광산으로 향하고 있었다. 교토의 대표는 제로의 정체를 추궁한다. 한편, 셜리에게 예상 밖의 비극이 찾아왔는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74051/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90991, "name": "코드 기아스 : 반역의 를르슈 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 90990, "name": "코드 기아스 : 반역의 를르슈 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-27T10:00:08.815835", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-11-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67080, "title": "코드 기아스 반역의 를르슈", "subject": "셜리와 총구", "description": "나리타에서의 전투에 휘말려 벌어진 어떤 사건이 를르슈와 카렌의 마음을 괴롭힌다. 신념을 관철해 브리타니아와 싸워나갈 것을 결심한 를르슈는 흑의 기사단을 이끌고 코넬리아군을 향해 출격한다. 스자쿠가 조종하는 랜슬롯과 대치하게 되었는데, 그러던 중 그 자리에 있을 리 없는 셜리의 모습을 발견한 를르슈. 셜리는 어떤 인물로부터 를르슈와 흑의 기사단이 연관되어 있다는 말을 듣고 를르슈의 뒤를 쫓아온 것이었는데.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74174/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96292, "name": "코드 기아스 : 반역의 를르슈 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96291, "name": "코드 기아스 : 반역의 를르슈 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-04T10:00:13.340541", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67081, "title": "코드 기아스 반역의 를르슈", "subject": "기아스 대 기아스", "description": "셜리에게 비밀을 들켰다고 의심하며 그녀의 뒤를 쫓는 를르슈. 어떻게 처리할 거냐고 C.C.는 묻지만 해답은 없었다. 그때, 셜리는 나리타에서 마오라는 수수께끼의 남자를 만났다. 마오는 인간의 사고를 읽어내는 기아스 능력자였다. 그가 조종하는 대로 어떤 죄를 속죄하기 위해 죽음을 선택하려 하는 셜리. C.C.는 한태 자신이 기아스 능력을 부여했던 남자와 대치했고, 를르슈는 진실을 알게 된 셜리와의 이별을 결심하는데.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74178/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0: