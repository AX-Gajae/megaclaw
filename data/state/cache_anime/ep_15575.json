ification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67438, "title": "코드 기아스 반역의 를르슈", "subject": "쿠루루기 스자쿠에게 명한다", "description": "유페미아의 기사가 된 스자쿠. C.C.는 스자쿠에게 기아스를 쓰라고 를르슈에게 말한다. 그것을 거절하고, 유페미아를 기습한 흑의 기사단. 이 위기에 랜슬롯이 출동했지만, 를르슈는 자신을 미끼로 랜슬롯을 기다리고 있었는데!", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/74719/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96849, "name": "코드 기아스 : 반역의 를르슈 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96848, "name": "코드 기아스 : 반역의 를르슈 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-18T10:00:08.268096", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67591, "title": "코드 기아스 반역의 를르슈", "subject": "신의 섬", "description": "시키네 섬에서 떨어진 외딴섬. 카미네 섬에서 눈을 뜬 스자쿠. 카렌과 조우해 그녀가 흑의 기사단의 멤버라는 것을 알게 된다. 한편, 마찬가지로 카미네섬으로 표류한 를르슈는 그곳에서 유페미아를 만난다. 한편, 섬 안쪽 동굴에서는 슈나이젤 일행이 유적을 조사하고 있었다. 이 세 그룹이 만났을 때 일어난 일은?!", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/12/75016/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96996, "name": "코드 기아스 : 반역의 를르슈 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96995, "name": "코드 기아스 : 반역의 를르슈 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-25T10:00:08.354435", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67592, "title": "코드 기아스 반역의 를르슈", "subject": "규슈 전역", "description": "전 쿠루루기 정권의 멤버였던 사와사키 아츠시가 후쿠오카 기지를 점거하고 '일본'의 독립을 선언한다. 하지만, 그것은 중화연방의 꼭두각시에 불과했다. 이에 를르슈는 합세하지 않고 역으로 흑의 시가단이 도쿄에 독립 국가를 도쿄에 만들겠다고 말했다. 그때 유페미아의 기사직을 사퇴한 스자쿠는 혼자 랜슬롯으로 후쿠오카를 향해 출격했다 하지만, 압도적인 사와사키의 군대 앞에서 궁지에 몰리고 말았는데!", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/01/76054/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 97008, "name": "코드 기아스 : 반역의 를르슈 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 97007, "name": "코드 기아스 : 반역의 를르슈 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-12-25T10:00:08.354435", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-12-24", "rating_components": []}, "access_type": null, "is_available": false}]}