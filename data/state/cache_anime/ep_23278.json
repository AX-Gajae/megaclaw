ber": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11351, "title": "알바 뛰는 마왕님!", "subject": "마왕, 신주쿠에서 후배와 데이트하다", "description": "용사와 마왕, 모두를 대상으로 공격해온 마력탄의 주인공은 용사에게 협박전화를 걸어온다. 엔테 이슬라를 언급하는 의문의 존재 때문에 마음이 심란해진 용사. \n그런데 그때 경찰서에서까지 전화가 걸려오는데...\n", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9478/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7801, "name": "알바 뛰는 마왕님! 3 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 21697, "name": "알바 뛰는 마왕님! 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:13:03.478631", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 11352, "title": "알바 뛰는 마왕님!", "subject": "용사, 마음의 온기를 느끼다", "description": "지진으로 지하도에 깔린 사람들을 돕는 마왕의 모습을 본 에밀리아는 동요한다.\n자신의 고향과 아버지의 목숨을 빼앗아간 마왕에게 복수심만을 안고 있었던 에밀리아는 향후 자신이 어떻게 행동해야 할지 고민하게 되는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/9479/v1/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:38.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 7802, "name": "알바 뛰는 마왕님! 4 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 21698, "name": "알바 뛰는 마왕님! 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-15T13:1