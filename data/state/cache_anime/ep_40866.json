ing": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2022-04-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54149, "title": "그럼에도 세상은 아름답다", "subject": "Wild waltz", "description": "리비와 함께 세상을 정복했으나 불현듯 나라를 떠난 맑음의 대국의 재상, 발드윈이 귀국하였다. 발드윈의 귀환에 왕국이 웅성거리는 가운데, 그 사실을 아는지 모르는지 발드윈은 니케에게 추파를 던지며 리비의 분노를 사게 된다. 과연 발드윈이 맑음의 대국으로 돌아온 이유는? 그리고 니케와 리비의 애정전선의 행방은…?", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56775/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72368, "name": "그럼에도 세상은 아름답다 - 판권 부활 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2022-04-25T01:00:00.094134", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2022-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54150, "title": "그럼에도 세상은 아름답다", "subject": "비 피하기", "description": "리비의 분노를 사 감옥에 투옥된 발드윈. 니케는 두 사람의 사이를 중재하고자 노력하지만, 오랜 시간 동안 굳어진 두 사람의 마음은 쉽게 풀리지 않았다. 이렇게 두 사람의 관계는 엇갈린 채로 끝나게 되는 걸까? 니케는 고민 끝에 리비와 발드윈이 마음을 놓고 얘기할 수 있도록, 닐과 함께 어떤 계획을 꾸미기 시작하는데...", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/04/56776/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72367, "name": "그럼에도 세상은 아름답다 - 판권 부활 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime"