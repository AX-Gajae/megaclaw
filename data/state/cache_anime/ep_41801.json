 "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74013/v15/Thumbnail.0000020.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:26.666000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90837, "name": "(영어) RWBY vol.1 9 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-30T00:00:08.749877", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66828, "title": "RWBY vol.1 - 영어", "subject": "배지와 책임 2", "description": "수업에 집중하지 못하는 팀원들을 못마땅하게 보던 와이스는 그림과의 실전 수업에 자원해 이기지만 루비에게 계속 화를 내다 헤어지고, 루비는 오즈핀 교장에게, 와이스는 포트 교수에게 팀의 의미에 대해 설명받는다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74014/v15/Thumbnail.0000023.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:09:43.733000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90836, "name": "(영어) RWBY vol.1 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-30T00:00:08.749877", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66829, "title": "RWBY vol.1 - 영어", "subject": "쟝의 성장", "description": "존은 대련 실력과 수업 따라가는 실력이 부족해 낙심하고, 학생들을 괴롭히던 카딘 일당 중 카딘은 존을 계속 괴롭힌다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/74006/v15/Thumbnail.0