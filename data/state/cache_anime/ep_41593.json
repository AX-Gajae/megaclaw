터 시작된다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/91177/v30/deb18ef20ae0/Thumbnail.0000016.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:06:48.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111589, "name": "집이 없어 8 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 111588, "name": "집이 없어 8 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-15T21:00:06.023530", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2024-VK04956", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성", "대사"]}, "access_type": null, "is_available": false}]}