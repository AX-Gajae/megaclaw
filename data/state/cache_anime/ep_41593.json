s": [], "episode_products": [{"id": 111581, "name": "집이 없어 4 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 111580, "name": "집이 없어 4 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-08T21:00:06.440880", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2024-VK04956", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성", "대사"]}, "access_type": null, "is_available": false}, {"id": 78773, "title": "집이 없어", "subject": "원래의 자리로", "description": "백은영은 신기숙사에 공석이 하나 생겼다는 소식과 그 자리에 고해준이 들어간다는 것을 알게 된다. \r\n 심란한 백은영은 터덜터덜 돌아온 구기숙사에 방치했던 쓰레기를 멍하니 보다가 고해준의 발걸음 소리가 들리니 저도 모르게 널부러진 쓰레기들을 서둘러 치우고 있다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/91174/v30/1bd48445b050/Thumbnail.0000016.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:06:48.500000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 111583, "name": "집이 없어 5 대여", "list_price": 500, "period": "7 day", "promotion": null}, {"id": 111582, "name": "집이 없어 5 소장", "list_price": 1100, "period": "0 day", "promotion": null}], "published_datetime": "2024-11-08T21:00:06.644563", "rating": {"rating": 15, "rating_type": "영상물등급위원회", "classification_number": "2024-VK04956", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["폭력성", "대사"]}, "access_type": null, "is_available": false}, {"id": 78774, "title": "집이 없어", "subject": "이사, 아니 전학?!", "description": "고해준이 신기숙사에 가지 않는다는 얘기를 듣고 내심 안심한 백은영.\r\n 하지만 다음날 고해준이 아예 전학을 가버린다는 소문을 듣고, 고해준에게 섭섭함과 짜증을 퍼붓고, 해준에게는 예전 엄마와 살던 집이 여전히 어두운 추억으로 남아있다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/02/91175/v30/43872a75b371/Thumbnail.0000015.jpg", "has_preview": false, "access_info_list": [], 