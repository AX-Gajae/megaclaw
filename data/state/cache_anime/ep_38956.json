g": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-11-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24100, "title": "(더빙) 이누야샤 3기", "subject": "돌 꽃과 싯포의 첫사랑!", "description": "싯포가 예전에 살던 마을과 비슷한 곳에 도착한 이누야샤 일행. 이들은 이곳에 사혼의 구슬 조각이 있다는 소문을 듣고 찾아왔지만 가영이는 구슬 조각의 낌새를 알아차리지 못한다. 결국 흩어져서 찾아 보기로 한 이누야샤 일행. 구슬 조각을 찾던 싯포는 동네 아이들한테 몰매를 맞는 한 소녀를 만나고 이 소녀가 사혼의 조각을 가지고 있다는 걸 알게 되는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91867/v30/11c363881610/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20063, "name": "이누야샤 3기 (더빙) 3 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-11-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24101, "title": "(더빙) 이누야샤 3기", "subject": "안개 속 미녀의 유혹!", "description": "남자들이 산에만 들어가면 돌아오지 않는 한 마을. 범인은 엄청난 미녀 요괴라고 한다. 미녀라는 소리에 혹해 산으로 향하는 미륵. 결국 아리따운 공주를 만나 키스까지 하기에 이른다. 질투심 반, 걱정 반에 미륵을 쫓아온 산고는 이 모습을 보고 이성을 잃는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91868/v30/e2276beee1a6/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:39.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20064, "name": "이누야샤 3기 (더빙) 4 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime"