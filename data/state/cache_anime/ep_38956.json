 "episode_products": [{"id": 20072, "name": "이누야샤 3기 (더빙) 12 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-12-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24110, "title": "(더빙) 이누야샤 3기", "subject": "청춘의 날이여, 안녕!", "description": "한마을에서 요괴를 퇴치해주고 마을에서 쉬게 된 이누야사 일행. 밤이 되자 갑자기 산고가 은밀히 미륵의 방에 찾아드는데... 미륵은 엉큼하게 반가이 맞아들이지만 갑자기 미륵을 공격하는 산고. 그런데 산고만이 아니라 미륵, 이누야사 역시... 그러던 중 싯포는 처음 보는 벼룩을 발견하게 되는데…", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91877/v30/1075f1ac5b5f/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:40.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 20073, "name": "이누야샤 3기 (더빙) 13 대여", "list_price": 500, "period": "7 day", "promotion": null}], "published_datetime": "2018-09-18T15:35:47.357934", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2003-12-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 24111, "title": "(더빙) 이누야샤 3기", "subject": "나락의 결계와 카라의 결심!", "description": "초하루가 되어가자 코우가와 이누야사가 이상하게 나락의 냄새를 느끼기 시작한다. 결국 이들이 나락의 성의 근처까지 찾아들자 카라는 코우가를 없애기 위해 해골군단을 이끌고 공격하기 시작한다. 이 싸움에서 코우가는 다리에 박혀있던 사혼의 구슬 조각을 빼앗기게 되고 목숨까지 위험해지지만 자신을 도와주러 나타난 이누야사 일행 때문에 간신히 목숨을 건진다. 한편 카라는 바람처럼 자유롭게 살고 싶다는 욕망을 버리지 못하고 나락으로부터 벗어나고자 하는데…", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91878/v30/520c26970d11/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:39.066000", "progressbar": nu