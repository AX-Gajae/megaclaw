il_path": "https://thumbnail.laftel.net/assets/2018/12/10160/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.100000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:04.357075", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-07T20:46:11.180725", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 12038, "title": "내 여자친구와 소꿉친구가 완전 수라장 [2019년 판권 만료작]", "subject": "잿빛 세계를 가르는 수라장", "description": "전생에서 에이타와 연인 관계였다는 버닝 푸딩 프린세스, 아키시노 히메카. \n그녀는 일류 전사의 매력을 갖추기 위해 소녀들의 모임에 들어오고자 한다.\n그리고 그녀만의 각오가 적힌 시를 적어오는데...\n한편, 마스즈 앞에는 아버지의 명령을 전하러 온 여동생 마나가 다시 한번 나타난다.\n", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/10161/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.100000", "progressbar": null, "item_expire_datetime": "2019-05-20T13:58:04.357075", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-08-07T20:46:11.532574", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 12039, "title": "내 여자친구와 소꿉친구가 완전 수라장 [2019년 판권 만료작]", "subject": "하기강습인데 수라장", "description": "일방적으로 소녀들의 모임 폐부를 통보 한 선도부 후유우미를 학원에서 만난 에이타. \n카오루의 소꿉친구이기도 한 후유우미는 왠지 에이타에게만 차가운 태도로 보이는데...\n한편, 마스즈는 후유우미를 협박하기 위해 히메에게 어떤 일을 부추긴다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/10162/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.133