:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-01-04T21:22:37.485412", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 17622, "title": "하쿠메이와 미코치 [2020년 판권 만료작]", "subject": "대나무탕 / 무와 파이프", "description": "한동안 바빴던 하쿠메이는 어깨가 뭉쳤다며 온천에 가고 싶다고 한다. 그때 마침 신문을 보고 있던 미코치가 근처에 온천이 생겼다는 기사를 발견하고 두 사람은 바로 온천으로 달려간다. 하지만 온천은 대청소 중이라 이용할 수가 없었고 두 사람은 실망을 금치 못한다. 그러자 하쿠메이는 노천탕을 직접 만들겠다고 하는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/14708/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.100000", "progressbar": null, "item_expire_datetime": "2020-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-01-04T21:22:37.510734", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 17623, "title": "하쿠메이와 미코치 [2020년 판권 만료작]", "subject": "야간기차 / 비와 털바늘낚시", "description": "하쿠메이와 미코치는 카노칸까지 기차 여행을 한다. 하쿠메이는 빨리 카노칸 호수에서 낚시를 하고 싶지만, 미코치는 낚시에 별로 취미가 없다. 하지만 그것도 모르고 하쿠메이는 미코치에게 낚시에 대해 이것저것 가르쳐주는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/14709/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:43.100000", "progressbar": null, "item_expire_datetime": "2020-12-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2018-01-04T21:22:37.541985", "rating":