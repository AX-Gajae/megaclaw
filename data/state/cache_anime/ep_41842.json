.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76658/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 98851, "name": "어리석은 천사는 악마와 춤춘다 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 98850, "name": "어리석은 천사는 악마와 춤춘다 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-14T01:00:08.126718", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-02-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69265, "title": "어리석은 천사는 악마와 춤춘다", "subject": "First aid", "description": "인체 모형과의 전투에서 힘이 다해 정신을 잃고만 릴리를 안아 방까지 데리고 온 아쿠츠. 돌아가려고 했지만 의식이 몽롱한 릴리가 그의 옷소매를 잡자, 방구석에 앉아 그녀와 함께 있기로 했다. 얼마 후 눈을 뜬 릴리가 잠이 들어버린 아쿠츠를 염려해 그에게 가까이 다가갔는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76886/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99253, "name": "어리석은 천사는 악마와 춤춘다 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99252, "name": "어리석은 천사는 악마와 춤춘다 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-21T01:00:08.377962", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2024-02-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69411, "title": 