progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104459, "name": "아따맘마 리마스터 17 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 104458, "name": "아따맘마 리마스터 17 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-05-24T21:00:08.243381", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-05-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73188, "title": "아따맘마 리마스터", "subject": "동동, 늘 하던대로", "description": "책에 묻혀 놓은 기름, 포크에 묻어 있는 케이크 찌꺼기. 동동은 깨끗하지 못한 엄마와 아리한테 화를 낸다. 엄마와 아리는 깔끔떠는 동동을 흉보며 별로 인기가 없을 거라고 단정한다. 동동네 반 학부모 모임에 갔던 엄마는 동동이 인기가 있다는 말을 듣고 동동이 낫토를 먹을 때 한쪽으로 먹으라는 둥, 까다롭게 군다며 동동의 흉을 본다. 며칠 후 학교에서 돌아온 동동은 자기 얘기를 떠벌린 엄마한테 화를 내는데…", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/05/81930/v14/Thumbnail.0000023.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:09:48.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104457, "name": "아따맘마 리마스터 18 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 104456, "name": "아따맘마 리마스터 18 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-05-24T21:00:08.243381", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-05-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73189, "title": "아따맘마 리마스터", "subject": "엄마, 버릴 수 없어!", "description": "아리는 동아리 합숙훈련 자금을 마련하기 위해 아르바이트에 나선다. 아리가 시식코너에서 일하게 됐단 얘기를 들은 엄마는 손님들이 어린애로 착각하지 않으면 다행이라고 비웃는다. 아리는 막상 시식코너에 서게 되자 부끄러워 말이 잘 안나오는데, 지나가던 할머니가 어린애가 고생한다며 격려의 말을 건넨다. 아리가 아르바이트를 하는 마트에 나타난 엄마는 그 장면을 목격하는데…", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/05/82246/v14/Thumbnail.0000021.jpg", "has_preview": false, "access_info_list": [], "running_time": "0:08:57.666000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104840, "name": "아따맘마 리마스터 19 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 104839, "name": "아따맘마 리마스터 19 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-05-31T21:00:08.337799", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-05-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73190, "title": "아따맘마 리마스터", "subject": "동동이는 낫토 대장!", "description": "엄마는 정확한 단어를 쓰지 않고 생각나는 대로 말을 하거나, 모든 물건을 이거, 저거, 그거라고 말한다. 특히 영어 단어를 자주 헷갈리는 엄마는 레스토랑에 가서 미디움을 밀레니엄이라고 했다가 거대한 스테이크 먹기에 도전하게 되는 등, 엄마의 말버릇으로 인해 여러 가지 사건이 발생한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/05/82247/v14/Thumbnail.0000024.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:10:14.333000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104838, "name": "아따맘마 리마스터 20 대여", "list_price": 300, "period": "7 day", "promotion": null}, {"id": 104837, "name": "아따맘마 리마스터 20 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2024-05-31T21:00:08.337799", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "브라보키즈", "broadcast_date": "2024-05-31", "rating_compone