dcast_date": "2026-01-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89949, "title": "어차피, 사랑하고 만다. 2기", "subject": "진정한 자신", "description": "2030년. 키즈키와 오랜만에 재회하고, 신에게는 고백을 받은 미즈호는 마음이 복잡해져 멍하니 천장을 바라본다. 그때, 아이루에게 전화가 걸려 온다. 아이루는 불꽃놀이 때 키즈키를 만났다는 얘기를 듣고, 다정한 말로 미즈호를 격려해 준다. 그러나 10년 전, 키즈키를 좋아한 사람은 미즈호뿐만이 아니었다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/103122/v30/9e266b155454/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129002, "name": "어차피, 사랑하고 만다. 2기 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-23T04:00:10.978038", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-01-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89950, "title": "어차피, 사랑하고 만다. 2기", "subject": "기적", "description": "2020년. 키즈키와 미즈호가 사귀기 시작한 걸 계기로, 키즈키에게 오랜 세월 품어왔던 마음을 전한 아이루. 송년회가 끝난 뒤, 아이루는 엄마에게 자신의 비밀을 털어놓는다. 한편, 이대로 5명의 관계가 무너지는 게 싫었던 슈고는 밤중에 미즈호에게 전화를 건다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/103354/v30/a1b5d2929325/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129280, "name": "어차피, 사랑하고 만다. 2기 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-30T04:00:10.131791", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-01-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89951, "title": "어차피, 사랑하고 만다. 2기", "subject": "사라지지 않는 마음", "description": "2021년, 3학년 선배들의 졸업식이 다가온다. 수영부 학생들은 축하 준비를 하면서도, 감염증으로 대부분의 행사나 대회가 취소된 선배들에게 졸업 축하한다는 말을 해도 되는 건지 망설인다. 그리고 졸업식 당일, 키즈키는 복잡한 마음으로 사이토 선배에게 꽃다발을 건넨다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/103683/v30/0912af48c05f/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129519, "name": "어차피, 사랑하고 만다. 2기 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-02-06T04:00:11.933569", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-02-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89952, "title": "어차피, 사랑하고 만다. 2기", "subject": "계속 좋아했어", "description": "2030년. 슈고는 육교에서 미즈호를 끌고 가는 키즈키를 발견하고 화가 나서 달려든다. 서로 붙잡고 싸우던 슈고와 키즈키는 계단 밑으로 떨어지고, 놀란 미즈호는 아이루를 불러서 두 사람을 신이 근무하는 병원으로 데려간다. 그렇게 몇 년 만에 소꿉친구 다섯 명이 한자리에 모인다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/103998/v30/9b6ef4d092c4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 129962, "name": "어차피, 사랑하고 만다. 2기 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-02-13T04:00:11.797921", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-02-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89953, "title": "어차피, 사랑하고 만다. 2기", "subject": "후회하고 싶지 않아", "description": "오랜만에 다섯 명이 재회한 날, 슈고는 어릴 때부터 품어왔던 미즈호를 향한 마음을 참지 못하고 미즈호를 껴안는다. 한편, 아이루와 함께 집에 돌아온 키즈키. 왜 미즈호와 헤어졌던 거냐고 아이루가 묻자, 키즈키는 아무에게도 말하지 못했던 과거 일을 털어놓는다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/104131/v30/1cffb8d30a4e/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 130197, "name": "어차피, 사랑하고 만다. 2기 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-02-20T04:00:12.835956", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-02-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89954, "title": "어차피, 사랑하고 만다. 2기", "subject": "잃고 싶지 않아", "description": "아이루는 키즈키가 아직 미즈호를 좋아한다는 걸 알고, 다시 한번 일어서라고 격려해 준다. 그리고 키즈키와 토야 사이에서 서투르게 행동하며 상처를 줬던 고등학생 시절을 회상한다. 한편, 슈고는 돌아가신 아버지가 했던 말을 떠올리며 미즈호에게 마음을 전하기로 결심한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/02/104244/v30/536ed5199ad5/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 130466, "name": "어차피, 사랑하고 만다. 2기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-02-27T04:00:11.239793", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-02-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89955, "title": "어차피, 사랑하고 만다. 2기", "subject": "선언", "description": "그동안 미즈호를 향한 마음을 억누르고 있었던 슈고가 키즈키에게 선전포고를 한다. 키즈키도 일을 그만두고 수영선수로 복귀하면서 다시 미즈호를 돌아보게 만들기로 결심한다. 그런 사정을 모르는 미즈호는 담당 작가의 취재를 위해 수영 강습실에 왔다가 뜻밖에 키즈키를 만난다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/03/104502/v30/1a8062dec4e0/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 130653, "name": "어차피, 사랑하고 만다. 2기 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-03-06T04:00:11.086037", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2026-03-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89956, "title": "어차피, 사랑하고 만다. 2기", "subject": "계속 말하고 싶었던 것", "description": "신의 집 앞에서 우연히 쿠로다와 마주친 미즈호. 쿠로다에게 비겁하다는 말을 듣고, 미즈호는 어떻게 하면 좋을지 고민에 빠진다. 그러던 중, 슈고에게 메뉴 개발을 도와달라는 부탁을 받고 함께 에노시마에 간다. 평소와 다른 슈고의 태도에 미즈호는 당황한 마음을 숨기지 못한다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/03/104712/v30/26612a9ff57d/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131059, "name": "어차피, 사랑하고 만다. 2기 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-03-13T04:00:12.822488", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": ""