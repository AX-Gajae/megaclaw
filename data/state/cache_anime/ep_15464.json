null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11808, "name": "유리가면 리메이크 2 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11809, "name": "유리가면 리메이크 2 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:16.136078", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14052, "title": "유리가면", "subject": "달아난 코지마", "description": "마야가 연극 ‘아름다운 신부’에서 맡은 역할은 우스꽝스러운 익살꾼 역할의 ‘비비’라는 여인이었다. 막상 막이 올라 처음 설정대로 연기하던 마야는 본능적으로 ‘비비’의 캐릭터를 재해석하여 신들린 연기를 펼치고, 관객은 주인공이 아닌 마야에게 박수갈채를 보낸다.\r\n 연기에 눈을 뜬 마야는 극단 ‘온딘’을 찾았다가 갑작스럽게 팬터마임 테스트를 치르는데, 이를 지켜본 아유미는 조금씩 마야의 존재를 신경 쓰기 시작한다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78375/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11810, "name": "유리가면 리메이크 3 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11811, "name": "유리가면 리메이크 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:16.325599", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14053, "title": "유리가면", "subject": "불꽃의 계단", "description": "마야에게 잠재된 연기에 대한 열망과 재능을 이끌어내려는 츠키카게. 그녀는 과거에 자신만이 연기할 수 있었던 ‘홍천녀’를 소화할 여배우를 직접 키우겠다는 목적으로 모습을 드러낸 것이었다. 그리고 그녀가 가진 ‘홍천녀’ 상연권을 둘러싼 마스미와의 신경전이 시작된다.\r\n 한편, 배우가 되기로 결심한 마야는 집을 나와 츠키카게 극단에 들어가 연기수업을 시작하고, 딸을 찾기 위해 달려온 마야의 엄마도 마야와 츠키카게의 고집에 발길을 돌리고 만다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78376/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11812, "name": "유리가면 리메이크 4 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11813, "name": "유리가면 리메이크 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:16.516946", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14054, "title": "유리가면", "subject": "제한된 대사", "description": "본격적인 연기수업을 시작한 마야. 하지만 본능적으로 남들과 다르게 반응하고 서투른 듯 보이는 그녀를 향한 주변의 시선은 마냥 따갑기만 하다. \r\n 그러나 츠키카게가 제안한 ‘제한된 대사’만으로 진행되는 연기수업에서 마야가 아유미를 상대로 의외의 선전을 펼치자, 모두는 응원을 하기 시작하는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78377/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.733000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11814, "name": "유리가면 리메이크 5 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11815, "name": "유리가면 리메이크 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:16.713498", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14055, "title": "유리가면", "subject": "나의 베스", "description": "아유미와의 대결에서 당당히 맞서고 극단원들에게도 인정을 받게 된 마야는 연기에 대한 열정이 더욱 뜨거워짐을 느낀다. \r\n 한편, 츠키카게 극단은 창단 공연으로 ‘작은 아씨들’을 올리기로 하는데, 네 자매 중 셋째 ‘베스’ 역에 파격적으로 마야가 발탁된다. 기쁘지만 첫 무대에 부담을 느낀 마야는 조급함에 연기력이 흔들려, 결국 일주일 뒤에 테스트를 통해 다시 ‘베스’의 배역을 정하기로 한다.\r\n 츠키카게는 마야에게 일주일 동안 베스로 살아갈 것을 명령하는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78379/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11816, "name": "유리가면 리메이크 6 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11817, "name": "유리가면 리메이크 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:16.906578", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14056, "title": "유리가면", "subject": "보랏빛 장미", "description": "드디어 테스트 날. 일주일 동안 베스가 되어 살았던 마야는 당당하게 역할을 다시 꿰차고 연습에 합류한다. 그러나 공연의 클라이맥스라고 할 수 있는, 고열에 시달리는 연기가 제대로 나오지 않자 고민에 빠진다. \r\n 급기야 밤새 차가운 비를 고스란히 맞고서야 베스의 감정을 찾아가는 마야. 공연 당일 40도에 가까운 열을 무릅쓰고 무대에 선 마야는 열연을 펼치고 정신을 잃는다. \r\n 얼마 뒤 눈을 뜬 마야는 그녀의 첫 번째 팬이 보낸 보라색 장미 꽃다발을 전해 받는다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78380/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11818, "name": "유리가면 리메이크 7 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11819, "name": "유리가면 리메이크 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:17.091033", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14057, "title": "유리가면", "subject": "폭풍 속을 가다", "description": "마야의 열정적인 연기가 돋보인 츠키카게 극단의 공연은 관객에게 호평을 받았지만, 언론에서는 혹평 일색이었다. 게다가 츠키카게와 모 기획사 사장과의 스캔들로 주간지가 떠들썩해지면서, 츠키카게 극단도 술렁이기 시작한다.\r\n 츠키카게는 마스미와 오노데라가 꾸민 짓임을 확신하고, 극단의 존폐의 위기를 벗어나기 위해 전국 연극대회에 출전하기로 한다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78381/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11820, "name": "유리가면 리메이크 8 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11821, "name": "유리가면 리메이크 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:17.273784", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14058, "title": "유리가면", "subject": "새로운 미도리", "description": "츠키카게 극단의 운명이 걸린 전국 연극대회. 지역예선에서 이들이 택한 작품은 ‘키재기’로 마야가 여주인공 ‘미도리’로 발탁된다. 그러나 그 와중에 온딘 극단 역시 ‘키재기’로 예선대회에 오르기로 했다는 사실을 알고 몹시 동요하며 자신감을 잃어버린 마야. \r\n 그러자 츠키카게는 특단의 훈련으로써 마야를 혹독한 환경에 몰아넣는다. 그리고 그곳에서 냉정을 되찾은 마야는 완벽하게 미도리를 연기하는 아유미와는 달리, 자신만의 새로운 미도리의 캐릭터를 찾기로 한다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78382/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11822, "name": "유리가면 리메이크 9 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11823, "name": "유리가면 리메이크 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:17.471357", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14059, "title": "유리가면", "subject": "키재기 두 명의 미도리", "description": "마침내 시작된 연극대회 예선. \r\n 평생의 라이벌이 될 마야와 아유미는 같은 공연, 같은 역할로 정면 대결을 벌인다. 원작에서 튀어나온 듯 완벽한 미도리를 연기한 아유미. 그리고 아무도 상상하지 못한 새로운 미도리를 연기한 마야. 둘은 모두 관객의 환호와 박수 속에 연기를 마치고, 츠키카게 극단과 온딘 극단은 공동 1위에 오르며, 전국 대회에서 다시 승부를 가르게 되었다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78383/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11824, "name": "유리가면 리메이크 10 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11825, "name": "유리가면 리메이크 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:17.653165", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14060, "title": "유리가면", "subject": "봄의 폭풍", "description": "전국 연극대회를 위해 나고야를 찾은 극단 츠키카게. 공연작은 ‘지나와 다섯 개의 파란 항아리’로 마야는 주인공 ‘지나’ 역을 맡았다. \r\n 한편, 온딘의 이사 오노데라는 마야를 질투하는 단원에게 접근해 츠키카게 극단의 공연을 방해하려는 계략을 꾸민다. \r\n 그리고 공연 당일, 누군가 츠키카게의 소품과 의상을 엉망으로 만들어 단원들은 부랴부랴 소품과 의상을 빌리러 길을 나선다. 혼자 남은 마야는 단원들을 목이 빠지게 기다리지만 설상가상 단원들과 연락조차 끊기고 만다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78384/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11826, "name": "유리가면 리메이크 11 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11827, "name": "유리가면 리메이크 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:17.837305", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14061, "title": "유리가면", "subject": "혼자뿐인 연극", "description": "츠키카게 극단의 공연 시간이 다가왔지만, 산속에 발이 묶인 단원들은 도착할 기미가 보이지 않는다. 마야는 기권을 하려는 츠키카게를 설득하여 무대에 혼자 오르기로 결심한다.\r\n 14명이 등장해야 할 공연이지만 노련하게 이끌어가는 마야. 웅성거리던 객석도 점차 마야의 연기에 사로잡혀 가는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78385/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11828, "name": "유리가면 리메이크 12 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11829, "name": "유리가면 리메이크 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.023604", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14062, "title": "유리가면", "subject": "내일의 풀", "description": "전국 연극대회에서 안타깝게 심사 대상에서 제외된 츠키카게 극단은 스폰서를 잃고 해산하기에 이른다. 마야와 다섯 명의 단원은 어려운 상황이지만 츠키카게를 따르기로 하고, 힘들지만 각자 일을 병행하며 연기 연습을 계속해나간다.\r\n 한편, 아이돌 영화의 단역을 맡게 된 마야. 주인공 옆을 지나는 보잘 것 없는 배역이지만, 마야는 최선을 다해 연습에 참가한다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78387/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11830, "name": "유리가면 리메이크 13 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11831, "name": "유리가면 리메이크 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.206946", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14063, "title": "유리가면", "subject": "숙명의 라이벌", "description": "극단은 해체되고 츠키카게도 병원에 입원하면서 제대로 연기연습을 할 수 없는 마야는 영화 ‘하얀 청춘백서’에서 단역을 맡고, 학교 연극부 공연에서 대역을 맡는 등 차근차근 경험을 쌓아 나갔다. \r\n 한편, 아유미 역시 ‘홍천녀’를 연기할 꿈을 꾸며 다양한 배역을 경험하고자 몸을 사리지 않고 수많은 역할에 도전한다.\r\n 두 사람이 드디어 ‘홍천녀’라는 하나의 목표를 향해 서로를 의식하며 서서히 라이벌 구도를 형성해나가기 시작한 것이다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78388/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11832, "name": "유리가면 리메이크 14 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11833, "name": "유리가면 리메이크 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.391733", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14064, "title": "유리가면", "subject": "함정", "description": "자신에게는 연기밖에 없음을 깨달은 마야는 다른 극단을 돌며 무대에 서게 해달라고 하지만 누구도 쉽사리 마야를 받아주지 않는다. 이때 츠키카게의 옛 동료였던 ‘하라다’가 마야의 잠재된 능력을 알아보고 무대에 올리기로 한다.\r\n 한편, 배역을 빼앗기고 질투에 눈이 먼 배우가 마야의 소품을 망가뜨리는 함정을 파놓지만, 무대 위의 마야는 당황하지 않고 연기하며 위기를 모면해 다시 한번 배우로서의 대담함을 평가받는다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78389/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11834, "name": "유리가면 리메이크 15 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11835, "name": "유리가면 리메이크 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.569878", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14065, "title": "유리가면", "subject": "무대 강탈자", "description": "보잘 것 없는 역할에도 관객의 시선을 사로잡아 버리는 마야. 그녀의 연기가 다른 배우들마저 압도해버리자 ‘무대 광풍’이라는 별명과 함께 기피의 대상이 되어간다.\r\n 그러나 마야를 눈여겨 본 도요 극장의 회장이 ‘바람의 언덕’의 캐서린 아역 배우로 점찍고, 오디션을 치른 마야는 당당하게 배역을 거머쥔다. \r\n 하지만 캐릭터에 동화되어가는 마야로 인해 상대 배역의 ‘마지마’와 사쿠라코지의 심경의 변화가 예고되는데…", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78390/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11836, "name": "유리가면 리메이크 16 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11837, "name": "유리가면 리메이크 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.750977", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14066, "title": "유리가면", "subject": "폭풍의 언덕", "description": "완벽한 캐서린이 되어가는 마야와 그러한 캐서린에게 자꾸만 끌리는 마지마. 무대는 두 사람의 열연으로 성인 배우들을 압도하는 인기를 얻게 된다. 공연은 성공리에 막을 내리지만, 오히려 ‘무대 광풍’이라는 마야의 숙명만을 확인하고 배우들은 더욱 더 마야를 외면하려 한다.\r\n 그러한 마야에게 츠키카게가 맡긴 다음 배역은 무대에서 꼼짝하지 않고 앉아있어야 하는 인형 엘리자베스였다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78391/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11838, "name": "유리가면 리메이크 17 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11839, "name": "유리가면 리메이크 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:18.950984", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14067, "title": "유리가면", "subject": "인형 역", "description": "대사 한 마디 없는 인형 연기를 해야 하는 마야. 캐릭터를 잡지 못하는 그녀에게 츠키카게는 혹독한 연습을 시키고, 그 과정을 통해 마야는 스스로를 비워야 하는 연기에 대해 깨닫는다. 자신을 위한 츠키카게의 의도를 알게 되고 인형 엘리자베스를 완벽히 소화해내는 마야.\r\n 보잘 것 없는 지하극장에서 시작된 공연 ‘돌의 미소’는 입소문을 타고 점점 뜨거운 반응을 얻어 가는데...", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78392/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11840, "name": "유리가면 리메이크 18 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11841, "name": "유리가면 리메이크 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:19.138699", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14068, "title": "유리가면", "subject": "벗겨진 가면", "description": "‘돌의 미소’ 공연의 마지막 날, 마야는 실종된 엄마에 대한 소식을 듣는다. 그러나 이미 공연 시각은 임박해 오고, 마음을 진정할 새도 없이 무대에 오른 마야는 눈물을 흘리고 만다. 인형 역의 가면이 벗겨져 버린 것. \r\n 츠키카게에게 근신처분을 받고 거리를 방황하던 마야는 갑작스런 마스미의 출연 의뢰에, 막이 오르기 45분 전에야 대본을 받고 무대에 오르려 한다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78394/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11842, "name": "유리가면 리메이크 19 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11843, "name": "유리가면 리메이크 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:19.324424", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}, {"id": 14069, "title": "유리가면", "subject": "바뀐 대본", "description": "다이토 극장의 연극 ‘몽연화’에 급히 대역으로 나서게 된 마야. 그러나 마야를 질투한 다른 출연자가 대본을 바꿔치기한다. 연극의 줄거리는 물론 대사 한 마디 모른 채 무대에 오른 마야. \r\n 공연이 무산될 위기를 맞지만 아유미가 나서서 마야와 호흡을 맞춰 이야기를 이끌어나간다. 또 한번 아유미의 천재성에 열등감을 느끼는 마야.\r\n 한편, 츠키카게는 근신처분을 어기고 연극에 출연한 마야에게 ‘기적은 사랑을 타고’라는 연극의 오디션에서 아유미에 맞서 ‘헬렌 켈러’역을 따낼 것을 요구한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78395/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:05.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 11844, "name": "유리가면 리메이크 20 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 11845, "name": "유리가면 리메이크 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-08-14T21:22:19.511900", "rating": {"rating": 0, "rating_type": "영상물등급위원회", "classification_number": "2024-VF00254", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": ["주제", "폭력성", "약물"]}, "access_type": null, "is_available": false}]}