adcast_date": "2025-06-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90705, "title": "캐리야! 학교가자 - 영어", "subject": "Election", "description": "오늘은 캐리의 반에서 체육부장을 선출하는 날이다. 체육부장은 반 아이들이라면 누구나 하고 싶은 인기 많은 자리다. 다른 아이들을 비롯해 캐리와 타미가 후보자로 나선다. 캐리와 타미는 평소에도 서로에게 경쟁심을 느끼는, 라이벌 관계이기 때문에 이번 승부는 결코 질 수 없다. 과연 체육부장 자리는 누가 차지할 것인가?", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102866/v30/0276e6f41380/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:46.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128754, "name": "캐리야! 학교가자 - 영어 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:13.187778", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90706, "title": "캐리야! 학교가자 - 영어", "subject": "Transfer Student", "description": "전학생 대니는 캐빈의 축구공을 빼앗아 가지고 노는가 하면, 수업 중 단체 활동에도 참여하지 않는다. 토미 선생님은 대니와 상담 도중 대니의 선한 모습을 발견하고 대니에게 조언을 해준다. 하지만 좌충우돌 대니는 급기야 우체통 만들기를 하던 도중 선생님의 지시를 따르지 않다가 교실 바깥으로 뛰쳐나가버린다. 토미는 대니를 잡기 위해 그 뒤를 쫓는데…!", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102867/v30/5950c17c84a7/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:02", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128755, "name": "캐리야! 학교가자 - 영어 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:13.379757", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90707, "title": "캐리야! 학교가자 - 영어", "subject": "Mom's Letter", "description": "달려가다가 넘어질 뻔한 대니를 간신히 붙잡은 토미. 토미 선생님은 대니를 방과 후까지 남겨서 자신이 무엇을 잘못했는지 반성하게 한다. 그 과정에서 토미는 대니가 속으로는 엄마를 사랑하고, 엄마의 관심을 받고픈 마음이 크다는 것을 알게 된다. 며칠 후 편지 낭독 행사에 쓸 우체통이 부서진 채 발견된다. 모두 대니를 범인으로 여기지만, 토미 선생님이 오해를 풀어준다. 편지 낭독 행사 당일, 대니 엄마는 대니를 향한 진심 어린 편지를 써주었고, 대니는 그것을 읽고 감동을 받는다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102868/v30/ccc7bb231a69/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128756, "name": "캐리야! 학교가자 - 영어 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:13.567258", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90708, "title": "캐리야! 학교가자 - 영어", "subject": "Understanding Friends", "description": "캐리는 최근 들어 줄리가 신경 쓰인다. 줄리는 요즘 괜히 짜증을 부리고, 학교를 자주 빠져서 조별 과제에 피해를 끼치거나, 청소 당번을 건너뛰는 등 민폐투성이기 때문이다. 하지만 교내에서 열린 손 편지 전해주기 행사를 통해 줄리 어머니가 줄리에게 보낸 편지가 공개되는 것으로 오해가 풀린다. 줄리는 그동안 몸이 아팠었던 것. 캐리는 그동안 줄리의 사정을 잘 알지도 못하면서 미워만 했던 것을 사과하고, 줄리와 더 좋은 친구가 된다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102869/v30/d7ecae8a363d/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128757, "name": "캐리야! 학교가자 - 영어 14 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:13.753533", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90709, "title": "캐리야! 학교가자 - 영어", "subject": "Martial Arts", "description": "꽈 사장의 카페의 미남 아르바이트생에게 무술 과외를 받는 캐리. 그러던 어느 날, 주변을 산책하던 타미가 와쿠의 무술 실력에 반해 자신도 무술을 가르쳐달라고 와쿠에 부탁한다. 하지만 자신이 외계인이라는 사실을 숨겨야 한다는 사실을 그리 심각하게 여기지 않는 와쿠가 불안한 캐리는 틀의 정체를 들키지 않기 위해서라도 타미를 와쿠에게서 떼어내야만 한다. 과연 캐리는 와쿠에 무술을 배우고야 말겠다고 의지를 불태우는 타미의 마음을 꺾을 수 있을까?", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102967/v30/d37c0dc8ef76/Thumbnail.0000029.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:17.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128758, "name": "캐리야! 학교가자 - 영어 15 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:13.941195", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90710, "title": "캐리야! 학교가자 - 영어", "subject": "Birthday Party", "description": "바쁜 아빠의 품에서 자란 이든은 얼마 후면 곧 생일이다. 그날만큼은 아빠와 꼭 시간을 같이 보내고픈 이든은 아빠에게 약속을 받아내지만, 당일 이든 아빠는 차가 고장 나는 바람에 난처한 상황이다. 이 상황을 두고 볼 수만은 없던 콜라가 이든 아빠한테로 날아가 초능력을 발휘해 이든 아빠를 무사히 데려오고, 이든은 아빠와 함께 행복한 생일을 보낸다.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102871/v30/29d464c685df/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:40.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128759, "name": "캐리야! 학교가자 - 영어 16 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:14.121776", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90711, "title": "캐리야! 학교가자 - 영어", "subject": "Leaving Home", "description": "콜라는 캐리가 애지중지하는 스케이트보드 헬멧을 놓고 다투다가 가출을 해버린다. 갈 곳이 마땅치 않던 콜라는 당분간 엘리의 집에 머무르기로 하는데, 깔끔하고 꼼꼼한 엘리의 생활태도에 맞추는 게 너무 어렵다. 콜라는 이미 캐리와 싸우고 가출했지만 캐리를 그리워하고 있다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102872/v30/490c2a63c266/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:59.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128760, "name": "캐리야! 학교가자 - 영어 17 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:14.305893", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90712, "title": "캐리야! 학교가자 - 영어", "subject": "Coming Home", "description": "캐리는 콜라가 끝내 집에 돌아오지 않자, 심통이 난다. 나아가 엘리가 자신의 허락도 받지 않고 콜라를 자기 집에 들였다는 사실을 알고 분노한다. 그러나 캐리와 엘리의 갈등도 잠시. 둘은 화해하고 함께 콜라를 만나기 위해 엘리네 집으로 간다. 하지만 콜라는 실수로 엘리의 바이올린 줄을 끊고 죄책감 때문에 어디론가 사라져 버린 뒤다. 캐리는 동네방네 떠돌아다니며 콜라를 찾아 나서고, 우여곡절 끝에 다시 만난 캐리와 콜라는 극적인 화해를 하면서 우정을 약속한다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102873/v30/dc2764ca7efd/Thumbnail.0000027.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:36.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128761, "name": "캐리야! 학교가자 - 영어 18 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:14.494630", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90713, "title": "캐리야! 학교가자 - 영어", "subject": "Missing Books", "description": "어느 날 갑자기 학교에 있던 모든 책이 사라졌다. 아이들은 기뻐하고, 꼬마 탐정 루시는 평화부장 캐리와 범인을 찾는다. 하지만 엉뚱하게도 범인은 콜라였다. 호기심 많은 콜라가 무심코 온갖 책을 가져다 몰래 읽고 있던 것. 캐리는 콜라와 함께 사람들 눈을 피해 몰래 가까스로 다시 책을 제자리에 갖다 놓고 그제야 안도의 한숨을 내쉰다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102874/v30/b4a8ca4c6475/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:53.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128762, "name": "캐리야! 학교가자 - 영어 19 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:14.682270", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 90714, "title": "캐리야! 학교가자 - 영어", "subject": "Housekeeping Cats", "description": "타운에는 최근 도둑이 기승을 부리고 있어 분위기가 뒤숭숭하다. 그러는 와중에 캐리 집만큼은 왠지 든든해 보인다. 캐리 엄마한테 먹이를 받아먹는 고양이가 늘 사방을 경계하며 철통 보안을 유지하고 있기 때문. 콜라는 고양이가 캐리 집을 잘 지키는 것은 좋지만 자신을 거칠게 대하는 게 불만이다. 한편 도둑들은 다음 타깃으로 캐리 집을 지목한다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/01/102877/v30/06f6e7831af3/Thumbnail.0000028.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:11:43.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 128763, "name": "캐리야! 학교가자 - 영어 20 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-01-17T00:00:14.870350", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "캐리TV", "broadcast_date": "2025-06-26", "rating_components": []}, "access_type": null, "is_available": false}]}