], "episode_products": [{"id": 1801, "name": "테니스의 왕자 13 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:27.946027", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3536, "title": "테니스의 왕자 part 1", "subject": "제비 반전술", "description": "지역 예선 최강의 라이벌이었던 카키노키 중학교가 무명인 후도미네 중학교에게 지고 만다. 후도미네는 작년 대회에서 출장을 사퇴한 전적이 있는 학교였다. 예상 외의 적 후도미네의 등장에 세이슌의 후지, 카와무라 콤비는 고전을 하게 된다. 이 상황을 벗어나고자 후지는 필살기 중 하나를 사용하게 된다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3064/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1802, "name": "테니스의 왕자 14 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:27.978101", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3537, "title": "테니스의 왕자 part 1", "subject": "각자의 싸움", "description": "후지의 필살기 제비 반전술로 인해 시합을 리드하던 세이슌. 하지만 후도미네의 필살기 파동구를 받아친 카와무라는 팔을 다치고 만다. 결국 복식 2는 기권을 하게 되고, 복식 1인 키쿠마루, 오오이시 페어의 시합이 시작된다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3065/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1803, "name": "테니스의 왕자 15 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:28.106757", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3538, "title": "테니스의 왕자 part 1", "subject": "부메랑 스네이크", "description": "복식 1 시합에서 승리한 세이슌. 단식 시합이 시작되려는 찰나 비가 내려 시합이 미뤄진다. 다행히 비가 그치고 카이도의 시합이 시작되는데, 상대인 후도미네의 카미오는 카이도와 상성이 나쁜 상대였다. 비 탓에 젖은 코트, 상성 나쁜 상대로 인하여 카이도는 좀체 자기 페이스를 찾지 못한 채 경기를 진행한다. ", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3066/v5/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1804, "name": "테니스의 왕자 16 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:28.144206", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3539, "title": "테니스의 왕자 part 1", "subject": "작은 승리 포즈", "description": "카이도의 새 기술 '부메랑 스네이크'가 경기장에 있는 모두를 놀래킨다. 하지만 후도미네의 카미오는 곧 자기 페이스를 되찾고, 카이도는 기술이 헛나가기만 한다. 새 기술에 의지하려는 카이도에게 너 자신의 테니스를 하라고 조언해주는 테니스 부 고문인 류자키 선생님. 카이도는 끈질기게 들러 붙는 자신만의 테니스 스타일을 펼치기 시작한다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3067/v5/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.300000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1805, "name": "테니스의 왕자 17 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:28.236126", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3540, "title": "테니스의 왕자 part 1", "subject": "러브 레터", "description": "드디어 세이슌의 료마와 후도미네의 신지의 시합이 시작되었다. 트위스트 서브를 이용해 재빨리 신지를 제압하는 료마. 하지만 신지도 트위스트 서브와 비슷한 킥 서브를 사용해 이에 맞선다. 한편 료마의 집에서는 료마의 사촌인 나나코가 에치젠 난지로의 옛날 앨범을 발견하게 된다. ", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3068/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1806, "name": "테니스의 왕자 18 소장", "list_price": 500, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-25T13:59:28.332904", "rating": {"rating": 12, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 3541, "title": "테니스의 왕자 part 1", "subject": "상처투성이 료마", "description": "료마와 신지가 접전을 벌이고, 료마는 여느 때와 다르게 적극적으로 플레이를 한다. 앞서가던 료마는 어느 순간부터 몸에 이상을 느끼게 되고, 그 틈을 타서 신지가 추격해 온다. 이상의 정체는 '스폿'. 신지는 의도적으로 료마를 스폿 상태에 빠지게 해서 점수를 딴 것이었다. 그리고 스폿 상태에 빠진 료마는 무리하게 시합을 하다가 다치고 만다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/3069/v4/Thumbnail.0000053.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:10.200000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1807, "name": "테니스의 왕자 19 소장", "list_price": 500, "period": "0 day", "promotion": null}], "p