: false}, {"id": 69316, "title": "손끝과 연연", "subject": "한 걸음을", "description": "유키가 자신의 여자친구라고 신에게 소개한 이츠오미. 두 사람의 관계를 축복하는 한편, 역시 에마가 신경 쓰이는 상황. 이츠오미에 대한 에마의 마음을 알고 있는 신은 그녀를 생각해 에마에게는 자기가 말하겠다고 했지만, 그런 신 또한 고등학교 때부터 계속 에마를 마음에 두고 있었는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/77136/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99463, "name": "손끝과 연연 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99462, "name": "손끝과 연연 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-02-26T02:00:09.676100", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-02-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 69594, "title": "손끝과 연연", "subject": "돌아가고 싶지 않아", "description": "린 & 쿄야까지 함께 수어 합숙을 하자고 제안한 이츠오미. 유키는 말할 것도 없었고 린 또한 적극적이었는데, 합숙 중에 쿄야와의 거리를 줄이려고 벼르고 있었다. 그런 린은 봄 방학에 아르바이트를 했던 공인중개사 사원으로부터 계속 대시를 받고 있었다. 합숙 당일, 모처럼 쿄야와 둘이서 있게 된 때도 그 남자의 전화가 걸려 왔는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/77700/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 99771, "name": "손끝과 연연 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 99770, "name": "손끝과 연연 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-04T02:00:09.707086", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-03-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 70156, "title": "손끝과 연연", "subject": "오우시의 세계", "description": "이즈미로부터 유키가 남자친구로 보이는 사람과 같이 있었다는 걸 듣게 된 오우시. 좀 더 솔직해지라는 말을 듣고 각오를 다진 표정으로 영상 통화를 걸었지만, 유키는 전화를 받지 않았다. 그 무렵 유키는 이츠오미의 집에서 묵는 중이었고, 영화를 보면서 지낸다는 이츠오미의 주말 생활을 그대로 따라갔지만 긴장한 탓에 전혀 편히 있질 못했는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/77935/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 100519, "name": "손끝과 연연 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 100518, "name": "손끝과 연연 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-11T02:00:09.957191", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-03-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 70375, "title": "손끝과 연연", "subject": "약속", "description": "엄마가 심부름을 부탁해 슈퍼에 들른 가운데, 점원이 마스크를 쓰고 있어 입 모양을 읽을 수 없자 곤란해하는 유키. 그 상황에서 그녀를 도와준 건 오우시였다. 평소와는 다르게 상냥하게 말을 걸어주는 오우시에게 유키는 위화감을 느꼈고, 게다가 이츠오미의 얘기를 하자 그녀의 손을 가로막고 정색하는 오우시의 모습에 그를 마치 모르는 사람처럼 느껴버리고 말았는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78255/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 100763, "name": "손끝과 연연 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 100762, "name": "손끝과 연연 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-18T02:00:09.526920", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-03-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 70752, "title": "손끝과 연연", "subject": "우리들의 세계", "description": "데이트를 하게 된 유키와 이츠오미. 유키가 고민 끝에 결정한 곳은 어느 공원이었다. 꽃 사진을 찍는 걸 좋아하는 유키는 공원 안에 있는 꽃을 찍으며 돌아다녔고, 이츠오미는 그 사진들을 통해 '유키가 보고 있는 세계'를 느꼈다. 그렇게 평화로운 시간이 흐르는 가운데, 유키는 친해지면 알려주겠다던 '그 질문'에 대한 답을 이츠오미에게 다시 한번 묻고자 했는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/03/78631/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:46.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 101068, "name": "손끝과 연연 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 101067, "name": "손끝과 연연 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-03-25T02:00:10.096090", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-03-24", "rating_components": []}, "access_type": null, "is_available": false}]}