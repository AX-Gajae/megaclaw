], "episode_products": [], "published_datetime": "2025-03-20T00:00:09.865504", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-03-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81407, "title": "이세계 실격", "subject": "저 굴에서 몹시 배덕한 냄새가 풍기는군", "description": "여행자에게 가호를 내려준다는 세계수 기슭에는 '토네리코'라는 조용한 마을이 있다. 자연과 함께 검소하게 생활하는 사람들이 살고 있다는 토네리코. 그러나, 그곳을 방문한 선생 일행이 본 것은 화려한 도박장과 야만스러운 남자들이 돌아다니는 광경이었다. \"부디 이 마을을 원래대로 되돌려 주시면 안 되겠습니까?\"라는 촌장의 부탁에 선생은.....", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91864/v30/e159edf2564c/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:58.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-03-20T00:00:10.045681", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-03-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 81408, "title": "이세계 실격", "subject": "날 한 줌의 재로 바꿔 주오", "description": "드리텐 성당을 목표로, 보이는 건 온통 모래뿐인 뜨거운 사막지대를 지나는\r\n선생 일행. 운이 좋게도 그곳은 니아의 고향이었고, 니아는 사막에 대한 지식을\r\n가지고 있었다. 그러나, 전갈처럼 생긴 마물을 타고 다니는 타락 전이자가 등장하고,\r\n그가 이끄는 폭주 집단이 그곳을 덮쳐오는데...!", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/91916/v30/f5096919814f/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:58.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-03-27T00:00:09.047317", "rating": {"rating": 15, "rating_type": "방송