ification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-11-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 86757, "title": "카쿠리요의 여관밥 2기", "subject": "응원하는 요리.", "description": "뱌쿠야와 헤어지고 타케치요가 있는 곳으로 잠입하는 아오이. 그곳에 나타난 건 남동쪽의 팔엽인 자쿠로였다. 자쿠로는 아오이의 요리에 흥미를 보이고, 서로가 만든 과자를 먹게 되었지만... 한편 그 무렵, 요왕이 있는 곳에 간 뱌쿠야는 큰주인에 대해서 직언을 올렸다. 하지만 그 자리에 다시 한번 나타난 것은 뇌수였는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100556/v30/0351b6737955/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 125794, "name": "카쿠리요의 여관밥 2기 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 125793, "name": "카쿠리요의 여관밥 2기 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-20T01:00:07.740651", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-11-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 86758, "title": "카쿠리요의 여관밥 2기", "subject": "북쪽 땅을 프로듀스 합니다.", "description": "요도에서 벌어진 소동에서 빠져나와 북쪽 땅으로 향하게 된 아오이 일행. 빙인족들의 생활을 엿보면서 도달한 팔엽의 성인 효리성에서 아오이는 카스가와 재회를 이루었고, 성주인 키요와도 만났다. 키요는 텐진야에 대한 협력을 약속했으나, 그 대신 북쪽 땅을 위해서라며 어떤 조건을 걸었는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/11/100980/v30/a9b20b75d31a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:06.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 126131, "name": "카쿠리요의 여관밥 2기 9 대여", "list_price": 700