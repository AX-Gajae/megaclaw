view": true, "access_info_list": [], "running_time": "0:25:04.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4403, "name": "식극의 소마 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48772, "name": "식극의 소마 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-06-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5820, "title": "식극의 소마", "subject": "메타모르포제", "description": "생각지 못한 실수로 인해 뷔페식 과제에서 탈락 위기에 처한 유키히라. 심사위원들은 만든 지 얼마 안 돼 사그라들어 버리는 유키히라의 오믈렛에 손조차 대지 않는다. 위기를 극복하기 위해 잠시 고민하던 유키히라. 잠시 후, 한 어린 소녀가 유키히라의 오믈렛을 선택하면서 상황은 급변하기 시작한다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36349/v4/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:06.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4404, "name": "식극의 소마 14 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48773, "name": "식극의 소마 14 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-07-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5821, "title": "식극의 소마", "subject": "「수라」라고 불린 남자", "description": "무사히 합숙을 마치고 쿄쿠세이로 돌아온 유키히라 일행. 유키히라는 그곳에서 생각지 못하게 아버지와 재회한다. 아버지인 죠이치로가 토오츠키 출신에 십걸 제2석이라는 사실을 알게 되는 유키히라. 유키히라는 아버지에 대해 너무 무지했다는 사실을 깨닫는다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36350/v4/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:59", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4405, "name": "식극의 소마 15 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48774, "name": "식극의 소마 15 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-07-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5822, "title": "식극의 소마", "subject": "만 리를 달리는 요리인", "description": "아버지와의 요리 대결을 벌이게 된 소마. 죠이치로와 소마는 후미오, 잇시키, 타도코로를 상대로 ‘이른 아침 기운을 북돋아 주는 요리’를 만들기 시작한다. 먼저 완성된 소마의 요리에 감탄을 금치 못하는 세 사람. 하지만 완벽한 듯한 소마의 요리 앞에서도 죠이치로는 불안한 기색 없이 자신의 요리를 내놓는데.", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36351/v4/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:06.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4406, "name": "식극의 소마 16 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48775, "name": "식극의 소마 16 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-07-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5823, "title": "식극의 소마", "subject": "관능의 닭튀김", "description": "가게를 환기하라는 아버지의 말에 유키히라 식당에 돌아온 소마. 하지만 다시 돌아온 상점가는 예전의 활기를 잃은 채였다. 역내 닭튀김 가게가 상점가 손님들을 끌어가고 있다는 사실을 알게 된 소마는 같은 닭튀김 요리로 손님을 되찾아오겠다고 결심하고. 니쿠미, 쿠라세와 함께 역내 달튀김 가게로 정찰을 떠난다.", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36352/v4/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:05.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4407, "name": "식극의 소마 17 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48776, "name": "식극의 소마 17 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-08-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5824, "title": "식극의 소마", "subject": "청춘의 닭튀김", "description": "모즈야와 대적할만한 닭튀김을 만들어내기 위해 힘을 모으는 유키히라와 미토. 모두의 노력으로 새로운 닭튀김 준비가 척척 진행돼 가고. 모든 준비를 갖춘 유키히라는 드디어 모즈야와의 대결에 돌입한다. 갑자기 매출이 줄기 시작한 모즈야에선 눈 앞에서 거슬리는 새로운 형식의 닭튀김에 당황하고. 결국 참지 못한 모즈야 사장은 직접 확인하겠다며 스미레 거리 상점가로 발길을 옮긴다.", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36353/v4/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:06.900000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4408, "name": "식극의 소마 18 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48777, "name": "식극의 소마 18 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-08-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5825, "title": "식극의 소마", "subject": "선택된 자", "description": "가을 선발에 출장권이 주어진 60명의 명단이 발표되고 소마와 기숙사 친구들은 무사히 60명 안에 들며 가을 선발을 향한 준비를 시작하게 된다. 예선전 주제는 '카레 요리.' 소마는 타도코로와 함께 향신료를 연구한다는 죠이치로의 후배를 찾아가 카레에 관한 조언을 듣기로 하지만, 그곳에서 깨달은 건 자신의 앞을 가로막고 있는 하야마 아키라의 존재였다.", "episode_num": "19", "episode_order": 19, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36354/v4/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:50.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4409, "name": "식극의 소마 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48778, "name": "식극의 소마 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:16:23", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2015-08-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5826, "title": "식극의 소마", "subject": "용은 누웠다가 하늘로 오른다", "description": "여름 방학. 친구들은 다가올 가을 선발을 위해 준비에 박차를 가하고. 소마 역시 부단한 연구 끝에 가을 선발에 내놓을 카레 요리의 준비를 마친다. 그리고 드디어 시작한 가을 선발 예선. 각 그룹에서 4명밖에 나갈 수 없는 본선 진출을 위해 학생들간의 뜨거운 승부가 시작되지만, 어째서인지 소마는 냄비 앞에서 태평히 잠을 잔다.", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/02/36356/v4/Thumbnail.0000059.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4410, "name": "식극의 소마 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 48779, "name": "식극