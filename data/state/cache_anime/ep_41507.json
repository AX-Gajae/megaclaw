], "episode_products": [{"id": 87641, "name": "사신 도련님과 검은 메이드 2기 21 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87640, "name": "사신 도련님과 검은 메이드 2기 21 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-09-04T21:30:06.778777", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-09-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64492, "title": "사신 도련님과 검은 메이드 2기", "subject": "도련님과 앨리스와 하늘을 나는 빗자루", "description": "수상한 누군가에게 쫓기게 되어 단장의 지시로 서커스단에서 잠시 벗어나 도련님의 저택에서 지내게 된 자인과 카프. 그런 그들을 쫓아서 소년과 노파로 이루어진 기묘한 2인조가 저택을 방문했다. 인간이면서 마력을 지닌 그들은 마술사라고 불리는 존재였고, 거기에 더해 소년인 니코는 도련님에게 닿아도 죽지 않는 불로불사의 저주가 걸려있었는데.", "episode_num": "22", "episode_order": 22, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/09/72176/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:52.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87835, "name": "사신 도련님과 검은 메이드 2기 22 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87834, "name": "사신 도련님과 검은 메이드 2기 22 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-09-11T21:30:08.127052", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-09-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 64687, "title": "사신 도련님과 검은 메이드 2기", "subject": "도련님과 앨리스와 마술 학교", "description": "자인이 시간을 조종하는 마법으로 재생시킨 사용인 일기를 읽는 도련님과 앨리스. 거기에는 샤론이 기록한, 샤데이의 마법과 관련된 중요한 비밀이 남아있었다. 그리고 도련님은 드디어 니코가 운영하는 마술 학교에 가게 되었다. 사실은 앨리스와 카프, 자인이랑만 갈 예정이었지만, 이 사실을 알게 된 비올라와 월터까지 함께 가게 되었는데.", "episode_num": "23", "episode_order": 23, "thumbnai