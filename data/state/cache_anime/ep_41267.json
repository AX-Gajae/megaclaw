ents": []}, "access_type": null, "is_available": false}, {"id": 63570, "title": "니어:오토마타 Ver1.1a part 1", "subject": "head[Y] battle", "description": "포드 153의 보고.\n 새로운 기계 생명체 네트워크 구축을 확인. 그 중심은 '아담'이 담당하고 있을 것으로 추정됨. 아담 수색 중, 기계 생명체의 대규모 폭주가 발생. 같은 현상이 지상 각지에서 동시다발적으로 확인된 상황. 사령관으로부터 전 요르하 부대를 대상으로 한 적 기계 생명체 요격 명령이 발령됨. 현재 다수의 요르하 부대 및 레지스탕스로부터, 교전 보고 및 지원 요청이 쇄도하고 있음. 본기는 2B와 함께 레지스탕스 캠프 지원 활동을 개시함.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70546/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 86379, "name": "니어:오토마타 Ver1.1a 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 86378, "name": "니어:오토마타 Ver1.1a 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-07-31T02:30:06.939996", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-07-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63571, "title": "니어:오토마타 Ver1.1a part 1", "subject": "flowers for m[A]chines", "description": "포드 042 & 포드 153 양쪽으로부터 보고.\n 포드 042 보고 : 폭주한 아담은 9S의 해킹, 레지스탕스의 요격 및 벙커로부터의 지원 포격에 의해---통신 에러---통신 에러---포드 042와의 통신을 복구 중입니다. 복구까지 12초---포드 153과의 통신을 복구 중입니다. 복구까지 15초--- 포드 042로부터 포드 153에게 : 지상 및 상공으로부터의 대규모 공격에 의해 일시적인 통신 에러가 발생. 현재 복구 작업 중. 포드 153으로부터 포드 042에게 : 본기도 같은 장해를 확인. 기록 시스템은 이상 없음. 포드 042로부터 포드 153에게 : 라져. 본기의 시스템 또한 현시점에서 이상은 발견되지 않음. 계속해서 수행 지원 대상인 2B와 함께 조사 임무와 그 기록을 수행하겠음. 포드 153으로부터 포드 042에게 : 라져. 본기 또한 9S와 임무 수행 및 기록을 수행하겠음.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/07/70547/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_i