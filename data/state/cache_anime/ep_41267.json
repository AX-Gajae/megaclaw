관으로부터 요르하 부대원 수색 임무를 지시받음. 행방불명된 기체들은 지상에서 임무 중 연락이 끊어진 것으로 추정됨. 블랙박스의 신호 발생 지점은 특정이 된 관계로, 해당 지점에 대한 목표물 수색을 개시한다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/02/65981/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 81476, "name": "니어:오토마타 Ver1.1a 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 81475, "name": "니어:오토마타 Ver1.1a 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-02-19T02:30:07.656258", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-02-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 60350, "title": "니어:오토마타 Ver1.1a part 1", "subject": "mave[R]ick", "description": "'포드 042의 보고' 폐허 도시 지역에서 레지스탕스와 기계 생명체 간의 교역 정보를 확인. 안드로이드와 기계 생명체는 적대 관계이지만, 교역 대상인 기계 생명체에게선 적성 반응 및 전투 의지가 확인되지 않은 것으로 파악됨. 릴리로부터 기계 생명체들에게 소재를 전달할 것을 의뢰받은 2B, 9S 둘과 함께 해당 지역에 대한 조사를 개시함.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/02/66445/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 81736, "name": "니어:오토마타 Ver1.1a 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 81735, "name": "니어:오토마타 Ver1.1a 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-02-26T02:30:07.990505", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-02-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 60432, "title": "니어:오토마타 Ver1.1a part 1", "subject": "[L]one wolf", "description": "'포드 042 · 포드 153 양쪽으로부터 보고.' 과거의 기록이라고 추측되는 데이터를 발견. 공유 서버로 전송함. 11941년 12월 8일. 어떤 비밀 임무와 함께 지구로 파견된 안드로이드들과 조우. 낯선 모습을 하고 있는 그들은 스스로를 '요르하 부대'라고 불렀다. 우리를 버린 사령부. 비밀 사항투성이고 수수께끼로 가득한 요르하 부대. 하지만 의심하기만 해서는 가족을 지킬 수 없다. 나의 선택이, 우리들의 싸움이, 오랜 시간 동안 이어져 온 소모전의 돌파구가 되기를 바란다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/03/66545/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 81909, "name": "니어:오토마타 Ver1.1a 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 81908, "name": "니어:오토마타 Ver1.1a 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-03-05T02:30:07.468942", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2023-03-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 60500, "title": "니어:오토마타 Ver1.1a part 1", "subject": "[Q]uestionable actions", "description": "'포드 153의 보고' 현시점까지의 임무에 있어서 기계 생명체의 변이체와 다수 조우했고, 일부와는 전투까지 발생함. 각 개체의 정보는 저번과 같이 서버에 업로드 완료. 이후 적과의 조우에 대비해서 벙커에서의 정보 해석 및 그 결과 공유를 요청함. 개체 식별 신호 : '파스칼'의 반응을 확인. 기계 생명체들의 마을에서 거주하는 한 기체가 미아가 된 것으로 추정됨. 의뢰에 따라 숲의 왕국 에어리어에 대한 수색을 개시함.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/03/66664/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_a