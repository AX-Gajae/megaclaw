published_datetime": "2025-12-26T09:00:10.971768", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-12-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89501, "title": "해파리 공주", "subject": "나는 해파리가 되고 싶다", "description": "아마즈는 재개발이 결정된 김에 건물을 팔기로 했다는 치에코 어머니의 전화를 받고 발등에 불이 떨어졌다. 시공사 주최의 주민 설명회에 참석한 아마즈는 똑 부러지는 시공사 직원 이나리에게 기가 죽어 자리에서 도망치고, 일을 추진하기 위해서라면 수단과 방법을 가리지 않는 권모술수 이나리의 타깃은 슈를 향하는데… 그런 아마즈 앞에 나타난 구세주가 있었으니?!", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/101847/v30/311e055fcaa0/Thumbnail.0000054.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:53.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127661, "name": "해파리 공주 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2025-12-26T09:00:11.169993", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2025-12-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 89502, "title": "해파리 공주", "subject": "나이트 오브더 리빙 아마즈", "description": "아마즈는 시공사와 이나리에게 맞서기 위해 과감한 변신을 시도했다. 익숙하지 않은 차림을 하고 나선 카페에서 생각외로 즐거운 시간을 보내며 쿠라노스케와의 마음의 벽도 차츰 허물어 가기 시작했다. 한편, 이나리의 계략에 제대로 빠져 속수무책으로 당해 버린 슈와 형의 비밀을 알아버린 쿠라노스케… 과연 이 난관을 어떻게 헤쳐나갈 것인가?!", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/12/101848/v30/5e89d764c765/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:22:56.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 127662, "na