ode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73722/v15/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:14.533000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90740, "name": "(일본어) RWBY vol.4 7 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-26T00:00:09.279062", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66814, "title": "RWBY vol.4 - 일본어", "subject": "해야 했던 대화", "description": "티리안이 사라지고 크로우에게 루비와 친구들의 질문이 쏟아진다.\n  크로우는 계절의 메이든 시스템에 대해 알려주고, 존은 피라가 선택을 강요받았다며 분노한다. 이어 크로우는 렘넌트의 형제 신, 창조와 파괴의 신에 대해 얘기하고 세일럼과 자신의 이름의 유래에 대해서도 얘기한다.\n  한편 블레이크는 아버지에게 오래 미뤄둔 사과를 건넨다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73732/v15/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:09.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90738, "name": "(일본어) RWBY vol.4 8 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-26T00:00:09.279062", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66815, "title": "RWBY vol.4 - 일본어", "subject": "이보 전진, 이보 후퇴", "description": "양은 의수를 끼고 아버지와 훈련을 하면서 처음으로 어머니인 레이븐에 대해 듣게 된다. 와이스는 소환술을 성공하고, 블레이크는 집에 침입한 스파이를 쫓는다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73730/v15/Thumbnail.0000047.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:19:56.300000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90745, "name": "(일본어) RWBY vol.4 9 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-27T00:00:10.474202", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66816, "title": "RWBY vol.4 - 일본어", "subject": "쿠로유리 마을", "description": "오스카는 오즈핀의 부탁대로 집을 나와 시내로 향한다.\n  렌은 쿠로유리 마을을 보고 아버지와 어머니를 잃었지만 노라를 만난 어린 시절을 회상한다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73735/v15/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:23.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 90742, "name": "(일본어) RWBY vol.4 10 소장", "list_price": 700, "period": "0 day", "promotion": null}], "published_datetime": "2023-11-27T00:00:10.474202", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "재능TV", "broadcast_date": "2023-11-27", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 66817, "title": "RWBY vol.4 - 일본어", "subject": "길을 나서다", "description": "양은 의수가 익숙해지자 떠나기로 하고, 타이양은 루비때와는 달리 양과 제대로 된 인사를 하고 헤어진다. 와이스는 클라인의 도움으로 집을 나가고, 선은 자신과 친구들을 밀어내는 블레이크에게 도움을 거부하지 말라고 말한다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73731/v15/Thumbnail.0000048.jpg", "has_preview": t