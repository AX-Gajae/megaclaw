, "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-04", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87475, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 03", "description": "아사히가 빙의해 있다는 사실을 꿈에도 모르는 팬들은 니요도의 새로운 캐릭터에 혼란을 느낀다. 문제의 심각성을 깨달은 아사히와 니요도는 이상적인 아이돌 캐릭터를 만들기 위해 고군분투한다. 한편, '징스'의 또 다른 멤버 요시노는 달라진 니요도의 모습을 보고 고민에 빠진다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99356/v30/b015d1c1f63f/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124263, "name": "카미쿠즈☆아이돌 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124262, "name": "카미쿠즈☆아이돌 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-03T00:00:14.770004", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87476, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 04", "description": "징스의 팬 미팅이 열리는 날. 팬들은 팬 미팅의 하이라이트인 '가위바위보 대회'에 사활을 걸었다. 한정판 브로마이드를 손에 넣으려는 팬들 사이에는 긴장감이 맴돈다. 하지만 웬일인지 무대 위 니요도도 가위바위보에 의욕을 보이는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99357/v30/b786292a71da/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124265, "name": "카미쿠즈☆아이돌 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124264, "name": "카미쿠즈☆아이돌 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-03T00:00:15.078266", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-11", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87477, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 05", "description": "니요도외 요시노는 징스의 2주년 라이브가 열린다는 소식을 듣는다. 공연장을 메우기에는 팬덤 규모가 턱없이 작은 상황. 아사히는 2주년 라이브를 성공시키겠다며 열의를 보인다. 한편, 징스는 인지도를 높이기 위해 아이돌 합동 이벤트 '꽃미남 산지 직송 시장'에 출연하게 된다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99358/v30/5c5b275dc886/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124267, "name": "카미쿠즈☆아이돌 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124266, "name": "카미쿠즈☆아이돌 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-03T00:00:15.396505", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87478, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 06", "description": "징스는 꽃미남 직송 행사의 여세를 몰아 '꽃미남 운동회'에 출연한다. 운동회라면 질색인 니요도지만 세토우치의 따가운 시선 때문에 아사히에게 일을 맡기지 못한다. 결국 쓰러진 니요도의 몸에 아사히가 들어가게 되는데…", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99359/v30/5b63a0252465/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124269, "name": "카미쿠즈☆아이돌 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124268, "name": "카미쿠즈☆아이돌 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-03T00:00:15.765126", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87479, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 07", "description": "시그라스 리더 '세토우치'는 알고 보니 아사히의 열성 팬이었다. 세토우치는 니요도가 아사히를 흉내 낸다며 불쾌해한다. 감시한다는 명분으로 징스의 공연마다 쫓아다니는 세토우치. 아사히와 니요도는 세토우치의 마음을 돌리기 위해 맹연습에 돌입한다.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99360/v30/d5a4c4ef52a3/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49.900000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 124271, "name": "카미쿠즈☆아이돌 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 124270, "name": "카미쿠즈☆아이돌 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2025-11-03T00:00:16.120805", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-04-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 87480, "title": "카미쿠즈☆아이돌", "subject": "STAGE. 08", "description": "징스의 첫 캘린더 촬영 날. 귀찮은 건 딱 질색인 니요도는 계속되는 촬영에 지쳐만 간다. 그런데 사실 캘린더의 의상 콘셉트에는 징스 팬들의 엄청난 고뇌와 갈등이 담겨 있었다.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/10/99361/v30/eb6b88174dd9/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23