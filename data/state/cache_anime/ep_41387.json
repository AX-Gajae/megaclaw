ate": "2023-04-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 61016, "title": "이 멋진 세계에 폭염을!", "subject": "홍마의 마을의 수호자들(가디언즈)", "description": "사신의 봉인이 풀려서 몬스터들이 마을 주변에서 날뛰기 시작했다. 선생님이 마을 어른들과 사신을 다시 봉인하기 위해 가고, 메구밍과 친구들은 도서관에서 자습한다. 그런데 그곳에 마을의 백수인 붓코로리가 나타나서 상담할 게 있다고 한다. 메구밍과 융융은 어쩔 수 없이 이야기를 들어주는데…", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/04/67451/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 82928, "name": "이 멋진 세계에 폭염을! 3 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 82927, "name": "이 멋진 세계에 폭염을! 3 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-04-21T00:00:08.254413", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-04-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 61110, "title": "이 멋진 세계에 폭염을!", "subject": "붉은 눈동자의 고고한 소녀(론리마스터)", "description": "후니후라와 도돈코가 후니후라의 남동생의 약을 사기 위해 돈을 모은다면서 융융에게 도와달라고 한다. 어떻게 해야 할지 망설이던 융융은 메구밍에게 의논한다. 다음날 메구밍은 융융이 후니후라와 도돈코에게 돈을 건네는 모습을 지켜보다가 융융이 떠난 다음 두 사람이 하는 말을 듣게 되는데...", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/04/67851/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 83148, "name": "이 멋진 세계에 폭염을! 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 83147, "name": "이 멋진 세계에 폭염을! 4 소장", "list_price