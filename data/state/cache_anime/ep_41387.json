 true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 83889, "name": "이 멋진 세계에 폭염을! 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 83888, "name": "이 멋진 세계에 폭염을! 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-05-26T00:00:07.587603", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-05-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 61973, "title": "이 멋진 세계에 폭염을!", "subject": "홍마의 마을에서 온 방문자(디스트로이어)", "description": "마차를 타고 액셀 마으로 향하는 메구밍과 융융. 액셀 마을까지 편하게 갈 줄 알았는데 메구밍이 몬스터 이야기를 꺼낼 때마다 몬스터들에게 습격을 받는다. 그리고 그때마다 융융이 마법으로 몬스터를 물리치고 결국 마력이 바닥이 났다. 그런데 하필 그때 생각지 못했던 적이 나타나는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/68891/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 84351, "name": "이 멋진 세계에 폭염을! 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 84350, "name": "이 멋진 세계에 폭염을! 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-02T00:00:07.287920", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-01", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62178, "title": "이 멋진 세계에 폭염을!", "subject": "풋내기 마을의 모험가들 (무법자)", "description": "풋내기 모험가의 마을 ‘액셀’에 도착한 메구밍과 융융은 모험가 길드에 가서 각자 파티 멤버를 구하려고 한다. 융융은 게시판에 파티 멤버를 모집한다고 써 붙이고 메구밍은 마법사를 구하는 파티에 들어가서 퀘스트를 한다. 하지만 둘 다 파티 멤버를 구하지 못하고 가지고 있는 돈이 떨어져 가는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69148/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 84626, "name": "이 멋진 세계에 폭염을! 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 84625, "name": "이 멋진 세계에 폭염을! 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-09T00:00:08.863526", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62336, "title": "이 멋진 세계에 폭염을!", "subject": "명물 아가씨와 숲의 악마(이레귤러)", "description": "퀘스트를 하기 위해 숲속으로 간 메구밍과 융융은 월버그를 찾아서 액셀 마을에 온 상위 악마인 호스트를 만난다. 악마가 나타났다는 이야기를 들은 길드에서는 모험가들을 모아 악마 토벌에 나서지만 실패한다. 한편 여관으로 돌아온 메구밍은 뜻밖의 사람을 만나는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69405/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 84827, "name": "이 멋진 세계에 폭염을! 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 84826, "name": "이 멋진 세계에 폭염을! 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-16T00:00:09.043958", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 62478, "title": "이 멋진 세계에 폭염을!", "subject": "이 멋진 세계에 폭염을! (익스플로전)", "description": "메구밍은 호스트를 쓰러뜨리기 위해 작전을 세우고 융융에게 도와달라고 한다. 만반의 준비를 하고 잠자리에 든 메구밍은 잠이 오지 않아 뒤척이는데 그때 융융이 방에 몰래 들어온다. 융융은 검은 고양이 인형을 가지고 메구밍에게 슬리프 마법을 걸어서 잠들게 하고 호스트와 싸우러 가는데…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/06/69752/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 85036, "name": "이 멋진 세계에 폭염을! 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 85035, "name": "이 멋진 세계에 폭염을! 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-06-23T00:00:08.009594", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-06-22", "rating_components": []}, "access_type": null, "is_available": false}]}