{"count": 48, "next": "https://api.laftel.net/api/episodes/v2/list/?item_id=46566&limit=20&offset=20&size=1&sort=oldest", "previous": null, "results": [{"id": 96502, "title": "파워레인저 다이노포스", "subject": "떴다! 레드 다이노, 킹!", "description": "수억 년 전 공룡을 멸망시킨 데보스군이 부활해 인류를 위협한다. 현신 토린은 다섯 명의 다이노포스를 결성해 그들에게 대항하려 한다. 토린이 마지막으로 찾아낸 용맹한 전사 강대성. 그는 우여곡절 끝에 강한 브레이브를 인정받고 레드 다이노로 변신한다. 드디어 5명의 전사가 모두 모인 ‘파워레인저 다이노포스!’ 그들은 힘을 합쳐 데보 몬스터를 물리치고 인류를 위기에서 구한다.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108557/v51/a9e36d6a3ebf/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:06.031000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138570, "name": "파워레인저 다이노포스 1 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:47.967692", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-07-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96503, "title": "파워레인저 다이노포스", "subject": "가브린초! 공룡 합체 등장!", "description": "데보스군이 본격적으로 인간을 공격하기 시작하는데 다이노포스는 아직 자신들의 정체를 밝히길 꺼린다. 특히 노근형은 과거에 가족들이 다친 게 자기 때문이라며 괴로워한다. 하지만 레드의 충고 덕에 가족을 지키려면 더 강해져야한다는 걸 깨닫고 용감하게 데보스군과 맞서 싸운다. 서로 솔직하게 정체를 밝히고 한 마음이 된 레드, 핑크, 블루는 공룡 합체 ‘티라노 킹’을 완성하고 데보스군을 물리친다.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108558/v51/d879a0cee0a1/Thumbnail.0000051.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:21.013000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138571, "name": "파워레인저 다이노포스 2 대여", "list_price": 700, "period": "7 day"