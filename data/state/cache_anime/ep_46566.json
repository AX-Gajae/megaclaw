 "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138573, "name": "파워레인저 다이노포스 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:48.663811", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-07-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96506, "title": "파워레인저 다이노포스", "subject": "등장! 충치에 걸린 안키돈!", "description": "데보 몬스터가 사람들의 이를 몽땅 썩게 만들었다. 다이노포스가 출동했지만 이안과 지후가 다투는 바람에 눈앞에서 놓치고 만다. 그때, 충치 빔을 맞은 파워 다이노 안키돈이 날뛰기 시작하고, 그의 파트너 라미레스는 안키돈을 구해달라고 한다. 지후는 이안과 계속 대립하지만 킹의 말을 듣고 자신이 이안을 오해했다는 걸 깨닫는다. 마음의 앙금을 털어버린 다이노포스는 다섯 명이 힘을 합쳐 데보 몬스터를 물리친다. 하지만 안키돈은 돌아오지 못하는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108561/v51/2c9848906457/Thumbnail.0000050.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:21:04.997000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 138574, "name": "파워레인저 다이노포스 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-07-18T00:00:48.890636", "rating": {"rating": 7, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-07-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 96507, "title": "파워레인저 다이노포스", "subject": "스톱! 노래하는 캔드릴라!", "description": "데보 몬스터에게 사로잡힌 안키돈. 다이노포스는 라미레스를 위해 최선을 다해 안키돈을 찾는다. 그때 어디선가 캔드릴라의 노랫소리가 들 리고 라미레스는 노랫소리 근처에 안키돈이 있다는 걸 알아챈다. 안키돈을 조종하는 데보 몬스터를 끌어내기 위해, 아미는 스티메로의 다이노셀로 몬스터가 자신에게 홀딱 반하게 만든다. 아미에게 반한 몬스터가 순순히 밖으로 나오자 다이노포스와 라미레스는 힘을 합쳐 몬스터를 물리친다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/06/108562/v51/bd