{"count": 12, "next": null, "previous": null, "results": [{"id": 83850, "title": "어느 마녀가 죽을 때까지", "subject": "여명 1년의 마녀", "description": "라피스 마을에서 사는 견습 마녀 메구 라즈베리는 17살이 되는 생일에, 스승인 '영년의 마녀' 파우스트로부터\n여명 1년의 저주에 걸렸다는 선고를 받았다. 살 수 있는 방법은 불가능에 가까워서 부루퉁해져 있는 가운데,\n어떤 소녀로부터 엄마가 잠든 채 일어나지 않는다는 이야기를 들었는데.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94343/v30/59e072a0b179/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-13T04:00:12.019829", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83851, "title": "어느 마녀가 죽을 때까지", "subject": "견습 마녀와 라피스의 사람들", "description": "메구의 친구이자 학생인 피네가 마녀의 집에 상담을 하러 방문했다. 그녀의 소원은, 할아버지의 유품인 낡은 손목시계를\n고치는 것. 움직이지 않게 된 손목시계는, 시계에 깃든 정령이 약해져 있는 것으로 보였는데.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94344/v30/ed1a5d0ab833/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-13T04:00:12.275390", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-12", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83852, "title": "어느 마녀가 죽을 때까지", "subject": "동쪽으로부터, 영지의 내방", "description": "파우스트가 집을 비우고, 집을 지키게 된 메구한테 동양에서 온 칠현인 중 하나인 '영지의 마녀' 이노리가\n찾아왔다. 이노리는 메구와 대화를 하는 가운데, 그녀의 수명이 얼마 남지 않았다는 걸 꿰뚫어 보았는데.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94558/v30/46b8a56a3fdc/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-20T04:00:10.533533", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83853, "title": "어느 마녀가 죽을 때까지", "subject": "축복은 개문과 함께", "description": "메구와 동갑이면서 칠현인인 '축복의 마녀' 소피가 이계 축제를 위해 라피스에 방문했다. 소피는 아름다운 \n마법 퍼포먼스로 사람들을 기쁘게 해주었지만, 그녀의 목적은 '마법을 이 세상에서 없애는 것'이었는데.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94559/v30/9ec112b3ceeb/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-20T04:00:10.899135", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83854, "title": "어느 마녀가 죽을 때까지", "subject": "제전의 밤하늘에 꽃은 핀다", "description": "메구와 소피는 이계 축제 현장에서 마리와 만났다. 그녀는 작년 축제에서 함께 불꽃놀이를 본 남성을\n찾고 있었다. 올해에는 불꽃놀이를 하지 않는다는 걸 알고, 재회를 포기하는 그녀를 보고 메구는\n함께 그 남성을 찾기로 결정했는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94636/v30/36e392328861/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-27T04:00:12.328654", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83855, "title": "어느 마녀가 죽을 때까지", "subject": "마법이 없는 해 질 녘 하늘은", "description": "기쁨의 눈물을 모으는 요령을 깨우치고, 효율 좋게 50알까지 눈물을 모으고 의기양양하게 웃는 메구.\n눈물을 모으는 것에 열중한 나머지 중요한 감정을 놓치고 있는 메구를 보고, 파우스트는 그녀에게\n마법을 쓰는 걸 금지한다고 말했는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/06/94637/v30/1e91c837fc78/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-06-27T04:00:12.530168", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-06-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83856, "title": "어느 마녀가 죽을 때까지", "subject": "언어와 재앙과 식전과", "description": "'라피스의 마녀'라는 별칭을 얻은 메구는 20년에 한 번 열리는 대제전인 '마법 식전'에 참가하게 되었다.\r\n마도사들로 붐비는 회장에서 메구는 무수히 많은 정령에 둘러싸인 정체불명의 소녀와 만나, 함께 회장을\r\n돌아보게 되었는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/94889/v30/0b5ad42f3724/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-04T04:00:10.137780", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83857, "title": "어느 마녀가 죽을 때까지", "subject": "악마에게 홀린 가족", "description": "어느 날 메구는 라피스에 살고 있는 소녀 메어리의 목에 화상 같은 상처 자국이 있는 걸 발견했다.\r\n그것은 악마의 제물이 된 증표인 '악마의 낙인'. 악마는 매우 위험한 존재인 탓에 파우스트는 메구에게\r\n메어리에게 관여하는 것을 금했는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/94890/v30/a641cbe092bb/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-04T04:00:10.488887", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-03", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83858, "title": "어느 마녀가 죽을 때까지", "subject": "오래된 거목은 잠든다", "description": "마력에 오염된 거목을 벌목해달라는 의뢰를 받은 메구. 마력을 너무 흡수해 변질된 거목을 빠르게\r\n제거하지 않으면 라피스 마을 전체에 악영향을 줄지도 모르는 위험한 상황이었다. 그런 나무 위에 있던 \r\n정체불명의 소녀가 메구에게 말을 걸었는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95222/v30/41ae79b6d413/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-11T04:00:11.369899", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83859, "title": "어느 마녀가 죽을 때까지", "subject": "파도 소리와 함께 축복의 종은 울린다 (전편)", "description": "메구의 다리를 치료해 주겠다고 자청한 '생명의 현자' 자크와 만나기 위해, 메구는 물의 수도 아쿠아마린에\r\n방문했다. 거기서 메구는 자신이 파우스트에게 거두어진 경위와 이 도시에 불린 진짜 이유를 알게 되었는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95223/v30/c46d1562595b/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-11T04:00:11.728012", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83860, "title": "어느 마녀가 죽을 때까지", "subject": "파도 소리와 함께 축복의 종은 울린다 (후편)", "description": "마력 오염의 치료법을 자크와 함께 찾는 메구. \r\n성공의 열쇠는 마법에 강한 마음을 담는 '감정'의 힘이었다.\r\n희망의 빛이 보이기 시작한 것도 잠시. \r\n인근 바다의 마력에 이변이 발생해 아쿠아마린에 쓰나미가 닥쳐오는 위기가 발생했는데...", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95776/v30/637a9a8d18d7/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-18T04:00:10.480812", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-17", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 83861, "title": "어느 마녀가 죽을 때까지", "subject": "내가 사랑한 사람들", "description": "아기였을 때의 꿈을 꾸고 잠을 설치는 메구의 앞에 '재앙의 마녀' 엘도라가 나타났다. \r\n엘도라는 메구와 똑같이 파우스트의 손에 자란 선배 제자였다. \r\n엘도라가 그녀에게 말한 진실은 메구로 하여금 크나큰 결단을내리게 이끌었는데...", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/07/95777/v30/a756f34aef23/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:53.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2025-07-18T04:00:10.845004", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2025-07-17", "rating_components": []}, "access_type": null, "is_available": false}]}