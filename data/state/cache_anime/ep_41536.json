_available": false}, {"id": 73415, "title": "언데드 걸 머더 파르스", "subject": "불사신과 귀신", "description": "고다르 가에서 일어난 흡혈귀 살해 사건의 수사를 이어가는 아야 일행. 내부인의 범행이라고 판단한 아야는 사건 당시 각각의 행동을 차례로 묻는다. 그 후 고다르 경과 함께 서쪽 숲으로 무언가를 찾으러 나간다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/05/81861/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104816, "name": "언데드 걸 머더 파르스 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-05-31T00:00:08.106720", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-08-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73416, "title": "언데드 걸 머더 파르스", "subject": "신우치 등장", "description": "한나 고다르를 죽인 범인을 알아낸 아야는 고다르 가족과 사용인을 모두 불러 모은다. 그리고 차근차근 설명하며 사건의 수수께끼를 풀어나간다. 곧이어 끔찍한 흡혈귀 살인 사건의 범인이 밝혀진다.", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/05/81862/v15/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 104815, "name": "언데드 걸 머더 파르스 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-05-31T00:00:08.106720", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2023-08-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 73417, "title": "언데드 걸 머더 파르스", "subject": "런던의 불사자", "description": "1899