der": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/01/63903/v15/Thumbnail.0000062.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:26:00.400000", "progressbar": null, "item_expire_datetime": "2026-02-03T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2023-01-21T15:30:12.327682", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KBS", "broadcast_date": "2021-03-25", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58982, "title": "꽉잡아 [2026년 판권 만료작]", "subject": "마음의 빚", "description": "자기 자신이 좋아하는 것이 목공인지 알아보고 싶어하는 두언, 드디어 관심을 가지게되고 학교 중간평가에 예전과 다른 열의를 발의 하는데 아직은 시기상조, 하지만 하의등급학생들로 기능대회 출전을 지시한 교장의 지침을 모르는 학생들은 두언이 선발되는것이 의아하다. 한편 아빠에 대한 창피함에 존재를 숨기고 반항으로 일관하던 지석은 두언이가 만든 편지함의 뜻을 들은 계기로 자신때문에 다리가 불편해진 아빠에 대해 사과하고 참회의 눈물을 흘린다.", "episode_num": "14", "episode_order": 14, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/01/63898/v15/Thumbnail.0000062.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:26:10.100000", "progressbar": null, "item_expire_datetime": "2026-02-03T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2023-01-21T15:30:12.327682", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KBS", "broadcast_date": "2021-04-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58983, "title": "꽉잡아 [2026년 판권 만료작]", "subject": "알고 싶지 않아", "description": "계속 연락이 닿지않는 아라. 걱정하던 두언에게 아라로 부터 유학을 간다는 납득하기 어려운 메시지를 받고 아라에게 문제 생겼음을 직감한다. 선 여고 학생들 사이에 아라의 소문을 알게된 두언은 결국 아라가 예전에 살던 강농시까지 찾아가 아라 과거의 아픔과 오해를 알게되고 오열하게 된다.", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/01/