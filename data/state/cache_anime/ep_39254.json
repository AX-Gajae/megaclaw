me": "0:23:54.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 37859, "name": "MIX 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 37858, "name": "MIX 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-05-08T22:30:00.023048", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-05-08", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31034, "title": "MIX(믹스) 1", "subject": "투수잖아?", "description": "니시무라에게 홈런을 맞는 상황에서도 필사적으로 수비하는 토우마와 소우이치로. 5회를 끝마치고 난 뒤에도 겨우 동점이라는 상황에 단념했다. 하지만 최고의 커브를 결정구로 가진 상대편 에이스인 니시무라 앞에서 타선은 그를 당해내지 못한다. 게다가 6회에서는 니시카도도 무너져내리고 순식간에 5점 차가 나게 되어버린다. 마지막 회의 공격에 전력을 다하는 메이세이 학원. 한편 그 무렵, 타치바나 자택에 오오야마라는 이상한 남자가 둘의 아버지인 에이스케를 찾아온다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27128/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 38125, "name": "MIX 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 38124, "name": "MIX 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-05-15T22:30:00.017580", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-05-15", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31361, "title": "MIX(믹스) 1", "subject": "봄이 오면", "description": "", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27376/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:54.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 38753, "name": "MIX 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 38752, "name": "MIX 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-05-23T01:00:00.233904", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-05-22", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31456, "title": "MIX(믹스) 1", "subject": "걱정돼?", "description": "메이세이 학원 고등부에 진학해 고시엔으로 가는 길을 걷기 시작한 토우마와 소우이치로. 혹독한 연습을 끝내고 귀가했지만 새 감독인 오오야마가 놀러와 있다. 아무것도 모르는 토우마는 화장실의 문을 열었을 때 옷을 갈아입고 있는 하루카와 조우한다. 당황해서 문을 닫지만 하루카를 신경 쓰고 있는 소우이치로에게 벗은 몸을 봤냐고 추궁당한다. 그 장면을 미소지은 얼굴로 보는 하루카. 한편, 오토미도 하루카의 존재가 신경 쓰이는 듯한데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27512/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 38958, "name": "MIX 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 38957, "name": "MIX 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-05-29T22:30:00.364153", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-05-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31545, "title": "MIX(믹스) 1", "subject": "우리 오빠", "description": "갑자기 쏟아지는 폭우로 패밀리 레스토랑으로 몸을 피한 소우이치로는 오토미를 라이벌로 생각하는 미타 아리사와 만나고 작년 고시엔 상위 8위에 든 토슈 고등학교의 에이스인 그녀의 오빠, 미타 히로키와도 조우한다. 이후에 토슈 고등학교는 메이세이 학원에게 연습 시합을 제안해온다. 아리사가 오토미에게 가진 대항심으로 형제의 대결이 시작된 것이었다. 타치바나 형제는 드디어 고교 야구에 데뷔하게 된다. 강호를 상대로 토우마의 투구는 인정받을 것인가? 오토미를 위해서라도 질 수는 없는 대결이 시작된다!", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27870/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 39112, "name": "MIX 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 39111, "name": "MIX 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-06-05T22:30:00.653744", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-06-05", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31651, "title": "MIX(믹스) 1", "subject": "엄청난 뉴스거리지?", "description": "", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27841/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:55", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 39294, "name": "MIX 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 39293, "name": "MIX 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2019-06-12T22:30:00.844577", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2019-06-12", "rating_components": []}, "access_type": null, "is_available": false}, {