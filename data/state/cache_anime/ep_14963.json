st_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-03T00:00:14.127778", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92562, "title": "마법기사 레이어스", "subject": "전설의 광물 에스쿠도", "description": "드디어 에테르나에 도착한 히카루 일행. 에스쿠도를 찾아 이상한 샘에 뛰어든다. 하지만 세 사람은 도중에 헤어져 버린다. 그런 세 사람 앞에 각자의 소중한 존재가 공격하기 시작한다. 점점 상처 입는 히카루 일행. 그때, 에메로드 공주의 환영이 나타나서 말을 건다.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105288/v30/460b81e03893/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:54.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 131764, "name": "마법기사 레이어스 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-03T00:00:14.363126", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92563, "title": "마법기사 레이어스", "subject": "목숨을 건 프레세아의 무기", "description": "드디어 에스쿠도를 손에 넣은 히카루 일행은 프레세아가 있는 곳으로 돌아가서 무기의 완성을 기다린다. 그곳에 아스콧이 보낸 마수가 공격하기 시작한다. 히카루 일행은 맞서 싸우지만, 세 사람의 마법과 무기로는 전혀 쓰러뜨릴 수 없다. 가혹한 상황에서 전설의 무기를 만드는 프레세아를 위해 세 사람은 필사적으로 저항하지만, 결국 프레세아가 있는 곳이 무너져 내린다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105602/v30/e011a3eeaa1a/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "