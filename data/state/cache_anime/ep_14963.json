time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132086, "name": "마법기사 레이어스 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-10T00:00:13.756712", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92566, "title": "마법기사 레이어스", "subject": "마법 기사 최대의 위기!", "description": "고향을 그리워하다가 결국 약한 소리를 하는 우미. 히카루와 후우는 그런 우미를 격려한다. 그러는 중에 알시오네가 강력한 마법을 펼친다. 그 공격으로 인해 히카루와 후우는 눈과 얼음으로 뒤덮인 세계에 갇히고 강력한 냉기 때문에 쓰러진다. 그리고 우미만이 도쿄 타워 전망대에서 눈을 뜬다. 하지만 그곳은 우미가 만들어 낸 망설임의 세계였다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105605/v30/522427902473/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132087, "name": "마법기사 레이어스 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-10T00:00:13.980892", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92567, "title": "마법기사 레이어스", "subject": "되살아나는 전설의 마신 세레스", "description": "드디어 바닷속 신전에서 마신 세레스와 만난 우미, 세레스는 우미에게 마신을 받아들일 자격이 있는지를 증명하라고 한다. 강한 마음을 그 증표로 보여 달라는 것이다. 그때, 밖에서 기다리는 히카루와 후우 앞에 마수가 나타나서 공격한다. 절체절명의 위기에 빠진 히카루와 후우는 우미와 마신을 방해하지 않으려고 필사적으로 사투를 벌인다. 히카루와 후우의 위기를 알아챈 우미는 세레스보다 두 사람을 구하는 것을 선택한다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105601/v30/ead1a914af96/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132088, "name": "마법기사 레이어스 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-10T00:00:14.194324", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-09", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92568, "title": "마법기사 레이어스", "subject": "이세계 세피로의 마신 전설", "description": "다음 마신을 찾기 위해 하늘에 뜬 산을 향해 가는 히카루 일행. 하지만 자가토의 공격을 받게 된다. 다행히 에메로드 공주의 도움으로 위기를 벗어나지만, 이동 수단을 잃게 된다. 히카루 일행은 근처 마을에서 다시 정비하려고 했지만, 마을에 들어서자마자 마을 사람들이 공격하기 시작한다. 맞서 싸울 수도 없는 히카루 일행을 비웃듯이 그 배후에는 환술사 칼디나가 있었다.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105907/v30/85d40a9b7312/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132334, "name": "마법기사 레이어스 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-17T00:00:13.237538", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92569, "title": "마법기사 레이어스", "subject": "무서운 환술사 칼디나", "description": "하늘 신전으로 향하는 히카루 일행에게 칼디나의 마수가 뻗는다. 칼디나가 환각으로 농락하자, 세 사람은 근처 동굴로 피한다. 그런데 동굴 안에는 돌로 변한 줄 알았던 클레프가 있었다. 클레프는 의심스러워하는 세 사람을 동굴 안으로 유인한다. 그곳에는 에메로드 공주까지 있었다. 하지만 놀라는 히카루 일행을 공주는 차가운 얼굴로 공격하기 시작한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105908/v30/28cfc8ffe31e/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132335, "name": "마법기사 레이어스 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-17T00:00:13.602093", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92570, "title": "마법기사 레이어스", "subject": "이 세상에서 가장 소중한 것", "description": "마법 기사를 죽이겠다며 열을 올리는 칼디나는 계략을 써서 후우를 혼자 떨어뜨려 놓는다. 그 틈에 히카루와 우미는 칼디나의 환술에 걸리고 만다. 겨우 히카루와 우미를 찾은 후우지만, 칼디나에게 조종당하는 두 사람에게 공격받게 된다. 두 사람이 다치지 않도록 방어만 하던 후우는 클레프의 조언을 듣고, 망설임을 극복하고 두 사람과 대치한다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105909/v30/93067ab51b09/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:50.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 132336, "name": "마법기사 레이어스 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2026-04-17T00:00:14.083756", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "tooniverse", "broadcast_date": "2026-04-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 92571, "title": "마법기사 레이어스", "subject": "히카루, 우미, 후우의 양보할 수 없는 소원", "description": "전투에도 익숙해지며, 연계 공격도 가능해진 세