cast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 9360, "title": "장신소녀 마토이 [2021년 판권 만료작]", "subject": "열리는 문", "description": "마토이 일행이 싸우는 사이, 하늘 위에서는 정차원의 문이 열리기 시작한다. 이 문이 열리면 온갖 자연법칙이 파괴되어 혼란에 빠진다는데. 한편 마토이는 자신의 어머니인 시오리 또한 정차원의 문에서 실종되었다는 소리를 듣고서…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7502/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:15.566000", "progressbar": null, "item_expire_datetime": "2021-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:14:35.915145", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 9361, "title": "장신소녀 마토이 [2021년 판권 만료작]", "subject": "다녀올게요", "description": "싱고 군이 의외의 사람을 범인으로 지목한다. 범인은 싱고에게 자신의 딸 마토이와 아내 시오리에 얽힌 진실을 말해준다. 한편 마토이는 어머니가 있는 정차원으로 떠날 각오를 다지고서, 싱고에게 마지막 인사를 건네는데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/7503/v4/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:15.566000", "progressbar": null, "item_expire_datetime": "2021-09-30T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-09-15T13:14:35.752723", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 9362, "title": "장신소녀 마토이 [2021년 판권 만료작]", "subject": "평범한 게 최고", "description": "이 세상을 구하기 위해, 엄마 시오리를 되찾기 위해, 마음을 다잡는 마토이. 그런 그녀를 따르는 유마와 클라루스. 그러나 크리드 킬러와 나이츠가 그들의 앞길을 가