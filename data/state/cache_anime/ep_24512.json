ts": []}, "access_type": null, "is_available": false}, {"id": 5842, "title": "암살교실 1기", "subject": "구기 대회의 시간", "description": "E반으로 내려오며 야구부에서 쫓겨났던 스기노는 구기 대회를 앞두고 야구부의 연습장을 지나치다 모욕적인 말을 듣게 된다. 대회에서 본때를 보여주겠다며 피땀 흘려 연습한 스기노와 E반 학생들. 그리고 다가온 구기 대회에서 E반 학생들은 놀라운 실력으로 3점을 선취해낸다. 이를 두고 보지 못한 이사장은 야구부의 지휘자로 나서며 E반을 압박하기 시작하는데. ", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4884/v1/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:13", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4438, "name": "암살교실 12 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27469, "name": "암살교실 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2017-06-16T20:18:58.707875", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5843, "title": "암살교실 1기", "subject": "재능의 시간", "description": "쿠누기가오카 3학년 E반에 카라스마를 도울 새로운 체육선생 ‘타카오카 아키라’가 나타난다. 아이들을 대하는 타카오카의 모습을 보며 자신이 가진 교사로서의 자질을 의심하는 카라스마. 하지만 머지 않아 타카오카는 모두의 앞에 자신의 실체를 드러내고. 카라스마는 이를 안타깝게 여기면서도 답을 찾지 못한 채 망설이기만 한다.   ", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4885/v1/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:14.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 4439, "name": "암살교실 13 대여", "list_price": 600, "period": "7 day", "promotion": null}, {"id": 27470, "name": "암살교실 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "20