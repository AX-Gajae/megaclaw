ailable": false}, {"id": 1739, "title": "겁쟁이 페달 1기", "subject": "RIDE.15 책략", "description": "마나미와의 재회로 전국 체전에 대한 열의가 생긴 사카미치.\r\n전국 체전에 나가기 위해 우선 이 합숙에서 1000km를 완주해야 된는 사카미치는 역시 대회 출장을 목표로 하는 이마이즈미나 나루코와 함께 열심히 페달을 돌린다. 그러나 그런 1학년들에 대해 2학년의 테지마, 아오야기는 책략을 펼치고 있는데…", "episode_num": "15", "episode_order": 15, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76399/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1161, "name": "겁쟁이 페달 15 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T18:27:25.449965", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-01-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 1740, "title": "겁쟁이 페달 1기", "subject": "RIDE.16 일점돌파", "description": "1000km주파를 향한 사카미치와 이마이즈미 나루코를 막는 2학년의 테지마, 아오야기. 두 사람은 앞선 순위를 사수하기 위해 사카미치에게 승부를 걸어 왔다. 두 사람의 강한 팀워크와 교묘한 책략에 의해 정신적으로도 궁지에 몰리는 이마이즈미와 나루코. 그런 가운데 테지마는 작년 봄 고등학교에 입학해서 아오야기와 만난 시절을 떠올리는데....", "episode_num": "16", "episode_order": 16, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76387/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49.966000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1162, "name": "겁쟁이 페달 16 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T18:27:25.724976", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-01-21", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 1741, "title": "겁쟁이 페달 1기", "subject": "RIDE.17 꼴찌 오노다", "description": "테지마의 철벽 방어를 깨고 언덕에서 일점 돌파를 이룬 사카미치. 온갖 작전이 바닥나서 낙담한 테지마였는데 꼭 둘이 함께 전국 체전에 가야 한다는 아오야기의 강한 의지를 따라 다시 1학년을 뒤쫓는다. \r\n골라인을 향해 전력으로 달리는 다섯명. 전국 체전 출전을 건 1학년과 2학년의 싸움이 마침내 절정으로 치닫는다!", "episode_num": "17", "episode_order": 17, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76388/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:49.933000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1163, "name": "겁쟁이 페달 17 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T18:27:25.804212", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-01-28", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 1742, "title": "겁쟁이 페달 1기", "subject": "RIDE.18 전력 승부", "description": "맨 뒤로 떨어져나가면서도 불굴의 의지로 페달을 돌려 앞서 가는 이마이즈미, 나루코, 테시마, 아오야기를 쫒아가는 사카미치. 5명 각각 다양한 마음을 가슴에 품고 골라인을 향해 전력으로 질주, 죽을 힘을 다해 골 스프린트에서 격돌! 전국 체전 출장을 건 1학년과 2학년의 싸움이 마침내 절정으로 치닫는다", "episode_num": "18", "episode_order": 18, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/02/76376/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:48.900000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 1164, "name": "겁쟁이 페달 18 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-05-19T18:27:25.872179", "rating": {"rating": 12, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2014-02-04", "ratin