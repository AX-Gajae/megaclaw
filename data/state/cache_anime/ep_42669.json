: []}, "access_type": null, "is_available": false}, {"id": 80114, "title": "3월의 라이온 2기", "subject": "검은 안개 외", "description": "수학여행을 다녀온 후 히나타의 반에서 타카기 일당들은 담임을 괴롭히기 시작한다. 결국 담임 선생님은 심적인 문제로 쓰러져 입원하게 되고. 새롭게 담임이 된 학년 주임 코쿠부는 문제를 해결하기 위해 히나타와 타카기의 보호자를 불러 삼자 면담을 하기로 한다. 히나타에게 사정을 들은 아카리는 일은 내팽개치고 면담을 가려는 할아버지를 설득해 자신이 면담을 하러 나선다. 하지만 두 사람은 타카기의 어머니를 만나고…", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/89636/v30/581ac7f6fea8/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:10.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114113, "name": "3월의 라이온 2기 - 판권 부활 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-12-19T00:00:11.749046", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니원", "broadcast_date": "2023-12-14", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 80115, "title": "3월의 라이온 2기", "subject": "작은 손바닥 외", "description": "코쿠부 선생님의 개입으로 인해 왕따 문제가 해결되기 시작한다. 타카기는 반 아이들 앞에서 형식적으로 사과하기는 했지만 코쿠부는 그런 그녀와 끈질기게 대화를 나누려고 한다. 그리고 반 친구들과 함께 예전처럼 웃을 수 있게 된 히나타. 그녀에게 왕따 문제로 전학갔던 치호로부터 첫 편지가 도착한다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/12/89637/v30/0e85460b0051/Thumbnail.0000060.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:25:10.133000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 114114, "name": "3월의 라이온 2기 - 판권 부활 13 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-12-19T00:00:11.876741", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "cla