et/assets/2022/04/57252/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72503, "name": "사축 씨는 꼬마 유령에게 치유받고 싶어 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72502, "name": "사축 씨는 꼬마 유령에게 치유받고 싶어 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-04-30T00:00:00.734094", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-04-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54325, "title": "사축 씨는 꼬마 유령에게 치유받고 싶어", "subject": null, "description": "5월 5일은 어린이날. 어린이날 하면, 코이노보리. 후시하라 씨는 어린이날을 맞이해 집에 '어린이날'과 어울리는 외견을 가진 유령짱과 먀코가 있다는 것을 상기한 후에 몹시 서두르며 일을 끝내기 위해 집중한다. 한편 집을 보고 있던 유령짱과 먀코는 꽃을 이용해서 후시하라 씨가 집에 돌아올지 안 올지를 점치는데.", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/05/57377/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 72693, "name": "사축 씨는 꼬마 유령에게 치유받고 싶어 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 72692, "name": "사축 씨는 꼬마 유령에게 치유받고 싶어 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-05-07T00:00:00.806073", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-05-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 54471, "title": "사축 씨는 꼬마 유령에게 치유받고 싶어", "subject": null, "desc