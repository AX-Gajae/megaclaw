_available": false}, {"id": 63587, "title": "쇼와 겐로쿠 라쿠고 심중", "subject": "제12화", "description": "온천 마을의 여관에서 작은 라쿠고회를 열게 된 키쿠히코와 스케로쿠. \r\n 모두의 기대를 한 몸에 받고 무대에 오른 스케로쿠는 \r\n 관객들의 따듯한 반응에 라쿠고와 사람의 관계를 새삼 깨닫는다. \r\n 다 같이 도쿄로 돌아갈 생각에 부푼 키쿠히코 앞에 집을 나갔다던 미요키치가 나타난다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70651/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:17.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87012, "name": "쇼와 겐로쿠 라쿠고 심중 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87011, "name": "쇼와 겐로쿠 라쿠고 심중 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-19T01:00:08.703265", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2023-08-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 63588, "title": "쇼와 겐로쿠 라쿠고 심중", "subject": "제13화", "description": "키쿠히코는 코나츠를 데리고 도쿄로 돌아오지만, \n 상처받은 아이와는 엇갈리기만 할 뿐 고독은 사라지지 않는다. \n 시간이 지나 라쿠고의 인기는 시들어진다. \n 8대째 야쿠모의 제자가 된 요타로는 신우치 승진을 앞두고, \n 오랫동안 품고 있던 소망을 스승에게 털어놓는다.", "episode_num": "13", "episode_order": 13, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/08/70652/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:01.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 87014, "name": "쇼와 겐로쿠 라쿠고 심중 13 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 87013, "name": "쇼와 겐로쿠 라쿠고 심중 13 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2023-08-19T01:30:08.4