el.net/assets/2018/12/4662/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:42.166000", "progressbar": null, "item_expire_datetime": "2019-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-16T14:23:59.455276", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5618, "title": "바쿠온!! [2019년 판권 만료작]", "subject": "겨울방학!", "description": "크리스마스 즈음에 생일을 맞는 히지리는 오토바이 면허를 따기 위해, 온사의 가게에서 산 오토바이로 연습을 시작한다. 처음엔 마음대로 되지 않아 오토바이에게 화풀이를 하지만, 이내 자기 힘으로 타 보겠다는 각오를 다진다. 한편, 크리스마스 파티를 위해 하네의 집에 모인 바이크 부원들은 산타클로스에 얽힌 추억을 얘기하며 즐거운 시간을 보낸다. ", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4663/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.166000", "progressbar": null, "item_expire_datetime": "2019-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2017-06-16T14:23:59.495493", "rating": {"rating": 15, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 5619, "title": "바쿠온!! [2019년 판권 만료작]", "subject": "신입생!", "description": "하네의 여동생, 유메와 동급생 치사메는 함께 오카노우에 고교 입학 시험을 치른다. 시험 당일, 입시생들의 안내를 맡으면서 바이크부를 홍보하는 부원들을 보며, 치사메는 자신의 초소형 오토바이 레이스를 떠올린다. 한편, 졸업을 앞둔 라이무 선배를 위해, 하네와 바이크 부원들은 비밀리에 졸업 파티를 준비하는데… ", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/4664/v4/Thumbnail.0000056.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:41.100000", "progressbar": null, "ite