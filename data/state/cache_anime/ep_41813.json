, "name": "코드네임 X 19 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96551, "name": "코드네임 X 19 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-04-10T00:00:09.341166", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KBS 1TV", "broadcast_date": "2023-08-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 67129, "title": "코드네임 X", "subject": "코드네임 R의 어질어질 곡예비행", "description": "바이올렛을 향해 가고 있는 부르스타 윙. 갑자기 번개가 치고, 그 탓에 엔진 하나가 고장이 난다. 문이 열리며 파랑과 I, 비밀 일기장이 날아갈 위험에 처하지만 파랑은 겨우겨우 구하는 데 성공한다. 안정을 찾은 기체 안에서 파랑은 바이올렛의 일기장을 보며 과거 바이올렛이 코스모의 실험체였다는 사실을 얘기하는데…", "episode_num": "20", "episode_order": 20, "thumbnail_path": "https://thumbnail.laftel.net/assets/2023/11/73566/v15/Thumbnail.0000035.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:14:36.400000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 96554, "name": "코드네임 X 20 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 96553, "name": "코드네임 X 20 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-04-17T00:00:09.483925", "rating": {"rating": 0, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "KBS 1TV", "broadcast_date": "2023-09-02", "rating_components": []}, "access_type": null, "is_available": false}]}