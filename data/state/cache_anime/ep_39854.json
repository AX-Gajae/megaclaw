75/v15/Thumbnail.0000029.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:21.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 53604, "name": "피터 그릴과 현자의 시간 6 대여", "list_price": 400, "period": "7 day", "promotion": null}, {"id": 53603, "name": "피터 그릴과 현자의 시간 6 소장", "list_price": 900, "period": "0 day", "promotion": null}], "published_datetime": "2020-08-17T01:00:00.095469", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2020-08-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41550, "title": "피터 그릴과 현자의 시간", "subject": "피터 그릴과 악연의 싸움", "description": "리사, 미미, 비건, 피그리트. 피터의 씨앗을 노리는 여자들의 배틀이 시작됐다!\r\n 비건이 마술로 소환한 것은 요정 아가페. 피터의 사정은 전혀 개의치 않고 흥분도를 수치화해서 보여주는 것이었다. 저마다의 양보 없는 싸움이 격해질 무렵, 팀이 술을 가지고 찾아와서 술판이 벌어지는데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2020/08/41002/v15/Thumbnail.0000029.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:12:21.766000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 53660, "name": "피터 그릴과 현자의 시간 7 대여", "list_price": 400, "period": "7 day", "promotion": null}, {"id": 53659, "name": "피터 그릴과 현자의 시간 7 소장", "list_price": 900, "period": "0 day", "promotion": null}], "published_datetime": "2020-08-24T01:00:00.117042", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2020-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 41601, "title": "피터 그릴과 현자의 시간", "subject": "피터 그릴과 비밀 조약", "description": "엄청난 밤을 보낸 탓에 폭발해 버린 처참한 모습의 아가페. 다툼을 피하기 위해서는 씨앗을 