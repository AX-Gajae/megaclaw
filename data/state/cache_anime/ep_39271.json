gressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-08T01:00:00.121132", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31005, "title": "Fairy gone [2022년 판권 만료작]", "subject": "여행길의 동반자", "description": "성대하게 열릴 열 번째 종전기념식을 앞두고 신형 인공요정이 오작동을 일으켰다. 다행히 현장에 있던 프리와 마리야의 저지로 사태가 크게 번지진 않았다. 그리고 그 사건에 대한 조사를 나선 도로테아였는데.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27246/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-15T01:00:00.336710", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31348, "title": "Fairy gone [2022년 판권 만료작]", "subject": "고집쟁이 대장장이와 삐뚤어진 토끼", "description": "인공 요정 폭주 사건이 또 일어났다. 원인을 명확하게 밝혀내지 못하는 바람에 내부 범행을 의심하며 상층부 간의 싸움은 크게 번져만 갔다. 프리는 단독 조사에 나섰지만 결정적은 증거를 잡지 못하는 상황이었다. 한편, '흑의 4'를 낙찰받은 흑막과 관련된 정보를 얻게 된 마리야. 하지만 정부와 연관이 있는 그 사람을 쉽게 건들 수 없어 곤란해하던 마리야의 앞에 스위티가 나타났는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27393/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-22T01:00:00.746234", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31400, "title": "Fairy gone [2022년 판권 만료작]", "subject": "무대 뒤의 피리 부는 자", "description": "세르쥬와 프리도 합류해 기습 작전에 성공하면서 도로테아는 흑의 4를 입수한다. 한편, 오작동을 일으킨 신형 인공요정이 투입된 채 진행된 종전기념식. 그곳에서 모습을 드러낸 수상 골반 헬와이즈와 슈바르츠 디제, 그리고 레이 돈. 레이 돈은 마리야와 베로니카의 고향을 불태운 장본인이었다. 그런 레이 돈을 형형한 눈빛으로 바라보는 베로니카였는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/05/27536/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-05-29T01:00:00.218151", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31529, "title": "Fairy gone [2022년 판권 만료작]", "subject": "굴러다니는 돌과 7인의 기사", "description": "수상 암살은 미수로 끝났고, 암살을 막아낸 하이브란츠 공 디제는 그 포상으로 요정 무기를 요구한다. 세상에 7개밖에 없는 요정 무기는 국보이기에 그 운반을 도로테아가 맡았는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27733/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-05T01:00:00.615612", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31619, "title": "Fairy gone [2022년 판권 만료작]", "subject": "재앙의 아이", "description": "도로테아를 습격한 자의 정체는 전쟁 대리인이자 용병부대 대장인 비비 리스카였다. 7인의 기사 중 한 명이기도 한 비비 리스카에게 압도적으로 패배한 도로테아. 동료의 죽음과 운반하던 요정 무기 프라타닐까지 뺏겨버린 현실에 마리야는 스스로를 책하는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/27857/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-12T16:00:00.516390", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31717, "title": "Fairy gone [2022년 판권 만료작]", "subject": "초대하지 않은 음악대", "description": "갑자기 디제가 통일 제스키아로부터의 독립을 선언하며 군사를 일으켰다. 울프란의 암약, 인공 요정 폭주, 수상 암살 미수, 리스카에 의한 열차 습격. 이 모든 게 계획된 사건이고, 독립 전쟁을 위한 준비였다. 통일 군이 이에 바로 대응하여 공도 합슈타트로 진압 부대를 파견한다. 도로테아 국장이자 7인의 기사 중 한 명인 네인 아우라도 진압 부대에 합류한다. 한편, 마리야와 프리 일행은 수도 론다시아로 급히 돌아오는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/28104/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-19T01:00:00.730722", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 31760, "title": "Fairy gone [2022년 판권 만료작]", "subject": "무력한 병사", "description": "공도 합슈타트에서 일어난 싸움은 양동작전이었고, 디제의 진짜 목적은 황제와 수상 골반이 있는 수도 론다시아였다. 리스카가 노련한 용병집단을 이끌고 론다시아를 기습하여 통일군은 치명적인 피해를 입는다. 마리야, 세르쥬, 클라라와 함께 요정 무기인 베로스틸을 손에 쥔 프리는 리스카를 쫓아 궁전으로 들어간다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/06/28337/v4/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-06-26T01:00:00.306474", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}]}