{"count": 12, "next": null, "previous": null, "results": [{"id": 30300, "title": "Fairy gone [2022년 판권 만료작]", "subject": "재투성이 소녀", "description": "전쟁이 끝난 지도 9년. 마리야 노엘은 경매장에서 소꿉친구 베로니카 손과 우연히 재회하게 된다. 하지만 베로니카는 두 사람의 고향을 불태워버린 남자에게 복수심을 품고 있었는데.", "episode_num": "1", "episode_order": 1, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/04/26076/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-04-10T01:00:00.198224", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 30432, "title": "Fairy gone [2022년 판권 만료작]", "subject": "늑대의 목줄과 백조의 날개", "description": "인위적으로 이식술을 받은 것이 아닌 요정 원체가 직접 인간에게 씐 특이체질 마리야는 프리의 제안으로 도로테아에 들어가게 된다. 그리고 첫 임무지에서 만난 마피아는 바로 프리의 예전 전우인 울프란이었는데.", "episode_num": "2", "episode_order": 2, "thumbnail_path": "https://thumbnail.laftel.net/assets/2019/04/26160/v1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:45.033000", "progressbar": null, "item_expire_datetime": "2022-03-31T23:30:00", "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2019-04-17T01:00:00.789836", "rating": {"rating": 19, "rating_type": null, "classification_number": "", "broadcast_channel_name": "", "broadcast_date": null, "rating_components": []}, "access_type": null, "is_available": false}, {"id": 30476, "title": "Fairy gone [2022년 판권 만료작]", "subject": "욕심쟁이 여우와 거짓말쟁이 까마귀", "description": "베로니카가 노리는 흑의 요정서가 발견되었다는 정보를 입수해 탑의 도시 이즈하라트로 향한 프리와 마리야. 요정학자 카인 디스타롤을 찾아갔지만 한발 앞서 실업가 스위티 비터 스위트가 와있었는데.", "episode_num": "