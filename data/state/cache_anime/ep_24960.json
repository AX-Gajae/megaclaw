de_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2240/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.100000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 13693, "name": "원펀맨 7 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-12T16:47:14.309784", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2015-11-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2344, "title": "원펀맨", "subject": "심해의 왕", "description": " 심해에 사는 괴인들이 지상을 접수하기 위해 J 시를 침공한다. A급 히어로인 '스팅거'가 격투 끝에 그들을 박멸시키지만, 뒤늦게 나타난 '심해왕'에게 한 방에 쓰러져 버린다. 뉴스에서 사건을 접한 사이타마와 제노스는 서둘러 J 시로 향하는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2241/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 13694, "name": "원펀맨 8 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-12T16:47:14.420392", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2015-11-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2345, "title": "원펀맨", "subject": "불굴의 정의", "description": "심해왕의 습격으로 인해 공포의 도가니에 빠진 재해 대피소에 제노스가 나타난다. 심해왕과 호각으로 싸우던 제노스는 어린아이를 감싸다가 심해왕이 뱉은 용해액을 뒤집어쓰고 만다. 제노스에게 최후의 일격을 가하려는 심해왕에게 또 다른 히어로가 덤벼드는데…", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2242/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 13695, "name": "원펀맨 9 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-12T16:47:14.536194", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2015-11-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2346, "title": "원펀맨", "subject": "전례 없는 위기", "description": " S급 히어로들에게 비상소집이 걸렸다. 마침 실버 팽의 도장을 방문했던 사이타마와 제노스도 실버 팽과 함께 히어로 협회 본부로 향한다. S급 히어로들이 모인 앞에서 협회 간부는 힘겹게 입을 열어 긴급회의를 열게 된 이유를 설명하는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2243/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 13696, "name": "원펀맨 10 소장", "list_price": 600, "period": "0 day", "promotion": null}], "published_datetime": "2017-09-12T16:47:14.650058", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "케이블", "broadcast_date": "2015-12-07", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 2347, "title": "원펀맨", "subject": "전 우주의 패자", "description": " A 시 상공에 나타난 거대 우주선에서 지상으로 내려온 전투원 멜자가드. 그를 막기 위해 S급 히어로 4명이 덤비지만, 치명상을 입히는 데에는 번번이 실패한다. 한편, 우주선 내부로 들어간 사이타마는 보스를 찾아다니며 적들을 해치우는데... ", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2018/12/2244/v1/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:25.0