, "is_available": false}, {"id": 75630, "title": "선배는 남자아이", "subject": "잘 가, 나 자신", "description": "마코토의 엄마는 마코토 방에 들어갔다가 아오이가 선물한 귀여운 손수건을 발견한다. 충격과 실의에 빠져 있는 엄마의 모습을 본 마코토는 아오이 손수건이라고 둘러대며 엄마를 안심시키고, 여장을 그만둔다. 그날 이후로 마코토를 바라보는 시선이 달라지고 주변에 친구들이 모여든다. 하지만 아오이는 오히려 마코토가 거짓말을 하는 거라며 화를 낸다.", "episode_num": "3", "episode_order": 3, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/07/84429/v30/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 107850, "name": "선배는 남자아이 3 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-07-22T14:00:11.180938", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-07-19", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75631, "title": "선배는 남자아이", "subject": "깨닫고 말았다", "description": "류지는 사키에게 달려가는 마코토의 모습을 보면서 자신의 감정을 깨닫는다. 마코토는 다시 여장하고 다니기로 하지만 전과는 달리 반 친구들과도 가깝게 지낸다. \r\n그러던 어느 날, 사키가 두 과목이나 낙제점을 받으면서 재시험을 치르게 된다. 류지와 마코토는 사키의 시험공부를 봐주기 위해 류지 집에서 합숙하기로 하는데…", "episode_num": "4", "episode_order": 4, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92071/v30/92516b162af0/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108380, "name": "선배는 남자아이 4 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-07-26T17:00:09.636992", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-07-26", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75632, "title": "선배는 남자아이", "subject": "특별함", "description": "마코토의 농구 경기를 관람하던 류지는 사키에게 마코토를 정말로 좋아하느냐고 묻는다. 류지야말로 마코토를 어떻게 생각하냐고 되묻는 사키의 질문에 류지는 마코토를 좋아한다고 솔직하게 대답한다. 그런데 그 말을 들은 사키가 갑자기 자신의 마음은 진짜로 보이지 않느냐면서 눈물을 글썽인다. 멀리서 심각한 분위기의 두 사람을 본 마코토는 류지와 사키가 사귄다고 의심하는데…", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92072/v30/2715f815a1be/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108552, "name": "선배는 남자아이 5 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-02T13:00:08.645208", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-02", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75633, "title": "선배는 남자아이", "subject": "정해야 하는 것", "description": "감기로 결석한 류지를 병문안하러 찾아온 마코토는 류지가 좋아하는 사람이 아오이라고 착각하고 류지에게 두 사람을 응원하겠다고 말한다. 한편, 마코토가 진로 조사표를 받아들고 오자, 마코토의 아버지는 마코토를 데리고 드라이브에 나선다. 그리고 마코토가 행복해지기 위해 자신이 도울 수 있는 게 뭔지 생각할 테니 마코토는 아무 걱정 하지 말고 자신만의 대답을 찾으면 된다면서 마코토를 격려한다.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92073/v30/f09bc6dcefb6/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108822, "name": "선배는 남자아이 6 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-16T18:00:10.278666", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75634, "title": "선배는 남자아이", "subject": "그런 쪽", "description": "류지의 교복 주머니 속에 있던 학생수첩이 떨어지면서 그 안에 끼워져 있던 마코토의 사진이 펼쳐진다. 다행히 아무것도 못 본 듯한 마코토의 반응에 류지는 안도하며 가슴을 쓸어내린다. 하지만 마코토가 평소와 다르다는 걸 눈치챈 류지는 마코토에게 좋아한다고 고백한다. 이젠 예전 같은 사이로 돌아갈 수 없다는 걸 직감하는 마코토. 그리고 다음 날 류지는 학교에 나오지 않는데...", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92074/v30/7c60d1ad843b/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109098, "name": "선배는 남자아이 7 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-23T16:00:11.441520", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75635, "title": "선배는 남자아이", "subject": "상처", "description": "아오이는 할머니가 쓰러지셨단 얘기를 듣고 곧장 아빠에게 전화하지만 연락이 닿지 않는다. 다행히 할머니는 큰 병이 아니었지만 아오이는 긴장이 풀려 병원 계단에서 넘어지고 만다. 집으로 돌아온 아오이. 그런데 밖에서 이상한 소리가 들린다. 그 순간 학교 근처에서 수상한 사람이 배회하니 조심하라고 했던 담임 선생님의 말이 떠오르고, 겁에 질려 류지에게 전화를 하는데…", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92075/v30/0315e40af551/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109316, "name": "선배는 남자아이 8 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-08-30T14:00:14.606784", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-08-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75636, "title": "선배는 남자아이", "subject": "크리스마스", "description": "크리스마스 이브. 아오이는 아빠와 가기로 했던 플라네타륨을 혼자 쓸쓸히 방문한다. 돌아오는 길에 우연히 엄마를 발견한 아오이는 필사적으로 뒤쫓아가지만 잡을 수 없다. \r\n류지의 집으로 가던 마코토는 절망에 빠진 아오이와 마주친다. 이제 자신에게는 아무도 없다며 눈물 흘리는 아오이를 끌어안고 언제나 곁에 있어 주겠다고 말하는 마코토. 그런데 마코토를 마중 나왔던 류지가 그런 두 사람의 모습을 보게 된다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92076/v30/f1ecd909a7c8/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109470, "name": "선배는 남자아이 9 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-06T15:00:18.589628", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-09-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75637, "title": "선배는 남자아이", "subject": "두 사람의 마음", "description": "마코토에게 이별을 고한 류지는 아오이를 찾아가 슬픔을 토로한다. 자신의 감정에 혼란을 느끼며 어떡해야 할지 갈팡질팡하는 마코토도 악몽에 시달린다. 서로를 피하는 마코토와 류지를 지켜보던 아오이는 두 사람을 화해시키기 위해 놀이공원으로 불러낸다. 그리고 어느 날, 아오이는 신사에 갔다가 우연히 엄마와 마주치는데…", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92077/v30/b9a9525d04a1/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 109973, "name": "선배는 남자아이 10 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-13T00:15:07.827931", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-09-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75638, "title": "선배는 남자아이", "subject": "한때 친구", "description": "수학여행을 앞둔 마코토와 류지. 그런데 류지의 반 친구인 사오토메가 마코토에게 수학여행 자유 시간에 하야세와 함께 다니게 해 달라고 부탁한다. 사실 마코토와 하야세는 1학년 때 친하게 지냈지만 어떤 사건이 터지면서 사이가 멀어지게 됐다. 마코토가 머뭇거리고 있는 그때, 하야세가 마코토에게 다가와 수학여행에서 함께 다니자고 먼저 손을 내민다. 그리고 수학여행. 하지만 마코토와 하야세는 여전히 어색하기만 한데…", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92078/v30/13e41b9f9c18/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110097, "name": "선배는 남자아이 11 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-20T17:00:13.349240", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-09-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75639, "title": "선배는 남자아이", "subject": "진짜 나", "description": "마코토의 엄마는 우연히 아버지가 자신이 바르던 매니큐어를 바르고 자신처럼 머리를 묶고 자신을 흉내 낸다는 사실을 알게 된다. 어머니가 돌아가신 뒤, 마코토의 엄마는 아버지와 인연을 끊고 살았다. 마코토는 아빠가 적어 준 주소를 들고 할아버지 댁으로 향한다. 마코토가 초인종을 누르자 긴 머리를 늘어뜨린 할아버지가 나온다. 할아버지의 집은 예쁘고 귀여운 물건들로 가득 차 있다. 폭설로 전철이 끊기는 바람에 할아버지 집에서 묵게 된 마코토는 할아버지가 옷 만드는 일을 한다는 걸 알게 된다. 할아버지가 만든 옷을 입고 신나게 눈밭을 뛰어다니는 마코토. 할아버지는 현재 자신은 행복하며, 소중한 것 몇 가지를 버리면 하나쯤은 지킬 수 있다고 말한다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2025/03/92079/v30/1eb52f3d9267/Thumbnail.0000055.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:01.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 110257, "name": "선배는 남자아이 12 대여", "list_price": 700, "period": "7 day", "promotion": null}], "published_datetime": "2024-09-27T00:00:10.973398", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2024-09-27", "rating_components": []}, "access_type": null, "is_available": false}]}