ccess_type": null, "is_available": false}, {"id": 75510, "title": "도망을 잘 치는 도련님", "subject": "윤지를 훔쳐라, 오가사와라 저택의 밤", "description": "자유자재로 모습을 바꾸고 온갖 기술로 적을 농락하는 도둑 카자마 겐바. 토키유키는 겐바와 함께 오가사와라 저택에 숨어들어 윤지가 보관되어 있는 창고에 침입하는 데 성공했다. 하지만, 그런 두 사람을 사다무네의 부하 이치카와 스케후사의 '귀'가 포착했는데...... 스케후사의 '귀신같은 청력'에 겐바도 고전을 면치 못한다. 숨 소리 한 번에 목숨이 달아날 수도 있는 상황에서 두 사람은 서서히 궁지에 몰린다. 목숨의 위기에 직면했을 때 엿보이는 인간의 마음이야말로 본질. 어두운 밤에 숨은 귀신을 상대로 토키유키 일행은 승리할 수 있을 것인가──.", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85579/v30/65d4d5039bb1/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 108719, "name": "도망을 잘 치는 도련님 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 108718, "name": "도망을 잘 치는 도련님 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2024-08-11T02:00:13.186644", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2024-08-10", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 75511, "title": "도망을 잘 치는 도련님", "subject": "겨울의 아이들", "description": "스와에서 첫 새해를 맞이한 토키유키. 전국의 혼란은 일단 소강상태에 접어들긴 했지만 소규모 충돌은 여전히 끊이지 않았고, 스와 땅에도 다시 새로운 위기가 닥쳐오고 있었다. 스와의 영지인 북쪽 국경 부근에서 오가사와라의 불온한 움직임을 감지한 요리시게 진영. 실력 있는 정찰병들은 모두 다른 임무를 수행 중인 가운데, 토키유키가 '도약당'을 이끌고 정찰을 다녀오겠다고 제안한다. 마음 든든한 제안에 기뻐하는 낭당원들이었지만 어째선지 요리시게만 이를 맹렬하게 반대했는데...... 어른들의 기대와 걱정을 짊어지고 도약당이 스와의 땅을 달린다──!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2024/08/85141/v30/87544e93280e/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.433000", "progressbar": null, "item_expire_datetime": null, "in_app_download": 