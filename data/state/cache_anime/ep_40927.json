ents": []}, "access_type": null, "is_available": false}, {"id": 56107, "title": "그래도 아유무는 다가온다", "subject": "선배한테 받고 싶거든요", "description": "밸런타인데이가 다가온다. 아유무에게 평소의 감사를 전하기 위해 초콜릿을 준비한 우루시는 어떻게 아유무에게 건네줘야 할지에 대해 계속 고민하고 있었다.\n [분위기를 잡고, 뜸을 엄청 들이다가...... 이때다 싶을 때 건네줘. 그럼 뭔가 한 걸음 진전될 거야!]\n [마키는 뭔 소릴 하는 거야...... 이상한 소릴 하니까, 긴장되기 시작하잖아......!]\n 마키의 조언을 받은 우루시는 아유무에게 초콜릿을 건네줄 수 있을 것인가?!", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/59933/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75613, "name": "그래도 아유무는 다가온다 6 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75612, "name": "그래도 아유무는 다가온다 6 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-17T00:30:08.702907", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-16", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56177, "title": "그래도 아유무는 다가온다", "subject": "그만둘 순 없으니까요", "description": "봄이 되어 우루시는 3학년으로 그리고 아유무는 2학년으로 진급했다. 쇼기부를 정식 부로 만들기 위해 우루시가 아유무, 타케루와 함께 신입 부원 모집에 힘쓰고 있을 때 신입생이자 아유무와 타케루의 중학교 시절 검도부 후배였던 린이 나타난다.\n [야오토메 우루시 씨......라고 하셨죠?]\n [아, 응?]\n [......제 소중한 선배님들을 돌려주세요]\n 린의 갑작스러운 선전포고에 쩔쩔매는 우루시, 쇼기부 잔류를 걸고 아유무는 린이 제안한 검도 시합을 받아들였는데.", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/60028/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 75744, "name": "그래도 아유무는 다가온다 7 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 75743, "name": "그래도 아유무는 다가온다 7 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-24T00:30:08.322942", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-23", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56326, "title": "그래도 아유무는 다가온다", "subject": "양보할 수 없는 역할이라서요", "description": "쇼기부가 정식 부가 되었습니다!'\r\n 린의 가입으로 정식 부로 승격한 쇼기부. 단둘이서 하던 동아리에 후배들이 가입하면서 시끌벅적해진다. 그러던 어느 날, 린은 돌연 우루시의 핵심에 접근한다. \r\n [솔직하게 여쭤볼 게 있어서요]\r\n [물어볼 게 있어?]\r\n [부장님은 타나카 씨를 좋아하세요?]\r\n 갑작스러운 린의 언동에 놀라 부끄러워하는 우루시. 그리고 린은 아유무를 찾아갔는데.", "episode_num": "8", "episode_order": 8, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/08/60307/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 76056, "name": "그래도 아유무는 다가온다 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76055, "name": "그래도 아유무는 다가온다 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-08-31T00:30:09.824865", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-08-30", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56452, "title": "그래도 아유무는 다가온다", "subject": "추억을 만들고 싶으니까요", "description": "골든 위크 마지막 날. 우루시, 아유무, 타케루, 린 네 명이서 게임 센터로 놀러 가게 되었다. 우루시&아유무, 타케루&린으로 짝을 지어 하게 된 에어 하키 대결에서, 아유무와 우루시는 패배하고 말았고 벌칙으로 마실 것을 사러 갔다. 마실 걸 사고 돌아오는 길에, 둘은 아유무의 부탁으로 스티커 사진을 찍게 되었다.\n [... 긴장하고 있어?]\n [네, 처음이라서요.]\n 그렇게 둘은 서로 좀처럼 볼 수 없는 표정으로 사진을 찍게 되었는데.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/09/60556/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 76230, "name": "그래도 아유무는 다가온다 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76229, "name": "그래도 아유무는 다가온다 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-09-07T00:30:10.032348", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-09-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56594, "title": "그래도 아유무는 다가온다", "subject": "질 수 없는 승부거든요", "description": "우루시의 집에 방문한 아유무는 처음으로 우루시의 아버지와 얼굴을 마주하게 되었다. 그런데 막 인사를 하고 난 다음에 우루시는 아유무를 끌고 급히 그 자리를 벗어났다. 둘은 우루시가 자주 가는 오코노미야키집으로 도망쳐 왔으나, 우루시의 아버지는 그런 그들의 생각을 꿰뚫어 보고 그들을 쫓아왔다. \n [아버님, 저랑 승부해 주시겠습니까?]\n [승부?]\n [제가 이기면... 따님 말씀을 제대로 들어주십시오.]\n 우루시의 이야기를 듣게 하기 위해 아유무는 우루시의 아버지와 쇼기로 승부하게 되었는데.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/09/60623/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 76512, "name": "그래도 아유무는 다가온다 10 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76511, "name": "그래도 아유무는 다가온다 10 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-09-14T00:30:09.940408", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-09-13", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56652, "title": "그래도 아유무는 다가온다", "subject": "강해져 있고 싶으니까요", "description": "쇼기부 동아리방에 우루시는 없었다. 아유무는 어쩐지 안절부절못하는 듯한 기색으로 쇼기 특훈에 임하고 있었다. 한편, 우루시는 수학여행을 즐기면서도 어딘가 정신이 딴 데 가 있는 모양. 상대방을 염려하여 연락을 해보려하는 우루시에게, 친구인 마키가 핵심을 찌르는 말을 했다.\n [저기, 우루시]\n [응?]\n [타나카를 좋아하는 거 아니야?]\n [그, 그러니까 아니라고!]\n 부정하면서도 우루시는 아유무에 대한 마음을 조금씩 의식하기 시작했다. 그리고 수학여행 사흘째, 우루시는 마키에게 아유무로부터 밤에 전화가 올 거라는 이야기를 털어놓았는데.", "episode_num": "11", "episode_order": 11, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/09/60710/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 76622, "name": "그래도 아유무는 다가온다 11 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 76621, "name": "그래도 아유무는 다가온다 11 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-09-21T00:30:09.812310", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니플러스", "broadcast_date": "2022-09-20", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 56785, "title": "그래도 아유무는 다가온다", "subject": "이겨서 전하고 싶으니까요", "description": "수학여행 사흘째. 약속된 날 밤에 우루시는 아유무의 전화를 기다리고 있었고, 얼마 안 있어 스마트폰 벨 소리가 울렸다.\n [달이 아름답네요.]\n [뭐? 뭐어?! 아니, 저기...]\n 아무렇지도 않게 아유무가 한 말에 우루시는 전화 너머로도 당황하는 모습을 보였다. 서로 쓸쓸했던 걸 채우기라도 하듯이, 눈앞에 없는 상대와 마주하며 쇼기를 두는 두 사람. 그리고, 아유무는 마음을 전하겠다는 강한 각오로 수학여행에서 돌아오는 우루시와의 승부에 도전했는데.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/09/60782/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22.466000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": fa