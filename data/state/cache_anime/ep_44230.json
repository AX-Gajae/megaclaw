": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-03-25T01:30:08.797572", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-03-24", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91628, "title": "인외교실의 인간혐오 교사", "subject": "인간 혐오와 여명의 빛", "description": "한 해의 마무리가 다가오는 시점, 상급 클래스 학생들은 졸업을 위한 최종 과제를 받게 된다.\r\n모두가 고전하면서도 열심히 과제를 해 나가는 와중에 쿄우카는 자신만의 힘으로 해결하는 것을 고집하고, 그 모습을 보다 못한 히토마는...", "episode_num": "6", "episode_order": 6, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/03/105247/v30/b204947de718/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.033000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-04-01T01:30:07.396570", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2026-03-31", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 91629, "title": "인외교실의 인간혐오 교사", "subject": "인간 혐오와 열매를 맺지 못하는 사랑 점", "description": "졸업생을 배출한 히토마는, 새로운 학기를 맞이한다. 상급 클래스에 새롭게 들어온 류자키 카린, 네즈 마치, 쿠로사와 네네코.\r\n그런데, 무려 학기 첫날부터 카린이 히토마에게 고백해 오는데...?!", "episode_num": "7", "episode_order": 7, "thumbnail_path": "https://thumbnail.laftel.net/assets/2026/04/105590/v30/1da0737a5247/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:23:51.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": false, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [], "published_datetime": "2026-04-08T