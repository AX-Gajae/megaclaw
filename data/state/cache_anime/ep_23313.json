ire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 59826, "name": "옆자리 괴물군 4 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 59825, "name": "옆자리 괴물군 4 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-03-18T00:00:00.166218", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2021-03-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45758, "title": "옆자리 괴물군", "subject": "요시다네 사정", "description": "하루의 중학교 시절과 친형 유우잔에 대해 시즈쿠가 묻자, 하루는 캐내려 하지 말라고 한다. 어디까지 개입해도 되는지 몰라서 고민하는 시즈쿠. 그런데 그때, 두 사람 앞에 갑자기 나타난 유우잔은 할 얘기가 있다며 시즈쿠를 데려간다. 한편, 그 자리에서 도망친 하루는 구기 대회 때 알게 된 오시마와 우연히 마주치고, 오시마에게 유우잔이 있는지 살펴보라고 하는데...", "episode_num": "5", "episode_order": 5, "thumbnail_path": "https://thumbnail.laftel.net/assets/2021/03/45670/v15/Thumbnail.0000058.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:22", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 59824, "name": "옆자리 괴물군 5 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 59823, "name": "옆자리 괴물군 5 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2021-03-18T00:00:00.166218", "rating": {"rating": 15, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니박스", "broadcast_date": "2021-03-18", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 45759, "title": "옆자리 괴물군", "subject": "그녀들의 우울한 나날", "description": "시즈쿠는 유우잔과 얘기를 나눈 이후로 하루를 잃기 싫은 걸 자각한다. 하지만 신통치 않은 모의고사 결과와 급부상한 오시마의 존재에 동요를 하게 된다. 오시마를 끌어들인 작전 회의에서 다투게 된 시즈쿠와 하루. 그걸 계기로 두 사람은 얘기를 나누지만 서로 의견이 맞지 않는다. 사이에서 듣고 있던 오시마는 그 상황이 답답해서 어떤 말을 하는데...", "ep