하야카와에게 무언가를 내민다. 그것은 히메노의 말이 적힌 담배였다. 하야카와는 그 한마디를 가슴에 품고 고스트를 죽이며 사와타리 체포에 성공한다. 그 무렵, 다시 사무라이 소드와 대치한 덴지는 가슴의 시동줄을 잡아당겨 체인소 맨으로 변하고, 체인소 맨과 사무라이 소드와의 마지막 전투가 시작된다.", "episode_num": "12", "episode_order": 12, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/63382/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 79288, "name": "체인소 맨 12 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 79287, "name": "체인소 맨 12 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-12-29T01:00:11.013760", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-12-27", "rating_components": []}, "access_type": null, "is_available": false}]}