tem_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78429, "name": "체인소 맨 8 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 78428, "name": "체인소 맨 8 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-12-01T01:00:10.493865", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-11-29", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58071, "title": "체인소 맨", "subject": "교토에서", "description": "덴지와 사무라이 소드의 격투가 벌어진다. 덴지는 사무라이 소드의 동료를 인질로 잡지만, 사무라이 소드는 인질과 함께 덴지를 베어버리고 마침내 덴지를 포획하는데 성공한다. 그런 와중에 죽은 줄 알았던 마키마가 살아있다는 게 밝혀진다. 마키마는 교토의 데블 헌터, 쿠로세와 텐도의 힘을 빌려 덴지 탈환에 나선다.", "episode_num": "9", "episode_order": 9, "thumbnail_path": "https://thumbnail.laftel.net/assets/2022/12/62358/v15/Thumbnail.0000057.jpg", "has_preview": true, "access_info_list": [], "running_time": "0:24:00.066000", "progressbar": null, "item_expire_datetime": null, "in_app_download": true, "is_avod": false, "is_free": false, "is_viewing": true, "products": [], "episode_products": [{"id": 78703, "name": "체인소 맨 9 대여", "list_price": 700, "period": "7 day", "promotion": null}, {"id": 78702, "name": "체인소 맨 9 소장", "list_price": 1500, "period": "0 day", "promotion": null}], "published_datetime": "2022-12-08T01:00:10.602488", "rating": {"rating": 19, "rating_type": "방송통신심의위원회", "classification_number": "", "broadcast_channel_name": "애니맥스", "broadcast_date": "2022-12-06", "rating_components": []}, "access_type": null, "is_available": false}, {"id": 58228, "title": "체인소 맨", "subject": "더 너덜너덜하게", "description": "일련의 습격으로 다수의 인원을 잃은 공안 대마 특이 4과. 병원 침대에서 깨어난 하야카와 아키는 히메노를 잃었다는 사실을 받아들이지 못한다. 그런 하야카와 앞에 쿠로세와 텐도가 나타나 하야카와를 지도하겠다고 말한다. 그 무렵, 마키마는 4과를 강화하기 위해 덴지와 파워의 지도를 맡을 인물을 소개한다.", "episode_num": "10", "episode_order": 10, "thumbnail_path": "ht